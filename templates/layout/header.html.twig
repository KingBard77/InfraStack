{# templates/layout/header.html.twig #}
{% block header %}
  <header id="header" class="header infrastack-header">
    <div class="container-xl">
      <div class="infrastack-header-row">
        <a
          href="{{ path('app_main') }}"
          class="infrastack-logo {{ app.request.attributes.get('_route') == 'app_main' ? 'active' : '' }}"
          aria-label="InfraStack home"
        >
          <img
            src="{{ asset('brand-mark.svg') }}"
            width="34"
            height="34"
            class="infrastack-brand-mark"
            alt=""
            aria-hidden="true"
          >
          <span>InfraStack</span>
        </a>

        <nav id="navmenu" class="navmenu infrastack-nav">
          <ul id="infrastack-nav-list">
            <li>
              <a href="{{ path('app_main') }}" class="{{ app.request.attributes.get('_route') == 'app_main' ? 'active' : '' }}">
                Home
              </a>
            </li>
            <li>
              <a href="{{ path('app_studio') }}" class="{{ app.request.attributes.get('_route') == 'app_studio' ? 'active' : '' }}">
                Studio
              </a>
            </li>
            <li>
              <a href="{{ path('app_author') }}" class="{{ app.request.attributes.get('_route') == 'app_author' ? 'active' : '' }}">
                Author Profile
              </a>
            </li>
            <li>
              <a href="{{ path('app_contact') }}" class="{{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}">
                Contact Us
              </a>
            </li>
            <li>
              <a href="{{ path('app_privacy') }}" class="{{ app.request.attributes.get('_route') == 'app_privacy' ? 'active' : '' }}">
                Privacy
              </a>
            </li>
          </ul>

          <button
            type="button"
            class="mobile-nav-toggle d-xl-none"
            aria-label="Open navigation menu"
            aria-controls="infrastack-nav-list"
            aria-expanded="false"
          >
            <i class="bi bi-list" aria-hidden="true"></i>
          </button>
        </nav>

        <a href="{{ path('app_studio') }}" class="infrastack-header-studio-link"><i class="bi bi-bounding-box-circles"></i> Open Studio</a>
      </div>
    </div>
  </header>
{% endblock %}
