{# templates/layout/header.html.twig #}
{% block header %}
  <header id="header" class="header infrastack-header">
    <div class="container-xl">
      <div class="infrastack-header-row">
        <a
          href="{{ path('app_main') }}"
          class="infrastack-logo {{ app.request.attributes.get('_route') == 'app_main' ? 'active' : '' }}"
          aria-label="InfraStack home"
        >
          <img
            src="{{ asset('infrastack-logo.svg') }}"
            width="150"
            height="48"
            alt=""
            aria-hidden="true"
          >
        </a>

        <nav id="navmenu" class="navmenu infrastack-nav">
          <ul id="infrastack-nav-list">
            <li>
              <a href="{{ path('app_main') }}" class="{{ app.request.attributes.get('_route') == 'app_main' ? 'active' : '' }}">
                Home
              </a>
            </li>
            <li>
              <a href="{{ path('app_category') }}" class="{{ app.request.attributes.get('_route') in ['app_category', 'tool_detail'] ? 'active' : '' }}">
                Tools
              </a>
            </li>
            <li>
              <a href="{{ path('app_author') }}" class="{{ app.request.attributes.get('_route') == 'app_author' ? 'active' : '' }}">
                Author Profile
              </a>
            </li>
            <li>
              <a href="{{ path('app_contact') }}" class="{{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}">
                Contact Us
              </a>
            </li>
            <li>
              <a href="{{ path('app_privacy') }}" class="{{ app.request.attributes.get('_route') == 'app_privacy' ? 'active' : '' }}">
                Privacy
              </a>
            </li>
          </ul>

          <button
            type="button"
            class="mobile-nav-toggle d-xl-none"
            aria-label="Open navigation menu"
            aria-controls="infrastack-nav-list"
            aria-expanded="false"
          >
            <i class="bi bi-list" aria-hidden="true"></i>
          </button>
        </nav>

        <form method="get" action="{{ path('app_category') }}" class="search-form infrastack-header-search" role="search">
          <label for="infrastack-header-search-input" class="visually-hidden">Search tools</label>
          <input
            id="infrastack-header-search-input"
            type="search"
            name="q"
            value="{{ app.request.query.get('q') }}"
            placeholder="Search tools..."
            class="form-control"
          >
          <button type="submit" class="btn" title="Search">
            <i class="bi bi-search"></i>
          </button>
        </form>
      </div>
    </div>
  </header>
{% endblock %}
