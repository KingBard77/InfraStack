{# link.html.twig #}
{% set linkItems = related_links|default(meta.related_links|default([])) %}

{% if linkItems is iterable and linkItems|length > 0 %}
  {% set linkTitleId = related_links_title_id|default('related-links-' ~ category|default('page') ~ '-' ~ slug|default('content')) %}
  {% set linkHeading = related_links_heading|default(meta.related_links_heading|default('Link')) %}
  {% set linkLimit = related_links_limit|default(2) %}

  <section class="related-link-section" aria-labelledby="{{ linkTitleId|e('html_attr') }}" data-related-link-section>
    <h4 id="{{ linkTitleId|e('html_attr') }}">{{ linkHeading }}:</h4>

    <div class="related-link-panel">
      <div class="related-link-list">
        {% for link in linkItems|slice(0, linkLimit) %}
          {% set linkUrl = link.url|default('')|trim %}

          {% if linkUrl starts with 'https://' or linkUrl starts with 'http://' %}
            {% set linkTitle = link.title|default(linkUrl) %}
            {% set linkDescription = link.description|default('') %}
            {% set linkEmbedUrl = link.embed_url|default(linkUrl)|trim %}
            {% set linkIframeTitle = link.iframe_title|default(linkTitle) %}

            <div class="related-link-item">
              <span class="related-link-title">{{ linkTitle }}</span>
              <span class="related-link-actions">
                <button
                  type="button"
                  class="related-link-action"
                  data-related-link-iframe
                  data-related-link-title="{{ linkIframeTitle|e('html_attr') }}"
                  data-related-link-iframe-url="{{ linkEmbedUrl|e('html_attr') }}"
                  data-related-link-browser-url="{{ linkUrl|e('html_attr') }}"
                  {% if linkDescription %}
                    aria-label="{{ 'Open iframe for ' ~ linkTitle ~ ': ' ~ linkDescription }}"
                  {% endif %}
                >
                  <i class="bi bi-window" aria-hidden="true"></i>
                  <span>Iframe</span>
                </button>
                <a class="related-link-action" href="{{ linkUrl }}" target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                  <span>Browser</span>
                </a>
              </span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="related-link-frame" data-related-link-frame hidden>
      <div class="related-link-frame-header">
        <strong data-related-link-frame-title>Embedded Tool</strong>
        <span class="related-link-frame-actions">
          <a href="#" target="_blank" rel="noopener noreferrer" data-related-link-frame-open>
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <span>Browser</span>
          </a>
          <button type="button" data-related-link-frame-close aria-label="Close iframe preview">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>
        </span>
      </div>
      <iframe
        data-related-link-frame-iframe
        title="Embedded related tool"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
      ></iframe>
    </div>
  </section>
{% endif %}
