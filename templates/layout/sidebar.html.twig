{# templates/layout/sidebar.html.twig #}
<div class="col-lg-4 sidebar">
  <div class="widgets-container">

    {{ include('layout/advertisement.html.twig') }}

    {{ include('layout/discussion.html.twig') }}
    
    <div class="tags-widget widget-item professional-tags-widget">
      <h3 class="widget-title">Popular Tags</h3>
      <ul>
        {% for tag in popular_tags|default([]) %}
          <li>
            <a
              href="{{ path('app_category', {
                tag: tag.name,
                q: search_query|default(''),
                sort: sort|default('newest'),
                group: group_filter|default(''),
                category: category_filter|default(''),
                family: family_filter|default('')
              }) }}"
              class="tag-chip {{ tag_filter|default('') == tag.name ? 'active' : '' }}"
            >
              <i class="bi bi-tag"></i>
              <span>{{ tag.name }}</span>
              <small>{{ tag.count }}</small>
            </a>
          </li>
        {% else %}
          <li>
            <span class="tag-chip tag-chip-empty">
              <i class="bi bi-tags"></i>
              <span>No tags found</span>
            </span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
