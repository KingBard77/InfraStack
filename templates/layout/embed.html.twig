{# templates/layout/embed.html.twig #}
{% if embedMode|default('frame') == 'builder' %}
<div class="embed-share-section">
  <div class="article-share-divider embed-share-divider" aria-hidden="true"></div>

  <div
    class="embed-share-box"
    data-embed-builder
    data-embed-base-url="{{ embedUrlWithShare|e('html_attr') }}"
    data-embed-title="{{ shareTitle|e('html_attr') }}"
    data-embed-category="{{ category|e('html_attr') }}"
    data-embed-slug="{{ slug|e('html_attr') }}"
  >
    <div class="embed-share-header">
      <h4><label for="article-embed-code">Embed</label></h4>
      <div class="embed-share-links">
        <button
          type="button"
          class="embed-share-panel-button embed-share-panel-button-customize"
          data-embed-focus="customize"
          aria-controls="article-embed-customize"
          aria-expanded="false"
        >
          <i class="bi bi-sliders" aria-hidden="true"></i>
          <span>Customize</span>
        </button>
        <button
          type="button"
          class="embed-share-panel-button embed-share-panel-button-disclaimer"
          data-embed-focus="disclaimer"
          aria-controls="article-embed-disclaimer"
          aria-expanded="false"
        >
          <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
          <span>Disclaimer</span>
        </button>
        <button
          type="button"
          class="embed-share-panel-button embed-share-panel-button-advanced"
          data-embed-focus="advanced"
          aria-controls="article-embed-advanced"
          aria-expanded="false"
        >
          <i class="bi bi-gear" aria-hidden="true"></i>
          <span>Advanced</span>
        </button>
      </div>
    </div>

    <div class="embed-share-control">
      <input
        id="article-embed-code"
        type="text"
        value="{{ embedCode }}"
        data-embed-code
        readonly
      >
      <button
        type="button"
        data-share-copy
        data-embed-copy
        data-copy-value="{{ embedCode|e('html_attr') }}"
      >
        <i class="bi bi-clipboard" aria-hidden="true"></i>
        <span data-share-copy-label>Copy</span>
      </button>
      <a
        href="{{ embedUrlWithShare }}"
        target="infrastackEmbedPreview"
        class="embed-share-demo"
        data-embed-demo
      >
        <i class="bi bi-window" aria-hidden="true"></i>
        <span data-share-demo-label>Demo</span>
      </a>
    </div>

    <div class="embed-share-customize" id="article-embed-customize" data-embed-section="customize" tabindex="-1" hidden>
      <label class="embed-share-toggle">
        <input type="checkbox" data-embed-include-current checked>
        <span class="embed-share-toggle-ui" aria-hidden="true"></span>
        <span>Include current inputs</span>
      </label>

      <label class="embed-share-field">
        <span>Size</span>
        <select data-embed-size>
          <option value="responsive">Responsive</option>
          <option value="compact">Compact</option>
          <option value="tall">Tall</option>
          <option value="fixed">Fixed 960px</option>
        </select>
      </label>

      <label class="embed-share-field">
        <span>Loading</span>
        <select data-embed-loading>
          <option value="lazy">Lazy</option>
          <option value="eager">Eager</option>
        </select>
      </label>
    </div>

    <div class="embed-share-disclaimer" id="article-embed-disclaimer" data-embed-section="disclaimer" tabindex="-1" hidden>
      <p>Embed this InfraStack tool only where the surrounding page gives users enough context to interpret the result.</p>
      <ul>
        <li>Treat the frame as a planning aid, not as approval, certification, compliance evidence, or production change guidance.</li>
        <li>Validate generated diagrams, values, exports, and assumptions before using them for technical or business decisions.</li>
        <li>Do not present the embed in a misleading, unsafe, unlawful, or security-sensitive context.</li>
        <li>InfraStack may revise tool behavior, labels, limits, routes, or embed availability as the platform changes.</li>
      </ul>
      <p>If that does not fit the page, link to the tool instead of embedding it.</p>
    </div>

    <div class="embed-share-advanced-panel" id="article-embed-advanced" data-embed-section="advanced" data-embed-advanced tabindex="-1" hidden>
      <label class="embed-share-field">
        <span>Width</span>
        <span class="embed-share-control-group">
          <input type="number" min="1" max="1600" step="1" value="100" data-embed-width>
          <select data-embed-width-unit aria-label="Embed width unit">
            <option value="%">%</option>
            <option value="px">px</option>
            <option value="vw">vw</option>
          </select>
        </span>
      </label>
      <label class="embed-share-field">
        <span>Height</span>
        <span class="embed-share-control-group">
          <input type="number" min="1" max="1600" step="1" value="100" data-embed-height>
          <select data-embed-height-unit aria-label="Embed height unit">
            <option value="%">%</option>
            <option value="px">px</option>
            <option value="vh">vh</option>
          </select>
        </span>
      </label>
      <label class="embed-share-field">
        <span>Aspect Ratio</span>
        <span class="embed-share-ratio-group">
          <input type="number" min="1" max="64" step="1" value="16" data-embed-aspect-width>
          <span aria-hidden="true">:</span>
          <input type="number" min="1" max="64" step="1" value="9" data-embed-aspect-height>
        </span>
      </label>
      <label class="embed-share-field">
        <span>Max Height</span>
        <span class="embed-share-control-group">
          <input type="text" inputmode="numeric" pattern="[0-9]*" placeholder="None" data-embed-max-height>
          <select data-embed-max-height-unit aria-label="Embed max height unit">
            <option value="px">px</option>
            <option value="vh">vh</option>
          </select>
        </span>
      </label>
      <label class="embed-share-toggle embed-share-toggle-muted">
        <input type="checkbox" data-embed-collapsible>
        <span class="embed-share-toggle-ui" aria-hidden="true"></span>
        <span>Collapsible embed</span>
      </label>
      <label class="embed-share-toggle embed-share-toggle-muted">
        <input type="checkbox" data-embed-fullscreen>
        <span class="embed-share-toggle-ui" aria-hidden="true"></span>
        <span>Allow fullscreen</span>
      </label>
      <label class="embed-share-field">
        <span>Referrer Policy</span>
        <select data-embed-referrer-policy>
          <option value="no-referrer">no-referrer</option>
          <option value="no-referrer-when-downgrade" selected>no-referrer-when-downgrade</option>
          <option value="origin">origin</option>
          <option value="origin-when-cross-origin">origin-when-cross-origin</option>
          <option value="same-origin">same-origin</option>
          <option value="strict-origin">strict-origin</option>
          <option value="strict-origin-when-cross-origin">strict-origin-when-cross-origin</option>
          <option value="unsafe-url">unsafe-url</option>
        </select>
      </label>
      <label class="embed-share-field">
        <span>Sandbox Tokens</span>
        <input
          type="text"
          value="allow-scripts allow-same-origin allow-forms allow-popups"
          data-embed-sandbox
        >
      </label>
    </div>
  </div>
</div>
{% else %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{{ article_title|default(meta.title|default('InfraStack Tool')) }}</title>
    <meta name="description" content="{{ article_summary|default(meta.summary|default('')) }}">
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="preload" href="{{ asset('fonts/roboto-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/nunito-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('lib/bootstrap/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('lib/bootstrap-icons/bootstrap-icons.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/pre.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/main.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/content/content.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/post.css') }}">
    <style>
      {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/custom.css' ignore missing %}

      [id^="sfwdt"],
      [id^="sfMiniToolbar"],
      .sf-toolbar,
      .sf-toolbarreset {
        display: none !important;
      }
    </style>
  </head>
  <body class="tool-embed-body">
    {% set shareTitle = article_title|default(meta.title|default('InfraStack Tool')) %}
    {% set shareUrl = article_url|default(app.request.uri) %}

    <main class="tool-embed-page">
      <div class="tool-embed-content">
        {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/tool.html.twig' ignore missing %}
      </div>
    </main>

    <footer class="tool-embed-footer" data-tool-embed-footer>
      {% set shareSummary = article_summary|default(meta.summary|default('')) %}
      {% set shareText = shareSummary ? shareTitle ~ ' - ' ~ shareSummary : shareTitle %}
      <div class="tool-embed-share">
        <span>Share:</span>
        <a href="{{ shareUrl }}" target="_blank" rel="noopener noreferrer" class="tool-embed-share-open">
          <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
          <span>Open</span>
        </a>
        <a href="https://www.linkedin.com/feed/?shareActive=true&shareUrl={{ shareUrl|url_encode }}" target="_blank" rel="noopener noreferrer" class="tool-embed-share-linkedin">
          <i class="bi bi-linkedin" aria-hidden="true"></i>
          <span>LinkedIn</span>
        </a>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl|url_encode }}" target="_blank" rel="noopener noreferrer" class="tool-embed-share-facebook">
          <i class="bi bi-facebook" aria-hidden="true"></i>
          <span>Facebook</span>
        </a>
        <a href="https://twitter.com/intent/tweet?url={{ shareUrl|url_encode }}&text={{ shareTitle|url_encode }}" target="_blank" rel="noopener noreferrer" class="tool-embed-share-twitter">
          <i class="bi bi-twitter-x" aria-hidden="true"></i>
          <span>Twitter</span>
        </a>
        <a href="https://api.whatsapp.com/send?text={{ shareText|url_encode }}%20{{ shareUrl|url_encode }}" target="_blank" rel="noopener noreferrer" class="tool-embed-share-whatsapp">
          <i class="bi bi-whatsapp" aria-hidden="true"></i>
          <span>WhatsApp</span>
        </a>
        <a href="mailto:?subject={{ shareTitle|url_encode }}&body={{ shareText|url_encode }}%0A%0A{{ shareUrl|url_encode }}" class="tool-embed-share-email">
          <i class="bi bi-envelope-fill" aria-hidden="true"></i>
          <span>Email</span>
        </a>
      </div>
      <div class="tool-embed-credit">
        Get this <a href="{{ shareUrl }}" target="_blank" rel="noopener noreferrer">{{ shareTitle }}</a> and more from <a href="{{ absolute_url(path('app_category')) }}" target="_blank" rel="noopener noreferrer">InfraStack</a>
      </div>
      <button type="button" class="tool-embed-close" data-tool-embed-footer-close aria-label="Close embed footer">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </footer>

    {{ importmap('app') }}
    <script>
      {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/custom.js' ignore missing %}

      document.querySelector('[data-tool-embed-footer-close]')?.addEventListener('click', function () {
        document.querySelector('[data-tool-embed-footer]')?.setAttribute('hidden', '');
        document.body.classList.add('tool-embed-footer-hidden');
      });

      function hideSymfonyDebugToolbar() {
        document.querySelectorAll('[id^="sfwdt"], [id^="sfMiniToolbar"], .sf-toolbar, .sf-toolbarreset').forEach(function (element) {
          element.setAttribute('hidden', '');
          element.style.setProperty('display', 'none', 'important');
        });
      }

      hideSymfonyDebugToolbar();
      window.addEventListener('load', hideSymfonyDebugToolbar);
      window.setTimeout(hideSymfonyDebugToolbar, 150);
      window.setTimeout(hideSymfonyDebugToolbar, 600);
    </script>
  </body>
</html>
{% endif %}
