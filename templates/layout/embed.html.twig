{# templates/layout/embed.html.twig #}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, follow">
        <title>{{ page_title }}</title>
        <link rel="icon" type="image/png" sizes="128x128" href="{{ asset('images/logo/infrastack-icon.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/logo/infrastack-icon.png') }}">
        <link rel="preload" href="{{ asset('fonts/roboto-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/nunito-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
        <link rel="stylesheet" href="{{ asset('lib/bootstrap-icons/bootstrap-icons.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/layout/share.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/layout/embed.css') }}">
    </head>
    <body class="studio-embed-body">
        <main
            id="studio-shared-project"
            class="studio-shared-page studio-embedded-page"
            data-icon-urls="{{ studio_icon_urls|json_encode|e('html_attr') }}"
            data-show-inventory="{{ show_inventory ? '1' : '0' }}"
            data-show-advisory="{{ show_advisory ? '1' : '0' }}"
        >
            <div class="studio-embed-toolbar">
                <strong>{{ shared_project.name }}</strong>
                <select id="studio-shared-view" aria-label="Projection"></select>
                <button id="studio-shared-zoom-out" type="button" aria-label="Zoom out"><i class="bi bi-dash-lg"></i></button>
                <span id="studio-shared-zoom">100%</span>
                <button id="studio-shared-zoom-in" type="button" aria-label="Zoom in"><i class="bi bi-plus-lg"></i></button>
                <button id="studio-shared-fit" type="button" aria-label="Fit diagram"><i class="bi bi-arrows-fullscreen"></i></button>
                <a href="{{ path('app_studio') }}" target="_blank" rel="noopener">Open InfraStack</a>
            </div>
            <div class="studio-shared-canvas-shell">
                <div id="studio-shared-graph" class="studio-shared-graph" aria-label="Embedded project diagram"></div>
                <div id="studio-shared-outline" class="studio-shared-outline" aria-hidden="true"></div>
                <a class="studio-share-watermark" href="{{ path('app_studio') }}" target="_blank" rel="noopener">Made with InfraStack</a>
            </div>
            <section class="studio-shared-section studio-embed-inventory" aria-labelledby="studio-shared-inventory-title" {{ show_inventory ? '' : 'hidden' }}>
                <div class="studio-shared-section-heading"><h2 id="studio-shared-inventory-title">Inventory</h2><strong id="studio-shared-inventory-count"></strong></div>
                <div class="studio-shared-table-wrap"><table><thead><tr><th>Asset</th><th>Type</th><th>Placement</th><th>Address</th><th>Resources</th><th>Controls</th></tr></thead><tbody id="studio-shared-inventory"></tbody></table></div>
            </section>
            <section class="studio-shared-section studio-embed-advisory" aria-labelledby="studio-shared-advisory-title" {{ show_advisory ? '' : 'hidden' }}>
                <div class="studio-shared-section-heading"><h2 id="studio-shared-advisory-title">Studio Result</h2><div class="studio-shared-grade"><span>Grade</span><strong id="studio-shared-grade">—</strong><small id="studio-shared-score">Not graded</small></div></div>
                <div id="studio-shared-findings" class="studio-shared-findings"></div>
            </section>
            <script id="studio-shared-project-data" type="application/json">{{ shared_project|json_encode(constant('JSON_HEX_TAG') + constant('JSON_HEX_AMP') + constant('JSON_HEX_APOS') + constant('JSON_HEX_QUOT'))|raw }}</script>
        </main>
        {{ importmap('layout-share') }}
    </body>
</html>
