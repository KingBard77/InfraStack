{# templates/layout/footer.html.twig #}
{% block footer %}
  <footer id="footer" class="footer infrastack-footer">
    <div class="container footer-top">
      <div class="row gy-4">
        <div class="col-lg-5 col-md-6 footer-about">
          <a href="{{ path('app_main') }}" class="infrastack-footer-logo" aria-label="InfraStack home">
            <img src="{{ asset('images/logo/infrastack-wordmark.png') }}" width="200" height="37" class="infrastack-wordmark infrastack-wordmark-light" alt="" aria-hidden="true">
            <span class="infrastack-wordmark-dark" aria-hidden="true"><span class="infrastack-wordmark-text">InfraStack</span><span class="infrastack-wordmark-suffix"><img src="{{ asset('images/logo/infrastack-wordmark.png') }}" alt=""></span></span>
          </a>
          <div class="footer-contact pt-3">
            <p>Browser-based infrastructure architecture design with synchronized diagrams, inventory, relationships, and deterministic results.</p>
            <p class="mt-3"><strong>Email:</strong> <a href="mailto:infrastack69@gmail.com">infrastack69@gmail.com</a></p>
            <p><strong>Website:</strong> <a href="https://www.infrastack.my">www.infrastack.my</a></p>
          </div>
        </div>

        <div class="col-lg-3 col-md-3 footer-links">
          <h4>Product</h4>
          <ul>
            <li><a href="{{ path('app_studio') }}">InfraStack Studio</a></li>
            <li><a href="{{ path('app_studio_template', {provider: 'aws', templateId: 'aws-three-tier'}) }}">AWS Architecture</a></li>
            <li><a href="{{ path('app_studio_template', {provider: 'azure', templateId: 'azure-three-tier'}) }}">Azure Architecture</a></li>
            <li><a href="{{ path('app_studio_template', {provider: 'kubernetes', templateId: 'kubernetes-production-application'}) }}">Kubernetes Architecture</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Company</h4>
          <ul>
            <li><a href="{{ path('app_author') }}">Author Profile</a></li>
            <li><a href="{{ path('app_contact') }}">Contact Us</a></li>
            <li><a href="{{ path('app_privacy') }}">Privacy Policy</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Start</h4>
          <ul>
            <li><a href="{{ path('app_main') }}">Home</a></li>
            <li><a href="{{ path('app_studio') }}">Open Studio</a></li>
            <li><a href="{{ path('app_contact') }}">Request Architecture</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="container copyright">
      <p>© <span>{{ "now"|date("Y") }}</span> <strong class="px-1 sitename">InfraStack</strong> <span>All Rights Reserved</span></p>
      <div class="credits">Built for practical infrastructure architecture planning and review.</div>
    </div>
  </footer>
{% endblock %}
