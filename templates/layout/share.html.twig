{# templates/layout/share.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/layout/share.css') }}">
{% endblock %}

{% block body %}
<section
    id="studio-shared-project"
    class="studio-shared-page"
    data-icon-urls="{{ studio_icon_urls|json_encode|e('html_attr') }}"
    data-embed-url="{{ embed_url }}"
>
    <div class="studio-share-heading">
        <div>
            <span>Shared InfraStack project</span>
            <h1>{{ shared_project.name }}</h1>
            <p>Read-only diagram, normalized inventory, and Studio Result.</p>
        </div>
        <div class="studio-share-actions">
            <button id="studio-share-copy" type="button"><i class="bi bi-link-45deg"></i> Copy link</button>
            <button id="studio-embed-copy" type="button"><i class="bi bi-code-slash"></i> Copy embed</button>
            <a href="{{ path('app_studio') }}"><i class="bi bi-pencil-square"></i> Open Studio</a>
        </div>
    </div>

    <div class="studio-share-toolbar">
        <label for="studio-shared-view">Projection
            <select id="studio-shared-view"></select>
        </label>
        <button id="studio-shared-zoom-out" type="button" aria-label="Zoom out"><i class="bi bi-dash-lg"></i></button>
        <span id="studio-shared-zoom">100%</span>
        <button id="studio-shared-zoom-in" type="button" aria-label="Zoom in"><i class="bi bi-plus-lg"></i></button>
        <button id="studio-shared-fit" type="button"><i class="bi bi-arrows-fullscreen"></i> Fit</button>
        <span class="studio-share-created">Shared {{ shared_created_at|date('M j, Y') }}</span>
    </div>

    <div class="studio-shared-canvas-shell">
        <div id="studio-shared-graph" class="studio-shared-graph" aria-label="Shared project diagram"></div>
        <div id="studio-shared-outline" class="studio-shared-outline" aria-hidden="true"></div>
        <a class="studio-share-watermark" href="{{ path('app_studio') }}">Made with InfraStack</a>
    </div>

    <section class="studio-shared-section" aria-labelledby="studio-shared-inventory-title">
        <div class="studio-shared-section-heading"><div><span>Project facts</span><h2 id="studio-shared-inventory-title">Inventory</h2></div><strong id="studio-shared-inventory-count"></strong></div>
        <div class="studio-shared-table-wrap"><table><thead><tr><th>Asset</th><th>Type</th><th>Placement</th><th>Address</th><th>Resources</th><th>Controls</th></tr></thead><tbody id="studio-shared-inventory"></tbody></table></div>
    </section>

    <section class="studio-shared-section" aria-labelledby="studio-shared-advisory-title">
        <div class="studio-shared-section-heading"><div><span>Explainable guidance</span><h2 id="studio-shared-advisory-title">Studio Result</h2></div><div class="studio-shared-grade"><span>Grade</span><strong id="studio-shared-grade">—</strong><small id="studio-shared-score">Not graded</small></div></div>
        <p class="studio-shared-advisory-note">Grades reflect modeled facts and are guidance, not certification.</p>
        <div id="studio-shared-findings" class="studio-shared-findings"></div>
    </section>

    <script id="studio-shared-project-data" type="application/json">{{ shared_project|json_encode(constant('JSON_HEX_TAG') + constant('JSON_HEX_AMP') + constant('JSON_HEX_APOS') + constant('JSON_HEX_QUOT'))|raw }}</script>
</section>
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'layout-share']) }}
{% endblock %}
