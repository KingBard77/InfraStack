{# templates/page/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/contact.css') }}">
{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

<!-- Contact Section -->
<section id="contact" class="contact section">

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row gy-4 mb-5">
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-geo-alt"></i>
          </div>
          <h3>Our Address</h3>
          <p>Bandar Baru Bangi, Selangor, Malaysia</p>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-envelope"></i>
          </div>
          <h3>Contact Email</h3>
          <p><a href="mailto:infrastack69@gmail.com">infrastack69@gmail.com</a></p>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-clock"></i>
          </div>
          <h3>Studio Access</h3>
          <p>Available anytime<br>
            Directly in your browser</p>
        </div>
      </div>
    </div>

    <div class="row contact-cta-row">
      <div class="col-lg-12 contact-cta-column">
        <div class="form-wrapper contact-direct" data-aos="fade-up" data-aos-delay="400">
          <div class="contact-direct-icon"><i class="bi bi-chat-square-text"></i></div>
          <p class="contact-direct-kicker">Contact InfraStack</p>
          <h2>Send an architecture enquiry</h2>
          <p>
            Complete the form and your email application will open with the message prepared for
            <strong>infrastack69@gmail.com</strong>. Do not include passwords, private keys, customer secrets,
            or production credentials.
          </p>
          <form
            id="contact-email-form"
            class="contact-form"
            action="mailto:infrastack69@gmail.com"
            method="get"
            data-recipient="infrastack69@gmail.com"
          >
            <div class="contact-form-grid">
              <label>
                <span class="contact-field-label">Name</span>
                <span class="field-control">
                  <span class="field-icon"><i class="bi bi-person"></i></span>
                  <input class="form-control" type="text" name="name" maxlength="80" autocomplete="name" required placeholder="Your name">
                </span>
              </label>
              <label>
                <span class="contact-field-label">Email</span>
                <span class="field-control">
                  <span class="field-icon"><i class="bi bi-envelope"></i></span>
                  <input class="form-control" type="email" name="email" maxlength="160" autocomplete="email" required placeholder="you@example.com">
                </span>
              </label>
              <label class="form-field-full">
                <span class="contact-field-label">Topic</span>
                <span class="field-control field-control-select">
                  <span class="field-icon"><i class="bi bi-tags"></i></span>
                  <select class="form-control contact-select" name="topic" required>
                    <option value="" selected disabled>Select a topic</option>
                    <option value="Architecture feedback">Architecture feedback</option>
                    <option value="Library request">Library request</option>
                    <option value="Studio support">Studio support</option>
                    <option value="Collaboration">Collaboration</option>
                    <option value="Other enquiry">Other enquiry</option>
                  </select>
                </span>
              </label>
              <label class="form-field-full">
                <span class="contact-field-label">Message</span>
                <span class="field-control field-control-message">
                  <span class="field-icon"><i class="bi bi-chat-left-text"></i></span>
                  <textarea class="form-control" name="message" maxlength="4000" required placeholder="Describe the provider, architecture, or outcome you need."></textarea>
                </span>
              </label>
            </div>
            <p id="contact-form-status" class="form-status" role="status" aria-live="polite"></p>
            <div class="form-actions">
              <button type="submit">
                <i class="bi bi-envelope-arrow-up"></i>
                Prepare Email
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>


{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
  <script type="module" src="{{ asset('js/page/contact.js') }}"></script>
{% endblock %}
