{# templates/page/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/contact.css') }}">
{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

<!-- Contact Section -->
<section id="contact" class="contact section">

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row gy-4 mb-5">
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-geo-alt"></i>
          </div>
          <h3>Our Address</h3>
          <p>Bandar Baru Bangi, Selangor, Malaysia</p>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-envelope"></i>
          </div>
          <h3>Contact Email</h3>
          <p>Email: info@example.com</p>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-clock"></i>
          </div>
          <h3>Opening Hour</h3>
          <p>24 hours<br>
            Article website access</p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-12">
        <div class="form-wrapper" data-aos="fade-up" data-aos-delay="400">
          <form action="forms/contact.php" method="post" role="form" class="php-email-form contact-form">
            <input type="hidden" name="phone" value="xxxxx">
            <div class="contact-form-grid">
              <div class="form-field">
                <label class="visually-hidden" for="contact-name">Your name</label>
                <div class="field-control">
                  <span class="field-icon"><i class="bi bi-person"></i></span>
                  <input id="contact-name" type="text" name="name" class="form-control" placeholder="Your name*" required="">
                </div>
              </div>
              <div class="form-field">
                <label class="visually-hidden" for="contact-email">Email address</label>
                <div class="field-control">
                  <span class="field-icon"><i class="bi bi-envelope"></i></span>
                  <input id="contact-email" type="email" class="form-control" name="email" placeholder="Email address*" required="">
                </div>
              </div>
              <div class="form-field form-field-full">
                <label class="visually-hidden" for="contact-subject">Topic</label>
                <div class="field-control field-control-select">
                  <span class="field-icon"><i class="bi bi-list"></i></span>
                  <select id="contact-subject" name="subject" class="form-control contact-select" required="">
                    <option value="" disabled selected>Select topic*</option>
                    <option value="Article Feedback">Article feedback</option>
                    <option value="Technical Correction">Technical correction</option>
                    <option value="Tool Request">Tool request</option>
                    <option value="General Inquiry">General inquiry</option>
                  </select>
                </div>
              </div>
              <div class="form-field form-field-full">
                <label class="visually-hidden" for="contact-message">Message</label>
                <div class="field-control field-control-message">
                  <span class="field-icon"><i class="bi bi-chat-dots"></i></span>
                  <textarea id="contact-message" class="form-control" name="message" rows="6" placeholder="Write a message*" required=""></textarea>
                </div>
              </div>
            </div>
            <div class="form-status">
              <div class="loading">Loading</div>
              <div class="error-message"></div>
              <div class="sent-message">Your message has been sent. Thank you!</div>
            </div>
            <div class="form-actions">
              <button type="submit">Submit Message</button>
            </div>
          </form>
        </div>
      </div>

    </div>

  </div>
</section><!-- /Contact Section -->


{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
{% endblock %}
