{# templates/page/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/contact.css') }}">
{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

<!-- Contact Section -->
<section id="contact" class="contact section">

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row gy-4 mb-5">
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-geo-alt"></i>
          </div>
          <h3>Our Address</h3>
          <p>Bandar Baru Bangi, Selangor, Malaysia</p>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-envelope"></i>
          </div>
          <h3>Contact Email</h3>
          <p><a href="mailto:hello@infrastack.my">hello@infrastack.my</a></p>
        </div>
      </div>

      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
        <div class="info-card">
          <div class="icon-box">
            <i class="bi bi-clock"></i>
          </div>
          <h3>Studio Access</h3>
          <p>Available anytime<br>
            Directly in your browser</p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-12">
        <div class="form-wrapper contact-direct" data-aos="fade-up" data-aos-delay="400">
          <div class="contact-direct-icon"><i class="bi bi-chat-square-text"></i></div>
          <p class="contact-direct-kicker">Talk to InfraStack</p>
          <h2>Architecture feedback, library requests, or collaboration</h2>
          <p>
            Send the context, provider, and architecture outcome you need. Please do not include passwords,
            private keys, customer secrets, or production credentials.
          </p>
          <a class="contact-primary-action" href="mailto:hello@infrastack.my?subject=InfraStack%20Studio%20Inquiry">
            <i class="bi bi-envelope"></i>
            Email hello@infrastack.my
          </a>
        </div>
      </div>

    </div>

  </div>
</section>


{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
{% endblock %}
