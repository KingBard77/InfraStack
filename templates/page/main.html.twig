{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

{% set posts = home_posts|default([]) %}
{% set familyGroups = home_family_groups|default([]) %}
{% set categoryCards = sidebar_categories|default([]) %}
{% set primaryPost = posts|first %}
{% set featuredPosts = posts|slice(0, 6) %}
{% set categoryIcons = {
  aws: 'bi bi-cloud',
  azure: 'bi bi-microsoft',
  gcp: 'bi bi-cloud-sun',
  ibm: 'bi bi-hdd-network',
  cisco: 'bi bi-diagram-3',
  cis: 'bi bi-clipboard2-check',
  security: 'bi bi-shield-check',
  shell: 'bi bi-terminal'
} %}
{% set categoryTones = {
  aws: 'blue',
  azure: 'cyan',
  gcp: 'emerald',
  ibm: 'indigo',
  cisco: 'teal',
  cis: 'slate',
  security: 'green',
  shell: 'dark'
} %}

<section class="home-platform-hero section">
  <div class="container">
    <div class="home-platform-hero-grid">
      <div class="home-platform-hero-copy" data-aos="fade-up">
        <span class="home-platform-badge">
          <i class="bi bi-layers"></i>
          Practical infrastructure workspaces
        </span>
        <h1>Practical tools for infrastructure teams</h1>
        <p>
          Build diagrams, estimates, assessments, scans, and shell commands inside inspectable InfraStack workspaces.
        </p>

        <form method="get" action="{{ path('app_category') }}" class="home-platform-search" role="search">
          <label for="home-platform-search-input" class="visually-hidden">Search tools</label>
          <i class="bi bi-search" aria-hidden="true"></i>
          <input
            id="home-platform-search-input"
            type="search"
            name="q"
            placeholder="Search tools, providers, or families..."
          >
          <button type="submit">Search</button>
        </form>

        <div class="home-platform-meta">
          <span><i class="bi bi-box"></i> {{ posts|length }} tool packages</span>
          <span><i class="bi bi-grid-3x3-gap"></i> {{ familyGroups|length }} workspace types</span>
          <span><i class="bi bi-folder2-open"></i> {{ categoryCards|length }} categories</span>
        </div>

        <div class="home-platform-actions">
          <a href="{{ path('app_category') }}" class="home-platform-primary">
            Browse tools
            <i class="bi bi-arrow-right"></i>
          </a>
          {% if primaryPost %}
            <a href="{{ primaryPost.url }}" class="home-platform-secondary">
              Open latest
            </a>
          {% endif %}
        </div>
      </div>

      <div class="home-platform-hero-visual" data-aos="fade-up" data-aos-delay="120">
        <div class="home-platform-console">
          <div class="home-platform-console-top">
            <span>InfraStack workspace</span>
            <strong>{{ posts|length }} tools</strong>
          </div>
          <div class="home-platform-console-stage">
            {% for family in familyGroups|slice(0, 3) %}
              <a
                href="{{ path('app_category', { family: family.slug }) }}"
                class="home-platform-stage-card"
                style="--family-start: {{ family.start }}; --family-end: {{ family.end }};"
              >
                <span><i class="{{ family.icon }}"></i></span>
                <strong>{{ family.label }}</strong>
                <small>{{ family.tool_count }} {{ family.tool_count == 1 ? 'tool' : 'tools' }}</small>
              </a>
            {% endfor %}
          </div>
          <div class="home-platform-console-flow">
            <span>Brief</span>
            <i class="bi bi-arrow-right"></i>
            <span>Model</span>
            <i class="bi bi-arrow-right"></i>
            <span>Export</span>
          </div>
        </div>

        <div class="home-platform-stat-grid">
          <a href="{{ path('app_category') }}" class="home-platform-stat">
            <i class="bi bi-tools"></i>
            <strong>{{ posts|length }}</strong>
            <span>Ready tools</span>
          </a>
          <a href="#home-categories" class="home-platform-stat">
            <i class="bi bi-layers"></i>
            <strong>{{ familyGroups|length }}</strong>
            <span>Workflows</span>
          </a>
          <a href="#home-categories" class="home-platform-stat">
            <i class="bi bi-clouds"></i>
            <strong>{{ categoryCards|length }}</strong>
            <span>Domains</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% if categoryCards|length > 0 %}
<section id="home-categories" class="home-directory-section section">
  <div class="container">
    <div class="home-section-head">
      <div>
        <span>Provider and domain categories</span>
        <h2>Browse by operating surface</h2>
      </div>
      <div class="home-section-actions">
        <div class="home-slider-controls" aria-label="Category slider controls">
          <button type="button" class="home-slider-button home-category-slider-prev" aria-label="Previous categories">
            <i class="bi bi-arrow-left"></i>
          </button>
          <button type="button" class="home-slider-button home-category-slider-next" aria-label="Next categories">
            <i class="bi bi-arrow-right"></i>
          </button>
        </div>
        <a href="{{ path('app_category') }}" class="home-section-link">
          View categories
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>

    <div class="home-one-row-slider home-category-slider swiper init-swiper">
      <script type="application/json" class="swiper-config">
        {
          "loop": false,
          "speed": 500,
          "spaceBetween": 16,
          "slidesPerView": "auto",
          "watchOverflow": true,
          "navigation": {
            "nextEl": ".home-category-slider-next",
            "prevEl": ".home-category-slider-prev"
          }
        }
      </script>
      <div class="home-category-catalog swiper-wrapper">
        {% for category in categoryCards %}
          {% set categoryTone = categoryTones[category.slug]|default('blue') %}
          <div class="swiper-slide">
            <a
              href="{{ path('app_category', { category: category.slug }) }}"
              class="home-category-catalog-card home-category-catalog-card-{{ categoryTone }}"
            >
              <span><i class="{{ categoryIcons[category.slug]|default('bi bi-folder2-open') }}"></i></span>
              <strong>{{ category.name }}</strong>
              <small>{{ category.count }} {{ category.count == 1 ? 'tool' : 'tools' }}</small>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if featuredPosts|length > 0 %}
<section id="home-featured" class="home-directory-section section">
  <div class="container">
    <div class="home-section-head">
      <div>
        <span>Featured workspaces</span>
        <h2>Open a practical InfraStack tool</h2>
      </div>
      <div class="home-section-actions">
        <div class="home-slider-controls" aria-label="Featured tools slider controls">
          <button type="button" class="home-slider-button home-tool-slider-prev" aria-label="Previous featured tools">
            <i class="bi bi-arrow-left"></i>
          </button>
          <button type="button" class="home-slider-button home-tool-slider-next" aria-label="Next featured tools">
            <i class="bi bi-arrow-right"></i>
          </button>
        </div>
        <a href="{{ path('app_category') }}" class="home-section-link">
          View all tools
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>

    <div class="home-one-row-slider home-tool-slider swiper init-swiper">
      <script type="application/json" class="swiper-config">
        {
          "loop": false,
          "speed": 500,
          "spaceBetween": 18,
          "slidesPerView": "auto",
          "watchOverflow": true,
          "navigation": {
            "nextEl": ".home-tool-slider-next",
            "prevEl": ".home-tool-slider-prev"
          }
        }
      </script>
      <div class="home-tool-grid swiper-wrapper">
        {% for tool in featuredPosts %}
          {% set summary = tool.card_summary|default(tool.summary|default('')) %}
          {% set tags = tool.tags|default([])|slice(0, 2) %}
          {% set toolDisplayTitle = tool.display_title|default(tool.title) %}
          <div class="swiper-slide">
            <article class="home-tool-card">
              <div class="home-tool-card-head">
                <span
                  class="home-tool-card-icon"
                  style="--tool-start: {{ tool.card_gradient_start }}; --tool-end: {{ tool.card_gradient_end }};"
                >
                  <i class="{{ tool.card_icon_class|default('bi bi-tools') }}"></i>
                </span>
                <span class="home-tool-card-badge">{{ tool.family }}</span>
              </div>
              <h3><a href="{{ tool.url }}">{{ toolDisplayTitle }}</a></h3>
              <p>{{ summary|length > 128 ? summary|slice(0, 128) ~ '...' : summary }}</p>
              <div class="home-tool-card-tags">
                {% for tag in tags %}
                  <span>{{ tag }}</span>
                {% else %}
                  <span>{{ tool.category }}</span>
                {% endfor %}
              </div>
              <div class="home-tool-card-foot">
                <span>{{ tool.category }}</span>
                <span>{{ tool.reading_time }}</span>
                <a href="{{ tool.url }}" aria-label="Open {{ toolDisplayTitle }}">
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </article>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="home-tools-center-action">
      <a href="{{ path('app_category') }}">View all tools</a>
    </div>
  </div>
</section>
{% endif %}

<section class="home-build-banner section">
  <div class="container">
    <div class="home-build-banner-inner">
      <span><i class="bi bi-rocket-takeoff"></i></span>
      <div>
        <h2>Great Prompts Need Great Tools</h2>
        <p>Use <strong class="px-1 sitename">InfraStack</strong> families as stable patterns for new calculators, diagrams, scans, assessments, and command builders.</p>
      </div>
      <div class="home-build-banner-actions">
        <a href="{{ path('app_category') }}">Explore tools</a>
        <a href="{{ path('app_contact') }}">Request a tool</a>
      </div>
    </div>
  </div>
</section>

{% endblock %}
