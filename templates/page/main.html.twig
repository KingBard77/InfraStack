{# templates/page/main.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/home.css') }}">
{% endblock %}

{% block body %}
<div class="home-studio-page">
  <section class="home-studio-hero" aria-labelledby="home-studio-title">
    <div class="container-xl home-studio-hero-inner">
      <div class="home-studio-hero-grid">
        <div class="home-studio-copy" data-aos="fade-up">
          <span class="home-studio-kicker">Design. Visualize. Document. Your Infrastructure.</span>
          <h1 id="home-studio-title">
            Design Infrastructure<br>
            Diagrams Smarter,<br>
            <span>Not Harder.</span>
          </h1>
          <p>
            InfraStack Studio is a modern, browser-based diagramming workspace for infrastructure engineers,
            architects, and DevOps teams. Create, review, and document infrastructure diagrams with clarity.
          </p>

          <div class="home-studio-actions">
            <a href="{{ path('app_studio') }}" class="home-studio-action home-studio-action-primary">
              Open InfraStack Studio
              <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a href="{{ path('app_studio') }}" class="home-studio-action home-studio-action-secondary">
              View Live Studio
              <i class="bi bi-play-fill" aria-hidden="true"></i>
            </a>
          </div>

          <p class="home-studio-assurance">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            Browser-based workspace with local project restore
          </p>
        </div>

        <div class="home-studio-preview-wrap" data-aos="fade-up" data-aos-delay="120">
          <div class="home-studio-preview-glow" aria-hidden="true"></div>
          <div class="home-studio-preview" aria-label="Static preview of the InfraStack Studio workspace">
            <div class="home-studio-preview-bar">
              <div class="home-studio-preview-title">
                <i class="bi bi-list" aria-hidden="true"></i>
                <strong>AWS VPC Architecture</strong>
                <span aria-hidden="true">›</span>
                <small><i class="bi bi-circle-fill" aria-hidden="true"></i> All changes saved</small>
              </div>
              <div class="home-studio-preview-actions" aria-hidden="true">
                <span><i class="bi bi-share"></i> Share</span>
                <span><i class="bi bi-box-arrow-up"></i> Export</span>
                <b>BA</b>
              </div>
            </div>

            <div class="home-studio-preview-body" aria-hidden="true">
              <aside class="home-studio-library">
                <div class="home-studio-search"><i class="bi bi-search"></i><span>Search components</span></div>
                <div class="home-studio-library-heading">Compute</div>
                <div class="home-studio-library-items">
                  <span class="is-orange"><i class="bi bi-cpu"></i><small>EC2</small></span>
                  <span class="is-orange"><i class="bi bi-bezier2"></i><small>Scaling</small></span>
                  <span class="is-orange"><i class="bi bi-lightning"></i><small>Lambda</small></span>
                </div>
                <div class="home-studio-library-heading">Storage</div>
                <div class="home-studio-library-items">
                  <span class="is-green"><i class="bi bi-bucket"></i><small>S3</small></span>
                  <span class="is-green"><i class="bi bi-device-ssd"></i><small>EBS</small></span>
                  <span class="is-green"><i class="bi bi-hdd-rack"></i><small>EFS</small></span>
                </div>
                <div class="home-studio-library-heading">Network</div>
                <div class="home-studio-library-items">
                  <span class="is-violet"><i class="bi bi-cloud"></i><small>VPC</small></span>
                  <span class="is-blue"><i class="bi bi-bounding-box"></i><small>Subnet</small></span>
                  <span class="is-violet"><i class="bi bi-signpost-split"></i><small>Route</small></span>
                </div>
              </aside>

              <div class="home-studio-canvas">
                <div class="home-studio-canvas-toolbar">
                  <span class="is-active"><i class="bi bi-cursor"></i></span>
                  <span><i class="bi bi-bounding-box-circles"></i></span>
                  <span><i class="bi bi-bezier"></i></span>
                  <span><i class="bi bi-type"></i></span>
                  <span><i class="bi bi-grid-3x3-gap"></i></span>
                </div>

                <div class="home-studio-cloud-shell">
                  <div class="home-studio-cloud-label"><i class="bi bi-cloud-fill"></i> AWS Cloud</div>
                  <div class="home-studio-vpc-shell">
                    <div class="home-studio-vpc-label"><i class="bi bi-bounding-box"></i> VPC <small>10.0.0.0/16</small></div>
                    <div class="home-studio-subnet-grid">
                      <div class="home-studio-subnet is-public">
                        <strong>Public Subnet 1</strong><small>10.0.1.0/24</small>
                        <span class="home-studio-node is-violet"><i class="bi bi-router"></i></span>
                        <em>NAT Gateway</em>
                      </div>
                      <div class="home-studio-subnet is-public">
                        <strong>Public Subnet 2</strong><small>10.0.2.0/24</small>
                        <span class="home-studio-node is-violet"><i class="bi bi-router"></i></span>
                        <em>NAT Gateway</em>
                      </div>
                      <div class="home-studio-subnet is-private">
                        <strong>Private Subnet 1</strong><small>10.0.3.0/24</small>
                        <span class="home-studio-node is-orange"><i class="bi bi-cpu"></i></span>
                        <em>EC2 Instance</em>
                      </div>
                      <div class="home-studio-subnet is-private">
                        <strong>Private Subnet 2</strong><small>10.0.4.0/24</small>
                        <span class="home-studio-node is-orange"><i class="bi bi-cpu"></i></span>
                        <em>EC2 Instance</em>
                      </div>
                    </div>
                  </div>
                  <span class="home-studio-route-node"><i class="bi bi-globe"></i><small>Route 53</small></span>
                  <span class="home-studio-storage-node"><i class="bi bi-bucket"></i><small>S3 Bucket</small></span>
                  <span class="home-studio-security-node"><i class="bi bi-lock"></i><small>Security Group</small></span>
                </div>

                <div class="home-studio-canvas-footer">
                  <span><i class="bi bi-hand-index"></i></span>
                  <span><i class="bi bi-dash"></i> 100% <i class="bi bi-plus"></i></span>
                </div>
              </div>

              <aside class="home-studio-inspector">
                <div class="home-studio-inspector-title">VPC <i class="bi bi-chevron-down"></i></div>
                <label>Name<span>Production VPC</span></label>
                <label>CIDR Block<span>10.0.0.0/16</span></label>
                <label>Region<span>ap-southeast-1 <i class="bi bi-chevron-down"></i></span></label>
                <label>DNS Hostnames<span>Enabled <i class="bi bi-chevron-down"></i></span></label>
                <label>Notes<span class="home-studio-notes">Main production VPC for application workloads.</span></label>
                <div class="home-studio-save">Save</div>
              </aside>
            </div>

            <span class="home-studio-preview-label">Workspace preview</span>
          </div>
        </div>
      </div>

      <div class="home-studio-feature-grid" data-aos="fade-up" data-aos-delay="180">
        <article>
          <span class="is-violet"><i class="bi bi-cursor"></i></span>
          <h2>Drag &amp; Drop Simplicity</h2>
          <p>Arrange and connect infrastructure components on a focused visual canvas.</p>
        </article>
        <article>
          <span class="is-green"><i class="bi bi-boxes"></i></span>
          <h2>Smart Infrastructure Library</h2>
          <p>Use cloud, on-premises, and networking components with consistent identities.</p>
        </article>
        <article>
          <span class="is-blue"><i class="bi bi-people"></i></span>
          <h2>Review Ready</h2>
          <p>Keep diagrams, inventory, relationships, and advisory context together.</p>
        </article>
        <article>
          <span class="is-orange"><i class="bi bi-file-earmark-arrow-down"></i></span>
          <h2>Export &amp; Document</h2>
          <p>Move from architecture model to shareable project output without busywork.</p>
        </article>
        <article>
          <span class="is-purple"><i class="bi bi-shield-check"></i></span>
          <h2>Restore &amp; Continue</h2>
          <p>Save normalized project data locally and return to your work later.</p>
        </article>
      </div>

      <div class="home-studio-trust" data-aos="fade-up" data-aos-delay="220">
        <p>Designed for infrastructure teams working across modern platforms</p>
        <div>
          <span><strong>aws</strong></span>
          <span><i class="bi bi-microsoft"></i> Azure</span>
          <span><i class="bi bi-cloud-fill"></i> Google Cloud</span>
          <span><strong>vmware</strong></span>
          <span><i class="bi bi-hexagon"></i> kubernetes</span>
          <span><i class="bi bi-router-fill"></i> CISCO</span>
        </div>
      </div>
    </div>
  </section>
</div>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
  <script type="module" src="{{ asset('js/page/home.js') }}"></script>
{% endblock %}
