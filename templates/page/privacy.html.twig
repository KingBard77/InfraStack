{# templates/page/privacy.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/privacy.css') }}">
{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

<section id="privacy" class="privacy-policy section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="privacy-hero">
          <div class="privacy-hero-icon">
            <i class="bi bi-shield-lock"></i>
          </div>
          <div>
            <p class="privacy-kicker">InfraStack privacy</p>
            <h1>Privacy Policy</h1>
            <p>
              How InfraStack handles Studio projects, browser storage, shared snapshots, analytics, server logs, and contact messages.
            </p>
            <div class="privacy-meta">
              <span><i class="bi bi-calendar3"></i> Updated August 23, 2026</span>
              <span><i class="bi bi-globe2"></i> infrastack.my</span>
            </div>
          </div>
        </div>

        <div class="privacy-grid">
          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-info-circle"></i>
            </div>
            <div>
              <h2>Overview</h2>
              <p>
                InfraStack provides a browser-based infrastructure architecture workspace at infrastack.my. This policy explains what information is handled when you browse the site, use Studio, create a read-only share or embed, or contact the site owner.
              </p>
              <p>
                Studio primarily runs in your browser. Recovery data and panel preferences are stored on your device. A project is sent to the InfraStack server only when you deliberately create a share or embed snapshot.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-input-cursor-text"></i>
            </div>
            <div>
              <h2>Information You Provide</h2>
              <ul>
                <li>Project names, assets, boundaries, relationships, properties, styles, and other diagram data you enter in Studio.</li>
                <li>Contact details and messages you choose to send through your email provider.</li>
                <li>Architecture feedback, library requests, corrections, or support information you choose to provide.</li>
                <li>Normalized project data submitted when you intentionally create a read-only share or embed.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-hdd-network"></i>
            </div>
            <div>
              <h2>Technical Data</h2>
              <ul>
                <li>Basic server logs may include request time, requested URL, browser information, and IP address.</li>
                <li>Operational and error information may be used to diagnose faults and protect the service from abuse.</li>
                <li>Google Analytics runs on the production site and may receive standard browser and usage information.</li>
                <li>Share requests include the normalized project snapshot needed to create the requested read-only link.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-cookie"></i>
            </div>
            <div>
              <h2>Browser Storage And Analytics</h2>
              <p>
                Studio uses browser local storage for project recovery and workspace layout preferences, including panel state and widths. You can remove this data through your browser controls. The production site loads Google Analytics, which may use cookies or similar identifiers to measure visits and feature usage under Google's own privacy terms.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-pc-display"></i>
            </div>
            <div>
              <h2>Local Projects And Exports</h2>
              <p>
                Working projects, recovery state, panel preferences, and browser-generated downloads remain on your device unless you use a feature that explicitly sends project data to the server. Editable JSON exports are downloaded through your browser and remain under your control.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-share"></i>
            </div>
            <div>
              <h2>Shared And Embedded Projects</h2>
              <p>
                Selecting Share or Embed sends the normalized Studio project to InfraStack and creates an anonymous read-only snapshot. New snapshots normally expire after 90 days. Anyone with the generated link may be able to view its diagram and any included project, inventory, or result information, so remove confidential material before sharing.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-diagram-3"></i>
            </div>
            <div>
              <h2>How Information Is Used</h2>
              <ul>
                <li>To operate Studio, restore local work, and generate diagrams, inventory, results, graphs, and exports.</li>
                <li>To create the read-only share or embed that you request.</li>
                <li>To respond to messages, feedback, and library requests.</li>
                <li>To diagnose errors, understand aggregate site usage, maintain the service, and reduce abuse.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-box-arrow-down"></i>
            </div>
            <div>
              <h2>Sensitive Project Data</h2>
              <p>
                Do not enter passwords, private keys, access tokens, production credentials, customer secrets, regulated personal data, or other sensitive information in Studio. This is especially important before creating a public share or embed link.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-plugin"></i>
            </div>
            <div>
              <h2>Third-Party Services</h2>
              <p>
                The production site uses Google Analytics. Choosing a social-sharing option, system share action, email link, or external reference may open a third-party service and provide that service with the shared URL and standard browser request information. Those services apply their own privacy policies.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-share"></i>
            </div>
            <div>
              <h2>Sharing And Disclosure</h2>
              <p>
                InfraStack does not sell contact messages or Studio project data. Information may be disclosed to service providers needed to host, monitor, analyze, or protect the site; when required by law; to investigate abuse; or when you intentionally use sharing, email, or another external service.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-clock-history"></i>
            </div>
            <div>
              <h2>Retention</h2>
              <p>
                New anonymous share and embed snapshots normally expire after 90 days. Server logs, analytics information, contact messages, and operational records are retained only as reasonably needed for operations, troubleshooting, security, legal obligations, or responding to you. Local Studio state and downloaded exports remain under your control.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-person-check"></i>
            </div>
            <div>
              <h2>Your Choices</h2>
              <ul>
                <li>You can clear Studio recovery data and layout preferences through your browser storage controls.</li>
                <li>You can block or delete analytics cookies through your browser or privacy tools, although measurements may be affected.</li>
                <li>You can keep a project local by using browser storage and exports without creating a share or embed.</li>
                <li>You can request review or deletion of information you sent or a share snapshot you created by contacting InfraStack with enough detail to identify it.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-lock"></i>
            </div>
            <div>
              <h2>Security</h2>
              <p>
                Technical and operational safeguards are used to reduce unauthorized access and misuse. No website, browser storage, hosting platform, email system, or transmission method is guaranteed to be completely secure, so keep secrets and sensitive production data out of Studio projects and contact messages.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-person-x"></i>
            </div>
            <div>
              <h2>Children</h2>
              <p>
                InfraStack is intended for infrastructure, cloud, security, and operations learning or professional use. The site is not directed to children, and it does not knowingly request personal information from children.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-arrow-repeat"></i>
            </div>
            <div>
              <h2>Policy Updates</h2>
              <p>
                This policy may change when Studio storage, sharing, analytics, contact channels, or other operational features change. The updated date at the top identifies the current revision.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide privacy-contact-card">
            <div class="privacy-card-icon">
              <i class="bi bi-envelope-paper"></i>
            </div>
            <div>
              <h2>Contact</h2>
              <p>
                For privacy questions, corrections, or removal requests, use the <a href="{{ path('app_contact') }}">contact page</a> or email <a href="mailto:infrastack69@gmail.com">infrastack69@gmail.com</a>.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
{% endblock %}
