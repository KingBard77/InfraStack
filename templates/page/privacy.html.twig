{# templates/page/privacy.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/privacy.css') }}">
{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

<section id="privacy" class="privacy-policy section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="privacy-hero">
          <div class="privacy-hero-icon">
            <i class="bi bi-shield-lock"></i>
          </div>
          <div>
            <p class="privacy-kicker">InfraStack privacy</p>
            <h1>Privacy Policy</h1>
            <p>
              How InfraStack handles visitor data, Studio project inputs, browser state, advertising technology, and contact messages.
            </p>
            <div class="privacy-meta">
              <span><i class="bi bi-calendar3"></i> Updated May 10, 2026</span>
              <span><i class="bi bi-globe2"></i> infrastack.my</span>
            </div>
          </div>
        </div>

        <div class="privacy-grid">
          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-info-circle"></i>
            </div>
            <div>
              <h2>Overview</h2>
              <p>
                InfraStack provides a browser-based infrastructure architecture workspace at infrastack.my. This Privacy Policy explains what information may be handled when you browse the site, use Studio, interact with advertisements, or contact the site owner.
              </p>
              <p>
                Studio primarily runs in the browser and keeps its working project state on your device. Do not place passwords, private keys, production credentials, customer secrets, or regulated personal data in public architecture projects.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-input-cursor-text"></i>
            </div>
            <div>
              <h2>Information You Provide</h2>
              <ul>
                <li>Component and architecture searches entered in Studio.</li>
                <li>Contact details and messages that you choose to send by email.</li>
                <li>Diagram, inventory, and advisory inputs required to build or export a project.</li>
                <li>Feedback, correction requests, or support messages that you choose to send.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-hdd-network"></i>
            </div>
            <div>
              <h2>Technical Data</h2>
              <ul>
                <li>Basic server logs may include request time, URL, browser, device, and IP address.</li>
                <li>Security and performance signals may be used to keep the site reliable.</li>
                <li>Browser features such as local storage may be used by Studio to preserve workspace state.</li>
                <li>Advertising and analytics services may receive standard browser request information when their scripts, pixels, tags, or frames load.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-cookie"></i>
            </div>
            <div>
              <h2>Cookies, Local Storage, And Similar Technologies</h2>
              <p>
                InfraStack and third-party services may use cookies, local storage, web beacons, pixels, tags, and similar browser technologies. These technologies can support preferences, embedded services, analytics, ad delivery, fraud prevention, frequency capping, and measurement of how pages or advertisements perform.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-badge-ad"></i>
            </div>
            <div>
              <h2>Advertising And Google AdSense</h2>
              <p>
                InfraStack may display advertisements, including ads served by Google AdSense or other advertising partners. Google and other third-party advertising vendors may use cookies or similar identifiers to serve ads based on visits to InfraStack and other websites on the Internet.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-sliders"></i>
            </div>
            <div>
              <h2>Ad Personalization And Opt-Out Choices</h2>
              <p>
                Advertising partners may personalize ads, limit how often an ad is shown, detect invalid traffic, measure campaign performance, and report aggregate ad activity. You can manage Google ad personalization through <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">My Ad Center</a>. You can also visit <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">aboutads.info choices</a> to learn about opting out of some participating companies' personalized advertising cookies.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-diagram-3"></i>
            </div>
            <div>
              <h2>How Information Is Used</h2>
              <ul>
                <li>To render pages, Studio projects, inventories, and architecture review output.</li>
                <li>To respond to messages or Studio feedback.</li>
                <li>To troubleshoot errors, improve content, and maintain site security.</li>
                <li>To understand which architecture libraries and features are useful to visitors.</li>
                <li>To show, measure, and improve advertisements where advertising services are enabled.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-box-arrow-down"></i>
            </div>
            <div>
              <h2>Studio Inputs And Exports</h2>
              <p>
                Studio can generate downloadable project data. Files created by the browser remain under your control. Avoid entering secrets, private keys, production credentials, or sensitive customer data into public projects.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-plugin"></i>
            </div>
            <div>
              <h2>Third-Party Services</h2>
              <p>
                The site may load third-party assets such as fonts, icons, JavaScript libraries, analytics tools, advertising tags, or embedded resources. Those providers may receive standard browser request information when their assets are loaded. Their privacy practices are governed by their own policies.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-share"></i>
            </div>
            <div>
              <h2>Sharing And Disclosure</h2>
              <p>
                InfraStack does not sell contact messages or Studio project inputs. Information may be shared with service providers that host, secure, monitor, deliver, analyze, or monetize the site; when required by law; to protect the site from abuse; or when you intentionally use a feature that sends data to a third-party service.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-clock-history"></i>
            </div>
            <div>
              <h2>Retention</h2>
              <p>
                Server logs, contact messages, analytics events, and operational records are kept only as long as reasonably needed for site operations, troubleshooting, security, legal, or improvement purposes. Browser-based exports and local Studio state remain under your control unless a feature explicitly sends data to the server.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-person-check"></i>
            </div>
            <div>
              <h2>Your Choices</h2>
              <ul>
                <li>You can disable or delete cookies through your browser settings, although some features may not work as expected.</li>
                <li>You can avoid submitting personal or sensitive information into Studio projects.</li>
                <li>You can request correction, deletion, or review of information you previously sent through the contact channel.</li>
                <li>You can manage Google ads through My Ad Center and browser-level privacy controls.</li>
              </ul>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-lock"></i>
            </div>
            <div>
              <h2>Security</h2>
              <p>
                Reasonable technical and operational measures are used to protect the site and reduce misuse. No website, hosting platform, network, browser, or transmission method can be guaranteed to be fully secure, so avoid sending secrets or sensitive production data through public Studio projects or email.
              </p>
            </div>
          </article>

          <article class="privacy-card">
            <div class="privacy-card-icon">
              <i class="bi bi-person-x"></i>
            </div>
            <div>
              <h2>Children</h2>
              <p>
                InfraStack is intended for infrastructure, cloud, security, and operations learning or professional use. The site is not directed to children, and it does not knowingly request personal information from children.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide">
            <div class="privacy-card-icon">
              <i class="bi bi-arrow-repeat"></i>
            </div>
            <div>
              <h2>Policy Updates</h2>
              <p>
                This policy may be updated when the site adds architecture libraries, advertising partners, analytics services, contact channels, or operational features. The updated date at the top of this page indicates the latest revision.
              </p>
            </div>
          </article>

          <article class="privacy-card privacy-card-wide privacy-contact-card">
            <div class="privacy-card-icon">
              <i class="bi bi-envelope-paper"></i>
            </div>
            <div>
              <h2>Contact</h2>
              <p>
                For privacy questions, corrections, or removal requests, use the <a href="{{ path('app_contact') }}">contact page</a> or email <a href="mailto:hello@infrastack.my">hello@infrastack.my</a>.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
{% endblock %}
