{# templates/page/category.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('lib/aos/aos.css') }}">
  <link rel="stylesheet" href="{{ asset('styles/page/category.css') }}">
{% endblock %}

{% block body %}

{{ include('layout/breadcrumbs.html.twig') }}

<!-- Category Profile Section -->
<section class="category-tools-page section">
  <div class="container-xl" data-aos="fade-up" data-aos-delay="100">
    <div class="row g-4 align-items-start">
      <div class="col-lg-8">
        {% set currentViewMode = view_mode|default('grid') %}
        {% set currentSort = sort|default('newest') %}
        {% set currentPerPage = per_page|default(6) %}
        {% set listingParams = {
          group: group_filter|default(''),
          category: category_filter|default(''),
          family: family_filter|default(''),
          tag: tag_filter|default(''),
          q: search_query|default(''),
          sort: currentSort,
          view: currentViewMode,
          per_page: currentPerPage
        } %}
        {% set sortOptions = [
          { value: 'newest', label: 'Newest' },
          { value: 'oldest', label: 'Oldest' },
          { value: 'title_asc', label: 'Title A-Z' },
          { value: 'title_desc', label: 'Title Z-A' },
          { value: 'category_asc', label: 'Category A-Z' },
          { value: 'category_desc', label: 'Category Z-A' }
        ] %}

        <div class="tools-results-toolbar" aria-label="Tools listing controls">
          <div class="tools-results-left">
            <form method="get" action="{{ path('app_category') }}" class="tools-sort-form">
              <input type="hidden" name="group" value="{{ group_filter|default('') }}">
              <input type="hidden" name="category" value="{{ category_filter|default('') }}">
              <input type="hidden" name="family" value="{{ family_filter|default('') }}">
              <input type="hidden" name="tag" value="{{ tag_filter|default('') }}">
              <input type="hidden" name="q" value="{{ search_query|default('') }}">
              <input type="hidden" name="view" value="{{ currentViewMode }}">

              <div class="tools-select-group">
                <label for="tools-sort-select">Sort</label>
                <select id="tools-sort-select" name="sort">
                  {% for option in sortOptions %}
                    <option value="{{ option.value }}" {{ currentSort == option.value ? 'selected' : '' }}>
                      {{ option.label }}
                    </option>
                  {% endfor %}
                </select>
              </div>

              <div class="tools-select-group">
                <label for="tools-per-page-select">Show</label>
                <select id="tools-per-page-select" name="per_page">
                  {% for option in per_page_options|default([6, 12, 24, 48]) %}
                    <option value="{{ option }}" {{ currentPerPage == option ? 'selected' : '' }}>
                      {{ option }}
                    </option>
                  {% endfor %}
                </select>
              </div>

              {% if current_page > 1 %}
                <input type="hidden" name="page" value="1">
              {% endif %}

              <button type="submit" class="tools-sort-submit" title="Apply listing controls">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <span class="visually-hidden">Apply listing controls</span>
              </button>
            </form>
          </div>

          <div class="tools-results-status">
            <span class="tools-results-count">
              {{ total_tools }} {{ total_tools == 1 ? 'tool' : 'tools' }}
            </span>
            {% if total_pages|default(1) > 1 %}
              <span class="tools-results-page">
                Page {{ current_page }} of {{ total_pages }}
              </span>
            {% endif %}
          </div>

          <div class="tools-results-right">
            <div class="tools-view-switch" role="group" aria-label="View mode">
              {% for mode in view_modes|default([]) %}
                {% set isActiveView = currentViewMode == mode.value %}
                <a
                  href="{{ path('app_category', listingParams|merge({ page: 1, view: mode.value })) }}"
                  class="tools-view-button {{ isActiveView ? 'active' : '' }}"
                  role="button"
                  aria-pressed="{{ isActiveView ? 'true' : 'false' }}"
                  title="{{ mode.label }} view"
                >
                  <i class="{{ mode.icon }}" aria-hidden="true"></i>
                  <span class="visually-hidden">{{ mode.label }} view</span>
                </a>
              {% endfor %}
            </div>
          </div>
        </div>

        {% if family_groups|default([])|length > 0 %}
          <div class="tool-family-list tool-family-list-{{ currentViewMode }}">
            {% for family in family_groups|default([]) %}
              <section
                class="tool-family-section"
                {% if family.label|default('') %}
                  aria-labelledby="tool-family-{{ family.slug|default(loop.index) }}"
                {% else %}
                  aria-label="Tools"
                {% endif %}
              >
                {% if family.label|default('') %}
                  <div class="tool-family-heading">
                    <h2 id="tool-family-{{ family.slug|default(loop.index) }}">
                      {{ family.label|default('Tools') }}
                    </h2>
                    <span>{{ family.tools|default([])|length }} {{ family.tools|default([])|length == 1 ? 'tool' : 'tools' }}</span>
                  </div>
                {% endif %}

                <div class="tool-card-grid tool-card-grid-{{ currentViewMode }}">
                  {% for tool in family.tools|default([]) %}
                    {% set toolDisplayTitle = tool.display_title|default(tool.title) %}
                    {% set toolDisplayCardTitle = tool.display_card_image_title|default(tool.card_image_title|default(toolDisplayTitle)) %}
                    <article class="tool-card-item">
                      <a
                        href="{{ path('tool_detail', { category: tool.category_slug, slug: tool.slug }) }}"
                        class="tool-card-link"
                        aria-label="{{ toolDisplayTitle }}"
                      >
                        {% if tool.card_image is defined and tool.card_image %}
                          <div class="tool-card-media">
                            <img src="{{ tool.card_image }}" alt="{{ toolDisplayTitle }}" class="img-fluid tool-card-image">
                          </div>
                        {% else %}
                          <div
                            class="tool-card-media tool-card-cover"
                            style="
                              --cover-start: {{ tool.card_gradient_start|default('#cbd5e1') }};
                              --cover-end: {{ tool.card_gradient_end|default('#94a3b8') }};
                              --cover-text: {{ tool.card_text_color|default('#ffffff') }};
                            "
                          >
                            <div class="tool-card-cover-kicker">
                              {{ tool.card_kicker|default(tool.category|default('Tool')) }}
                            </div>

                            <div class="tool-card-cover-icon">
                              <i class="{{ tool.card_icon_class|default('bi bi-tools') }} tool-card-icon-anim-{{ tool.card_icon_animation|default('fade') }}"></i>
                            </div>

                            <div class="tool-card-cover-title">
                              {{ toolDisplayCardTitle }}
                            </div>
                          </div>
                        {% endif %}

                        <div class="tool-card-body">
                          <h3 class="tool-card-title">{{ toolDisplayTitle }}</h3>

                          {% if tool.card_summary is defined and tool.card_summary %}
                            <p class="tool-card-summary">{{ tool.card_summary }}</p>
                          {% else %}
                            <p class="tool-card-summary tool-card-summary-empty">&nbsp;</p>
                          {% endif %}

                          <div class="tool-card-taxonomy">
                            <span>{{ tool.family|default('Tool') }}</span>
                            <span>{{ tool.category|default('Tool') }}</span>
                          </div>

                          <div class="tool-card-meta">
                            <div class="tool-card-author">
                              {% set authorImage = tool.author_image|default('') %}
                              {% set authorImageUrl = authorImage %}
                              {% if authorImage and authorImage is not same as('') and not (
                                authorImage starts with 'http://'
                                or authorImage starts with 'https://'
                                or authorImage starts with '//'
                                or authorImage starts with 'data:'
                              ) %}
                                {% set authorImageUrl = asset(authorImage|trim('/')) %}
                              {% endif %}

                              {% if authorImageUrl %}
                                <img
                                  src="{{ authorImageUrl }}"
                                  alt="{{ tool.author }}"
                                  class="tool-card-avatar-image"
                                >
                              {% else %}
                                <span class="tool-card-avatar">{{ tool.author_initial|default('T') }}</span>
                              {% endif %}

                              <div class="tool-card-author-copy">
                                <p class="tool-card-author-name">{{ tool.author }}</p>
                                <p class="tool-card-author-date">
                                  <time datetime="{{ tool.date }}">{{ tool.date }}</time>
                                </p>
                              </div>
                            </div>
                          </div>
                        </div>
                      </a>
                    </article>
                  {% endfor %}
                </div>
              </section>
            {% endfor %}
          </div>
        {% else %}
          <div class="tool-card-empty">
            <p>No tools found.</p>
          </div>
        {% endif %}

        {% if total_pages > 1 %}
          <section id="pagination-2" class="pagination-2 section">
            <div class="d-flex justify-content-center">
              <ul>
                <li>
                  {% if current_page > 1 %}
                    <a href="{{ path('app_category', listingParams|merge({ page: current_page - 1 })) }}">
                      <i class="bi bi-chevron-left"></i>
                    </a>
                  {% else %}
                    <span class="disabled"><i class="bi bi-chevron-left"></i></span>
                  {% endif %}
                </li>

                {% for i in 1..total_pages %}
                  <li>
                    <a
                      href="{{ path('app_category', listingParams|merge({ page: i })) }}"
                      class="{{ current_page == i ? 'active' : '' }}"
                    >
                      {{ i }}
                    </a>
                  </li>
                {% endfor %}

                <li>
                  {% if current_page < total_pages %}
                    <a href="{{ path('app_category', listingParams|merge({ page: current_page + 1 })) }}">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  {% else %}
                    <span class="disabled"><i class="bi bi-chevron-right"></i></span>
                  {% endif %}
                </li>
              </ul>
            </div>
          </section>
        {% endif %}
      </div>

      {{ include('layout/sidebar.html.twig') }}
    </div>
  </div>
</section>
<!-- Category Profile Section -->

{% endblock %}

{% block javascripts %}
  <script src="{{ asset('lib/aos/aos.js') }}"></script>
  {{ parent() }}
{% endblock %}
