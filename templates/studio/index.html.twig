            <header><div><span>Canvas help</span><h2 id="studio-shortcuts-title">Keyboard shortcuts</h2></div><button class="studio-icon-button" type="submit" value="close" aria-label="Close keyboard shortcuts"><i class="bi bi-x-lg"></i></button></header>
            <div class="studio-shortcuts-grid">
                <section><h3>Navigate</h3><dl><div><dt><kbd>Space</kbd> + drag</dt><dd>Pan canvas</dd></div><div><dt><kbd>Wheel</kbd></dt><dd>Zoom at cursor</dd></div><div><dt><kbd>F</kbd></dt><dd>Fit architecture</dd></div><div><dt><kbd>Alt</kbd> + drag</dt><dd>Temporarily disable snapping</dd></div></dl></section>
                <section><h3>Select and edit</h3><dl><div><dt><kbd>Drag</kbd></dt><dd>Box select</dd></div><div><dt><kbd>Shift</kbd> + click</dt><dd>Add or remove selection</dd></div><div><dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>A</kbd></dt><dd>Select visible assets</dd></div><div><dt><kbd>Esc</kbd></dt><dd>Clear selection or Connect mode</dd></div><div><dt><kbd>Arrow keys</kbd></dt><dd>Nudge selected assets</dd></div></dl></section>
                <section><h3>Actions</h3><dl><div><dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>D</kbd></dt><dd>Duplicate</dd></div><div><dt><kbd>Delete</kbd></dt><dd>Delete selection</dd></div><div><dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Z</kbd></dt><dd>Undo</dd></div><div><dt><kbd>Shift</kbd> + <kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Z</kbd></dt><dd>Redo</dd></div><div><dt><kbd>?</kbd></dt><dd>Open this guide</dd></div></dl></section>
            </div>
        </form>
    </dialog>

    <dialog id="studio-share-dialog" class="studio-publish-dialog studio-share-dialog" aria-labelledby="studio-share-dialog-title">
        <form method="dialog" class="studio-publish-dialog-shell studio-share-shell">
            <header class="studio-share-heading">
                <h2 id="studio-share-dialog-title" class="studio-visually-hidden">Share architecture</h2>
                <p id="studio-share-introduction" class="studio-share-introduction"></p>
                <button class="studio-icon-button" type="submit" value="close" aria-label="Close sharing"><i class="bi bi-x-lg"></i></button>
            </header>
            <figure class="studio-share-preview"><img id="studio-share-preview" alt="Generated architecture share image"></figure>
            <div class="studio-share-primary-actions">
                <div class="studio-share-status" role="status"><span id="studio-share-status-text">Read-only share link ready</span></div>
                <a id="studio-share-whatsapp" class="studio-share-action is-whatsapp" href="#" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i><span>Continue to WhatsApp</span></a>
                <button id="studio-share-system" class="studio-share-action" type="button"><i class="bi bi-box-arrow-up"></i><span>System Share</span></button>
                <button id="studio-share-copy-image" class="studio-share-action" type="button"><i class="bi bi-clipboard"></i><span>Copy Image</span></button>
                <button id="studio-share-download-image" class="studio-share-action" type="button"><i class="bi bi-download"></i><span>Download PNG</span></button>
            </div>
            <details class="studio-share-platforms-disclosure">
                <summary>More sharing options <i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
                <nav class="studio-share-platforms" aria-label="Share on another platform">
                    <a id="studio-share-x" href="#" target="_blank" rel="noopener" aria-label="Share on X" title="Share on X"><i class="bi bi-twitter-x"></i></a>
                    <a id="studio-share-facebook" href="#" target="_blank" rel="noopener" aria-label="Share on Facebook" title="Share on Facebook"><i class="bi bi-facebook"></i></a>
                    <a id="studio-share-linkedin" href="#" target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="Share on LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a id="studio-share-telegram" href="#" target="_blank" rel="noopener" aria-label="Share on Telegram" title="Share on Telegram"><i class="bi bi-telegram"></i></a>
                    <a id="studio-share-reddit" href="#" target="_blank" rel="noopener" aria-label="Share on Reddit" title="Share on Reddit"><i class="bi bi-reddit"></i></a>
                    <a id="studio-share-email" href="#" aria-label="Share by email" title="Share by email"><i class="bi bi-envelope"></i></a>
                </nav>
            </details>
        </form>
    </dialog>

    <dialog id="studio-embed-dialog" class="studio-publish-dialog studio-embed-dialog" aria-labelledby="studio-embed-dialog-title">
        <form method="dialog" class="studio-publish-dialog-shell studio-embed-shell">
            <header class="studio-embed-heading"><h2 id="studio-embed-dialog-title">Embed</h2><nav class="studio-embed-tabs" aria-label="Embed settings"><button class="is-customize is-active" type="button" data-embed-focus="studio-embed-panel-customize" aria-controls="studio-embed-panel-customize" aria-expanded="true"><i class="bi bi-sliders"></i> Customize</button><button class="is-disclaimer is-active" type="button" data-embed-focus="studio-embed-panel-disclaimer" aria-controls="studio-embed-panel-disclaimer" aria-expanded="true"><i class="bi bi-shield-exclamation"></i> Disclaimer</button><button class="is-advanced is-active" type="button" data-embed-focus="studio-embed-panel-advanced" aria-controls="studio-embed-panel-advanced" aria-expanded="true"><i class="bi bi-gear"></i> Advanced</button></nav><button id="studio-embed-close" class="studio-icon-button" type="submit" value="close" aria-label="Close embed"><i class="bi bi-x-lg"></i></button></header>
            <div class="studio-embed-code-row"><input id="studio-embed-code" type="text" readonly aria-label="Embed iframe code"><button id="studio-share-copy-embed" type="button"><i class="bi bi-clipboard"></i> Copy</button><a id="studio-embed-demo" href="#" target="_blank" rel="noopener"><i class="bi bi-window"></i> Demo</a></div>
            <section id="studio-embed-panel-disclaimer" class="studio-embed-disclaimer" tabindex="-1"><strong>Embed this InfraStack architecture only where the surrounding page gives users enough context to interpret the result.</strong><ul><li>Treat the frame as a planning aid, not approval, certification, compliance evidence, or production guidance.</li><li>Validate generated diagrams, values, exports, and assumptions before technical or business decisions.</li><li>Do not embed it in a misleading, unsafe, unlawful, or security-sensitive context.</li><li>InfraStack may revise behavior, labels, limits, routes, or availability as the platform changes.</li></ul><span>If that does not fit the page, link to the shared architecture instead.</span></section>
            <section id="studio-embed-panel-customize" class="studio-embed-panel" tabindex="-1">
                <div class="studio-embed-field-grid">
                    <label>Width <span><input id="studio-embed-width" type="number" min="1" max="1600" value="100"><select id="studio-embed-width-unit"><option value="%">%</option><option value="px">px</option><option value="vw">vw</option></select></span></label>
                    <label>Height <span><input id="studio-embed-height" type="number" min="1" max="1600" value="100"><select id="studio-embed-height-unit"><option value="%">%</option><option value="px">px</option><option value="vh">vh</option></select></span></label>
                    <label class="studio-embed-ratio">Aspect ratio <span><input id="studio-embed-ratio-width" type="number" min="1" max="32" value="16"><b>:</b><input id="studio-embed-ratio-height" type="number" min="1" max="32" value="9"></span></label>
                    <label>Max height <span><input id="studio-embed-max-height" type="number" min="0" max="2000" placeholder="None"><select id="studio-embed-max-height-unit"><option value="px">px</option><option value="vh">vh</option></select></span></label>
                </div>
                <div class="studio-share-options"><label><input id="studio-embed-inventory" type="checkbox"> Include inventory</label><label><input id="studio-embed-advisory" type="checkbox"> Include Studio Result</label><label><input id="studio-embed-collapsible" type="checkbox"> Collapsible embed</label><label><input id="studio-embed-fullscreen" type="checkbox"> Allow fullscreen</label></div>
            </section>
            <section id="studio-embed-panel-advanced" class="studio-embed-panel studio-embed-advanced" tabindex="-1"><div class="studio-embed-field-grid"><label>Referrer policy <select id="studio-embed-referrer"><option value="no-referrer-when-downgrade">no-referrer-when-downgrade</option><option value="strict-origin-when-cross-origin">strict-origin-when-cross-origin</option><option value="no-referrer">no-referrer</option></select></label><label>Sandbox tokens <input id="studio-embed-sandbox" type="text" value="allow-scripts allow-same-origin allow-forms allow-popups"></label></div></section>
        </form>
    </dialog>
</div>
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio']) }}
{% endblock %}
