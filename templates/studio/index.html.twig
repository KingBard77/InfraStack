{# templates/studio/index.html.twig #}
{% extends 'base.html.twig' %}
{% import 'layout/advertisement.html.twig' as advertisement %}

{% block title %}{{ page_title }}{% endblock %}

{% block site_header %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/studio/studio.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/studio/content.css') }}">
{% endblock %}

{% block body %}
<div
    id="infrastack-studio"
    class="infrastack-studio"
    data-library-config="{{ studio_libraries|json_encode|e('html_attr') }}"
    data-package-registry="{{ studio_packages|json_encode|e('html_attr') }}"
    data-share-url="{{ path('app_studio_share_create') }}"
    data-share-csrf="{{ csrf_token('submit') }}"
>
    <header class="studio-appbar" aria-label="Studio application bar">
        <a href="{{ path('app_main') }}" class="studio-appbar-brand" aria-label="InfraStack home">
            <img src="{{ asset('images/logo/infrastack-wordmark.png') }}" width="180" height="33" alt="">
        </a>
        <label class="studio-project-switcher" for="studio-project-name">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>
            <input id="studio-project-name" type="text" maxlength="80" autocomplete="off" spellcheck="false" aria-label="Project name">
            <i class="bi bi-pencil" aria-hidden="true"></i>
        </label>
        <span id="studio-save-state" class="studio-save-state"><i aria-hidden="true"></i> Blank project ready</span>
        <div class="studio-appbar-spacer"></div>
        <div class="studio-control-cluster" aria-label="History controls">
            <button id="studio-undo" class="studio-icon-button" type="button" aria-label="Undo" title="Undo"><i class="bi bi-arrow-counterclockwise"></i></button>
            <button id="studio-redo" class="studio-icon-button" type="button" aria-label="Redo" title="Redo"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
        <div class="studio-control-cluster" aria-label="View controls">
            <select id="studio-view-select" class="studio-select" aria-label="Architecture projection"><option value="overview">Overview</option></select>
        </div>
        <button id="studio-reset-layout" class="studio-icon-button studio-display-button" type="button" aria-label="Reset panel layout" title="Reset panel layout"><i class="bi bi-layout-three-columns"></i></button>
        <button id="studio-wide-screen" class="studio-icon-button studio-display-button" type="button" aria-label="Enter wide screen" aria-pressed="false" title="Wide screen"><i class="bi bi-aspect-ratio"></i></button>
        <button id="studio-fullscreen" class="studio-icon-button studio-display-button" type="button" aria-label="Enter full screen" aria-pressed="false" title="Full screen"><i class="bi bi-fullscreen"></i></button>
        <button id="studio-share" class="studio-button studio-button-primary" type="button"><i class="bi bi-person-plus"></i> Share</button>
        <button id="studio-embed" class="studio-button" type="button"><i class="bi bi-code-slash"></i> Embed</button>
        <details class="studio-export-menu">
            <summary class="studio-button"><i class="bi bi-download"></i> Export <i class="bi bi-chevron-down"></i></summary>
            <div>
                <button id="studio-download-json" type="button"><i class="bi bi-filetype-json"></i><span>Download project JSON<small>Editable Studio state</small></span></button>
                <button id="studio-import-json" type="button"><i class="bi bi-upload"></i><span>Restore JSON<small>Open a saved project</small></span></button>
            </div>
        </details>
        <span class="studio-avatar" aria-label="Local user">BA</span>
        <input id="studio-import-file" class="visually-hidden" type="file" accept="application/json,.json" aria-label="Restore project JSON file">
    </header>

    <nav id="studio-mode-navigation" class="studio-mode-navigation" role="tablist" aria-label="Studio modes">
        <div class="studio-mode-segments" role="presentation">
            <button id="studio-mode-design-tab" class="is-active" type="button" role="tab" aria-selected="true" aria-controls="studio-mode-design" title="Design — Canvas and editing">
                <i class="bi bi-bezier2" aria-hidden="true"></i><strong>Design</strong>
            </button>
            <button id="studio-mode-review-tab" type="button" role="tab" aria-selected="false" aria-controls="studio-mode-review" title="Review — Results and guidance">
                <i class="bi bi-stars" aria-hidden="true"></i><strong>Review</strong><span id="studio-mode-review-count" class="studio-mode-count" aria-label="Open findings" hidden>0</span>
            </button>
            <button id="studio-mode-inventory-tab" type="button" role="tab" aria-selected="false" aria-controls="studio-mode-inventory" title="Inventory — Assets and resources">
                <i class="bi bi-table" aria-hidden="true"></i><strong>Inventory</strong><span id="studio-mode-inventory-count" class="studio-mode-count" aria-label="Assets" hidden>0</span>
            </button>
            <button id="studio-mode-share-tab" type="button" role="tab" aria-selected="false" aria-controls="studio-mode-share" title="Share — Publish and export">
                <i class="bi bi-share" aria-hidden="true"></i><strong>Share</strong>
            </button>
        </div>
    </nav>

    <div id="studio-message" class="studio-message" role="status" aria-live="polite"></div>

    <div id="studio-mode-design" class="studio-workspace studio-mode-panel" role="tabpanel" aria-labelledby="studio-mode-design-tab">
        <nav class="studio-navigation-rail" aria-label="Studio sections">
            <button id="studio-rail-canvas" class="is-active" type="button" aria-label="Canvas" title="Canvas"><i class="bi bi-layers"></i></button>
            <button id="studio-rail-templates" type="button" aria-label="Templates" title="Templates"><i class="bi bi-grid"></i></button>
            <button id="studio-rail-assets" type="button" aria-label="Components" title="Components"><i class="bi bi-boxes"></i></button>
            <button id="studio-rail-history" type="button" aria-label="History and recovery" aria-expanded="false" title="History and recovery"><i class="bi bi-clock-history"></i></button>
        </nav>
        <button id="studio-palette-toggle" class="studio-panel-expand studio-palette-expand" type="button" aria-label="Expand component library" title="Expand component library" hidden><i class="bi bi-chevron-right"></i></button>
        <button id="studio-inspector-toggle" class="studio-panel-expand studio-inspector-expand" type="button" aria-label="Expand inspector" title="Expand inspector" hidden><i class="bi bi-chevron-left"></i></button>
        <button id="studio-palette-resizer" class="studio-panel-resizer studio-palette-resizer" type="button" role="separator" aria-label="Resize component library" aria-orientation="vertical" aria-valuemin="210" aria-valuemax="420" aria-valuenow="250"></button>
        <button id="studio-inspector-resizer" class="studio-panel-resizer studio-inspector-resizer" type="button" role="separator" aria-label="Resize inspector" aria-orientation="vertical" aria-valuemin="210" aria-valuemax="420" aria-valuenow="280"></button>
        <aside class="studio-panel studio-palette-panel" aria-labelledby="studio-palette-title">
            <div class="studio-panel-tabs-bar">
                <div class="studio-library-tabs" role="tablist" aria-label="Library views">
                    <button id="studio-components-tab" class="is-active" type="button" role="tab" aria-selected="true">Components</button>
                    <button id="studio-templates-tab" type="button" role="tab" aria-selected="false">Templates</button>
                </div>
                <button id="studio-palette-collapse" class="studio-panel-collapse" type="button" aria-label="Collapse component library" title="Collapse component library"><i class="bi bi-chevron-left"></i></button>
            </div>
            <div id="studio-components-panel" role="tabpanel">
                <button id="studio-upload-custom-icon" class="studio-button studio-button-block studio-upload-icon" type="button"><i class="bi bi-upload"></i> Upload custom icon</button>
                <div id="studio-catalogue-browser">
                    <div class="studio-panel-heading"><h2 id="studio-palette-title" class="visually-hidden">Component library</h2><span id="studio-asset-count" class="studio-count">0</span></div>
                    <label class="studio-catalogue-search" for="studio-catalogue-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="studio-catalogue-search" type="search" placeholder="Search components" autocomplete="off">
                        <kbd>⌘ K</kbd>
                    </label>
                    <div class="studio-catalogue-filters">
                        <label for="studio-catalogue-library">Library<select id="studio-catalogue-library" class="studio-select" aria-label="Asset library"></select></label>
                        <label for="studio-catalogue-provider">Provider<select id="studio-catalogue-provider" class="studio-select" aria-label="Asset provider"></select></label>
                    </div>
                    <div id="studio-palette" class="studio-palette"></div>
                </div>
            </div>
            <div id="studio-templates-panel" class="studio-template-panel" role="tabpanel" hidden>
                <div class="studio-catalogue-filters studio-template-filters">
                    <label for="studio-template-family">Library<select id="studio-template-family" class="studio-select" aria-label="Template library"></select></label>
                    <label for="studio-template-provider">Provider<select id="studio-template-provider" class="studio-select" aria-label="Template provider"></select></label>
                </div>
                <div class="studio-template-heading"><div><span>Architecture templates</span><strong id="studio-template-provider-label">Choose a library and provider</strong></div><span id="studio-template-count" class="studio-count">0</span></div>
                <p>Choose a provider-native starting point. Every template remains fully editable.</p>
                <div id="studio-template-list" class="studio-template-list"></div>
                <button id="studio-new-project" class="studio-template-card" type="button"><i class="bi bi-file-earmark-plus"></i><span><strong>Blank architecture</strong><small>Empty local Studio project</small></span></button>
                <button id="studio-template-restore" class="studio-template-card" type="button"><i class="bi bi-upload"></i><span><strong>Restore JSON</strong><small>Continue from an exported project</small></span></button>
                <details class="studio-reference-controls">
                    <summary>Background reference</summary>
                    <p>Import a PNG or JPEG only as a traceable background. It is not a diagram asset.</p>
                    <button id="studio-reference-import" class="studio-button studio-button-block" type="button">Import image</button>
                    <input id="studio-reference-file" class="visually-hidden" type="file" accept="image/png,image/jpeg">
                    <label class="studio-reference-toggle" for="studio-reference-visible"><span>Show reference</span><input id="studio-reference-visible" type="checkbox"></label>
                    <label class="studio-reference-toggle" for="studio-reference-locked"><span>Lock position</span><input id="studio-reference-locked" type="checkbox"></label>
                    <label class="studio-reference-opacity-label" for="studio-reference-opacity"><span>Opacity</span><span id="studio-reference-name">None</span></label>
                    <input id="studio-reference-opacity" type="range" min="5" max="100" value="28">
                    <div class="studio-reference-grid">
                        <label for="studio-reference-x">X<input id="studio-reference-x" type="number" min="0" max="2300" step="10"></label>
                        <label for="studio-reference-y">Y<input id="studio-reference-y" type="number" min="0" max="1300" step="10"></label>
                        <label for="studio-reference-width">Width<input id="studio-reference-width" type="number" min="200" max="2400" step="10"></label>
                        <label for="studio-reference-height">Height<input id="studio-reference-height" type="number" min="120" max="1400" step="10"></label>
                    </div>
                    <button id="studio-reference-fit" class="studio-button studio-button-block" type="button">Fit to canvas</button>
                    <button id="studio-reference-remove" class="studio-button studio-button-block" type="button">Remove reference</button>
                </details>
            </div>
            <div id="studio-history-panel" class="studio-history-panel" role="tabpanel" hidden>
                <div class="studio-history-heading">
                    <span><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                    <div><small>Session timeline</small><strong>History and recovery</strong></div>
                    <span id="studio-history-count" class="studio-count">0</span>
                </div>
                <p>Select an earlier state to undo multiple changes. Redo remains available from the top toolbar.</p>
                <div id="studio-history-list" class="studio-history-list"></div>
                <div id="studio-history-empty" class="studio-history-empty"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><strong>No changes yet</strong><span>Edits made during this session will appear here.</span></div>
                <section id="studio-recovery-card" class="studio-recovery-card" aria-labelledby="studio-recovery-title" hidden>
                    <div class="studio-recovery-heading"><i class="bi bi-clock-history" aria-hidden="true"></i><span><strong id="studio-recovery-title">Recover previous session</strong><small id="studio-recovery-name"></small></span></div>
                    <p id="studio-recovery-meta"></p>
                    <div class="studio-recovery-actions"><button id="studio-recover-session" class="studio-button studio-button-primary" type="button">Recover</button><button id="studio-discard-recovery" class="studio-button" type="button">Discard</button></div>
                </section>
            </div>
        </aside>

        <main class="studio-stage-panel">
            <div class="studio-stage-heading visually-hidden">
                <div class="studio-stage-title"><span id="studio-view-eyebrow">Overview projection</span><h2 id="studio-stage-title">Overview architecture</h2></div>
            </div>
            <div id="studio-stage" class="studio-stage" tabindex="0" aria-label="Architecture canvas">
                <div class="studio-ruler studio-ruler-horizontal" aria-hidden="true"><span>0</span><span>400</span><span>800</span><span>1200</span><span>1600</span></div>
                <div class="studio-ruler studio-ruler-vertical" aria-hidden="true"><span>0</span><span>400</span><span>800</span><span>1200</span></div>
                <div class="studio-floating-toolbar" aria-label="Canvas tools">
                    <button id="studio-select-tool" class="is-active" type="button" aria-label="Select and move" title="Select and move"><i class="bi bi-cursor"></i></button>
                    <button id="studio-connect" type="button" aria-label="Connect assets" aria-pressed="false" title="Connect assets"><i class="bi bi-bezier2"></i></button>
                    <select id="studio-connect-type" class="studio-select" aria-label="Relationship type">
                        <option value="network">Network</option><option value="vpn">VPN</option><option value="peering">Peering</option><option value="trust">Trust</option><option value="api">API</option><option value="replication">Replication</option><option value="administration">Administration</option>
                    </select>
                    <button id="studio-duplicate" type="button" aria-label="Duplicate selected assets" title="Duplicate selected assets"><i class="bi bi-copy"></i></button>
                    <button id="studio-auto-layout" type="button" aria-label="Auto layout architecture" title="Auto layout architecture"><i class="bi bi-magic"></i></button>
                    <details id="studio-align-menu" class="studio-tool-menu">
                        <summary aria-label="Align selected assets" title="Align selected assets"><i class="bi bi-align-start"></i></summary>
                        <div class="studio-tool-menu-popover" role="group" aria-label="Alignment options">
                            <button type="button" data-align="left">Align left</button>
                            <button type="button" data-align="center">Align center</button>
                            <button type="button" data-align="right">Align right</button>
                            <button type="button" data-align="top">Align top</button>
                            <button type="button" data-align="middle">Align middle</button>
                            <button type="button" data-align="bottom">Align bottom</button>
                        </div>
                    </details>
                    <details id="studio-distribute-menu" class="studio-tool-menu">
                        <summary aria-label="Distribute selected assets" title="Distribute selected assets"><i class="bi bi-distribute-horizontal"></i></summary>
                        <div class="studio-tool-menu-popover" role="group" aria-label="Distribution options">
                            <button type="button" data-distribute="horizontal">Distribute horizontally</button>
                            <button type="button" data-distribute="vertical">Distribute vertically</button>
                        </div>
                    </details>
                    <button id="studio-insert-image" type="button" aria-label="Insert image or icon asset" title="Insert image or icon asset"><i class="bi bi-image"></i></button>
                    <input id="studio-image-asset-file" class="visually-hidden" type="file" accept="image/png,image/jpeg,image/webp" aria-label="Upload image asset file">
                    <button id="studio-delete-selection" type="button" aria-label="Delete selected items" title="Delete selected items" disabled><i class="bi bi-trash3"></i></button>
                    <button id="studio-review-action" type="button" aria-label="Review architecture" title="Review architecture"><i class="bi bi-stars"></i></button>
                </div>
                <div id="studio-reference-frame" class="studio-reference-frame" hidden>
                    <img id="studio-reference-image" class="studio-reference-image" alt="Local architecture reference">
                    <span class="studio-resize-handle studio-reference-resize" aria-hidden="true"></span>
                </div>
                <div id="studio-graph" class="studio-graph" role="group" aria-label="Editable architecture graph"></div>
                <div id="studio-empty-state" class="studio-empty-state" hidden>
                    <strong>Let's start drawing</strong>
                    <span>Start with a template or an empty canvas.</span>
                    <button id="studio-empty-template" class="studio-button studio-button-primary studio-empty-primary" type="button"><i class="bi bi-grid" aria-hidden="true"></i> Browse templates</button>
                    <div class="studio-empty-secondary">
                        <button id="studio-empty-blank" type="button"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Blank project</button>
                        <button id="studio-empty-restore" type="button"><i class="bi bi-upload" aria-hidden="true"></i> Restore JSON</button>
                    </div>
                    <button id="studio-empty-upload-icon" class="studio-empty-upload" type="button"><i class="bi bi-image" aria-hidden="true"></i> Upload icon</button>
                </div>
                <div id="studio-minimap" class="studio-minimap" role="img" aria-label="Canvas minimap"></div>
                <div class="studio-canvas-controls" aria-label="Canvas viewport controls">
                    <button id="studio-bottom-zoom-out" type="button" aria-label="Zoom out"><i class="bi bi-dash-lg"></i></button>
                    <span id="studio-bottom-zoom-value">100%</span>
                    <button id="studio-bottom-zoom-in" type="button" aria-label="Zoom in"><i class="bi bi-plus-lg"></i></button>
                    <button id="studio-bottom-fit" type="button" aria-label="Fit to screen"><i class="bi bi-arrows-angle-expand"></i></button>
                    <button id="studio-shortcuts-button" type="button" aria-label="Keyboard shortcuts" title="Keyboard shortcuts"><i class="bi bi-keyboard"></i></button>
                </div>
                <div class="studio-canvas-settings" aria-label="Canvas settings">
                    <label><input id="studio-grid-visible" type="checkbox" checked> Grid</label>
                    <label><input id="studio-snap-enabled" type="checkbox" checked> Snap</label>
                    <label><input id="studio-guides-enabled" type="checkbox" checked> Guides</label>
                    <label for="studio-grid-size">Grid <select id="studio-grid-size" class="studio-canvas-select"><option value="5">5 px</option><option value="10" selected>10 px</option><option value="20">20 px</option><option value="40">40 px</option></select></label>
                    <span id="studio-cursor-position">X: 0, Y: 0</span>
                </div>
            </div>
            <div class="studio-stage-footer"><span id="studio-stage-summary">0 assets · 0 connections</span><span>Drag empty canvas to select. Space-drag pans. Mouse wheel zooms. Press ? for shortcuts.</span></div>
            <div class="studio-relationship-legend" aria-label="Relationship legend">
                <span data-type="network">Network</span><span data-type="vpn">VPN</span><span data-type="peering">Peering</span><span data-type="trust">Trust</span><span data-type="api">API</span><span data-type="replication">Replication</span><span data-type="administration">Administration</span>
            </div>
        </main>

        <aside class="studio-panel studio-inspector-panel" aria-labelledby="studio-inspector-title">
            <div class="studio-panel-tabs-bar">
                <div class="studio-inspector-tabs" role="tablist" aria-label="Inspector views">
                    <button id="studio-properties-tab" class="is-active" type="button" role="tab" aria-selected="true">Properties</button>
                    <button id="studio-style-tab" type="button" role="tab" aria-selected="false">Style</button>
                </div>
                <button id="studio-inspector-collapse" class="studio-panel-collapse" type="button" aria-label="Collapse inspector" title="Collapse inspector"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="studio-panel-heading"><div><span>Selected item</span><h2 id="studio-inspector-title">Inspector</h2></div><button id="studio-delete-item" class="studio-icon-button" type="button" title="Delete selected item" disabled><i class="bi bi-trash3"></i></button></div>
            <div id="studio-inspector-empty" class="studio-inspector-empty"><i class="bi bi-cursor"></i><p>Select an asset, boundary, or relationship to edit it.</p></div>
            <form id="studio-asset-form" class="studio-inspector-form" hidden>
                <strong id="studio-selected-type" class="studio-selected-type"></strong>
                <div id="studio-properties-panel" class="studio-inspector-tab-panel studio-inspector-sections">
                    <details id="studio-inspector-basic" class="studio-inspector-section" open>
                        <summary><i class="bi bi-card-text" aria-hidden="true"></i><span><strong>Basic</strong><small>Name and purpose</small></span></summary>
                        <div class="studio-inspector-section-body">
                            <label for="studio-field-label">Name</label><input id="studio-field-label" type="text" maxlength="80" required>
                            <label for="studio-field-role">Description / role</label><input id="studio-field-role" type="text" maxlength="100">
                        </div>
                    </details>
                    <div id="studio-context-fields" class="studio-context-fields">
                        <details id="studio-inspector-placement" class="studio-inspector-section">
                            <summary><i class="bi bi-geo-alt" aria-hidden="true"></i><span><strong>Placement</strong><small>Boundary and location</small></span></summary>
                            <div class="studio-inspector-section-body">
                                <label for="studio-field-parent">Parent boundary</label><select id="studio-field-parent" class="studio-select"><option value="">None</option></select>
                                <label for="studio-field-provider">Provider / region</label><input id="studio-field-provider" type="text" maxlength="60">
                                <div class="studio-form-grid"><div><label for="studio-field-environment">Environment</label><input id="studio-field-environment" type="text" maxlength="40"></div><div><label for="studio-field-zone">Availability zone</label><input id="studio-field-zone" type="text" maxlength="40"></div></div>
                                <div id="studio-context-placement-fields" class="studio-context-field-group"></div>
                            </div>
                        </details>
                        <details id="studio-inspector-network" class="studio-inspector-section">
                            <summary><i class="bi bi-diagram-3" aria-hidden="true"></i><span><strong>Network</strong><small>Addressing and connectivity</small></span></summary>
                            <div class="studio-inspector-section-body">
                                <label for="studio-field-address">IP address or CIDR block</label><input id="studio-field-address" type="text" maxlength="64">
                                <label for="studio-field-hostname">Hostname</label><input id="studio-field-hostname" type="text" maxlength="80">
                                <div id="studio-context-network-fields" class="studio-context-field-group"></div>
                            </div>
                        </details>
                        <details id="studio-inspector-resources" class="studio-inspector-section">
                            <summary><i class="bi bi-cpu" aria-hidden="true"></i><span><strong>Resources</strong><small>Compute and storage</small></span></summary>
                            <div class="studio-inspector-section-body">
                                <div class="studio-form-grid"><div><label for="studio-field-cpu">CPU</label><input id="studio-field-cpu" type="text" maxlength="30"></div><div><label for="studio-field-memory">Memory</label><input id="studio-field-memory" type="text" maxlength="30"></div><div><label for="studio-field-storage">Storage</label><input id="studio-field-storage" type="text" maxlength="40"></div></div>
                                <div id="studio-context-resources-fields" class="studio-context-field-group"></div>
                            </div>
                        </details>
                        <details id="studio-inspector-image" class="studio-inspector-section" hidden>
                            <summary><i class="bi bi-image" aria-hidden="true"></i><span><strong>Image</strong><small>Embedded image settings</small></span></summary>
                            <div class="studio-inspector-section-body">
                                <section id="studio-image-properties" class="studio-image-properties" hidden>
