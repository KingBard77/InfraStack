{# content.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ meta.title|default('Content') }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}

  <style>
    {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/custom.css' ignore missing %}
  </style>
{% endblock %}

{% block body %}

  {{ include('layout/breadcrumbs.html.twig') }}

  <div class="container">
    <div class="row">

      <div class="col-lg-8">
        <section id="blog-details" class="blog-details section">
          <div class="container">
            <article class="article">

              <div class="article-content">

                <div class="content-header">
                  <div class="title-meta mb-3">
                    {% if meta.category_label is defined and meta.category_label %}
                      <a href="#" class="category">{{ meta.category_label }}</a>
                    {% endif %}

                    {% if meta.reading_time is defined and meta.reading_time %}
                      <span class="divider">•</span>
                      <span class="reading-time">
                        <i class="bi bi-clock"></i> {{ meta.reading_time }}
                      </span>
                    {% endif %}
                  </div>

                  <h1 class="title">{{ meta.title }}</h1>

                  <div class="author-info">
                    <div class="author-details">
                      {% set authorImage = meta.author_image|default('') %}
                      {% set authorImageUrl = authorImage %}
                      {% if authorImage and authorImage is not same as('') and not (
                        authorImage starts with 'http://'
                        or authorImage starts with 'https://'
                        or authorImage starts with '//'
                        or authorImage starts with 'data:'
                      ) %}
                        {% set authorImageUrl = asset(authorImage|trim('/')) %}
                      {% endif %}

                      {% if authorImageUrl %}
                        <img src="{{ authorImageUrl }}" alt="{{ meta.author|default('Author') }}" class="author-img">
                      {% endif %}

                      <div class="info">
                        {% if meta.author is defined and meta.author %}
                          <h4>{{ meta.author }}</h4>
                        {% endif %}

                        {% if meta.author_role is defined and meta.author_role %}
                          <span class="role">{{ meta.author_role }}</span>
                        {% endif %}
                      </div>
                    </div>

                    <div class="post-meta">
                      {% if meta.date is defined and meta.date %}
                        <span class="date">
                          <i class="bi bi-calendar3"></i> {{ meta.date }}
                        </span>
                      {% endif %}

                      {% if meta.comments is defined and meta.comments %}
                        <span class="divider">•</span>
                        <span class="comments">
                          <i class="bi bi-chat-text"></i> {{ meta.comments }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </div>

                <div class="content">

                  {% if meta.intro is defined and meta.intro %}
                    <div class="tool-intro mb-4">
                      <p class="tool-main-description">{{ meta.intro|nl2br }}</p>
                    </div>
                  {% endif %}

                  {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/tool.html.twig' ignore missing %}

                  <div class="markdown-content">
                    {{ content_html|raw }}
                  </div>
                </div>

                {# share.html.twig #}
                {{ include('layout/share.html.twig') }}
                {% set shareUrl = article_url|default(app.request.uri) %}
                {% set shareTitle = article_title|default(meta.title|default('InfraStack Tool')) %}
                {% set embedSeparator = '?' in shareUrl ? '&' : '?' %}
                {% set embedUrl = embed_url|default(shareUrl ~ embedSeparator ~ 'share=embed') %}
                {% set embedUrlWithShare = 'share=' in embedUrl ? embedUrl : embedUrl ~ ('?' in embedUrl ? '&' : '?') ~ 'share=embed' %}
                {% set embedCode = '<iframe src="' ~ embedUrlWithShare ~ '" title="' ~ shareTitle ~ '" width="100%" height="100%" loading="lazy" referrerpolicy="no-referrer-when-downgrade" sandbox="allow-scripts allow-same-origin allow-forms allow-popups" style="width:100%;height:100%;aspect-ratio:16 / 9;border:1px solid #dbe4ee;border-radius:14px;"></iframe>' %}

                {# embed.html.twig #}
                {{ include('layout/embed.html.twig', { embedMode: 'builder' }) }}

                {# link.html.twig #}
                {{ include('layout/link.html.twig') }}
              </div>
            </article>
          </div>
        </section>
      </div>

      {{ include('layout/sidebar.html.twig') }}

    </div>
  </div>

{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script>
    {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/custom.js' ignore missing %}
  </script>
{% endblock %}
