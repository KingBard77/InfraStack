{# content.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ meta.title|default('Content') }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}

  <style>
    {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/custom.css' ignore missing %}
  </style>
{% endblock %}

{% block body %}

  {{ include('layout/breadcrumbs.html.twig') }}

  <div class="container">
    <div class="row">

      <div class="col-lg-8">
        <section id="blog-details" class="blog-details section">
          <div class="container" data-aos="fade-up">
            <article class="article">

              <div class="article-content" data-aos="fade-up" data-aos-delay="100">

                <div class="content-header">
                  <div class="title-meta mb-3">
                    {% if meta.category_label is defined and meta.category_label %}
                      <a href="#" class="category">{{ meta.category_label }}</a>
                    {% endif %}

                    {% if meta.reading_time is defined and meta.reading_time %}
                      <span class="divider">•</span>
                      <span class="reading-time">
                        <i class="bi bi-clock"></i> {{ meta.reading_time }}
                      </span>
                    {% endif %}
                  </div>

                  <h1 class="title">{{ meta.title }}</h1>

                  <div class="author-info">
                    <div class="author-details">
                      {% set authorImage = meta.author_image|default('') %}
                      {% set authorImageUrl = authorImage %}
                      {% if authorImage and authorImage is not same as('') and not (
                        authorImage starts with 'http://'
                        or authorImage starts with 'https://'
                        or authorImage starts with '//'
                        or authorImage starts with 'data:'
                      ) %}
                        {% set authorImageUrl = asset(authorImage|trim('/')) %}
                      {% endif %}

                      {% if authorImageUrl %}
                        <img src="{{ authorImageUrl }}" alt="{{ meta.author|default('Author') }}" class="author-img">
                      {% endif %}

                      <div class="info">
                        {% if meta.author is defined and meta.author %}
                          <h4>{{ meta.author }}</h4>
                        {% endif %}

                        {% if meta.author_role is defined and meta.author_role %}
                          <span class="role">{{ meta.author_role }}</span>
                        {% endif %}
                      </div>
                    </div>

                    <div class="post-meta">
                      {% if meta.date is defined and meta.date %}
                        <span class="date">
                          <i class="bi bi-calendar3"></i> {{ meta.date }}
                        </span>
                      {% endif %}

                      {% if meta.comments is defined and meta.comments %}
                        <span class="divider">•</span>
                        <span class="comments">
                          <i class="bi bi-chat-text"></i> {{ meta.comments }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </div>

                <div class="content">

                  {% if meta.intro is defined and meta.intro %}
                    <div class="tool-intro mb-4">
                      <p class="tool-main-description">{{ meta.intro }}</p>
                    </div>
                  {% endif %}

                  {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/tool.html.twig' ignore missing %}

                  <div class="markdown-content">
                    {{ content_html|raw }}
                  </div>
                </div>

                {% set shareUrl = article_url|default(app.request.uri) %}
                {% set shareTitle = article_title|default(meta.title|default('InfraStack Tool')) %}
                {% set shareSummary = article_summary|default(meta.summary|default('')) %}
                {% set shareText = shareSummary ? shareTitle ~ ' - ' ~ shareSummary : shareTitle %}
                {% set embedCode = '<iframe src="' ~ shareUrl ~ '" title="' ~ shareTitle ~ '" width="100%" height="720" loading="lazy" style="border:1px solid #dbe4ee;border-radius:14px;"></iframe>' %}

                <div class="meta-bottom article-share-panel">
                  {% if meta.tags is defined and meta.tags|length > 0 %}
                    <div class="tags-section">
                      <h4>Related Topics</h4>
                      <div class="tags">
                        {% for tag in meta.tags %}
                          <a
                            href="{{ path('app_category', { tag: tag }) }}"
                            class="tag"
                          >
                            {{ tag }}
                          </a>
                        {% endfor %}
                      </div>
                    </div>

                    <div class="article-share-divider"></div>
                  {% endif %}

                  <div class="share-section">
                    <h4>Share Article</h4>
                    <div class="share-actions" aria-label="Share article">
                      <a
                        href="https://twitter.com/intent/tweet?url={{ shareUrl|url_encode }}&text={{ shareTitle|url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="share-action"
                        aria-label="Share on X"
                      >
                        <i class="bi bi-twitter-x"></i>
                      </a>

                      <a
                        href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl|url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="share-action"
                        aria-label="Share on Facebook"
                      >
                        <i class="bi bi-facebook"></i>
                      </a>

                      <a
                        href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl|url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="share-action"
                        aria-label="Share on LinkedIn"
                      >
                        <i class="bi bi-linkedin"></i>
                      </a>

                      <a
                        href="https://api.whatsapp.com/send?text={{ shareText|url_encode }}%20{{ shareUrl|url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="share-action"
                        aria-label="Share on WhatsApp"
                      >
                        <i class="bi bi-whatsapp"></i>
                      </a>

                      <a
                        href="https://t.me/share/url?url={{ shareUrl|url_encode }}&text={{ shareTitle|url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="share-action"
                        aria-label="Share on Telegram"
                      >
                        <i class="bi bi-telegram"></i>
                      </a>

                      <a
                        href="https://www.reddit.com/submit?url={{ shareUrl|url_encode }}&title={{ shareTitle|url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="share-action"
                        aria-label="Share on Reddit"
                      >
                        <i class="bi bi-reddit"></i>
                      </a>

                      <a
                        href="mailto:?subject={{ shareTitle|url_encode }}&body={{ shareText|url_encode }}%0A%0A{{ shareUrl|url_encode }}"
                        class="share-action"
                        aria-label="Share by email"
                      >
                        <i class="bi bi-envelope"></i>
                      </a>

                      <button
                        type="button"
                        class="share-action"
                        data-share-copy
                        data-copy-value="{{ shareUrl }}"
                        aria-label="Copy article link"
                      >
                        <i class="bi bi-link-45deg"></i>
                      </button>

                      <button
                        type="button"
                        class="share-action share-action-embed"
                        data-share-copy
                        data-copy-value="{{ embedCode|e('html_attr') }}"
                        aria-label="Copy embed code"
                      >
                        <i class="bi bi-code-slash"></i>
                      </button>
                    </div>

                    <div class="embed-share-box">
                      <label for="article-embed-code">Embed this tool</label>
                      <div class="embed-share-control">
                        <input
                          id="article-embed-code"
                          type="text"
                          value="{{ embedCode }}"
                          readonly
                        >
                        <button
                          type="button"
                          data-share-copy
                          data-copy-value="{{ embedCode|e('html_attr') }}"
                        >
                          Copy Embed
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

              </div>

            </article>
          </div>
        </section>
      </div>

      {{ include('layout/sidebar.html.twig') }}

    </div>
  </div>

{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script>
    {% include 'content/tools/' ~ category ~ '/' ~ slug ~ '/custom.js' ignore missing %}
  </script>
{% endblock %}
