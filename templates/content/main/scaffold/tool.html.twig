{# tool.html.twig #}
<div class="__TOOL_CLASS__" data-tool-slug="__TOOL_SLUG__" data-tool-category="__CATEGORY_LABEL__">
  <div class="tool-box">
    <div class="tool-shell tool-prompt-shell">
      <div class="tool-shell-body __TOOL_SLUG__-prompt-grid">
        <div>
          <label for="__DOM_PREFIX__Prompt" class="tool-main-label">Visualizer prompt</label>
          <textarea id="__DOM_PREFIX__Prompt" class="form-control" rows="5" placeholder="Describe the architecture, topology, flow, or layout to visualize."></textarea>
          <p class="tool-helper-text">Use this prompt as the source brief, then refine the generated model with the controls below.</p>
        </div>

        <div class="__TOOL_SLUG__-prompt-actions">
          <button type="button" class="tool-action-btn tool-action-btn-primary" id="__DOM_PREFIX__Generate">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span data-button-label>Generate visualizer</span>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_PREFIX__Reset">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span data-button-label>Reset</span>
          </button>
        </div>
      </div>
    </div>

    <div class="tool-error-state" id="__DOM_PREFIX__ErrorState" hidden></div>

    <section class="tool-shell tool-inspector-shell" aria-labelledby="__DOM_PREFIX__ConfigTitle">
      <div class="tool-shell-header">
        <div>
          <h2 class="tool-shell-title" id="__DOM_PREFIX__ConfigTitle">Configuration</h2>
          <p class="tool-shell-subtitle">Start with basic controls, then open custom controls when the generated model needs more detail.</p>
        </div>
      </div>

      <div class="tool-shell-body">
        <div class="tool-inspector-section">
          <h3 class="__TOOL_SLUG__-section-title">Basic</h3>
          <div class="__TOOL_SLUG__-basic-grid">
            <div>
              <label class="tool-control-label" for="__DOM_PREFIX__Preset">Preset</label>
              <select id="__DOM_PREFIX__Preset" class="form-select">
                <option value="default">Default pattern</option>
              </select>
              <p class="tool-control-hint" id="__DOM_PREFIX__PresetDescription">Preset copy belongs in tool-local custom.js.</p>
            </div>

            <div>
              <label class="tool-control-label" for="__DOM_PREFIX__Scope">Scope</label>
              <input type="text" id="__DOM_PREFIX__Scope" class="form-control" value="default">
            </div>

            <div>
              <label class="tool-control-label" for="__DOM_PREFIX__Layout">Layout</label>
              <select id="__DOM_PREFIX__Layout" class="form-select">
                <option value="layered">Layered</option>
                <option value="flow">Flow</option>
                <option value="grid">Grid</option>
              </select>
            </div>
          </div>
        </div>

        <details class="__TOOL_SLUG__-custom-controls">
          <summary>
            <span>Custom controls</span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
          </summary>

          <div class="__TOOL_SLUG__-custom-controls-body">
            <div class="__TOOL_SLUG__-config-tabs" role="tablist" aria-label="Visualizer configuration">
              <button type="button" class="__TOOL_SLUG__-config-tab active" id="__DOM_PREFIX__ModelConfigTab" data-config-tab-target="__DOM_PREFIX__ModelConfigPanel" role="tab" aria-controls="__DOM_PREFIX__ModelConfigPanel" aria-selected="true" tabindex="0">Model</button>
              <button type="button" class="__TOOL_SLUG__-config-tab" id="__DOM_PREFIX__StyleConfigTab" data-config-tab-target="__DOM_PREFIX__StyleConfigPanel" role="tab" aria-controls="__DOM_PREFIX__StyleConfigPanel" aria-selected="false" tabindex="-1">Style</button>
              <button type="button" class="__TOOL_SLUG__-config-tab" id="__DOM_PREFIX__OutputConfigTab" data-config-tab-target="__DOM_PREFIX__OutputConfigPanel" role="tab" aria-controls="__DOM_PREFIX__OutputConfigPanel" aria-selected="false" tabindex="-1">Output</button>
            </div>

            <div class="tool-inspector-section __TOOL_SLUG__-config-panel active" id="__DOM_PREFIX__ModelConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__ModelConfigTab">
              <div class="__TOOL_SLUG__-internal-grid">
                <div>
                  <label class="tool-control-label" for="__DOM_PREFIX__ModelDepth">Model depth</label>
                  <select id="__DOM_PREFIX__ModelDepth" class="form-select">
                    <option value="compact">Compact</option>
                    <option value="standard">Standard</option>
                    <option value="detailed">Detailed</option>
                  </select>
                </div>
                <div>
                  <label class="tool-control-label" for="__DOM_PREFIX__Grouping">Grouping</label>
                  <select id="__DOM_PREFIX__Grouping" class="form-select">
                    <option value="logical">Logical</option>
                    <option value="placement">Placement</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="tool-inspector-section __TOOL_SLUG__-config-panel" id="__DOM_PREFIX__StyleConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__StyleConfigTab" hidden>
              <div class="__TOOL_SLUG__-internal-grid">
                <div>
                  <label class="tool-control-label" for="__DOM_PREFIX__Density">Density</label>
                  <select id="__DOM_PREFIX__Density" class="form-select">
                    <option value="balanced">Balanced</option>
                    <option value="compact">Compact</option>
                    <option value="wide">Wide</option>
                  </select>
                </div>
                <div>
                  <label class="tool-control-label" for="__DOM_PREFIX__ShowLabels">Labels</label>
                  <select id="__DOM_PREFIX__ShowLabels" class="form-select">
                    <option value="full">Full labels</option>
                    <option value="short">Short labels</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="tool-inspector-section __TOOL_SLUG__-config-panel" id="__DOM_PREFIX__OutputConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__OutputConfigTab" hidden>
              <div class="__TOOL_SLUG__-internal-grid">
                <div>
                  <label class="tool-control-label" for="__DOM_PREFIX__IncludeNotes">Prompt notes</label>
                  <select id="__DOM_PREFIX__IncludeNotes" class="form-select">
                    <option value="yes">Include notes</option>
                    <option value="no">Hide notes</option>
                  </select>
                </div>
                <div>
                  <label class="tool-control-label" for="__DOM_PREFIX__ExportName">Export name</label>
                  <input type="text" id="__DOM_PREFIX__ExportName" class="form-control" value="__TOOL_SLUG__">
                </div>
              </div>
            </div>
          </div>
        </details>

        <div class="tool-inspector-section" id="__DOM_PREFIX__SelectedShell">
          <h3 class="__TOOL_SLUG__-section-title">Selected item</h3>
          <p class="__TOOL_SLUG__-selected-empty" id="__DOM_PREFIX__SelectedEmpty">Select a stage item to edit persisted position or size.</p>

          <div class="__TOOL_SLUG__-selected-editor d-none" id="__DOM_PREFIX__SelectedEditor">
            <div class="__TOOL_SLUG__-selected-name" id="__DOM_PREFIX__SelectedName"></div>
            <div class="__TOOL_SLUG__-internal-grid">
              <div>
                <label class="tool-control-label" for="__DOM_PREFIX__SelectedX">X position</label>
                <input type="number" id="__DOM_PREFIX__SelectedX" class="form-control" min="0" step="4">
              </div>
              <div>
                <label class="tool-control-label" for="__DOM_PREFIX__SelectedY">Y position</label>
                <input type="number" id="__DOM_PREFIX__SelectedY" class="form-control" min="0" step="4">
              </div>
              <div>
                <label class="tool-control-label" for="__DOM_PREFIX__SelectedWidth">Width</label>
                <input type="number" id="__DOM_PREFIX__SelectedWidth" class="form-control" min="96" step="4">
              </div>
              <div>
                <label class="tool-control-label" for="__DOM_PREFIX__SelectedHeight">Height</label>
                <input type="number" id="__DOM_PREFIX__SelectedHeight" class="form-control" min="44" step="4">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-shell tool-stage-shell" id="__DOM_PREFIX__StageShell" aria-labelledby="__DOM_PREFIX__StageTitle">
      <div class="tool-shell-header __TOOL_SLUG__-stage-header">
        <div>
          <h2 class="tool-shell-title" id="__DOM_PREFIX__StageTitle">__TOOL_TITLE__</h2>
          <p class="tool-shell-subtitle" id="__DOM_PREFIX__StageSubtitle">Generate a visual model with editable controls and export-ready output.</p>
        </div>
        <div class="__TOOL_SLUG__-stage-meta" id="__DOM_PREFIX__StageMeta"></div>
      </div>

      <div class="tool-stage-toolbar">
        <div class="__TOOL_SLUG__-stage-toolbar-actions">
          <div class="__TOOL_SLUG__-zoom-control" id="__DOM_PREFIX__ZoomControl">
            <button type="button" class="__TOOL_SLUG__-zoom-step" id="__DOM_PREFIX__ZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" class="__TOOL_SLUG__-zoom-input" id="__DOM_PREFIX__ZoomInput" min="10" max="400" step="1" value="100" aria-label="Zoom percent">
            <span class="__TOOL_SLUG__-zoom-label" id="__DOM_PREFIX__ZoomLabel">100%</span>
            <button type="button" class="__TOOL_SLUG__-zoom-step" id="__DOM_PREFIX__ZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="__TOOL_SLUG__-stage-toolbar-btn" id="__DOM_PREFIX__ZoomFit">Fit</button>
          <button type="button" class="__TOOL_SLUG__-stage-toolbar-btn" id="__DOM_PREFIX__ZoomActual">100%</button>
          <button type="button" class="__TOOL_SLUG__-stage-toolbar-btn" id="__DOM_PREFIX__ZoomHideUi">Hide UI</button>
          <button type="button" class="__TOOL_SLUG__-stage-toolbar-btn" id="__DOM_PREFIX__Fullscreen">Fullscreen</button>
          <button type="button" class="__TOOL_SLUG__-stage-toolbar-btn" id="__DOM_PREFIX__ResetLayout">Reset layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="__DOM_PREFIX__StageEmpty">Generate a diagram to populate the visualizer stage.</div>
        <div class="tool-stage-canvas __TOOL_SLUG__-stage-canvas d-none" id="__DOM_PREFIX__StageCanvas"></div>

        <div class="__TOOL_SLUG__-stage-footer">
          <span class="tool-helper-chip">Prompt aware</span>
          <span class="tool-helper-chip">Editable stage</span>
          <span class="tool-helper-chip">SVG workspace</span>
          <span class="tool-helper-chip">JSON restore ready</span>
        </div>
      </div>
    </section>

    <section class="tool-shell tool-output-shell" aria-labelledby="__DOM_PREFIX__OutputTitle">
      <div class="tool-shell-header">
        <div>
          <h2 class="tool-shell-title" id="__DOM_PREFIX__OutputTitle">Output</h2>
          <p class="tool-shell-subtitle">Review the generated inventory, prompt notes, and restorable JSON state.</p>
        </div>
      </div>

      <div class="tool-shell-body">
        <div class="tool-empty-state" id="__DOM_PREFIX__OutputEmpty">Generate a visualizer model to populate the output panels.</div>

        <div class="__TOOL_SLUG__-output-content d-none" id="__DOM_PREFIX__OutputContent">
          <div class="__TOOL_SLUG__-output-status-card" id="__DOM_PREFIX__OutputStatus"></div>

          <div class="tool-output-toolbar">
            <div class="tool-output-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_PREFIX__ExportPng">Export PNG</button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_PREFIX__DownloadSvg">Download SVG</button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_PREFIX__CopyJson">Copy JSON</button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_PREFIX__DownloadJson">Download JSON</button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost" id="__DOM_PREFIX__ImportJsonButton">Import JSON</button>
            </div>
          </div>

          <div class="tool-tabs" role="tablist" aria-label="Visualizer output">
            <button type="button" class="tool-tab-btn active" id="__DOM_PREFIX__InventoryTab" data-output-tab-target="__DOM_PREFIX__InventoryPanel" role="tab" aria-controls="__DOM_PREFIX__InventoryPanel" aria-selected="true" tabindex="0">Inventory</button>
            <button type="button" class="tool-tab-btn" id="__DOM_PREFIX__PromptNotesTab" data-output-tab-target="__DOM_PREFIX__PromptNotesPanel" role="tab" aria-controls="__DOM_PREFIX__PromptNotesPanel" aria-selected="false" tabindex="-1">Prompt Notes</button>
            <button type="button" class="tool-tab-btn" id="__DOM_PREFIX__JsonTab" data-output-tab-target="__DOM_PREFIX__JsonPanel" role="tab" aria-controls="__DOM_PREFIX__JsonPanel" aria-selected="false" tabindex="-1">JSON</button>
          </div>

          <div class="tool-tab-panel active" id="__DOM_PREFIX__InventoryPanel" data-output-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__InventoryTab">
            <div class="__TOOL_SLUG__-inventory-panel">
              <table class="__TOOL_SLUG__-inventory-table">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Component</th>
                    <th scope="col">Placement</th>
                    <th scope="col">Purpose</th>
                  </tr>
                </thead>
                <tbody id="__DOM_PREFIX__InventoryTableBody"></tbody>
              </table>
            </div>
          </div>

          <div class="tool-tab-panel" id="__DOM_PREFIX__PromptNotesPanel" data-output-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__PromptNotesTab" hidden>
            <div class="__TOOL_SLUG__-prompt-notes-card" id="__DOM_PREFIX__PromptNotes">
              <h3 class="__TOOL_SLUG__-result-section-title">Prompt Notes</h3>
              <p class="__TOOL_SLUG__-note-copy" id="__DOM_PREFIX__PromptSummary"></p>
              <div class="__TOOL_SLUG__-note-grid">
                <div>
                  <h4 class="__TOOL_SLUG__-note-title">Detected keywords</h4>
                  <ul class="__TOOL_SLUG__-note-list" id="__DOM_PREFIX__KeywordList"></ul>
                </div>
                <div>
                  <h4 class="__TOOL_SLUG__-note-title">Applied assumptions</h4>
                  <ul class="__TOOL_SLUG__-note-list" id="__DOM_PREFIX__AssumptionList"></ul>
                </div>
              </div>
            </div>
          </div>

          <div class="tool-tab-panel" id="__DOM_PREFIX__JsonPanel" data-output-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__JsonTab" hidden>
            <div class="tool-json-shell">
              <div class="__TOOL_SLUG__-json-header">
                <span>Restorable state</span>
                <span>JSON preserves editable workspace state.</span>
              </div>
              <pre class="__TOOL_SLUG__-json-code" id="__DOM_PREFIX__JsonOutput"></pre>
            </div>
          </div>
        </div>
      </div>

      <input type="file" id="__DOM_PREFIX__ImportJson" class="d-none" accept="application/json">
    </section>
  </div>
</div>
