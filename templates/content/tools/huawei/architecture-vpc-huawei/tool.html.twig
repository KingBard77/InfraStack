{# tool.html.twig #}

<div class="architecture-vpc-huawei-tool" data-tool-slug="architecture-vpc-huawei" data-tool-category="huawei" data-tool-family="architecture" data-tool-canonical="architecture_vpc_huawei">
  <div class="tool-box">
    {# ns:start family.architecture.workspace.01_input-brief #}
    <section class="tool-shell tool-prompt-shell architecture-vpc-huawei-prompt-shell" id="architectureVpcHuaweiPromptShell" data-section="architecture-prompt" data-root-selector=".architecture-vpc-huawei-tool" aria-label="Huawei Cloud architecture prompt">
      <div class="tool-main-row">
        <label for="architectureVpcHuaweiPrompt" class="tool-main-label">Architecture prompt</label>
        <div class="tool-main-input-grid architecture-vpc-huawei-main-input-grid">
          <textarea
            id="architectureVpcHuaweiPrompt"
            class="form-control architecture-vpc-huawei-prompt"
            rows="5"
            placeholder="Describe the Huawei Cloud VPC, region, availability zones, subnet tiers, ingress path, workload runtime, data services, security, and hybrid connectivity."
          >Create a medium Huawei Cloud architecture across 3 availability zones. Use VPC CIDR 10.80.0.0/16 with public ingress subnet 10.80.0.0/24, private app subnet 10.80.10.0/24, and private data subnet 10.80.20.0/24. Add WAF and DNS, Elastic Load Balance, security groups, network ACLs, NAT Gateway egress, DEW KMS, CSMS, Cloud Eye and CTS, VPC flow logs, enterprise project prod-app, and edge protected ingress.</textarea>
        </div>
      </div>

      <p class="tool-control-hint architecture-vpc-huawei-prompt-hint">
        Use one brief prompt with workload scale, availability zones, VPC CIDR, subnet tiers, ingress, workload runtime, managed services, security controls, operations, and hybrid connectivity. Preset selection or Generate Architecture creates the editable workspace.
      </p>

      <div class="architecture-vpc-huawei-main-actions">
        <button type="button" class="tool-action-btn tool-action-btn-primary" id="architectureVpcHuaweiGenerate">
          <i class="bi bi-stars" aria-hidden="true"></i>
          <span data-button-label>Generate Architecture</span>
        </button>
        <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVpcHuaweiReset">
          <span data-button-label>Load Default</span>
        </button>
      </div>
    </section>
    {# ns:end family.architecture.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureVpcHuaweiErrorState" hidden></div>

    <section class="tool-shell tool-inspector-shell" id="architectureVpcHuaweiConfigShell" aria-labelledby="architectureVpcHuaweiConfigTitle">
      <div class="tool-shell-header">
        <div>
          <h2 class="tool-shell-title" id="architectureVpcHuaweiConfigTitle">Basic</h2>
        </div>
      </div>

      <div class="tool-shell-body">
        {# ns:start family.architecture.workspace.02_basic-settings #}
        <div class="tool-inspector-section architecture-vpc-huawei-basic-section" id="architectureVpcHuaweiBasicConfig" data-section="basic-tab" data-root-selector=".architecture-vpc-huawei-tool">
          <div class="architecture-vpc-huawei-basic-grid">
            <div class="architecture-vpc-huawei-control-stack">
              <label class="tool-control-label" for="architectureVpcHuaweiPreset">Preset</label>
              <select id="architectureVpcHuaweiPreset" class="form-select">
                <option value="secure-vpc-app" selected>Secure VPC App</option>
                <option value="openshift-platform">CCE Platform</option>
                <option value="data-services">Data Services</option>
                <option value="hybrid-connectivity">Hybrid Connectivity</option>
              </select>
            </div>

            <div class="architecture-vpc-huawei-control-stack">
              <label class="tool-control-label" for="architectureVpcHuaweiSize">Workload scale</label>
              <select id="architectureVpcHuaweiSize" class="form-select">
                <option value="small">Small</option>
                <option value="medium" selected>Medium</option>
                <option value="large">Large</option>
              </select>
            </div>

            <div class="architecture-vpc-huawei-control-stack">
              <label class="tool-control-label" for="architectureVpcHuaweiAccessBlocks">Availability zones</label>
              <select id="architectureVpcHuaweiAccessBlocks" class="form-select">
                <option value="1">1 zone</option>
                <option value="2">2 zones</option>
                <option value="3" selected>3 zones</option>
              </select>
            </div>
            <p class="tool-control-hint" id="architectureVpcHuaweiPresetDescription">WAF and DNS, public ingress, private app/data subnets, security groups, flow logs, and monitored operations.</p>
          </div>
        </div>
        {# ns:end family.architecture.workspace.02_basic-settings #}

        {# ns:start family.architecture.workspace.03_advanced-settings #}
        <details class="architecture-vpc-huawei-custom-panel" id="architectureVpcHuaweiCustomControls" data-section="custom-tab" data-root-selector=".architecture-vpc-huawei-tool">
          <summary class="architecture-vpc-huawei-custom-panel-summary">
            <span>Custom</span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
          </summary>

          <div class="architecture-vpc-huawei-custom-panel-body">
            <div class="architecture-vpc-huawei-config-tabs" role="tablist" aria-label="Huawei Cloud custom configuration">
              <button type="button" class="architecture-vpc-huawei-config-tab active" id="architectureVpcHuaweiNetworkTab" data-config-tab-target="architectureVpcHuaweiNetworkPanel" role="tab" aria-controls="architectureVpcHuaweiNetworkPanel" aria-selected="true" tabindex="0">Network</button>
              <button type="button" class="architecture-vpc-huawei-config-tab" id="architectureVpcHuaweiServicesTab" data-config-tab-target="architectureVpcHuaweiServicesPanel" role="tab" aria-controls="architectureVpcHuaweiServicesPanel" aria-selected="false" tabindex="-1">Services</button>
              <button type="button" class="architecture-vpc-huawei-config-tab" id="architectureVpcHuaweiSecurityTab" data-config-tab-target="architectureVpcHuaweiSecurityPanel" role="tab" aria-controls="architectureVpcHuaweiSecurityPanel" aria-selected="false" tabindex="-1">Security</button>
            </div>

            <div class="tool-inspector-section architecture-vpc-huawei-config-panel active" id="architectureVpcHuaweiNetworkPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVpcHuaweiNetworkTab">
              <div class="architecture-vpc-huawei-config-grid">
                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiRouting">Connectivity pattern</label>
                  <select id="architectureVpcHuaweiRouting" class="form-select">
                    <option value="public-private">Public/private tiers</option>
                    <option value="private-only">Private endpoint only</option>
                    <option value="hybrid">Hybrid connectivity</option>
                    <option value="edge-protected" selected>Edge protected ingress</option>
                  </select>
                </div>

                <div class="architecture-vpc-huawei-control-stack architecture-vpc-huawei-vlan-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiVlans">Subnet tiers</label>
                  <textarea id="architectureVpcHuaweiVlans" class="form-control architecture-vpc-huawei-vlan-input">Public ingress subnet 10.80.0.0/24
Private app subnet 10.80.10.0/24
Private data subnet 10.80.20.0/24</textarea>
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiTrunkVlans">VPC CIDR</label>
                  <input type="text" id="architectureVpcHuaweiTrunkVlans" class="form-control" value="10.80.0.0/16">
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiNativeVlan">Public subnet CIDR</label>
                  <input type="text" id="architectureVpcHuaweiNativeVlan" class="form-control" value="10.80.0.0/24">
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiAccessVlan">Private app subnet CIDR</label>
                  <input type="text" id="architectureVpcHuaweiAccessVlan" class="form-control" value="10.80.10.0/24">
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiSviGateway">Data subnet CIDR</label>
                  <input type="text" id="architectureVpcHuaweiSviGateway" class="form-control" value="10.80.20.0/24">
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiOspfArea">Enterprise project</label>
                  <input type="text" id="architectureVpcHuaweiOspfArea" class="form-control" value="prod-app">
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiBgpAsn">Edge ASN</label>
                  <input type="text" id="architectureVpcHuaweiBgpAsn" class="form-control" value="64520">
                </div>

                <div class="architecture-vpc-huawei-control-stack">
                  <label class="tool-control-label" for="architectureVpcHuaweiRedundancyVip">DNS zone</label>
                  <input type="text" id="architectureVpcHuaweiRedundancyVip" class="form-control" value="app.example.com">
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-vpc-huawei-config-panel" id="architectureVpcHuaweiServicesPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVpcHuaweiServicesTab" hidden>
              <div class="architecture-vpc-huawei-toggle-grid">
                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">CCE</span>
                  <input type="checkbox" id="architectureVpcHuaweiWireless">
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">Security groups / ACLs</span>
                  <input type="checkbox" id="architectureVpcHuaweiFirewall" checked>
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">Enterprise Router</span>
                  <input type="checkbox" id="architectureVpcHuaweiWan">
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">Cloud Eye / CTS</span>
                  <input type="checkbox" id="architectureVpcHuaweiMonitoring" checked>
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">DEW KMS / CSMS</span>
                  <input type="checkbox" id="architectureVpcHuaweiDhcpDns" checked>
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">WAF and DNS</span>
                  <input type="checkbox" id="architectureVpcHuaweiHsrp" checked>
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">Elastic Load Balance</span>
                  <input type="checkbox" id="architectureVpcHuaweiEtherChannel" checked>
                </label>
              </div>
            </div>

            <div class="tool-inspector-section architecture-vpc-huawei-config-panel" id="architectureVpcHuaweiSecurityPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVpcHuaweiSecurityTab" hidden>
              <div class="architecture-vpc-huawei-toggle-grid">
                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">VPC flow logs</span>
                  <input type="checkbox" id="architectureVpcHuaweiAcl" checked>
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">NAT Gateway egress</span>
                  <input type="checkbox" id="architectureVpcHuaweiNat" checked>
                </label>

                <label class="architecture-vpc-huawei-toggle-item">
                  <span class="architecture-vpc-huawei-toggle-copy">Direct Connect / VPN</span>
                  <input type="checkbox" id="architectureVpcHuaweiVpn">
                </label>
              </div>
            </div>
          </div>
        </details>
        {# ns:end family.architecture.workspace.03_advanced-settings #}

        {# ns:start family.architecture.workspace.04_selected-item #}
        <div class="tool-inspector-section architecture-vpc-huawei-selected-section" id="architectureVpcHuaweiSelectedShell" data-section="selected-item" data-root-selector=".architecture-vpc-huawei-tool">
          <h3 class="architecture-vpc-huawei-section-title">Selected item</h3>
          <p class="architecture-vpc-huawei-selected-empty architecture-vpc-huawei-selected-empty-chips" id="architectureVpcHuaweiSelectedEmpty" aria-label="Select a node or boundary box to move, resize, or highlight it. Arrow keys move the selected item; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
            <span class="architecture-vpc-huawei-selected-empty-copy">
              <span class="architecture-vpc-huawei-selected-hint-chip architecture-vpc-huawei-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a node or boundary box</span>
              <span class="architecture-vpc-huawei-selected-hint-chip architecture-vpc-huawei-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
              <span class="architecture-vpc-huawei-selected-hint-chip architecture-vpc-huawei-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected item</span>
              <span class="architecture-vpc-huawei-selected-hint-chip architecture-vpc-huawei-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
              <span class="architecture-vpc-huawei-selected-hint-chip architecture-vpc-huawei-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
              <span class="architecture-vpc-huawei-selected-hint-chip architecture-vpc-huawei-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
            </span>
          </p>

          <div class="architecture-vpc-huawei-selected-editor d-none" id="architectureVpcHuaweiSelectedEditor">
            <div class="architecture-vpc-huawei-selected-name" id="architectureVpcHuaweiSelectedName"></div>

            <div class="architecture-vpc-huawei-selected-grid">
              <div class="architecture-vpc-huawei-control-stack">
                <label class="tool-control-label" for="architectureVpcHuaweiSelectedX">X position</label>
                <input type="number" id="architectureVpcHuaweiSelectedX" class="form-control" min="0" step="4">
              </div>

              <div class="architecture-vpc-huawei-control-stack">
                <label class="tool-control-label" for="architectureVpcHuaweiSelectedY">Y position</label>
                <input type="number" id="architectureVpcHuaweiSelectedY" class="form-control" min="0" step="4">
              </div>

              <div class="architecture-vpc-huawei-control-stack">
                <label class="tool-control-label" for="architectureVpcHuaweiSelectedWidth">Width</label>
                <input type="number" id="architectureVpcHuaweiSelectedWidth" class="form-control" min="120" step="4">
              </div>

              <div class="architecture-vpc-huawei-control-stack">
                <label class="tool-control-label" for="architectureVpcHuaweiSelectedHeight">Height</label>
                <input type="number" id="architectureVpcHuaweiSelectedHeight" class="form-control" min="58" step="4">
              </div>
            </div>

            <div class="architecture-vpc-huawei-selected-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVpcHuaweiHighlightNode">
                <i class="bi bi-highlighter" aria-hidden="true"></i>
                <span data-button-label>Highlight</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVpcHuaweiApplyNode">
                <i class="bi bi-check2" aria-hidden="true"></i>
                <span data-button-label>Apply</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureVpcHuaweiResetNode">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                <span data-button-label>Reset</span>
              </button>
            </div>
          </div>
        </div>
        {# ns:end family.architecture.workspace.04_selected-item #}
      </div>
    </section>

    <section class="tool-shell tool-stage-shell architecture-vpc-huawei-stage-shell" id="architectureVpcHuaweiStageShell" data-section="diagram-buttons" data-root-selector=".architecture-vpc-huawei-tool" aria-labelledby="architectureVpcHuaweiStageTitle">
      {# ns:start family.architecture.workspace.05_result-text #}
      <div class="tool-shell-header architecture-vpc-huawei-stage-header" id="architectureVpcHuaweiStageHeader" data-section="title" data-root-selector=".architecture-vpc-huawei-tool">
        <div class="architecture-vpc-huawei-stage-heading">
          <h2 class="tool-shell-title" id="architectureVpcHuaweiStageTitle">Huawei Cloud VPC Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureVpcHuaweiStageSubtitle">
            <span class="architecture-vpc-huawei-stage-preset-chip">Secure VPC App preset</span>
          </p>
        </div>
        <div class="architecture-vpc-huawei-stage-meta" id="architectureVpcHuaweiStageMeta"></div>
      </div>
      {# ns:end family.architecture.workspace.05_result-text #}

      {# ns:start family.architecture.workspace.06_result-diagram #}
      <div class="tool-stage-toolbar">
        <div class="architecture-vpc-huawei-stage-toolbar-actions">
          <div class="architecture-vpc-huawei-zoom-control" id="architectureVpcHuaweiZoomControl">
            <button type="button" class="architecture-vpc-huawei-zoom-step" id="architectureVpcHuaweiZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="architectureVpcHuaweiZoomInput" class="architecture-vpc-huawei-zoom-input" value="50" min="15" max="240" step="1" aria-label="Zoom percentage">
            <span class="architecture-vpc-huawei-zoom-label" id="architectureVpcHuaweiZoomLabel">%</span>
            <button type="button" class="architecture-vpc-huawei-zoom-step" id="architectureVpcHuaweiZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="architecture-vpc-huawei-icon-btn" id="architectureVpcHuaweiZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-huawei-icon-btn" id="architectureVpcHuaweiZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="architecture-vpc-huawei-icon-btn" id="architectureVpcHuaweiUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-huawei-icon-btn" id="architectureVpcHuaweiHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false">
            <i class="bi bi-bounding-box" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-huawei-icon-btn" id="architectureVpcHuaweiZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-huawei-icon-btn" id="architectureVpcHuaweiFullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-vpc-huawei-stage-toolbar-btn" id="architectureVpcHuaweiResetLayout">Reset layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="architectureVpcHuaweiStageEmpty">Choose a preset to generate diagram.</div>
        <div class="tool-stage-canvas architecture-vpc-huawei-stage-canvas d-none" id="architectureVpcHuaweiStageCanvas"></div>
      </div>

      <div class="architecture-vpc-huawei-stage-footer">
        <div class="architecture-vpc-huawei-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" title="Prompt and preset aware" aria-label="Prompt and preset aware" tabindex="0">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span class="architecture-vpc-huawei-visually-hidden">Prompt and preset aware</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-inspector" title="Editable inspector controls" aria-label="Editable inspector controls" tabindex="0">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            <span class="architecture-vpc-huawei-visually-hidden">Editable inspector controls</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-drag" title="Drag nodes or boundary boxes to customize layout" aria-label="Drag nodes or boundary boxes to customize layout" tabindex="0">
            <i class="bi bi-arrows-move" aria-hidden="true"></i>
            <span class="architecture-vpc-huawei-visually-hidden">Drag nodes or boundary boxes to customize layout</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-svg" title="SVG workspace" aria-label="SVG workspace" tabindex="0">
            <i class="bi bi-bezier2" aria-hidden="true"></i>
            <span class="architecture-vpc-huawei-visually-hidden">SVG workspace</span>
          </span>
          <button type="button" class="tool-helper-chip tool-helper-chip-keyboard" id="architectureVpcHuaweiUsageHelpButton" title="Keyboard shortcuts and usage" aria-label="Open keyboard help" aria-controls="architectureVpcHuaweiUsageHelpPopup" aria-expanded="false">
            <i class="bi bi-keyboard" aria-hidden="true"></i>
            <span class="architecture-vpc-huawei-visually-hidden">Keyboard Help</span>
          </button>
        </div>
      </div>

      <div class="architecture-vpc-huawei-usage-overlay d-none" id="architectureVpcHuaweiUsageHelpPopup" role="dialog" aria-modal="false" aria-labelledby="architectureVpcHuaweiUsageHelpTitle">
        <div class="architecture-vpc-huawei-usage-card">
          <button type="button" class="architecture-vpc-huawei-usage-close" id="architectureVpcHuaweiUsageHelpClose" aria-label="Close keyboard help">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>

          <h3 class="architecture-vpc-huawei-usage-title" id="architectureVpcHuaweiUsageHelpTitle">Diagram Controls</h3>
          <p class="architecture-vpc-huawei-usage-copy">Select a box in the diagram, then adjust it without leaving the stage.</p>

          <div class="architecture-vpc-huawei-usage-panel">Hold the selected box in place visually while you tune layout, size, and zoom.</div>

          <div class="architecture-vpc-huawei-usage-divider"></div>

          <div class="architecture-vpc-huawei-usage-list" aria-label="Keyboard and pointer controls">
            <div class="architecture-vpc-huawei-usage-row">
              <span class="architecture-vpc-huawei-usage-keys">
                <kbd>&larr;</kbd>
                <kbd>&uarr;</kbd>
                <kbd>&darr;</kbd>
                <kbd>&rarr;</kbd>
              </span>
              <span>move selected box</span>
            </div>
            <div class="architecture-vpc-huawei-usage-row">
              <span class="architecture-vpc-huawei-usage-keys">
                <kbd>Shift</kbd>
                <kbd>+</kbd>
                <kbd>Arrows</kbd>
              </span>
              <span>move faster</span>
            </div>
            <div class="architecture-vpc-huawei-usage-row">
              <span class="architecture-vpc-huawei-usage-keys">
                <kbd>Alt</kbd>
                <kbd>+</kbd>
                <kbd>Arrows</kbd>
              </span>
              <span>resize selected box</span>
            </div>
            <div class="architecture-vpc-huawei-usage-row">
              <span class="architecture-vpc-huawei-usage-keys">
                <kbd>Mouse</kbd>
                <kbd>Drag</kbd>
              </span>
              <span>reposition box</span>
            </div>
            <div class="architecture-vpc-huawei-usage-row">
              <span class="architecture-vpc-huawei-usage-keys">
                <kbd>Cmd / Ctrl</kbd>
