{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.architecture-vnet-azure-post-visual {
    --post-start: #2563EB;
    --post-end: #06B6D4;
    --post-accent: #06B6D4;
}

.architecture-vnet-azure-post-visual .tool-post-node:nth-child(1),
.architecture-vnet-azure-post-visual .tool-post-node:nth-child(3),
.architecture-vnet-azure-post-visual .tool-post-node:nth-child(5) {
    background: rgba(255, 255, 255, 0.18);
}

.architecture-vnet-azure-post-visual .tool-post-icon {
    background: rgba(6, 182, 212, 0.24);
}
</style>
{% else %}
<div
  class="tool-post-visual architecture-vnet-azure-post-visual tool-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#2563EB') }}; --post-end: {{ post.card_gradient_end|default('#06B6D4') }};"
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="bi bi-cloud-check"></i>
    <i class="bi bi-diagram-3"></i>
    <i class="bi bi-hdd-network"></i>
    <i class="bi bi-boxes"></i>
    <i class="bi bi-globe2"></i>
  </div>
  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('Azure')) }}</span>
    <span class="tool-post-icon"><i class="{{ post.card_icon_class|default('bi bi-diagram-3') }}"></i></span>
  </div>
  <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('Azure VNet Architecture')) }}</div>
  <div class="tool-post-map" aria-hidden="true">
    <span class="tool-post-node"><i class="bi bi-cloud-check"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-boxes"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-hdd-network"></i></span>
  </div>
  <div class="tool-post-footer">
    <span>{{ post.reading_time|default('4 min read') }}</span>
    <span>{{ post.category|default('Azure') }}</span>
  </div>
  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-chevron-down"></i> {{ post.date_display|default('Apr. 18th, 2026') }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('Azure') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('4 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('Azure VNet Architecture') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
