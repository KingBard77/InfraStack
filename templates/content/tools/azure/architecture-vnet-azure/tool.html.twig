{# tool.html.twig #}

<div class="architecture-vnet-azure-tool">
  <div class="tool-box">
    {# ns:start family.architecture.workspace.01_input-brief #}
    <div class="tool-shell tool-prompt-shell">
      <div class="tool-main-row">
        <label for="architectureVnetAzurePrompt" class="tool-main-label">Architecture prompt</label>
        <div class="tool-main-input-grid architecture-vnet-azure-main-input-grid">
          <textarea
            id="architectureVnetAzurePrompt"
            class="form-control architecture-vnet-azure-prompt"
            placeholder="Describe the Azure VNet layout, region, availability zones, ingress path, workload tier, data tier, and supporting services."
          >Create an Azure VNet architecture in eastus with 2 availability zones. Use public subnets for an internet-facing Application Gateway, private app subnets for Virtual Machine Scale Sets, and private data subnets for Azure SQL. Add a single NAT gateway, Private Endpoints for Blob Storage and Key Vault, Azure Monitor, and NSG flow logs.</textarea>

        </div>
      </div>

      <p class="tool-control-hint architecture-vnet-azure-prompt-hint">
        Use one brief prompt with region, AZ count, ingress, private tiers, and supporting Azure services. Presets below can prefill and instantly generate a working layout.
      </p>

      <div class="architecture-vnet-azure-main-actions">
        <button type="button" class="tool-action-btn tool-action-btn-primary" id="architectureVnetAzureGenerate">
          <i class="bi bi-stars" aria-hidden="true"></i>
          <span>Generate Diagram</span>
        </button>
        <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVnetAzureReset">Load Default</button>
      </div>
    </div>
    {# ns:end family.architecture.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureVnetAzureErrorState"></div>

    <div class="architecture-vnet-azure-advanced-grid">
      <aside class="tool-shell tool-inspector-shell">
        <div class="tool-shell-header">
          <div>
            <h2 class="tool-shell-title">Basic</h2>
          </div>
        </div>

        <div class="tool-shell-body">
          {# ns:start family.architecture.workspace.02_basic-settings #}
          <div class="tool-inspector-section architecture-vnet-azure-basic-preset-section">
            <div class="architecture-vnet-azure-basic-grid">
              <div class="architecture-vnet-azure-control-stack">
                <label class="tool-control-label" for="architectureVnetAzurePreset">Preset</label>
                <select id="architectureVnetAzurePreset" class="form-select">
                  <option value="three-tier-web" selected>3-Tier Web</option>
                  <option value="ecs-fargate">Azure Container Apps</option>
                  <option value="eks-platform">Private AKS</option>
                  <option value="hybrid-shared">Hybrid Shared Services</option>
                </select>
              </div>

              <div class="architecture-vnet-azure-control-stack">
                <label class="tool-control-label" for="architectureVnetAzureRegion">Region</label>
                <select id="architectureVnetAzureRegion" class="form-select">
                  <option value="eastus">eastus</option>
                  <option value="eastus2">eastus2</option>
                  <option value="centralus">centralus</option>
                  <option value="westus2">westus2</option>
                  <option value="westeurope">westeurope</option>
                  <option value="southeastasia">southeastasia</option>
                  <option value="australiaeast">australiaeast</option>
                </select>
              </div>

              <div class="architecture-vnet-azure-control-stack">
                <label class="tool-control-label" for="architectureVnetAzureAzCount">Availability zones</label>
                <select id="architectureVnetAzureAzCount" class="form-select">
                  <option value="1">1 AZ</option>
                  <option value="2" selected>2 AZ</option>
                  <option value="3">3 AZ</option>
                </select>
              </div>
              <p class="tool-control-hint" id="architectureVnetAzurePresetDescription">Public App Gateway, private VM scale sets, Azure SQL, single NAT.</p>
            </div>
          </div>
          {# ns:end family.architecture.workspace.02_basic-settings #}

          {# ns:start family.architecture.workspace.03_advanced-settings #}
          <details class="architecture-vnet-azure-custom-panel">
            <summary class="architecture-vnet-azure-custom-panel-summary">
              <span>Custom</span>
              <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>

            <div class="architecture-vnet-azure-custom-panel-body">
              <div class="architecture-vnet-azure-config-tabs" role="tablist" aria-label="Azure VNet custom configuration">
                <button type="button" class="architecture-vnet-azure-config-tab active" id="architectureVnetAzureNetworkConfigTab" data-config-tab-target="architectureVnetAzureNetworkConfigPanel" role="tab" aria-controls="architectureVnetAzureNetworkConfigPanel" aria-selected="true" tabindex="0">Network layout</button>
                <button type="button" class="architecture-vnet-azure-config-tab" id="architectureVnetAzureWorkloadConfigTab" data-config-tab-target="architectureVnetAzureWorkloadConfigPanel" role="tab" aria-controls="architectureVnetAzureWorkloadConfigPanel" aria-selected="false" tabindex="-1">Workload</button>
                <button type="button" class="architecture-vnet-azure-config-tab" id="architectureVnetAzureServicesConfigTab" data-config-tab-target="architectureVnetAzureServicesConfigPanel" role="tab" aria-controls="architectureVnetAzureServicesConfigPanel" aria-selected="false" tabindex="-1">Services and controls</button>
              </div>

              <div class="tool-inspector-section architecture-vnet-azure-config-panel active" id="architectureVnetAzureNetworkConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVnetAzureNetworkConfigTab">
                <div class="architecture-vnet-azure-config-grid">
                  <div class="architecture-vnet-azure-control-stack">
                    <label class="tool-control-label" for="architectureVnetAzureCidr">VNet CIDR</label>
                    <input type="text" id="architectureVnetAzureCidr" class="form-control" value="10.0.0.0/16">
                  </div>

                  <div class="architecture-vnet-azure-control-stack">
                    <label class="tool-control-label" for="architectureVnetAzureNatMode">NAT mode</label>
                    <select id="architectureVnetAzureNatMode" class="form-select">
                      <option value="none">No NAT</option>
                      <option value="single" selected>Single NAT</option>
                      <option value="per-az">One per AZ</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section architecture-vnet-azure-config-panel" id="architectureVnetAzureWorkloadConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVnetAzureWorkloadConfigTab" hidden>
                <div class="architecture-vnet-azure-config-grid">
                  <div class="architecture-vnet-azure-control-stack">
                    <label class="tool-control-label" for="architectureVnetAzureAppTier">App tier</label>
                    <select id="architectureVnetAzureAppTier" class="form-select">
                      <option value="ec2">Virtual Machine Scale Sets</option>
                      <option value="ecs">Azure Container Apps</option>
                      <option value="eks">AKS</option>
                      <option value="lambda">Azure Functions in VNet</option>
                    </select>
                  </div>

                  <div class="architecture-vnet-azure-control-stack">
                    <label class="tool-control-label" for="architectureVnetAzureDatabase">Database tier</label>
                    <select id="architectureVnetAzureDatabase" class="form-select">
                      <option value="none">No database tier</option>
                      <option value="rds" selected>Azure SQL</option>
                      <option value="aurora">Azure Database for PostgreSQL</option>
                      <option value="dynamodb">Azure Cosmos DB</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section architecture-vnet-azure-config-panel" id="architectureVnetAzureServicesConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVnetAzureServicesConfigTab" hidden>
                <div class="architecture-vnet-azure-toggle-grid">
                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Azure DNS</span>
                    <input type="checkbox" id="architectureVnetAzureRoute53" checked>
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Azure Front Door</span>
                    <input type="checkbox" id="architectureVnetAzureCloudFront">
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Azure WAF</span>
                    <input type="checkbox" id="architectureVnetAzureWaf">
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Application Gateway</span>
                    <input type="checkbox" id="architectureVnetAzureAlb" checked>
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Azure Bastion</span>
                    <input type="checkbox" id="architectureVnetAzureBastion">
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Private Endpoints</span>
                    <input type="checkbox" id="architectureVnetAzureEndpoints" checked>
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">NSG flow logs</span>
                    <input type="checkbox" id="architectureVnetAzureFlowLogs" checked>
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Azure Monitor</span>
                    <input type="checkbox" id="architectureVnetAzureCloudWatch" checked>
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">VPN Gateway</span>
                    <input type="checkbox" id="architectureVnetAzureSiteToSiteVpn">
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Virtual WAN</span>
                    <input type="checkbox" id="architectureVnetAzureTransitGateway">
                  </label>

                  <label class="architecture-vnet-azure-toggle-item">
                    <span class="architecture-vnet-azure-toggle-copy">Azure Cache for Redis</span>
                    <input type="checkbox" id="architectureVnetAzureCache">
                  </label>
                </div>
              </div>

            </div>
          </details>
          {# ns:end family.architecture.workspace.03_advanced-settings #}

          {# ns:start family.architecture.workspace.04_selected-item #}
          <div class="tool-inspector-section architecture-vnet-azure-selected-section" id="architectureVnetAzureSelectedShell">
            <h3 class="architecture-vnet-azure-section-title">Selected item</h3>

            <p class="architecture-vnet-azure-selected-empty architecture-vnet-azure-selected-empty-chips" id="architectureVnetAzureSelectedEmpty" aria-label="Select a draggable box in the stage to move, resize, or highlight it. Arrow keys move the selected box; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
              <span class="architecture-vnet-azure-selected-empty-copy">
                <span class="architecture-vnet-azure-selected-hint-chip architecture-vnet-azure-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a draggable box</span>
                <span class="architecture-vnet-azure-selected-hint-chip architecture-vnet-azure-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
                <span class="architecture-vnet-azure-selected-hint-chip architecture-vnet-azure-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected box</span>
                <span class="architecture-vnet-azure-selected-hint-chip architecture-vnet-azure-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
                <span class="architecture-vnet-azure-selected-hint-chip architecture-vnet-azure-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
                <span class="architecture-vnet-azure-selected-hint-chip architecture-vnet-azure-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
              </span>
            </p>

            <div class="architecture-vnet-azure-selected-editor d-none" id="architectureVnetAzureSelectedEditor">
              <div class="architecture-vnet-azure-selected-name" id="architectureVnetAzureSelectedName"></div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVnetAzureSelectedX">X position</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVnetAzureSelectedX" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVnetAzureSelectedY">Y position</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVnetAzureSelectedY" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVnetAzureSelectedWidth">Width</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVnetAzureSelectedWidth" class="form-control" min="96" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVnetAzureSelectedHeight">Height</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVnetAzureSelectedHeight" class="form-control" min="44" step="4">
                </div>
              </div>

              <div class="architecture-vnet-azure-selected-actions">
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVnetAzureHighlightCard">Highlight box</button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVnetAzureApplyCardSize">Apply item</button>
                <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureVnetAzureResetCardSize">Reset item</button>
              </div>
            </div>
          </div>
          {# ns:end family.architecture.workspace.04_selected-item #}
        </div>
      </aside>
    </div>

    <section class="tool-shell tool-stage-shell" id="architectureVnetAzureStageShell" data-section="diagram-buttons" data-root-selector=".architecture-vnet-azure-tool">
      {# ns:start family.architecture.workspace.05_result-text #}
      <div class="tool-shell-header architecture-vnet-azure-stage-header" data-section="title" data-root-selector=".architecture-vnet-azure-tool">
        <div class="architecture-vnet-azure-stage-heading">
          <h2 class="tool-shell-title" id="architectureVnetAzureStageTitle">Azure VNet Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureVnetAzureStageSubtitle">
            <span class="architecture-vnet-azure-stage-preset-chip">3-Tier Web preset</span>
          </p>
        </div>
        <div class="architecture-vnet-azure-stage-meta" id="architectureVnetAzureStageMeta"></div>
      </div>
      {# ns:end family.architecture.workspace.05_result-text #}

      {# ns:start family.architecture.workspace.06_result-diagram #}
      <div class="tool-stage-toolbar">
        <div class="architecture-vnet-azure-stage-toolbar-actions">
          <div class="architecture-vnet-azure-zoom-control" id="architectureVnetAzureZoomControl">
            <button type="button" class="architecture-vnet-azure-zoom-step" id="architectureVnetAzureZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="architectureVnetAzureZoomInput" class="architecture-vnet-azure-zoom-input" value="50" min="15" max="240" step="1" aria-label="Zoom percentage">
            <span class="architecture-vnet-azure-zoom-label" id="architectureVnetAzureZoomLabel">%</span>
            <button type="button" class="architecture-vnet-azure-zoom-step" id="architectureVnetAzureZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="architecture-vnet-azure-icon-btn" id="architectureVnetAzureZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vnet-azure-icon-btn" id="architectureVnetAzureZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="architecture-vnet-azure-icon-btn" id="architectureVnetAzureUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vnet-azure-icon-btn" id="architectureVnetAzureHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false">
            <i class="bi bi-bounding-box" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vnet-azure-icon-btn" id="architectureVnetAzureZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vnet-azure-icon-btn" id="architectureVnetAzureFullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-vnet-azure-stage-toolbar-btn" id="architectureVnetAzureResetLayout">Reset layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="architectureVnetAzureStageEmpty">Choose a preset to generate diagram.</div>
        <div class="tool-stage-canvas architecture-vnet-azure-stage-canvas d-none" id="architectureVnetAzureStageCanvas"></div>
      </div>

      <div class="architecture-vnet-azure-stage-footer">
        <div class="architecture-vnet-azure-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" title="Prompt and preset aware" aria-label="Prompt and preset aware" tabindex="0">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span class="architecture-vnet-azure-visually-hidden">Prompt and preset aware</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-inspector" title="Editable inspector controls" aria-label="Editable inspector controls" tabindex="0">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            <span class="architecture-vnet-azure-visually-hidden">Editable inspector controls</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-drag" title="Drag boxes to customize layout" aria-label="Drag boxes to customize layout" tabindex="0">
            <i class="bi bi-arrows-move" aria-hidden="true"></i>
            <span class="architecture-vnet-azure-visually-hidden">Drag boxes to customize layout</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-svg" title="SVG workspace" aria-label="SVG workspace" tabindex="0">
            <i class="bi bi-bezier2" aria-hidden="true"></i>
            <span class="architecture-vnet-azure-visually-hidden">SVG workspace</span>
          </span>
          <button type="button" class="tool-helper-chip tool-helper-chip-keyboard" id="architectureVnetAzureUsageHelpButton" title="Keyboard shortcuts and usage" aria-label="Open keyboard help" aria-controls="architectureVnetAzureUsageHelpPopup" aria-expanded="false">
            <i class="bi bi-keyboard" aria-hidden="true"></i>
            <span class="architecture-vnet-azure-visually-hidden">Keyboard Help</span>
          </button>
        </div>
      </div>

      <div class="architecture-vnet-azure-usage-overlay d-none" id="architectureVnetAzureUsageHelpPopup" role="dialog" aria-modal="false" aria-labelledby="architectureVnetAzureUsageHelpTitle">
        <div class="architecture-vnet-azure-usage-card">
          <button type="button" class="architecture-vnet-azure-usage-close" id="architectureVnetAzureUsageHelpClose" aria-label="Close keyboard help">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>

          <h3 class="architecture-vnet-azure-usage-title" id="architectureVnetAzureUsageHelpTitle">Diagram Controls</h3>
          <p class="architecture-vnet-azure-usage-copy">Select a box in the diagram, then adjust it without leaving the stage.</p>

          <div class="architecture-vnet-azure-usage-panel">Hold the selected box in place visually while you tune layout, size, and zoom.</div>

          <div class="architecture-vnet-azure-usage-divider"></div>

          <div class="architecture-vnet-azure-usage-list" aria-label="Keyboard and pointer controls">
            <div class="architecture-vnet-azure-usage-row">
              <span class="architecture-vnet-azure-usage-keys">
                <kbd>←</kbd>
                <kbd>↑</kbd>
                <kbd>↓</kbd>
                <kbd>→</kbd>
              </span>
              <span>move selected box</span>
            </div>
            <div class="architecture-vnet-azure-usage-row">
              <span class="architecture-vnet-azure-usage-keys">
                <kbd>Shift</kbd>
                <kbd>+</kbd>
                <kbd>Arrows</kbd>
              </span>
              <span>move faster</span>
            </div>
            <div class="architecture-vnet-azure-usage-row">
              <span class="architecture-vnet-azure-usage-keys">
                <kbd>Alt</kbd>
                <kbd>+</kbd>
                <kbd>Arrows</kbd>
              </span>
              <span>resize selected box</span>
            </div>
            <div class="architecture-vnet-azure-usage-row">
              <span class="architecture-vnet-azure-usage-keys">
                <kbd>Mouse</kbd>
                <kbd>Drag</kbd>
              </span>
              <span>reposition box</span>
            </div>
            <div class="architecture-vnet-azure-usage-row">
              <span class="architecture-vnet-azure-usage-keys">
                <kbd>Cmd / Ctrl</kbd>
                <kbd>+</kbd>
                <kbd>Z</kbd>
              </span>
              <span>undo stage edit</span>
            </div>
            <div class="architecture-vnet-azure-usage-row">
              <span class="architecture-vnet-azure-usage-keys">
                <kbd>Ctrl / Cmd</kbd>
                <kbd>Wheel</kbd>
              </span>
              <span>zoom stage by 1%</span>
            </div>
          </div>
        </div>
      </div>
      {# ns:end family.architecture.workspace.06_result-diagram #}
    </section>

    <section class="tool-shell tool-output-shell">
      <div class="tool-empty-state" id="architectureVnetAzureOutputEmpty">Generate an architecture diagram to review technical inventory, service mix, and exportable JSON.</div>

      <div class="architecture-vnet-azure-output-content d-none" id="architectureVnetAzureOutputContent">
        <div class="architecture-vnet-azure-output-shell">
          {# ns:start family.architecture.workspace.07_score-card #}
          <div class="architecture-vnet-azure-output-summary">
            <div class="architecture-vnet-azure-output-status-card" aria-live="polite">
              <div class="architecture-vnet-azure-score-card" id="architectureVnetAzureOutputStatus">
                <div class="architecture-vnet-azure-score-kicker">Architecture Score</div>
                <div class="architecture-vnet-azure-score-value">Ready</div>
                <div class="architecture-vnet-azure-score-summary">Generate a diagram to score the current VNet baseline.</div>
              </div>
            </div>
          </div>
          {# ns:end family.architecture.workspace.07_score-card #}

          {# ns:start family.architecture.workspace.08_sort-card #}
          <div class="architecture-vnet-azure-toolbar-shell">
            <div class="architecture-vnet-azure-toolbar tool-output-toolbar">
              <div class="architecture-vnet-azure-toolbar-main">
                <label for="architectureVnetAzureInventorySort" class="architecture-vnet-azure-sort-label">Sort</label>
                <div class="architecture-vnet-azure-sort-wrap">
                  <details class="architecture-vnet-azure-sort-select" id="architectureVnetAzureInventorySortSelect">
                    <summary class="architecture-vnet-azure-sort-summary">
                      <span id="architectureVnetAzureInventorySortSummary">ID</span>
                    </summary>

                    <div class="architecture-vnet-azure-sort-menu">
                      <div class="architecture-vnet-azure-sort-grid">
                        <button type="button" class="architecture-vnet-azure-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                        <button type="button" class="architecture-vnet-azure-sort-option" data-sort-value="alphabetical" aria-pressed="false">A-Z</button>
                        <button type="button" class="architecture-vnet-azure-sort-option" data-sort-value="component" aria-pressed="false">Component</button>
                        <button type="button" class="architecture-vnet-azure-sort-option" data-sort-value="placement" aria-pressed="false">Placement</button>
                        <button type="button" class="architecture-vnet-azure-sort-option" data-sort-value="purpose" aria-pressed="false">Purpose</button>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="architectureVnetAzureInventorySort" value="id">
                </div>
              </div>

              <div class="tool-output-actions">
