<div class="calculate-cost-azure-tool" data-tool-slug="calculate-cost-azure" data-tool-category="Azure">
<div class="tool-box">
  <form class="calculate-cost-azure-form" id="calculateCostAzureForm">
    <div class="calculate-cost-azure-main-row">
      <label for="calculateCostAzureLabel" class="calculate-cost-azure-main-label">
        Estimate label:
        <span class="info-dot" title="Name the workload or environment you want to estimate">i</span>
      </label>

      <div class="calculate-cost-azure-main-input-grid">
        <input
          type="text"
          id="calculateCostAzureLabel"
          class="form-control"
          placeholder="Production API stack"
          value="Lean web platform"
        >

        <div class="calculate-cost-azure-main-actions">
          <button type="submit" class="btn btn-primary calculate-cost-azure-submit-btn" id="calculateCostAzureSubmit">Estimate</button>
          <button type="button" class="calculate-cost-azure-secondary-btn calculate-cost-azure-reset-btn" id="calculateCostAzureReset">Reset</button>
        </div>
      </div>
    </div>

    <div class="calculate-cost-azure-basic-panel">
      <div class="calculate-cost-azure-inner-panel">
        <div class="calculate-cost-azure-setting-row">
          <label for="calculateCostAzurePreset" class="calculate-cost-azure-setting-label">
            Preset:
            <span class="info-dot" title="Load a starting cost shape for a common Azure workload">i</span>
          </label>

          <div class="calculate-cost-azure-setting-field">
            <div class="calculate-cost-azure-inline-grid calculate-cost-azure-inline-grid-preset">
              <details class="calculate-cost-azure-select" id="calculateCostAzurePresetSelect">
                <summary class="calculate-cost-azure-select-summary">
                  <span id="calculateCostAzurePresetSummary">Lean web platform</span>
                </summary>

                <div class="calculate-cost-azure-select-body">
                  <div class="calculate-cost-azure-select-grid calculate-cost-azure-select-grid-list">
                    <label class="calculate-cost-azure-select-card">
                      <input type="radio" name="calculateCostAzurePresetOption" value="lean-web" checked>
                      <span class="calculate-cost-azure-select-title">Lean web platform</span>
                    </label>

                    <label class="calculate-cost-azure-select-card">
                      <input type="radio" name="calculateCostAzurePresetOption" value="serverless-api">
                      <span class="calculate-cost-azure-select-title">Serverless API</span>
                    </label>

                    <label class="calculate-cost-azure-select-card">
                      <input type="radio" name="calculateCostAzurePresetOption" value="steady-platform">
                      <span class="calculate-cost-azure-select-title">Steady application platform</span>
                    </label>

                    <label class="calculate-cost-azure-select-card">
                      <input type="radio" name="calculateCostAzurePresetOption" value="blank">
                      <span class="calculate-cost-azure-select-title">Blank estimate</span>
                    </label>
                  </div>
                </div>
              </details>
              <input type="hidden" id="calculateCostAzurePreset" value="lean-web">

              <button type="button" class="calculate-cost-azure-secondary-btn" id="calculateCostAzureApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-azure-setting-row">
          <label class="calculate-cost-azure-setting-label">
            Pricing basis:
            <span class="info-dot" title="Starter prices are visible and editable in Advanced so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-azure-setting-field">
            <div class="calculate-cost-azure-basis-grid">
              <div class="calculate-cost-azure-basis-card">
                <span class="calculate-cost-azure-basis-label">Catalog</span>
                <span class="calculate-cost-azure-basis-value">Starter Azure mix</span>
                <span class="calculate-cost-azure-basis-note">Virtual Machines use a compact purchase-model catalog. Storage, Azure Functions, API, and egress use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-azure-basis-card">
                <span class="calculate-cost-azure-basis-label">Output</span>
                <span class="calculate-cost-azure-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-azure-basis-note">Use the result as a planning estimate, then verify material decisions in Azure pricing, billing, or agreement data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-azure-service-grid">
          <section class="calculate-cost-azure-service-card" data-service-card="compute">
            <div class="calculate-cost-azure-service-head">
              <div>
                <h3 class="calculate-cost-azure-service-title">Azure VM Compute</h3>
                <p class="calculate-cost-azure-service-copy">VM count, runtime, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-azure-switch-wrap">
                <input type="checkbox" id="calculateCostAzureIncludeCompute" checked>
                <span class="slider"></span>
                <span class="calculate-cost-azure-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-azure-service-body" id="calculateCostAzureComputeBody">
              <div class="calculate-cost-azure-card-grid calculate-cost-azure-card-grid-two">
                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureComputeInstance" class="calculate-cost-azure-field-label">VM profile</label>
                  <details class="calculate-cost-azure-select" id="calculateCostAzureComputeInstanceSelect">
                    <summary class="calculate-cost-azure-select-summary">
                      <span id="calculateCostAzureComputeInstanceSummary">D2s v5 - 2 vCPU - 8 GiB</span>
                    </summary>

                    <div class="calculate-cost-azure-select-body">
                      <div class="calculate-cost-azure-select-grid calculate-cost-azure-select-grid-list">
                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="b2s">
                          <span class="calculate-cost-azure-select-title">B2s - 2 vCPU - 4 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="b2ms">
                          <span class="calculate-cost-azure-select-title">B2ms - 2 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="d2s-v5" checked>
                          <span class="calculate-cost-azure-select-title">D2s v5 - 2 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="d4s-v5">
                          <span class="calculate-cost-azure-select-title">D4s v5 - 4 vCPU - 16 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="d8s-v5">
                          <span class="calculate-cost-azure-select-title">D8s v5 - 8 vCPU - 32 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="f4s-v2">
                          <span class="calculate-cost-azure-select-title">F4s v2 - 4 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="e4s-v5">
                          <span class="calculate-cost-azure-select-title">E4s v5 - 4 vCPU - 32 GiB</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputeInstanceOption" value="custom">
                          <span class="calculate-cost-azure-select-title" id="calculateCostAzureComputeCustomOptionLabel">Custom size - user defined</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostAzureComputeInstance" value="d2s-v5">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureComputePurchase" class="calculate-cost-azure-field-label">Purchase model</label>
                  <details class="calculate-cost-azure-select" id="calculateCostAzureComputePurchaseSelect">
                    <summary class="calculate-cost-azure-select-summary">
                      <span id="calculateCostAzureComputePurchaseSummary">Pay-as-you-go</span>
                    </summary>

                    <div class="calculate-cost-azure-select-body">
                      <div class="calculate-cost-azure-select-grid calculate-cost-azure-select-grid-two">
                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputePurchaseOption" value="onDemand" checked>
                          <span class="calculate-cost-azure-select-title">Pay-as-you-go</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputePurchaseOption" value="spot">
                          <span class="calculate-cost-azure-select-title">Spot</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputePurchaseOption" value="savings1">
                          <span class="calculate-cost-azure-select-title">Savings plan 1yr</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputePurchaseOption" value="savings3">
                          <span class="calculate-cost-azure-select-title">Savings plan 3yr</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputePurchaseOption" value="reserved1">
                          <span class="calculate-cost-azure-select-title">Reserved instance 1yr</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureComputePurchaseOption" value="reserved3">
                          <span class="calculate-cost-azure-select-title">Reserved instance 3yr</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostAzureComputePurchase" value="onDemand">
                </div>

                <div class="calculate-cost-azure-custom-instance-grid calculate-cost-azure-card-span-two d-none" id="calculateCostAzureComputeCustomFields">
                  <div class="calculate-cost-azure-field-stack">
                    <label for="calculateCostAzureComputeCustomLabel" class="calculate-cost-azure-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostAzureComputeCustomLabel"
                      class="form-control"
                      placeholder="Custom instance profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-azure-field-stack">
                    <label for="calculateCostAzureComputeCustomVcpu" class="calculate-cost-azure-field-label">Custom vCPU</label>
                    <input
                      type="number"
                      id="calculateCostAzureComputeCustomVcpu"
                      class="form-control"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-azure-field-stack">
                    <label for="calculateCostAzureComputeCustomMemoryGiB" class="calculate-cost-azure-field-label">Custom memory GiB</label>
                    <input
                      type="number"
                      id="calculateCostAzureComputeCustomMemoryGiB"
                      class="form-control"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

                <p class="calculate-cost-azure-field-hint calculate-cost-azure-card-span-two d-none" id="calculateCostAzureComputeCustomHint">Custom size uses the VM hourly override in Advanced. Set the custom vCPU and memory here, then price it with the override field.</p>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureComputeCount" class="calculate-cost-azure-field-label">VM count</label>
                  <input type="number" id="calculateCostAzureComputeCount" class="form-control" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureComputeHours" class="calculate-cost-azure-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostAzureComputeHours" class="form-control" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-azure-service-card" data-service-card="disk">
            <div class="calculate-cost-azure-service-head">
              <div>
                <h3 class="calculate-cost-azure-service-title">Managed Disk Storage</h3>
                <p class="calculate-cost-azure-service-copy">Premium SSD-style capacity plus optional IOPS and throughput.</p>
              </div>

              <label class="switch calculate-cost-azure-switch-wrap">
                <input type="checkbox" id="calculateCostAzureIncludeDisk" checked>
                <span class="slider"></span>
                <span class="calculate-cost-azure-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-azure-service-body" id="calculateCostAzureDiskBody">
              <div class="calculate-cost-azure-card-grid calculate-cost-azure-card-grid-two">
                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureDiskStorageGb" class="calculate-cost-azure-field-label">Storage GB</label>
                  <input type="number" id="calculateCostAzureDiskStorageGb" class="form-control" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureDiskIops" class="calculate-cost-azure-field-label">Provisioned IOPS</label>
                  <input type="number" id="calculateCostAzureDiskIops" class="form-control" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-azure-field-stack calculate-cost-azure-card-span-two">
                  <label for="calculateCostAzureDiskThroughput" class="calculate-cost-azure-field-label">Throughput MB/s</label>
                  <input type="number" id="calculateCostAzureDiskThroughput" class="form-control" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-azure-service-card" data-service-card="blob">
            <div class="calculate-cost-azure-service-head">
              <div>
                <h3 class="calculate-cost-azure-service-title">Blob Storage</h3>
                <p class="calculate-cost-azure-service-copy">Object storage, request volume, and outbound transfer.</p>
              </div>

              <label class="switch calculate-cost-azure-switch-wrap">
                <input type="checkbox" id="calculateCostAzureIncludeBlob" checked>
                <span class="slider"></span>
                <span class="calculate-cost-azure-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-azure-service-body" id="calculateCostAzureBlobBody">
              <div class="calculate-cost-azure-card-grid calculate-cost-azure-card-grid-two">
                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureBlobStorageGb" class="calculate-cost-azure-field-label">Storage GB</label>
                  <input type="number" id="calculateCostAzureBlobStorageGb" class="form-control" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureBlobEgressGb" class="calculate-cost-azure-field-label">Transfer out GB</label>
                  <input type="number" id="calculateCostAzureBlobEgressGb" class="form-control" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureBlobGetRequestsK" class="calculate-cost-azure-field-label">GET requests (1k)</label>
                  <input type="number" id="calculateCostAzureBlobGetRequestsK" class="form-control" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureBlobPutRequestsK" class="calculate-cost-azure-field-label">PUT/LIST requests (1k)</label>
                  <input type="number" id="calculateCostAzureBlobPutRequestsK" class="form-control" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-azure-service-card" data-service-card="functions">
            <div class="calculate-cost-azure-service-head">
              <div>
                <h3 class="calculate-cost-azure-service-title">Azure Functions</h3>
                <p class="calculate-cost-azure-service-copy">Requests, duration, and memory drive the bill.</p>
              </div>

              <label class="switch calculate-cost-azure-switch-wrap">
                <input type="checkbox" id="calculateCostAzureIncludeFunctions" checked>
                <span class="slider"></span>
                <span class="calculate-cost-azure-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-azure-service-body" id="calculateCostAzureFunctionsBody">
              <div class="calculate-cost-azure-card-grid calculate-cost-azure-card-grid-two">
                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureFunctionsRequestsMillion" class="calculate-cost-azure-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostAzureFunctionsRequestsMillion" class="form-control" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureFunctionsDurationMs" class="calculate-cost-azure-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostAzureFunctionsDurationMs" class="form-control" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-azure-field-stack calculate-cost-azure-card-span-two">
                  <label for="calculateCostAzureFunctionsMemoryMb" class="calculate-cost-azure-field-label">Memory MB</label>
                  <input type="number" id="calculateCostAzureFunctionsMemoryMb" class="form-control" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-azure-service-card" data-service-card="api">
            <div class="calculate-cost-azure-service-head">
              <div>
                <h3 class="calculate-cost-azure-service-title">API Management</h3>
                <p class="calculate-cost-azure-service-copy">HTTP and REST requests with response egress.</p>
              </div>

              <label class="switch calculate-cost-azure-switch-wrap">
                <input type="checkbox" id="calculateCostAzureIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-azure-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-azure-service-body" id="calculateCostAzureApiBody">
              <div class="calculate-cost-azure-card-grid calculate-cost-azure-card-grid-two">
                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureApiType" class="calculate-cost-azure-field-label">API type</label>
                  <details class="calculate-cost-azure-select" id="calculateCostAzureApiTypeSelect">
                    <summary class="calculate-cost-azure-select-summary">
                      <span id="calculateCostAzureApiTypeSummary">Consumption gateway</span>
                    </summary>

                    <div class="calculate-cost-azure-select-body">
                      <div class="calculate-cost-azure-select-grid calculate-cost-azure-select-grid-two">
                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureApiTypeOption" value="http" checked>
                          <span class="calculate-cost-azure-select-title">Consumption gateway</span>
                        </label>

                        <label class="calculate-cost-azure-select-card">
                          <input type="radio" name="calculateCostAzureApiTypeOption" value="rest">
                          <span class="calculate-cost-azure-select-title">Standard gateway</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostAzureApiType" value="http">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureApiRequestsMillion" class="calculate-cost-azure-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostAzureApiRequestsMillion" class="form-control" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-azure-field-stack calculate-cost-azure-card-span-two">
                  <label for="calculateCostAzureApiResponseKb" class="calculate-cost-azure-field-label">Avg response KB</label>
                  <input type="number" id="calculateCostAzureApiResponseKb" class="form-control" min="0" step="1" value="32">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-azure-service-card" data-service-card="overhead">
            <div class="calculate-cost-azure-service-head">
              <div>
                <h3 class="calculate-cost-azure-service-title">Shared Egress And Overhead</h3>
                <p class="calculate-cost-azure-service-copy">Network, support uplift, and blended buffer.</p>
              </div>
            </div>

            <div class="calculate-cost-azure-service-body">
              <div class="calculate-cost-azure-card-grid calculate-cost-azure-card-grid-two">
                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureSharedEgressGb" class="calculate-cost-azure-field-label">Shared egress GB</label>
                  <input type="number" id="calculateCostAzureSharedEgressGb" class="form-control" min="0" step="1" value="120">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureSupportPct" class="calculate-cost-azure-field-label">Support uplift %</label>
                  <input type="number" id="calculateCostAzureSupportPct" class="form-control" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureContingencyPct" class="calculate-cost-azure-field-label">Contingency %</label>
                  <input type="number" id="calculateCostAzureContingencyPct" class="form-control" min="0" step="0.1" value="10">
                </div>

                <div class="calculate-cost-azure-field-stack">
                  <label for="calculateCostAzureManualAdjustment" class="calculate-cost-azure-field-label">Manual adjustment $</label>
                  <input type="number" id="calculateCostAzureManualAdjustment" class="form-control" step="0.01" value="0">
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <details class="calculate-cost-azure-advanced" id="calculateCostAzureAdvanced">
      <summary class="calculate-cost-azure-advanced-summary">Advanced</summary>

      <div class="calculate-cost-azure-advanced-body">
        <div class="calculate-cost-azure-inner-panel">
          <div class="calculate-cost-azure-setting-row">
            <label class="calculate-cost-azure-setting-label">
              Free tier toggles:
              <span class="info-dot" title="Apply the starter free-tier allowances that most affect this model">i</span>
            </label>

            <div class="calculate-cost-azure-setting-field">
              <div class="calculate-cost-azure-toggle-grid">
                <label class="switch calculate-cost-azure-switch-wrap calculate-cost-azure-switch-card">
                  <input type="checkbox" id="calculateCostAzureFreeTierFunctions" checked>
                  <span class="slider"></span>
                  <span class="calculate-cost-azure-switch-label">Functions requests + GB-s</span>
                </label>

                <label class="switch calculate-cost-azure-switch-wrap calculate-cost-azure-switch-card">
                  <input type="checkbox" id="calculateCostAzureFreeTierApi" checked>
                  <span class="slider"></span>
