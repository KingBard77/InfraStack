{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}

<div class="architecture-logical-application-tool" data-tool-slug="architecture-logical-application" data-tool-category="infrastructure" data-tool-family="architecture" data-tool-canonical="architecture_logical_application">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <div class="tool-shell tool-prompt-shell architecture-logical-application-prompt-shell architecture-logical-application-input-card" id="architectureLogicalApplicationPromptShell" data-section="architecture-prompt" data-root-selector=".architecture-logical-application-tool">
      <div class="architecture-logical-application-input-brief" data-input-layout="stacked">
        <div class="architecture-logical-application-input-row">
          <div class="architecture-logical-application-input-label-wrap">
            <label for="architectureLogicalApplicationPrompt" class="tool-main-label architecture-logical-application-input-label">Application architecture brief</label>
            <span class="architecture-logical-application-helper-chip" title="Describe the logical application scope, actors, components, integrations, identity, and business flow." aria-label="Describe the logical application scope, actors, components, integrations, identity, and business flow.">i</span>
          </div>
          <div class="tool-main-input-grid architecture-logical-application-main-input-grid architecture-logical-application-input-stack">
            <textarea
              id="architectureLogicalApplicationPrompt"
              class="form-control architecture-logical-application-prompt architecture-logical-application-input-control"
              rows="7"
              placeholder="Describe the application name, purpose, users, frontend, backend services, databases, cache, integrations, authentication, notifications, monitoring, and business flow."
            >Create a customer web application for account registration, profile updates, approvals, notifications, and reporting. Users are Customer, Admin, Support Officer, and Partner API. Include Web Portal, Admin Portal, API Gateway, Authentication Service, User Service, Approval Service, Notification Service, Reporting Service, PostgreSQL, Redis, Object Storage, Email, SMS, OAuth2, MFA, Grafana, Prometheus, ELK, and an end-to-end request flow from registration to approval notification.</textarea>
            <div class="architecture-logical-application-input-error d-none" id="architectureLogicalApplicationInputError" role="alert"></div>
          </div>
        </div>

        <div class="architecture-logical-application-main-actions architecture-logical-application-input-actions">
          <button
            type="button"
            class="tool-action-btn tool-action-btn-primary architecture-logical-application-action-btn architecture-logical-application-action-btn-primary"
            id="architectureLogicalApplicationGenerate"
          >
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span data-button-label>Generate Diagram</span>
          </button>
          <button
            type="button"
            class="tool-action-btn tool-action-btn-secondary architecture-logical-application-action-btn architecture-logical-application-action-btn-secondary"
            id="architectureLogicalApplicationReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span data-button-label>Reset</span>
          </button>
        </div>

        <div class="architecture-logical-application-input-helper-card">
          <span class="architecture-logical-application-input-hint">Use one brief or Custom fields to model actors, frontend channels, services, data stores, integrations, identity, notifications, observability, and business flow. Preset selection or Generate Diagram creates the editable workspace.</span>
          <span class="architecture-logical-application-helper-chip architecture-logical-application-helper-chip-inline" title="Describe the logical application scope." aria-label="Describe the logical application scope.">i</span>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureLogicalApplicationErrorState" hidden></div>

    <section class="tool-shell tool-inspector-shell" id="architectureLogicalApplicationConfigShell" aria-label="Configuration">

      <div class="tool-shell-body">
        {# ns:start family._base.workspace.02_basic-settings #}
        <div class="tool-inspector-section architecture-logical-application-basic-section architecture-logical-application-basic-card" id="architectureLogicalApplicationBasicConfig" data-section="basic-tab" data-root-selector=".architecture-logical-application-tool">

          <div class="architecture-logical-application-example-card">
            <span class="architecture-logical-application-example-label">Example logical architecture</span>
            <strong class="architecture-logical-application-example-value">Citizen portal, approval service, notifications, records database</strong>
            <span class="architecture-logical-application-example-helper">Preset, detail level, and flow focus update the generated model and exported JSON.</span>
          </div>

          <div class="architecture-logical-application-basic-grid">
            <div class="architecture-logical-application-control-stack architecture-logical-application-setting-card">
              <label class="tool-control-label architecture-logical-application-setting-label" for="architectureLogicalApplicationPreset">Preset <span class="architecture-logical-application-helper-chip" title="Choose the logical application pattern to seed the custom fields and diagram." aria-label="Choose the logical application pattern to seed the custom fields and diagram.">i</span></label>
              <div class="architecture-logical-application-select-wrap">
                <div class="architecture-logical-application-native-select-wrap" id="architectureLogicalApplicationPresetSelect">
                  <select id="architectureLogicalApplicationPreset" class="form-select architecture-logical-application-select architecture-logical-application-native-select">
                    <option value="web-application" selected>Web Application</option>
                    <option value="mobile-application">Mobile Application</option>
                    <option value="microservices">Microservices</option>
                    <option value="enterprise-application">Enterprise Application</option>
                    <option value="government-application">Government Application</option>
                    <option value="ai-ml-application">AI/ML Application</option>
                    <option value="event-driven-application">Event-Driven Application</option>
                    <option value="data-processing-pipeline">Data Processing Pipeline</option>
                    <option value="identity-access-management">Identity &amp; Access Management</option>
                    <option value="service-dependency-map">Service Dependency Map</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="architecture-logical-application-control-stack architecture-logical-application-setting-card">
              <label class="tool-control-label architecture-logical-application-setting-label" for="architectureLogicalApplicationDetailLevel">Detail level <span class="architecture-logical-application-helper-chip" title="Choose how much component detail the generated diagram should expose." aria-label="Choose how much component detail the generated diagram should expose.">i</span></label>
              <div class="architecture-logical-application-select-wrap">
                <div class="architecture-logical-application-native-select-wrap" id="architectureLogicalApplicationDetailLevelSelect">
                  <select id="architectureLogicalApplicationDetailLevel" class="form-select architecture-logical-application-select architecture-logical-application-native-select">
                    <option value="executive">Executive</option>
                    <option value="component" selected>Component</option>
                    <option value="service">Service detail</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="architecture-logical-application-control-stack architecture-logical-application-setting-card">
              <label class="tool-control-label architecture-logical-application-setting-label" for="architectureLogicalApplicationFlowDepth">Flow focus <span class="architecture-logical-application-helper-chip" title="Choose how strongly the business flow is represented in notes and connectors." aria-label="Choose how strongly the business flow is represented in notes and connectors.">i</span></label>
              <div class="architecture-logical-application-select-wrap">
                <div class="architecture-logical-application-native-select-wrap" id="architectureLogicalApplicationFlowDepthSelect">
                  <select id="architectureLogicalApplicationFlowDepth" class="form-select architecture-logical-application-select architecture-logical-application-native-select">
                    <option value="summary">Summary</option>
                    <option value="standard" selected>Standard</option>
                    <option value="expanded">Expanded</option>
                  </select>
                </div>
              </div>
            </div>
            <p class="tool-control-hint architecture-logical-application-setting-hint" id="architectureLogicalApplicationPresetDescription">Web portal, API gateway, application services, database, cache, notifications, monitoring, and identity controls.</p>
          </div>
        </div>
        {# ns:end family._base.workspace.02_basic-settings #}

        {# ns:start family._base.workspace.03_custom-settings #}
        <details class="architecture-logical-application-custom-panel" data-custom-layout="tabbed_two_column" id="architectureLogicalApplicationCustomControls" data-section="custom-tab" data-root-selector=".architecture-logical-application-tool">
          <summary class="architecture-logical-application-custom-panel-summary">
            <span>Custom</span>
              <span class="architecture-logical-application-custom-arrow-slot" aria-hidden="true"></span>
          </summary>

          <div class="architecture-logical-application-custom-panel-body">
            <div class="architecture-logical-application-config-tabs" role="tablist" aria-label="Logical application custom configuration">
              <button type="button" class="architecture-logical-application-config-tab active" id="architectureLogicalApplicationOverviewTab" data-config-tab-target="architectureLogicalApplicationOverviewPanel" role="tab" aria-controls="architectureLogicalApplicationOverviewPanel" aria-selected="true" tabindex="0">Overview</button>
              <button type="button" class="architecture-logical-application-config-tab" id="architectureLogicalApplicationComponentsTab" data-config-tab-target="architectureLogicalApplicationComponentsPanel" role="tab" aria-controls="architectureLogicalApplicationComponentsPanel" aria-selected="false" tabindex="-1">Components</button>
              <button type="button" class="architecture-logical-application-config-tab" id="architectureLogicalApplicationIntegrationsTab" data-config-tab-target="architectureLogicalApplicationIntegrationsPanel" role="tab" aria-controls="architectureLogicalApplicationIntegrationsPanel" aria-selected="false" tabindex="-1">Integrations</button>
              <button type="button" class="architecture-logical-application-config-tab" id="architectureLogicalApplicationFlowTab" data-config-tab-target="architectureLogicalApplicationFlowPanel" role="tab" aria-controls="architectureLogicalApplicationFlowPanel" aria-selected="false" tabindex="-1">Flow</button>
            </div>

            <div class="tool-inspector-section architecture-logical-application-config-panel active" id="architectureLogicalApplicationOverviewPanel" data-config-panel role="tabpanel" aria-labelledby="architectureLogicalApplicationOverviewTab">
              <div class="architecture-logical-application-config-grid">
                <div class="architecture-logical-application-control-stack">
                  <label class="tool-control-label" for="architectureLogicalApplicationApplicationName">Application Name <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="Name shown as the logical application boundary." aria-label="Name shown as the logical application boundary.">i</span></label>
                  <input type="text" id="architectureLogicalApplicationApplicationName" class="form-control" value="Customer Web Portal">
                </div>

                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationBusinessPurpose">Business Purpose <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="Describe what the application does for the business or public service." aria-label="Describe what the application does for the business or public service.">i</span></label>
                  <textarea id="architectureLogicalApplicationBusinessPurpose" class="form-control architecture-logical-application-note-input">Allow customers to register, manage profiles, request approvals, receive notifications, and review status dashboards.</textarea>
                </div>

                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationUsersActors">Users / Actors <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List each user, actor, partner, agency, or external system on separate lines or comma-separated." aria-label="List each user, actor, partner, agency, or external system on separate lines or comma-separated.">i</span></label>
                  <textarea id="architectureLogicalApplicationUsersActors" class="form-control architecture-logical-application-note-input">Customer, Admin, Support Officer, Partner API</textarea>
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-logical-application-config-panel" id="architectureLogicalApplicationComponentsPanel" data-config-panel role="tabpanel" aria-labelledby="architectureLogicalApplicationComponentsTab" hidden>
              <div class="architecture-logical-application-config-grid">
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationFrontendComponents">Frontend Components <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List web portals, mobile apps, dashboards, admin portals, or API consumers." aria-label="List web portals, mobile apps, dashboards, admin portals, or API consumers.">i</span></label>
                  <textarea id="architectureLogicalApplicationFrontendComponents" class="form-control architecture-logical-application-note-input">Web Portal, Admin Portal, Public API Consumer</textarea>
                </div>
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationBackendServices">Backend Services <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List application services that implement business logic." aria-label="List application services that implement business logic.">i</span></label>
                  <textarea id="architectureLogicalApplicationBackendServices" class="form-control architecture-logical-application-note-input">Authentication Service, User Service, Approval Service, Notification Service, Reporting Service</textarea>
                </div>
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationDatabases">Databases <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List relational, document, search, warehouse, or graph databases." aria-label="List relational, document, search, warehouse, or graph databases.">i</span></label>
                  <textarea id="architectureLogicalApplicationDatabases" class="form-control architecture-logical-application-note-input">PostgreSQL, Reporting Database</textarea>
                </div>
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationCacheStorage">Cache / Storage <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List cache, object storage, shared file storage, or document stores." aria-label="List cache, object storage, shared file storage, or document stores.">i</span></label>
                  <textarea id="architectureLogicalApplicationCacheStorage" class="form-control architecture-logical-application-note-input">Redis, Object Storage, File Storage</textarea>
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-logical-application-config-panel" id="architectureLogicalApplicationIntegrationsPanel" data-config-panel role="tabpanel" aria-labelledby="architectureLogicalApplicationIntegrationsTab" hidden>
              <div class="architecture-logical-application-config-grid">
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationExternalIntegrations">External Integrations <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List external APIs, payment gateways, partner systems, or government systems." aria-label="List external APIs, payment gateways, partner systems, or government systems.">i</span></label>
                  <textarea id="architectureLogicalApplicationExternalIntegrations" class="form-control architecture-logical-application-note-input">Payment Gateway, SMS Gateway, Email Service, Partner CRM</textarea>
                </div>
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationAuthenticationMethod">Authentication Method <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List SSO, OAuth2, OpenID Connect, LDAP, FreeIPA, Active Directory, MFA, or related methods." aria-label="List SSO, OAuth2, OpenID Connect, LDAP, FreeIPA, Active Directory, MFA, or related methods.">i</span></label>
                  <textarea id="architectureLogicalApplicationAuthenticationMethod" class="form-control architecture-logical-application-note-input">OAuth2, OpenID Connect, MFA</textarea>
                </div>
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationNotifications">Notifications <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List outbound notification channels." aria-label="List outbound notification channels.">i</span></label>
                  <textarea id="architectureLogicalApplicationNotifications" class="form-control architecture-logical-application-note-input">Email, SMS, Push Notification</textarea>
                </div>
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationMonitoringLogging">Monitoring &amp; Logging <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="List observability, dashboard, logging, tracing, or APM tools." aria-label="List observability, dashboard, logging, tracing, or APM tools.">i</span></label>
                  <textarea id="architectureLogicalApplicationMonitoringLogging" class="form-control architecture-logical-application-note-input">Grafana, Prometheus, ELK, APM</textarea>
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-logical-application-config-panel" id="architectureLogicalApplicationFlowPanel" data-config-panel role="tabpanel" aria-labelledby="architectureLogicalApplicationFlowTab" hidden>
              <div class="architecture-logical-application-config-grid">
                <div class="architecture-logical-application-control-stack architecture-logical-application-wide-control">
                  <label class="tool-control-label" for="architectureLogicalApplicationBusinessFlow">Business Flow <span class="architecture-logical-application-helper-chip architecture-logical-application-custom-helper-chip" title="Describe the end-to-end process step by step." aria-label="Describe the end-to-end process step by step.">i</span></label>
                  <textarea id="architectureLogicalApplicationBusinessFlow" class="form-control architecture-logical-application-note-input">1. Customer registers through the web portal. 2. Authentication service verifies identity. 3. User service stores profile data. 4. Approval service routes the request to an officer. 5. Notification service sends status updates. 6. Reporting service updates the dashboard.</textarea>
                </div>
              </div>
            </div>
          </div>
        </details>
        {# ns:end family._base.workspace.03_custom-settings #}

        {# ns:start family.architecture.workspace.04_selected-item #}
        <div class="tool-inspector-section architecture-logical-application-selected-section" id="architectureLogicalApplicationSelectedShell" data-section="selected-item" data-root-selector=".architecture-logical-application-tool">
          <h3 class="architecture-logical-application-section-title">Selected item</h3>
          <p class="architecture-logical-application-selected-empty architecture-logical-application-selected-empty-chips" id="architectureLogicalApplicationSelectedEmpty" aria-label="Select a draggable box in the stage to move, resize, or highlight it. Select a line to adjust its bend handle. Arrow keys move the selected box; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
            <span class="architecture-logical-application-selected-empty-copy">
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a draggable box</span>
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Select a line to adjust bends</span>
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected box</span>
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
              <span class="architecture-logical-application-selected-hint-chip architecture-logical-application-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
            </span>
          </p>

          <div class="architecture-logical-application-selected-editor d-none" id="architectureLogicalApplicationSelectedEditor">
            <div class="architecture-logical-application-selected-name" id="architectureLogicalApplicationSelectedName"></div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architectureLogicalApplicationSelectedX">X position</label>
              <div class="tool-control-field">
                <input type="number" id="architectureLogicalApplicationSelectedX" class="form-control" min="0" step="4">
              </div>
            </div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architectureLogicalApplicationSelectedY">Y position</label>
              <div class="tool-control-field">
                <input type="number" id="architectureLogicalApplicationSelectedY" class="form-control" min="0" step="4">
              </div>
            </div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architectureLogicalApplicationSelectedWidth">Width</label>
              <div class="tool-control-field">
                <input type="number" id="architectureLogicalApplicationSelectedWidth" class="form-control" min="96" step="4">
              </div>
            </div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architectureLogicalApplicationSelectedHeight">Height</label>
              <div class="tool-control-field">
                <input type="number" id="architectureLogicalApplicationSelectedHeight" class="form-control" min="44" step="4">
              </div>
            </div>

            <div class="architecture-logical-application-selected-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureLogicalApplicationHighlightItem">Highlight box</button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureLogicalApplicationApplyItemSize">Apply item</button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureLogicalApplicationResetItemSize">Reset item</button>
            </div>
          </div>
        </div>
        {# ns:end family.architecture.workspace.04_selected-item #}
      </div>
    </section>

    <section class="tool-shell tool-stage-shell architecture-logical-application-stage-shell" id="architectureLogicalApplicationStageShell" data-section="diagram-buttons" data-root-selector=".architecture-logical-application-tool" aria-labelledby="architectureLogicalApplicationStageTitle">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <header class="tool-shell-header architecture-logical-application-stage-header">
        <div class="architecture-logical-application-stage-heading">
          <h2 class="tool-shell-title" id="architectureLogicalApplicationStageTitle">Logical Application Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureLogicalApplicationStageSubtitle"><span class="architecture-logical-application-stage-preset-chip">Web Application preset</span></p>
        </div>
        <div class="architecture-logical-application-stage-meta" id="architectureLogicalApplicationStageMeta"></div>
      </header>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="architecture-logical-application-stage-toolbar-actions">
          <div class="architecture-logical-application-zoom-control" id="architectureLogicalApplicationZoomControl">
          <button type="button" class="architecture-logical-application-zoom-step" id="architectureLogicalApplicationZoomOut" aria-label="Zoom out" title="Zoom out"><i class="bi bi-dash" aria-hidden="true"></i></button>
          <input type="number" id="architectureLogicalApplicationZoomInput" class="architecture-logical-application-zoom-input" min="25" max="180" step="1" value="80" aria-label="Zoom percentage">
          <span class="architecture-logical-application-zoom-label" id="architectureLogicalApplicationZoomLabel">%</span>
          <button type="button" class="architecture-logical-application-zoom-step" id="architectureLogicalApplicationZoomIn" aria-label="Zoom in" title="Zoom in"><i class="bi bi-plus" aria-hidden="true"></i></button>
          </div>
          <button type="button" class="architecture-logical-application-icon-btn" id="architectureLogicalApplicationZoomFit" aria-label="Zoom to fit" title="Zoom to fit"><i class="bi bi-arrows-angle-contract" aria-hidden="true"></i></button>
          <button type="button" class="architecture-logical-application-icon-btn" id="architectureLogicalApplicationZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%"><span>100</span></button>
          <button type="button" class="architecture-logical-application-icon-btn" id="architectureLogicalApplicationUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
          <button type="button" class="architecture-logical-application-icon-btn" id="architectureLogicalApplicationHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false"><i class="bi bi-bounding-box" aria-hidden="true"></i></button>
          <button type="button" class="architecture-logical-application-icon-btn" id="architectureLogicalApplicationZoomHideUi" aria-label="Hide UI" title="Hide UI"><i class="bi bi-eye-slash" aria-hidden="true"></i><span class="architecture-logical-application-visually-hidden">Hide UI</span></button>
          <button type="button" class="architecture-logical-application-icon-btn" id="architectureLogicalApplicationFullscreen" aria-label="Open fullscreen" title="Open fullscreen"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-logical-application-stage-toolbar-btn" id="architectureLogicalApplicationResetLayout" aria-label="Auto layout" title="Auto layout">Auto layout</button>
        </div>
      </div>

      <div class="tool-stage-body architecture-logical-application-stage-body" id="architectureLogicalApplicationStageBody">
        <div class="tool-empty-state architecture-logical-application-stage-empty d-none" id="architectureLogicalApplicationStageEmpty">Choose a preset to generate diagram</div>
        <div class="tool-stage-canvas architecture-logical-application-stage-canvas" id="architectureLogicalApplicationStageCanvas" tabindex="0" role="img" aria-label="Generated logical application architecture diagram"></div>
      </div>

      <div class="architecture-logical-application-stage-footer">
        <div class="architecture-logical-application-stage-toolbar-chips">
