{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}

<div class="architecture-physical-server-tool" data-tool-slug="architecture-physical-server" data-tool-category="infrastructure" data-tool-family="architecture" data-tool-canonical="architecture_physical_server">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <div class="tool-shell tool-prompt-shell architecture-physical-server-prompt-shell architecture-physical-server-input-card" id="architecturePhysicalServerPromptShell" data-section="architecture-prompt" data-root-selector=".architecture-physical-server-tool">
      <div class="architecture-physical-server-input-brief" data-input-layout="stacked">
        <div class="architecture-physical-server-input-row">
          <div class="architecture-physical-server-input-label-wrap">
            <label for="architecturePhysicalServerPrompt" class="tool-main-label architecture-physical-server-input-label">Architecture prompt</label>
            <span class="architecture-physical-server-helper-chip" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
          </div>
          <div class="tool-main-input-grid architecture-physical-server-main-input-grid architecture-physical-server-input-stack">
            <textarea
              id="architecturePhysicalServerPrompt"
              class="form-control architecture-physical-server-prompt architecture-physical-server-input-control"
              rows="7"
              placeholder="Describe racks, physical servers, hypervisor platform, storage, VLANs, monitoring, backup, power, cooling, and security."
            >Create an on-premises infrastructure stack with 2 racks and 3 hypervisor nodes. Use Proxmox VE for cluster management, OpenStack for tenant workloads, Synology HA NAS for iSCSI and NFS storage, VLAN 10 management 10.0.10.0/24, VLAN 20 storage 10.0.20.0/24, VLAN 30 tenant 10.0.30.0/24, VLAN 40 backup 10.0.40.0/24, firewall, core switch, Zabbix, syslog, snapshots, offsite backup, redundant power, cooling, IPMI, and physical security.</textarea>
            <div class="architecture-physical-server-input-error d-none" id="architecturePhysicalServerInputError" role="alert"></div>
          </div>
        </div>

        <div class="architecture-physical-server-main-actions architecture-physical-server-input-actions">
          <button
            type="button"
            class="tool-action-btn tool-action-btn-primary architecture-physical-server-action-btn architecture-physical-server-action-btn-primary"
            id="architecturePhysicalServerGenerate"
          >
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span data-button-label>Generate Diagram</span>
          </button>
          <button
            type="button"
            class="tool-action-btn tool-action-btn-secondary architecture-physical-server-action-btn architecture-physical-server-action-btn-secondary"
            id="architecturePhysicalServerReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span data-button-label>Reset</span>
          </button>
        </div>

        <div class="architecture-physical-server-input-helper-card">
          <span class="architecture-physical-server-input-hint">Use one brief with rack count, hypervisor nodes, virtualization platform, shared storage, segmented networks, monitoring, backup, and facility controls. Preset selection or Generate Diagram creates the editable workspace.</span>
          <span class="architecture-physical-server-helper-chip architecture-physical-server-helper-chip-inline" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architecturePhysicalServerErrorState" hidden></div>

    <section class="tool-shell tool-inspector-shell" id="architecturePhysicalServerConfigShell" aria-label="Configuration">

      <div class="tool-shell-body">
        {# ns:start family._base.workspace.02_basic-settings #}
        <div class="tool-inspector-section architecture-physical-server-basic-section architecture-physical-server-basic-card" id="architecturePhysicalServerBasicConfig" data-section="basic-tab" data-root-selector=".architecture-physical-server-tool">

          <div class="architecture-physical-server-example-card">
            <span class="architecture-physical-server-example-label">Example architecture settings</span>
            <strong class="architecture-physical-server-example-value">On-prem private cloud, 2 racks, 6 hypervisor nodes</strong>
            <span class="architecture-physical-server-example-helper">Region, zone count, and preset should change the generated model and exported JSON.</span>
          </div>

          <div class="architecture-physical-server-basic-grid">
            <div class="architecture-physical-server-control-stack architecture-physical-server-setting-card">
              <label class="tool-control-label architecture-physical-server-setting-label" for="architecturePhysicalServerPreset">Preset <span class="architecture-physical-server-helper-chip" title="Choose a starting preset that updates the visible controls and generated output." aria-label="Choose a starting preset that updates the visible controls and generated output.">i</span></label>
              <div class="architecture-physical-server-select-wrap">
                <div class="architecture-physical-server-native-select-wrap" id="architecturePhysicalServerPresetSelect">
                  <select id="architecturePhysicalServerPreset" class="form-select architecture-physical-server-select architecture-physical-server-native-select">
                    <option value="onprem-private-cloud" selected>On-Prem Private Cloud</option>
                    <option value="storage-backed-virtualization">Storage-Backed Virtualization</option>
                    <option value="backup-focused-cluster">Backup-Focused Cluster</option>
                    <option value="edge-lab-stack">Edge Lab Stack</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="architecture-physical-server-control-stack architecture-physical-server-setting-card">
              <label class="tool-control-label architecture-physical-server-setting-label" for="architecturePhysicalServerRackCount">Racks <span class="architecture-physical-server-helper-chip" title="Choose the rack count used by the physical layout assumptions." aria-label="Choose the rack count used by the physical layout assumptions.">i</span></label>
              <div class="architecture-physical-server-select-wrap">
                <div class="architecture-physical-server-native-select-wrap" id="architecturePhysicalServerRackCountSelect">
                  <select id="architecturePhysicalServerRackCount" class="form-select architecture-physical-server-select architecture-physical-server-native-select">
                    <option value="1">1 rack</option>
                    <option value="2" selected>2 racks</option>
                    <option value="3">3 racks</option>
                    <option value="4">4 racks</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="architecture-physical-server-control-stack architecture-physical-server-setting-card">
              <label class="tool-control-label architecture-physical-server-setting-label" for="architecturePhysicalServerHypervisorCount">Hypervisor nodes <span class="architecture-physical-server-helper-chip" title="Choose the hypervisor node count used by the physical layout assumptions." aria-label="Choose the hypervisor node count used by the physical layout assumptions.">i</span></label>
              <div class="architecture-physical-server-select-wrap">
                <div class="architecture-physical-server-native-select-wrap" id="architecturePhysicalServerHypervisorCountSelect">
                  <select id="architecturePhysicalServerHypervisorCount" class="form-select architecture-physical-server-select architecture-physical-server-native-select">
                    <option value="1">1 node</option>
                    <option value="2">2 nodes</option>
                    <option value="3" selected>3 nodes</option>
                    <option value="4">4 nodes</option>
                    <option value="5">5 nodes</option>
                    <option value="6">6 nodes</option>
                  </select>
                </div>
              </div>
            </div>
            <p class="tool-control-hint architecture-physical-server-setting-hint" id="architecturePhysicalServerPresetDescription">Proxmox VE, OpenStack, Synology HA storage, segmented VLANs, monitoring, backup, and redundant facility controls.</p>
          </div>
        </div>
        {# ns:end family._base.workspace.02_basic-settings #}

        {# ns:start family._base.workspace.03_custom-settings #}
        <details class="architecture-physical-server-custom-panel" data-custom-layout="tabbed_two_column" id="architecturePhysicalServerCustomControls" data-section="custom-tab" data-root-selector=".architecture-physical-server-tool">
          <summary class="architecture-physical-server-custom-panel-summary">
            <span>Custom</span>
              <span class="architecture-physical-server-custom-arrow-slot" aria-hidden="true"></span>
          </summary>

          <div class="architecture-physical-server-custom-panel-body">
            <div class="architecture-physical-server-config-tabs" role="tablist" aria-label="Physical server custom configuration">
              <button type="button" class="architecture-physical-server-config-tab active" id="architecturePhysicalServerPlatformTab" data-config-tab-target="architecturePhysicalServerPlatformPanel" role="tab" aria-controls="architecturePhysicalServerPlatformPanel" aria-selected="true" tabindex="0">Platform</button>
              <button type="button" class="architecture-physical-server-config-tab" id="architecturePhysicalServerNetworkTab" data-config-tab-target="architecturePhysicalServerNetworkPanel" role="tab" aria-controls="architecturePhysicalServerNetworkPanel" aria-selected="false" tabindex="-1">Network</button>
              <button type="button" class="architecture-physical-server-config-tab" id="architecturePhysicalServerOperationsTab" data-config-tab-target="architecturePhysicalServerOperationsPanel" role="tab" aria-controls="architecturePhysicalServerOperationsPanel" aria-selected="false" tabindex="-1">Operations</button>
              <button type="button" class="architecture-physical-server-config-tab" id="architecturePhysicalServerBackupTab" data-config-tab-target="architecturePhysicalServerBackupPanel" role="tab" aria-controls="architecturePhysicalServerBackupPanel" aria-selected="false" tabindex="-1">Backup</button>
            </div>

            <div class="tool-inspector-section architecture-physical-server-config-panel active" id="architecturePhysicalServerPlatformPanel" data-config-panel role="tabpanel" aria-labelledby="architecturePhysicalServerPlatformTab">
              <div class="architecture-physical-server-config-grid">
                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerPlatform">Virtualization platform <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune virtualization platform before regenerating the diagram." aria-label="Tune virtualization platform before regenerating the diagram.">i</span></label>                  <div class="architecture-physical-server-native-select-wrap" id="architecturePhysicalServerPlatformSelect">
                    <select id="architecturePhysicalServerPlatform" class="form-select architecture-physical-server-native-select">
                      <option value="proxmox-openstack" selected>Proxmox + OpenStack</option>
                      <option value="proxmox">Proxmox VE</option>
                      <option value="openstack">OpenStack</option>
                      <option value="vmware">VMware</option>
                      <option value="mixed">Mixed platform</option>
                    </select>
                  </div>
                </div>

                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerStorageModel">Storage model <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune storage model before regenerating the diagram." aria-label="Tune storage model before regenerating the diagram.">i</span></label>                  <div class="architecture-physical-server-native-select-wrap" id="architecturePhysicalServerStorageModelSelect">
                    <select id="architecturePhysicalServerStorageModel" class="form-select architecture-physical-server-native-select">
                      <option value="synology-ha" selected>Synology HA NAS</option>
                      <option value="san-nas">SAN / NAS</option>
                      <option value="local-raid">Local RAID / SSD</option>
                      <option value="hybrid">Hybrid local + shared</option>
                    </select>
                  </div>
                </div>

                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerNetworkMode">Network pattern <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune network pattern before regenerating the diagram." aria-label="Tune network pattern before regenerating the diagram.">i</span></label>                  <div class="architecture-physical-server-native-select-wrap" id="architecturePhysicalServerNetworkModeSelect">
                    <select id="architecturePhysicalServerNetworkMode" class="form-select architecture-physical-server-native-select">
                      <option value="segmented-vlans" selected>Segmented VLANs</option>
                      <option value="dual-switch-ha">Dual-switch HA</option>
                      <option value="dmz-edge">DMZ edge stack</option>
                      <option value="flat-lab">Flat lab network</option>
                    </select>
                  </div>
                </div>

                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerServerModel">Server model <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune server model before regenerating the diagram." aria-label="Tune server model before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerServerModel" class="form-control" value="Dell PowerEdge R740xd">
                </div>

                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerStoragePlatform">Storage platform <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune storage platform before regenerating the diagram." aria-label="Tune storage platform before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerStoragePlatform" class="form-control" value="Synology NAS Cluster">
                </div>

                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerMgmtTool">Management plane <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune management plane before regenerating the diagram." aria-label="Tune management plane before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerMgmtTool" class="form-control" value="Proxmox VE + OpenStack Horizon">
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-physical-server-config-panel" id="architecturePhysicalServerNetworkPanel" data-config-panel role="tabpanel" aria-labelledby="architecturePhysicalServerNetworkTab" hidden>
              <div class="architecture-physical-server-config-grid">
                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerManagementNetwork">Management network <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune management network before regenerating the diagram." aria-label="Tune management network before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerManagementNetwork" class="form-control" value="VLAN 10 - 10.0.10.0/24">
                </div>
                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerStorageNetwork">Storage network <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune storage network before regenerating the diagram." aria-label="Tune storage network before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerStorageNetwork" class="form-control" value="VLAN 20 - 10.0.20.0/24">
                </div>
                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerTenantNetwork">Tenant / VM network <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune tenant / vm network before regenerating the diagram." aria-label="Tune tenant / vm network before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerTenantNetwork" class="form-control" value="VLAN 30 - 10.0.30.0/24">
                </div>
                <div class="architecture-physical-server-control-stack">
                  <label class="tool-control-label" for="architecturePhysicalServerBackupNetwork">Backup network <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune backup network before regenerating the diagram." aria-label="Tune backup network before regenerating the diagram.">i</span></label>
                  <input type="text" id="architecturePhysicalServerBackupNetwork" class="form-control" value="VLAN 40 - 10.0.40.0/24">
                </div>
                <div class="architecture-physical-server-control-stack architecture-physical-server-wide-control">
                  <label class="tool-control-label" for="architecturePhysicalServerNetworkNotes">Network notes <span class="architecture-physical-server-helper-chip architecture-physical-server-custom-helper-chip" title="Tune network notes before regenerating the diagram." aria-label="Tune network notes before regenerating the diagram.">i</span></label>
                  <textarea id="architecturePhysicalServerNetworkNotes" class="form-control architecture-physical-server-note-input">Router / gateway, firewall, core switch, separated management, storage, tenant, and backup traffic.</textarea>
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-physical-server-config-panel" id="architecturePhysicalServerOperationsPanel" data-config-panel role="tabpanel" aria-labelledby="architecturePhysicalServerOperationsTab" hidden>
              <div class="architecture-physical-server-toggle-grid">
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Proxmox VE</span>
                  <input type="checkbox" id="architecturePhysicalServerProxmox" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">OpenStack Horizon</span>
                  <input type="checkbox" id="architecturePhysicalServerHorizon" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Synology DSM</span>
                  <input type="checkbox" id="architecturePhysicalServerSynologyDsm" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Zabbix monitoring</span>
                  <input type="checkbox" id="architecturePhysicalServerZabbix" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Central syslog</span>
                  <input type="checkbox" id="architecturePhysicalServerSyslog" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Out-of-band / IPMI</span>
                  <input type="checkbox" id="architecturePhysicalServerOutOfBand" checked>
                </label>
              </div>
            </div>

            <div class="tool-inspector-section architecture-physical-server-config-panel" id="architecturePhysicalServerBackupPanel" data-config-panel role="tabpanel" aria-labelledby="architecturePhysicalServerBackupTab" hidden>
              <div class="architecture-physical-server-toggle-grid">
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Snapshot replication</span>
                  <input type="checkbox" id="architecturePhysicalServerSnapshots" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Offsite backup</span>
                  <input type="checkbox" id="architecturePhysicalServerOffsiteBackup" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Disaster recovery plan</span>
                  <input type="checkbox" id="architecturePhysicalServerDisasterRecovery" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Redundant power</span>
                  <input type="checkbox" id="architecturePhysicalServerRedundantPower" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Cooling / hot-cold aisle</span>
                  <input type="checkbox" id="architecturePhysicalServerCooling" checked>
                </label>
                <label class="architecture-physical-server-toggle-item">
                  <span class="architecture-physical-server-toggle-copy">Physical security</span>
                  <input type="checkbox" id="architecturePhysicalServerPhysicalSecurity" checked>
                </label>
              </div>
            </div>
          </div>
        </details>
        {# ns:end family._base.workspace.03_custom-settings #}

        {# ns:start family.architecture.workspace.04_selected-item #}
        <div class="tool-inspector-section architecture-physical-server-selected-section" id="architecturePhysicalServerSelectedShell" data-section="selected-item" data-root-selector=".architecture-physical-server-tool">
          <h3 class="architecture-physical-server-section-title">Selected item</h3>
          <p class="architecture-physical-server-selected-empty architecture-physical-server-selected-empty-chips" id="architecturePhysicalServerSelectedEmpty" aria-label="Select a draggable box in the stage to move, resize, or highlight it. Select a line to adjust its bend handle. Arrow keys move the selected box; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
            <span class="architecture-physical-server-selected-empty-copy">
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a draggable box</span>
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Select a line to adjust bends</span>
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected box</span>
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
              <span class="architecture-physical-server-selected-hint-chip architecture-physical-server-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
            </span>
          </p>

          <div class="architecture-physical-server-selected-editor d-none" id="architecturePhysicalServerSelectedEditor">
            <div class="architecture-physical-server-selected-name" id="architecturePhysicalServerSelectedName"></div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architecturePhysicalServerSelectedX">X position</label>
              <div class="tool-control-field">
                <input type="number" id="architecturePhysicalServerSelectedX" class="form-control" min="0" step="4">
              </div>
            </div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architecturePhysicalServerSelectedY">Y position</label>
              <div class="tool-control-field">
                <input type="number" id="architecturePhysicalServerSelectedY" class="form-control" min="0" step="4">
              </div>
            </div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architecturePhysicalServerSelectedWidth">Width</label>
              <div class="tool-control-field">
                <input type="number" id="architecturePhysicalServerSelectedWidth" class="form-control" min="96" step="4">
              </div>
            </div>

            <div class="tool-control-row">
              <label class="tool-control-label" for="architecturePhysicalServerSelectedHeight">Height</label>
              <div class="tool-control-field">
                <input type="number" id="architecturePhysicalServerSelectedHeight" class="form-control" min="44" step="4">
              </div>
            </div>

            <div class="architecture-physical-server-selected-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architecturePhysicalServerHighlightItem">Highlight box</button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architecturePhysicalServerApplyItemSize">Apply item</button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architecturePhysicalServerResetItemSize">Reset item</button>
            </div>
          </div>
        </div>
        {# ns:end family.architecture.workspace.04_selected-item #}
      </div>
    </section>

    <section class="tool-shell tool-stage-shell architecture-physical-server-stage-shell" id="architecturePhysicalServerStageShell" data-section="diagram-buttons" data-root-selector=".architecture-physical-server-tool" aria-labelledby="architecturePhysicalServerStageTitle">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <header class="tool-shell-header architecture-physical-server-stage-header">
        <div class="architecture-physical-server-stage-heading">
          <h2 class="tool-shell-title" id="architecturePhysicalServerStageTitle">Physical Server Architecture</h2>
          <p class="tool-shell-subtitle" id="architecturePhysicalServerStageSubtitle"><span class="architecture-physical-server-stage-preset-chip">On-Prem Private Cloud preset</span></p>
        </div>
        <div class="architecture-physical-server-stage-meta" id="architecturePhysicalServerStageMeta"></div>
      </header>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="architecture-physical-server-stage-toolbar-actions">
          <div class="architecture-physical-server-zoom-control" id="architecturePhysicalServerZoomControl">
          <button type="button" class="architecture-physical-server-zoom-step" id="architecturePhysicalServerZoomOut" aria-label="Zoom out" title="Zoom out"><i class="bi bi-dash" aria-hidden="true"></i></button>
          <input type="number" id="architecturePhysicalServerZoomInput" class="architecture-physical-server-zoom-input" min="25" max="180" step="1" value="80" aria-label="Zoom percentage">
          <span class="architecture-physical-server-zoom-label" id="architecturePhysicalServerZoomLabel">%</span>
          <button type="button" class="architecture-physical-server-zoom-step" id="architecturePhysicalServerZoomIn" aria-label="Zoom in" title="Zoom in"><i class="bi bi-plus" aria-hidden="true"></i></button>
          </div>
          <button type="button" class="architecture-physical-server-icon-btn" id="architecturePhysicalServerZoomFit" aria-label="Zoom to fit" title="Zoom to fit"><i class="bi bi-arrows-angle-contract" aria-hidden="true"></i></button>
