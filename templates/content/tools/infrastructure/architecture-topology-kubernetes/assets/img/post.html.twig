{% set post_start = post.card_gradient_start|default('#06B6D4') %}
{% set post_end = post.card_gradient_end|default('#10B981') %}
{% set post_title = post.card_image_title|default(post.title|default('Kubernetes Topology Architecture')) %}
{% set post_kicker = post.card_kicker|default(post.category|default('Infrastructure')) %}

<style>
  .architecture-topology-kubernetes-post-visual {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--post-start), var(--post-end));
    color: #ffffff;
    font-family: Roboto, Arial, sans-serif;
    padding: 34px;
  }

  .architecture-topology-kubernetes-post-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.55;
  }

  .architecture-topology-kubernetes-post-header,
  .architecture-topology-kubernetes-post-body {
    position: relative;
    z-index: 1;
  }

  .architecture-topology-kubernetes-post-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .architecture-topology-kubernetes-post-kicker,
  .architecture-topology-kubernetes-post-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 800;
  }

  .architecture-topology-kubernetes-post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.9fr);
    gap: 34px;
    align-items: center;
    margin-top: 44px;
  }

  .architecture-topology-kubernetes-post-label {
    display: block;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
    opacity: 0.88;
  }

  .architecture-topology-kubernetes-post-copy h2 {
    max-width: 620px;
    margin: 0;
    font-family: Nunito, Roboto, Arial, sans-serif;
    font-size: 46px;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .architecture-topology-kubernetes-post-copy p {
    max-width: 620px;
    margin: 18px 0 0;
    font-size: 19px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
  }

  .architecture-topology-kubernetes-post-diagram {
    display: grid;
    gap: 14px;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: 0 24px 60px rgba(6, 78, 59, 0.24);
  }

  .architecture-topology-kubernetes-post-node {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    border-radius: 16px;
    background: #ffffff;
    color: #0f172a;
    padding: 12px 14px;
    font-weight: 900;
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.14);
  }

  .architecture-topology-kubernetes-post-node i {
    color: #0891b2;
  }

  @media (max-width: 720px) {
    .architecture-topology-kubernetes-post-body {
      grid-template-columns: 1fr;
    }

    .architecture-topology-kubernetes-post-copy h2 {
      font-size: 34px;
    }
  }
</style>

<div class="tool-post-visual architecture-topology-kubernetes-post-visual" style="--post-start: {{ post_start }}; --post-end: {{ post_end }};">
  <div class="architecture-topology-kubernetes-post-grid" aria-hidden="true"></div>
  <div class="architecture-topology-kubernetes-post-header">
    <span class="architecture-topology-kubernetes-post-kicker">{{ post_kicker }}</span>
    <span class="architecture-topology-kubernetes-post-pill"><i class="bi bi-diagram-3"></i> Editable topology</span>
  </div>
  <div class="architecture-topology-kubernetes-post-body">
    <div class="architecture-topology-kubernetes-post-copy">
      <span class="architecture-topology-kubernetes-post-label">InfraStack Workspace</span>
      <h2>{{ post_title }}</h2>
      <p>Map control plane, workers, Pods, Services, policy, storage, and observability into one exportable Kubernetes review model.</p>
    </div>
    <div class="architecture-topology-kubernetes-post-diagram" aria-hidden="true">
      <span class="architecture-topology-kubernetes-post-node architecture-topology-kubernetes-post-node-control"><i class="bi bi-cpu"></i> Control Plane</span>
      <span class="architecture-topology-kubernetes-post-node architecture-topology-kubernetes-post-node-worker"><i class="bi bi-hdd-network"></i> Worker Nodes</span>
      <span class="architecture-topology-kubernetes-post-node architecture-topology-kubernetes-post-node-pods"><i class="bi bi-boxes"></i> Pods</span>
      <span class="architecture-topology-kubernetes-post-node architecture-topology-kubernetes-post-node-service"><i class="bi bi-signpost-split"></i> Services</span>
    </div>
  </div>
</div>
