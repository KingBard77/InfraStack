{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}
<div class="architecture-topology-kubernetes-tool" data-tool-slug="architecture-topology-kubernetes" data-tool-category="Infrastructure" data-tool-family="architecture">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <div class="tool-shell tool-prompt-shell architecture-topology-kubernetes-input-card" id="architectureTopologyKubernetesInputShell" aria-label="Kubernetes topology prompt">
      <div class="architecture-topology-kubernetes-input-brief" data-input-layout="stacked">
        <div class="architecture-topology-kubernetes-input-row">
          <div class="architecture-topology-kubernetes-input-label-wrap">
            <label for="architectureTopologyKubernetesInput" class="tool-main-label architecture-topology-kubernetes-input-label">Topology prompt</label>
            <span class="architecture-topology-kubernetes-helper-chip" title="Describe the cluster boundary, control plane, workers, workloads, Services, and traffic path." aria-label="Describe the cluster boundary, control plane, workers, workloads, Services, and traffic path.">i</span>
          </div>
          <div class="tool-main-input-grid architecture-topology-kubernetes-main-input-grid architecture-topology-kubernetes-input-stack">
            <textarea
              id="architectureTopologyKubernetesInput"
              class="form-control architecture-topology-kubernetes-prompt architecture-topology-kubernetes-input-control"
              rows="7"
              placeholder="Describe the Kubernetes topology: control plane, worker nodes, Pods, Services, ingress, policy, storage, and observability."
            >Create a Kubernetes topology with one managed control plane, three worker nodes, kubelet and kube-proxy on each node, frontend and API workloads, ClusterIP Services, ingress at the edge, NetworkPolicy boundaries, persistent storage, and platform observability.</textarea>
            <span class="architecture-topology-kubernetes-visually-hidden" id="architectureTopologyKubernetesPrompt"></span>
            <div class="architecture-topology-kubernetes-input-error d-none" id="architectureTopologyKubernetesInputError" role="alert"></div>
          </div>
        </div>

        <div class="architecture-topology-kubernetes-main-actions architecture-topology-kubernetes-input-actions">
          <button type="button" class="tool-action-btn tool-action-btn-primary architecture-topology-kubernetes-action-btn architecture-topology-kubernetes-action-btn-primary" id="architectureTopologyKubernetesGenerate">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span>Generate Diagram</span>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-secondary architecture-topology-kubernetes-action-btn architecture-topology-kubernetes-action-btn-secondary" id="architectureTopologyKubernetesReset">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
          <button type="button" class="architecture-topology-kubernetes-visually-hidden" id="architectureTopologyKubernetesPrimaryAction" tabindex="-1" aria-hidden="true">Generate Diagram</button>
          <button type="button" class="architecture-topology-kubernetes-visually-hidden" id="architectureTopologyKubernetesSecondaryAction" tabindex="-1" aria-hidden="true">Reset</button>
        </div>

        <div class="architecture-topology-kubernetes-input-helper-card">
          <span class="architecture-topology-kubernetes-input-hint">Use one cluster brief with control-plane context, workers, workloads, Services, ingress, policy, storage, and observability. Basic and Custom controls update the same generated model, exports, and JSON restore state.</span>
          <span class="architecture-topology-kubernetes-helper-chip architecture-topology-kubernetes-helper-chip-inline" title="The workspace does not connect to a live Kubernetes API server." aria-label="The workspace does not connect to a live Kubernetes API server.">i</span>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureTopologyKubernetesErrorState"></div>

    <div class="architecture-topology-kubernetes-advanced-grid">
      <aside class="tool-shell tool-inspector-shell architecture-topology-kubernetes-inspector-shell" aria-label="Kubernetes topology controls">
        <div class="tool-shell-body architecture-topology-kubernetes-inspector-body">
          {# ns:start family._base.workspace.02_basic-settings #}
          <div class="tool-inspector-section architecture-topology-kubernetes-basic-preset-section architecture-topology-kubernetes-basic-card" aria-label="Basic settings">
            <div class="architecture-topology-kubernetes-example-card">
              <span class="architecture-topology-kubernetes-example-label">Example topology settings</span>
              <strong class="architecture-topology-kubernetes-example-value">Managed cluster, three workers, ingress and Services</strong>
              <span class="architecture-topology-kubernetes-example-helper">Preset, profile, environment, and control-plane visibility seed the first generated model.</span>
            </div>

            <div class="architecture-topology-kubernetes-basic-grid">
              <div class="architecture-topology-kubernetes-control-stack architecture-topology-kubernetes-setting-card">
                <label class="tool-control-label architecture-topology-kubernetes-setting-label" for="architectureTopologyKubernetesBasicPrimary">Preset <span class="architecture-topology-kubernetes-helper-chip" title="Choose the topology viewpoint used by the generated model." aria-label="Choose the topology viewpoint used by the generated model.">i</span></label>
                <div class="architecture-topology-kubernetes-native-select-wrap">
                  <select id="architectureTopologyKubernetesBasicPrimary" class="form-select architecture-topology-kubernetes-native-select">
                    <option value="cluster" selected>Cluster Topology</option>
                    <option value="traffic">Traffic Flow</option>
                    <option value="workload">Workload Placement</option>
                    <option value="platform">Platform Services</option>
                  </select>
                </div>
              </div>

              <div class="architecture-topology-kubernetes-control-stack architecture-topology-kubernetes-setting-card">
                <label class="tool-control-label architecture-topology-kubernetes-setting-label" for="architectureTopologyKubernetesClusterProfile">Cluster profile <span class="architecture-topology-kubernetes-helper-chip" title="Choose the cluster operating profile." aria-label="Choose the cluster operating profile.">i</span></label>                <div class="architecture-topology-kubernetes-native-select-wrap" id="architectureTopologyKubernetesClusterProfileSelect">
                  <select id="architectureTopologyKubernetesClusterProfile" class="form-select architecture-topology-kubernetes-native-select">
                    <option value="managed-regional" selected>Managed Regional</option>
                    <option value="self-managed">Self Managed</option>
                    <option value="edge-small">Edge Small</option>
                    <option value="multi-tenant">Multi Tenant</option>
                  </select>
                </div>
              </div>

              <div class="architecture-topology-kubernetes-control-stack architecture-topology-kubernetes-setting-card">
                <label class="tool-control-label architecture-topology-kubernetes-setting-label" for="architectureTopologyKubernetesBasicText">Environment <span class="architecture-topology-kubernetes-helper-chip" title="Use environment wording in labels and export notes." aria-label="Use environment wording in labels and export notes.">i</span></label>
                <div class="architecture-topology-kubernetes-native-select-wrap" id="architectureTopologyKubernetesBasicTextSelect">
                  <select id="architectureTopologyKubernetesBasicText" class="form-select architecture-topology-kubernetes-native-select">
                    <option value="Production">Production</option>
                    <option value="Development">Development</option>
                    <option value="Staging" selected>Staging</option>
                  </select>
                </div>
              </div>

              <label class="architecture-topology-kubernetes-switch-card architecture-topology-kubernetes-setting-card" for="architectureTopologyKubernetesBasicToggle">
                <span>
                  <span class="tool-control-label architecture-topology-kubernetes-setting-label">Control plane</span>
                  <span class="tool-control-hint architecture-topology-kubernetes-setting-hint">Show API server, scheduler, controllers, and etcd.</span>
                </span>
                <input type="checkbox" id="architectureTopologyKubernetesBasicToggle" checked>
                <span class="architecture-topology-kubernetes-switch-track" aria-hidden="true"></span>
              </label>

              <p class="tool-control-hint architecture-topology-kubernetes-setting-hint" id="architectureTopologyKubernetesPresetDescription">Control plane, worker nodes, Services, ingress, policy, storage, and observability are prepared as an editable topology preview.</p>
            </div>
          </div>
          {# ns:end family._base.workspace.02_basic-settings #}

          {# ns:start family._base.workspace.03_custom-settings #}
          <details class="architecture-topology-kubernetes-custom-panel architecture-topology-kubernetes-custom-settings" id="architectureTopologyKubernetesCustomSettings" data-custom-layout="tabbed_two_column" open>
            <summary class="architecture-topology-kubernetes-custom-panel-summary architecture-topology-kubernetes-custom-summary">
              <span>Custom</span>
              <span class="architecture-topology-kubernetes-custom-arrow-slot" aria-hidden="true"></span>
            </summary>

            <div class="architecture-topology-kubernetes-custom-panel-body architecture-topology-kubernetes-custom-body">
              <div class="architecture-topology-kubernetes-config-tabs" role="tablist" aria-label="Kubernetes custom settings">
                <button type="button" class="architecture-topology-kubernetes-config-tab active" id="architectureTopologyKubernetesNetworkConfigTab" data-config-tab-target="architectureTopologyKubernetesNetworkConfigPanel" role="tab" aria-controls="architectureTopologyKubernetesNetworkConfigPanel" aria-selected="true" tabindex="0">Network layout</button>
                <button type="button" class="architecture-topology-kubernetes-config-tab" id="architectureTopologyKubernetesWorkloadConfigTab" data-config-tab-target="architectureTopologyKubernetesWorkloadConfigPanel" role="tab" aria-controls="architectureTopologyKubernetesWorkloadConfigPanel" aria-selected="false" tabindex="-1">Workload</button>
                <button type="button" class="architecture-topology-kubernetes-config-tab" id="architectureTopologyKubernetesServicesConfigTab" data-config-tab-target="architectureTopologyKubernetesServicesConfigPanel" role="tab" aria-controls="architectureTopologyKubernetesServicesConfigPanel" aria-selected="false" tabindex="-1">Services and controls</button>
              </div>

              <div class="tool-inspector-section architecture-topology-kubernetes-config-panel active" id="architectureTopologyKubernetesNetworkConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureTopologyKubernetesNetworkConfigTab">
                <div class="architecture-topology-kubernetes-config-grid">
                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesNamespace">Namespace focus <span class="architecture-topology-kubernetes-helper-chip architecture-topology-kubernetes-custom-helper-chip" title="Name the namespace boundary shown in the topology." aria-label="Name the namespace boundary shown in the topology.">i</span></label>
                    <input type="text" id="architectureTopologyKubernetesNamespace" class="form-control architecture-topology-kubernetes-custom-text-field" value="platform" placeholder="platform">
                  </div>

                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesServiceType">Service exposure <span class="architecture-topology-kubernetes-helper-chip architecture-topology-kubernetes-custom-helper-chip" title="Choose the Service exposure model." aria-label="Choose the Service exposure model.">i</span></label>                    <div class="architecture-topology-kubernetes-native-select-wrap" id="architectureTopologyKubernetesServiceTypeSelect">
                      <select id="architectureTopologyKubernetesServiceType" class="form-select architecture-topology-kubernetes-native-select">
                        <option value="ClusterIP" selected>ClusterIP</option>
                        <option value="NodePort">NodePort</option>
                        <option value="LoadBalancer">LoadBalancer</option>
                        <option value="Gateway API">Gateway API</option>
                      </select>
                    </div>
                  </div>

                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesIngressMode">Ingress pattern <span class="architecture-topology-kubernetes-helper-chip architecture-topology-kubernetes-custom-helper-chip" title="Choose the north-south traffic entry pattern." aria-label="Choose the north-south traffic entry pattern.">i</span></label>                    <div class="architecture-topology-kubernetes-native-select-wrap" id="architectureTopologyKubernetesIngressModeSelect">
                      <select id="architectureTopologyKubernetesIngressMode" class="form-select architecture-topology-kubernetes-native-select">
                        <option value="ingress-controller" selected>Ingress Controller</option>
                        <option value="gateway-api">Gateway API</option>
                        <option value="service-mesh">Service Mesh</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section architecture-topology-kubernetes-config-panel" id="architectureTopologyKubernetesWorkloadConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureTopologyKubernetesWorkloadConfigTab" hidden>
                <div class="architecture-topology-kubernetes-config-grid">
                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesWorkerCount">Worker nodes</label>
                    <input type="number" id="architectureTopologyKubernetesWorkerCount" class="form-control architecture-topology-kubernetes-custom-number-field" min="1" max="6" step="1" value="3">
                  </div>
                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesPodGroups">Pod groups</label>
                    <input type="number" id="architectureTopologyKubernetesPodGroups" class="form-control architecture-topology-kubernetes-custom-number-field" min="1" max="8" step="1" value="3">
                  </div>
                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesReplicaTarget">Replica target</label>
                    <input type="number" id="architectureTopologyKubernetesReplicaTarget" class="form-control architecture-topology-kubernetes-custom-number-field" min="1" max="12" step="1" value="3">
                  </div>
                  <div class="architecture-topology-kubernetes-control-stack">
                    <label class="tool-control-label" for="architectureTopologyKubernetesNodeRuntime">Node runtime</label>                    <div class="architecture-topology-kubernetes-native-select-wrap" id="architectureTopologyKubernetesNodeRuntimeSelect">
                      <select id="architectureTopologyKubernetesNodeRuntime" class="form-select architecture-topology-kubernetes-native-select">
                        <option value="containerd" selected>containerd</option>
                        <option value="cri-o">CRI-O</option>
                        <option value="mixed">Mixed Runtime</option>
                      </select>
                    </div>
                  </div>
                  <div class="architecture-topology-kubernetes-control-stack architecture-topology-kubernetes-control-stack-wide">
                    <label class="tool-control-label" for="architectureTopologyKubernetesWorkloads">Workload labels</label>
                    <textarea id="architectureTopologyKubernetesWorkloads" class="form-control architecture-topology-kubernetes-custom-textarea" rows="4" placeholder="frontend&#10;api&#10;worker">frontend&#10;api&#10;worker</textarea>
                  </div>
                  <div class="architecture-topology-kubernetes-control-stack architecture-topology-kubernetes-control-stack-wide">
                    <label class="tool-control-label" for="architectureTopologyKubernetesObjects">Kubernetes objects</label>
                    <textarea id="architectureTopologyKubernetesObjects" class="form-control architecture-topology-kubernetes-custom-textarea" rows="4" placeholder="Deployment&#10;Service&#10;ConfigMap">Deployment&#10;Service&#10;Ingress</textarea>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section architecture-topology-kubernetes-config-panel" id="architectureTopologyKubernetesServicesConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureTopologyKubernetesServicesConfigTab" hidden>
                <div class="architecture-topology-kubernetes-toggle-grid">
                  <label class="architecture-topology-kubernetes-toggle-item">
                    <span class="architecture-topology-kubernetes-toggle-copy">NetworkPolicy lane</span>
                    <input type="checkbox" id="architectureTopologyKubernetesShowNetworkPolicy" checked>
                  </label>
                  <label class="architecture-topology-kubernetes-toggle-item">
                    <span class="architecture-topology-kubernetes-toggle-copy">Persistent storage</span>
                    <input type="checkbox" id="architectureTopologyKubernetesShowStorage" checked>
                  </label>
                  <label class="architecture-topology-kubernetes-toggle-item">
                    <span class="architecture-topology-kubernetes-toggle-copy">Observability lane</span>
                    <input type="checkbox" id="architectureTopologyKubernetesShowObservability" checked>
                  </label>
                </div>
              </div>
            </div>
          </details>
          {# ns:end family._base.workspace.03_custom-settings #}

          {# ns:start family.architecture.workspace.04_selected-item #}
          <div class="tool-inspector-section architecture-topology-kubernetes-selected-section" id="architectureTopologyKubernetesSelectedShell">
            <h3 class="architecture-topology-kubernetes-section-title">Selected item</h3>
            <p class="architecture-topology-kubernetes-selected-empty architecture-topology-kubernetes-selected-empty-chips" id="architectureTopologyKubernetesSelectedEmpty" aria-label="Select a draggable box in the stage to move, resize, or highlight it. Select a connector path to adjust its arrow handles. Arrow keys move the selected box; Shift moves faster; Alt plus arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
              <span class="architecture-topology-kubernetes-selected-empty-copy">
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a draggable box</span>
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Adjust connector handles</span>
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected box</span>
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-keyboard"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrows resize</span>
                <span class="architecture-topology-kubernetes-selected-hint-chip architecture-topology-kubernetes-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
              </span>
            </p>

            <div class="architecture-topology-kubernetes-selected-editor d-none" id="architectureTopologyKubernetesSelectedEditor">
              <label class="tool-control-label" for="architectureTopologyKubernetesSelectedName">Name</label>
              <input type="text" id="architectureTopologyKubernetesSelectedName" class="form-control architecture-topology-kubernetes-selected-name">
              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureTopologyKubernetesSelectedX">X position</label>
                <div class="tool-control-field"><input type="number" id="architectureTopologyKubernetesSelectedX" class="form-control" min="0" step="4"></div>
              </div>
              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureTopologyKubernetesSelectedY">Y position</label>
                <div class="tool-control-field"><input type="number" id="architectureTopologyKubernetesSelectedY" class="form-control" min="0" step="4"></div>
              </div>
              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureTopologyKubernetesSelectedWidth">Width</label>
                <div class="tool-control-field"><input type="number" id="architectureTopologyKubernetesSelectedWidth" class="form-control" min="96" step="4"></div>
              </div>
              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureTopologyKubernetesSelectedHeight">Height</label>
                <div class="tool-control-field"><input type="number" id="architectureTopologyKubernetesSelectedHeight" class="form-control" min="44" step="4"></div>
              </div>
              <div class="architecture-topology-kubernetes-selected-actions">
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureTopologyKubernetesHighlightCard">Highlight box</button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureTopologyKubernetesApplyCardSize">Apply item</button>
                <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureTopologyKubernetesResetCardSize">Reset item</button>
              </div>
            </div>
          </div>
          {# ns:end family.architecture.workspace.04_selected-item #}
        </div>
      </aside>
    </div>

    <section class="tool-shell tool-stage-shell architecture-topology-kubernetes-stage-shell" id="architectureTopologyKubernetesStageShell" data-section="diagram-buttons" data-root-selector=".architecture-topology-kubernetes-tool" aria-label="Kubernetes topology stage">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-shell-header architecture-topology-kubernetes-stage-header" data-section="title" data-root-selector=".architecture-topology-kubernetes-tool">
        <div class="architecture-topology-kubernetes-stage-heading">
          <h2 class="tool-shell-title" id="architectureTopologyKubernetesStageTitle">Kubernetes Topology Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureTopologyKubernetesStageSubtitle"><span class="architecture-topology-kubernetes-stage-preset-chip">Cluster Topology preset</span></p>
        </div>
        <div class="architecture-topology-kubernetes-stage-meta" id="architectureTopologyKubernetesStageMeta">Preview</div>
      </div>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="architecture-topology-kubernetes-stage-toolbar-actions">
          <div class="architecture-topology-kubernetes-zoom-control" id="architectureTopologyKubernetesZoomControl">
            <button type="button" class="architecture-topology-kubernetes-zoom-step" id="architectureTopologyKubernetesZoomOut" aria-label="Zoom out" title="Zoom out"><i class="bi bi-dash" aria-hidden="true"></i></button>
            <input type="number" id="architectureTopologyKubernetesZoomInput" class="architecture-topology-kubernetes-zoom-input" value="100" min="50" max="160" step="10" aria-label="Zoom percentage">
            <span class="architecture-topology-kubernetes-zoom-label" id="architectureTopologyKubernetesZoomLabel">%</span>
            <button type="button" class="architecture-topology-kubernetes-zoom-step" id="architectureTopologyKubernetesZoomIn" aria-label="Zoom in" title="Zoom in"><i class="bi bi-plus" aria-hidden="true"></i></button>
          </div>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesZoomFit" aria-label="Zoom to fit" title="Zoom to fit"><i class="bi bi-arrows-angle-contract" aria-hidden="true"></i></button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%"><span>100</span></button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false"><i class="bi bi-bounding-box" aria-hidden="true"></i></button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesZoomHideUi" aria-label="Hide UI" title="Hide UI"><i class="bi bi-eye-slash" aria-hidden="true"></i></button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesFullscreen" aria-label="Open fullscreen" title="Open fullscreen"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-topology-kubernetes-stage-toolbar-btn" id="architectureTopologyKubernetesResetLayout" aria-label="Auto layout" title="Auto layout">Auto layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty d-none" id="architectureTopologyKubernetesStageEmpty">Generate a topology to fill the stage.</div>
        <div class="tool-stage-canvas architecture-topology-kubernetes-stage-canvas architecture-topology-kubernetes-stage-preview" id="architectureTopologyKubernetesStageCanvas">
          <svg class="architecture-topology-kubernetes-stage-svg" id="architectureTopologyKubernetesDiagram" viewBox="0 0 1180 820" role="img" aria-label="Kubernetes topology architecture preview">
            <defs>
              <marker id="architectureTopologyKubernetesArrow" markerWidth="11" markerHeight="11" refX="10" refY="5.5" orient="auto" markerUnits="userSpaceOnUse">
                <path d="M 0 0 L 11 5.5 L 0 11 z" class="architecture-topology-kubernetes-connector-arrow"></path>
              </marker>
              <marker id="architectureTopologyKubernetesArrowActive" markerWidth="11" markerHeight="11" refX="10" refY="5.5" orient="auto" markerUnits="userSpaceOnUse">
                <path d="M 0 0 L 11 5.5 L 0 11 z" class="architecture-topology-kubernetes-connector-arrow"></path>
              </marker>
            </defs>
            <g id="architectureTopologyKubernetesConnectorLayer"></g>
            <g id="architectureTopologyKubernetesDiagramLayer"></g>
          </svg>
          <div class="architecture-topology-kubernetes-stage-preview-overlay" id="architectureTopologyKubernetesPreviewOverlay" role="status">
            <div class="architecture-topology-kubernetes-stage-preview-panel">
              <span class="architecture-topology-kubernetes-stage-preview-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
              <strong>Generate a Kubernetes topology</strong>
              <span>Review the preview, tune controls, then generate the editable workspace and output tables.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="architecture-topology-kubernetes-stage-footer">
        <div class="architecture-topology-kubernetes-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" title="Prompt and preset aware" aria-label="Prompt and preset aware" tabindex="0"><i class="bi bi-stars" aria-hidden="true"></i><span class="architecture-topology-kubernetes-visually-hidden">Prompt and preset aware</span></span>
          <span class="tool-helper-chip tool-helper-chip-inspector" title="Editable inspector controls" aria-label="Editable inspector controls" tabindex="0"><i class="bi bi-sliders2" aria-hidden="true"></i><span class="architecture-topology-kubernetes-visually-hidden">Editable inspector controls</span></span>
