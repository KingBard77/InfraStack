{# tool.html.twig #}

{# ns:start family._base.workspace.00_shell #}
<div class="architecture-topology-kubernetes-tool" data-tool-slug="architecture-topology-kubernetes" data-tool-category="Infrastructure" data-tool-family-shell="base">
  {# ns:start family._base.workspace.01_input-brief #}
  <section class="tool-shell tool-prompt-shell architecture-topology-kubernetes-input-card" id="architectureTopologyKubernetesInputShell" aria-label="Kubernetes topology prompt">
    <div class="architecture-topology-kubernetes-input-brief" data-input-layout="stacked">
      <div class="architecture-topology-kubernetes-input-row">
        <div class="architecture-topology-kubernetes-input-label-wrap">
          <label for="architectureTopologyKubernetesInput" class="tool-main-label architecture-topology-kubernetes-input-label">Topology prompt</label>
          <span class="architecture-topology-kubernetes-helper-chip" title="Describe cluster viewpoint, namespaces, services, ingress, workloads, policy lanes, and platform services" aria-label="Describe cluster viewpoint, namespaces, services, ingress, workloads, policy lanes, and platform services">i</span>
        </div>

        <div class="tool-main-input-grid architecture-topology-kubernetes-main-input-grid architecture-topology-kubernetes-input-stack">
          <textarea
            id="architectureTopologyKubernetesInput"
            class="form-control architecture-topology-kubernetes-prompt architecture-topology-kubernetes-input-control"
            rows="4"
            placeholder="Example: Show ingress, Services, namespaces, worker pools, NetworkPolicy lane, and shared platform services for a staging cluster."
          ></textarea>
          <div class="architecture-topology-kubernetes-input-error d-none" id="architectureTopologyKubernetesInputError" role="alert"></div>
        </div>
      </div>

      <div class="architecture-topology-kubernetes-main-actions architecture-topology-kubernetes-input-actions">
        <button type="button" class="btn btn-primary architecture-topology-kubernetes-action-btn architecture-topology-kubernetes-action-btn-primary" id="architectureTopologyKubernetesPrimaryAction">
          <i class="bi bi-diagram-3" aria-hidden="true"></i>
          <span>Prepare Topology</span>
        </button>
        <button type="button" class="architecture-topology-kubernetes-action-btn architecture-topology-kubernetes-action-btn-secondary" id="architectureTopologyKubernetesSecondaryAction">
          <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          <span>Reset</span>
        </button>
      </div>

      <div class="architecture-topology-kubernetes-input-helper-card">
        <span class="architecture-topology-kubernetes-input-hint">This draft follows the AWS architecture workspace rhythm: prompt first, inspector controls second, visual contract on the stage.</span>
        <span class="architecture-topology-kubernetes-helper-chip architecture-topology-kubernetes-helper-chip-inline" title="Full diagram generation, export, and restore remain out of scope for this draft batch" aria-label="Full diagram generation, export, and restore remain out of scope for this draft batch">i</span>
      </div>
    </div>
  </section>
  {# ns:end family._base.workspace.01_input-brief #}

  <div class="architecture-topology-kubernetes-workspace" aria-label="Kubernetes topology architecture workspace">
    <aside class="tool-shell architecture-topology-kubernetes-inspector-shell" aria-label="Kubernetes topology inspector">
      <header class="architecture-topology-kubernetes-inspector-header">
        <div>
          <h2 class="architecture-topology-kubernetes-inspector-title">Topology Controls</h2>
          <p class="architecture-topology-kubernetes-inspector-copy">Tune the draft model before reviewing the stage.</p>
        </div>
      </header>

      <div class="architecture-topology-kubernetes-inspector-body">
        {# ns:start family._base.workspace.02_basic-settings #}
        <section class="tool-inspector-section architecture-topology-kubernetes-basic-preset-section architecture-topology-kubernetes-basic-card" aria-label="Basic settings">
          <div class="architecture-topology-kubernetes-example-card">
            <span class="architecture-topology-kubernetes-example-label">Example topology settings</span>
            <strong class="architecture-topology-kubernetes-example-value">Cluster layout, staging environment, three node groups</strong>
            <span class="architecture-topology-kubernetes-example-helper">Use Basic settings for the topology choices that every draft should expose first.</span>
          </div>

          <div class="architecture-topology-kubernetes-basic-grid">
            <div class="architecture-topology-kubernetes-setting-card">
              <div class="architecture-topology-kubernetes-setting-label-wrap">
                <label class="tool-control-label architecture-topology-kubernetes-setting-label" for="architectureTopologyKubernetesBasicPrimary">Viewpoint</label>
                <span class="architecture-topology-kubernetes-helper-chip" title="Choose the first topology viewpoint for the draft preview" aria-label="Choose the first topology viewpoint for the draft preview">i</span>
              </div>
              <select id="architectureTopologyKubernetesBasicPrimary" class="form-select architecture-topology-kubernetes-native-select">
                <option value="Cluster layout" selected>Cluster layout</option>
                <option value="Namespace map">Namespace map</option>
                <option value="Traffic flow">Traffic flow</option>
              </select>
            </div>

            <div class="architecture-topology-kubernetes-setting-card">
              <div class="architecture-topology-kubernetes-setting-label-wrap">
                <span class="tool-control-label architecture-topology-kubernetes-setting-label">Environment</span>
                <span class="architecture-topology-kubernetes-helper-chip" title="Use environment context to tune labels without claiming production readiness" aria-label="Use environment context to tune labels without claiming production readiness">i</span>
              </div>
              <details class="architecture-topology-kubernetes-select" id="architectureTopologyKubernetesBasicSelect">
                <summary class="architecture-topology-kubernetes-select-summary">
                  <span id="architectureTopologyKubernetesBasicSelectSummary">Staging</span>
                  <span class="architecture-topology-kubernetes-select-arrow-slot" aria-hidden="true"></span>
                </summary>
                <div class="architecture-topology-kubernetes-select-body" id="architectureTopologyKubernetesBasicSelectMenu">
                  <label class="architecture-topology-kubernetes-select-option">
                    <input type="radio" name="architectureTopologyKubernetesBasicOption" value="Development">
                    <span class="architecture-topology-kubernetes-select-option-title">Development</span>
                  </label>
                  <label class="architecture-topology-kubernetes-select-option">
                    <input type="radio" name="architectureTopologyKubernetesBasicOption" value="Staging" checked>
                    <span class="architecture-topology-kubernetes-select-option-title">Staging</span>
                  </label>
                  <label class="architecture-topology-kubernetes-select-option">
                    <input type="radio" name="architectureTopologyKubernetesBasicOption" value="Production planning">
                    <span class="architecture-topology-kubernetes-select-option-title">Production planning</span>
                  </label>
                </div>
              </details>
            </div>

            <div class="architecture-topology-kubernetes-setting-card">
              <div class="architecture-topology-kubernetes-setting-label-wrap">
                <label class="tool-control-label architecture-topology-kubernetes-setting-label" for="architectureTopologyKubernetesBasicText">Node groups</label>
                <span class="architecture-topology-kubernetes-helper-chip" title="Keep this as a small draft number until the full topology model exists" aria-label="Keep this as a small draft number until the full topology model exists">i</span>
              </div>
              <input
                type="text"
                id="architectureTopologyKubernetesBasicText"
                class="form-control architecture-topology-kubernetes-text-field"
                placeholder="3"
                value="3"
              >
            </div>

            <div class="architecture-topology-kubernetes-setting-card">
              <div class="architecture-topology-kubernetes-setting-label-wrap">
                <span class="tool-control-label architecture-topology-kubernetes-setting-label">Stateful services</span>
                <span class="architecture-topology-kubernetes-helper-chip" title="Show stateful platform notes in the draft topology preview" aria-label="Show stateful platform notes in the draft topology preview">i</span>
              </div>
              <label class="architecture-topology-kubernetes-switch-card">
                <input type="checkbox" id="architectureTopologyKubernetesBasicToggle">
                <span class="architecture-topology-kubernetes-switch-track" aria-hidden="true"></span>
                <span class="architecture-topology-kubernetes-switch-copy">Enabled</span>
              </label>
            </div>
          </div>
        </section>
        {# ns:end family._base.workspace.02_basic-settings #}

        {# ns:start family._base.workspace.03_custom-settings #}
        <details class="architecture-topology-kubernetes-custom-settings" id="architectureTopologyKubernetesCustomSettings" data-custom-layout="tabbed_two_column" open>
          <summary class="architecture-topology-kubernetes-custom-summary architecture-topology-kubernetes-custom-panel-summary">
            <span>Custom topology</span>
            <span class="architecture-topology-kubernetes-custom-arrow-slot" aria-hidden="true"></span>
          </summary>

          <div class="architecture-topology-kubernetes-custom-body architecture-topology-kubernetes-custom-panel-body">
            <div class="architecture-topology-kubernetes-custom-tabs architecture-topology-kubernetes-config-tabs" role="tablist" aria-label="Kubernetes topology custom configuration">
              <button type="button" class="architecture-topology-kubernetes-custom-tab active" id="architectureTopologyKubernetesCustomTabOne" data-custom-tab-target="architectureTopologyKubernetesCustomPanelOne" role="tab" aria-controls="architectureTopologyKubernetesCustomPanelOne" aria-selected="true" tabindex="0">Topology</button>
              <button type="button" class="architecture-topology-kubernetes-custom-tab" id="architectureTopologyKubernetesCustomTabTwo" data-custom-tab-target="architectureTopologyKubernetesCustomPanelTwo" role="tab" aria-controls="architectureTopologyKubernetesCustomPanelTwo" aria-selected="false" tabindex="-1">Scale</button>
              <button type="button" class="architecture-topology-kubernetes-custom-tab" id="architectureTopologyKubernetesCustomTabThree" data-custom-tab-target="architectureTopologyKubernetesCustomPanelThree" role="tab" aria-controls="architectureTopologyKubernetesCustomPanelThree" aria-selected="false" tabindex="-1">Workloads</button>
            </div>

            <div class="architecture-topology-kubernetes-custom-panel-content active" id="architectureTopologyKubernetesCustomPanelOne" data-custom-panel role="tabpanel" aria-labelledby="architectureTopologyKubernetesCustomTabOne">
              <div class="architecture-topology-kubernetes-custom-grid" data-custom-columns="2">
                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesCustomText">Namespace focus</label>
                  <input
                    type="text"
                    id="architectureTopologyKubernetesCustomText"
                    class="form-control architecture-topology-kubernetes-custom-text-field"
                    placeholder="platform"
                  >
                  <p class="architecture-topology-kubernetes-custom-hint">Optional namespace or domain to highlight in the draft.</p>
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesServiceType">Service exposure</label>
                  <select id="architectureTopologyKubernetesServiceType" class="form-select architecture-topology-kubernetes-custom-text-field">
                    <option value="ClusterIP" selected>ClusterIP</option>
                    <option value="NodePort">NodePort</option>
                    <option value="LoadBalancer">LoadBalancer</option>
                    <option value="ExternalName">ExternalName</option>
                  </select>
                  <p class="architecture-topology-kubernetes-custom-hint">Kubernetes Services abstract Pods and expose stable access paths.</p>
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesCustomSelect">Ingress pattern</label>
                  <details id="architectureTopologyKubernetesCustomSelect" class="architecture-topology-kubernetes-custom-dropdown">
                    <summary class="architecture-topology-kubernetes-custom-dropdown-summary">
                      <span id="architectureTopologyKubernetesCustomSelectValue">Ingress controller</span>
                      <span class="architecture-topology-kubernetes-custom-arrow-slot" aria-hidden="true"></span>
                    </summary>
                    <div class="architecture-topology-kubernetes-custom-dropdown-menu" role="listbox" aria-label="Ingress pattern">
                      <button type="button" class="architecture-topology-kubernetes-custom-dropdown-option active" data-custom-dropdown-value="Ingress controller" role="option" aria-selected="true">Ingress controller</button>
                      <button type="button" class="architecture-topology-kubernetes-custom-dropdown-option" data-custom-dropdown-value="Gateway API" role="option" aria-selected="false">Gateway API</button>
                      <button type="button" class="architecture-topology-kubernetes-custom-dropdown-option" data-custom-dropdown-value="Service mesh" role="option" aria-selected="false">Service mesh</button>
                    </div>
                  </details>
                  <p class="architecture-topology-kubernetes-custom-hint">Choose the north-south traffic entry model for the preview.</p>
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <span class="architecture-topology-kubernetes-custom-label">Diagram density</span>
                  <div class="architecture-topology-kubernetes-custom-radio-group" role="radiogroup" aria-label="Diagram density">
                    <label class="architecture-topology-kubernetes-custom-radio-card">
                      <input type="radio" id="architectureTopologyKubernetesCustomRadioStandard" name="architectureTopologyKubernetesCustomRadio" value="Compact" checked>
                      <span>
                        <span class="architecture-topology-kubernetes-custom-radio-title">Compact</span>
                        <span class="architecture-topology-kubernetes-custom-radio-copy">Summarize namespaces and shared services.</span>
                      </span>
                    </label>
                    <label class="architecture-topology-kubernetes-custom-radio-card">
                      <input type="radio" id="architectureTopologyKubernetesCustomRadioOverride" name="architectureTopologyKubernetesCustomRadio" value="Expanded">
                      <span>
                        <span class="architecture-topology-kubernetes-custom-radio-title">Expanded</span>
                        <span class="architecture-topology-kubernetes-custom-radio-copy">Call out workload groups and traffic layers.</span>
                      </span>
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <div class="architecture-topology-kubernetes-custom-panel-content" id="architectureTopologyKubernetesCustomPanelTwo" data-custom-panel role="tabpanel" aria-labelledby="architectureTopologyKubernetesCustomTabTwo" hidden>
              <div class="architecture-topology-kubernetes-custom-grid" data-custom-columns="2">
                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesCustomNumber">Worker pools</label>
                  <input
                    type="number"
                    id="architectureTopologyKubernetesCustomNumber"
                    class="form-control architecture-topology-kubernetes-custom-number-field"
                    min="1"
                    step="1"
                    placeholder="3"
                    value="3"
                  >
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesReplicaCount">Replica target</label>
                  <input
                    type="number"
                    id="architectureTopologyKubernetesReplicaCount"
                    class="form-control architecture-topology-kubernetes-custom-number-field"
                    min="1"
                    step="1"
                    placeholder="3"
                    value="3"
                  >
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <span class="architecture-topology-kubernetes-custom-label">Add platform services</span>
                  <label class="architecture-topology-kubernetes-custom-checkbox-option">
                    <input type="checkbox" id="architectureTopologyKubernetesCustomToggle" checked>
                    <span>Enabled</span>
                  </label>
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <span class="architecture-topology-kubernetes-custom-label">NetworkPolicy lane</span>
                  <label class="architecture-topology-kubernetes-custom-checkbox-option">
                    <input type="checkbox" id="architectureTopologyKubernetesNetworkPolicy" checked>
                    <span>Enabled</span>
                  </label>
                </div>
              </div>
            </div>

            <div class="architecture-topology-kubernetes-custom-panel-content" id="architectureTopologyKubernetesCustomPanelThree" data-custom-panel role="tabpanel" aria-labelledby="architectureTopologyKubernetesCustomTabThree" hidden>
              <div class="architecture-topology-kubernetes-custom-grid" data-custom-columns="1">
                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesCustomTextarea">Workload groups</label>
                  <textarea
                    id="architectureTopologyKubernetesCustomTextarea"
                    class="form-control architecture-topology-kubernetes-custom-textarea"
                    rows="3"
                    placeholder="frontend&#10;api&#10;workers&#10;platform services"
                  ></textarea>
                </div>

                <div class="architecture-topology-kubernetes-custom-card">
                  <label class="architecture-topology-kubernetes-custom-label" for="architectureTopologyKubernetesObjectTextarea">Kubernetes objects</label>
                  <textarea
                    id="architectureTopologyKubernetesObjectTextarea"
                    class="form-control architecture-topology-kubernetes-custom-textarea"
                    rows="3"
                    placeholder="Deployment/frontend&#10;Service/frontend&#10;Ingress/public&#10;ConfigMap/app-config"
                  ></textarea>
                </div>

                <div class="architecture-topology-kubernetes-custom-info" data-info-layout="auto">
                  <span>Draft only; no full topology diagram is generated.</span>
                  <span>Ready status must be changed in meta.yml before production deploy.</span>
                </div>
              </div>
            </div>
          </div>
        </details>
        {# ns:end family._base.workspace.03_custom-settings #}
      </div>
    </aside>

    {# ns:start family.architecture.workspace.04_visual-contract #}
    <section class="tool-shell tool-stage-shell architecture-topology-kubernetes-visual-contract architecture-topology-kubernetes-stage-shell" id="architectureTopologyKubernetesStageShell" aria-label="Kubernetes topology visual contract">
      <div class="architecture-topology-kubernetes-surface-state" data-state="draft">
        <strong>Draft preview</strong>
        <span id="architectureTopologyKubernetesSummary">Add a brief to prepare the topology preview.</span>
      </div>

      <div class="tool-stage-toolbar">
        <div class="architecture-topology-kubernetes-stage-toolbar-actions">
          <div class="architecture-topology-kubernetes-zoom-control" id="architectureTopologyKubernetesZoomControl">
            <button type="button" class="architecture-topology-kubernetes-zoom-step" id="architectureTopologyKubernetesZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="architectureTopologyKubernetesZoomInput" class="architecture-topology-kubernetes-zoom-input" value="80" min="40" max="160" step="5" aria-label="Zoom percentage">
            <span class="architecture-topology-kubernetes-zoom-label" id="architectureTopologyKubernetesZoomLabel">%</span>
            <button type="button" class="architecture-topology-kubernetes-zoom-step" id="architectureTopologyKubernetesZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false">
            <i class="bi bi-bounding-box"></i>
          </button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash"></i>
          </button>
          <button type="button" class="architecture-topology-kubernetes-icon-btn" id="architectureTopologyKubernetesFullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-topology-kubernetes-stage-toolbar-btn" id="architectureTopologyKubernetesResetLayout" aria-label="Auto arrange layout" title="Auto arrange layout">Auto layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty d-none" id="architectureTopologyKubernetesStageEmpty">Choose a preset to generate diagram.</div>
        <div class="tool-stage-canvas architecture-topology-kubernetes-stage-canvas" id="architectureTopologyKubernetesStageCanvas">
          <svg class="diagram-root architecture-topology-kubernetes-diagram-root" id="architectureTopologyKubernetesDiagram" viewBox="0 0 820 420" role="img" aria-labelledby="architectureTopologyKubernetesDiagramTitle architectureTopologyKubernetesDiagramDesc">
            <title id="architectureTopologyKubernetesDiagramTitle">Kubernetes topology draft</title>
            <desc id="architectureTopologyKubernetesDiagramDesc">Draft topology showing client entry, ingress, Service, workload, namespace, nodes, and optional policy boundary.</desc>
            <defs>
              <marker id="architectureTopologyKubernetesArrow" markerWidth="11" markerHeight="11" refX="9" refY="5.5" orient="auto" markerUnits="userSpaceOnUse">
                <path d="M1,1 L10,5.5 L1,10 Z" fill="currentColor"></path>
              </marker>
            </defs>
            <g id="architectureTopologyKubernetesDiagramLayer"></g>
          </svg>
        </div>
      </div>

      <div class="architecture-topology-kubernetes-stage-footer">
        <div class="architecture-topology-kubernetes-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" title="Prompt and preset aware" aria-label="Prompt and preset aware" tabindex="0">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span class="architecture-topology-kubernetes-visually-hidden">Prompt and preset aware</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-inspector" title="Editable inspector controls" aria-label="Editable inspector controls" tabindex="0">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            <span class="architecture-topology-kubernetes-visually-hidden">Editable inspector controls</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-drag" title="Visual contract draft" aria-label="Visual contract draft" tabindex="0">
            <i class="bi bi-bounding-box" aria-hidden="true"></i>
            <span class="architecture-topology-kubernetes-visually-hidden">Visual contract draft</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-svg" title="SVG workspace" aria-label="SVG workspace" tabindex="0">
            <i class="bi bi-bezier2" aria-hidden="true"></i>
            <span class="architecture-topology-kubernetes-visually-hidden">SVG workspace</span>
          </span>
          <button type="button" class="tool-helper-chip tool-helper-chip-keyboard" id="architectureTopologyKubernetesUsageHelpButton" title="Keyboard shortcuts and usage" aria-label="Open keyboard help" aria-controls="architectureTopologyKubernetesUsageHelpPopup" aria-expanded="false">
            <i class="bi bi-keyboard" aria-hidden="true"></i>
            <span class="architecture-topology-kubernetes-visually-hidden">Keyboard Help</span>
          </button>
        </div>
      </div>

      <div class="architecture-topology-kubernetes-usage-overlay d-none" id="architectureTopologyKubernetesUsageHelpPopup" role="dialog" aria-modal="false" aria-labelledby="architectureTopologyKubernetesUsageHelpTitle">
        <div class="architecture-topology-kubernetes-usage-card">
          <button type="button" class="architecture-topology-kubernetes-usage-close" id="architectureTopologyKubernetesUsageHelpClose" aria-label="Close keyboard help">
            <i class="bi bi-x-lg"></i>
          </button>
          <h3 class="architecture-topology-kubernetes-usage-title" id="architectureTopologyKubernetesUsageHelpTitle">Diagram Controls</h3>
          <p class="architecture-topology-kubernetes-usage-copy">This draft renders a static topology contract before full drag, export, and restore behavior is implemented.</p>
          <div class="architecture-topology-kubernetes-usage-panel">Use zoom controls to inspect the draft stage and Auto layout to restore the default view.</div>
        </div>
      </div>

      <ul id="architectureTopologyKubernetesRows" class="architecture-topology-kubernetes-preview-rows"></ul>
    </section>
    {# ns:end family.architecture.workspace.04_visual-contract #}
  </div>
</div>
{# ns:end family._base.workspace.00_shell #}
