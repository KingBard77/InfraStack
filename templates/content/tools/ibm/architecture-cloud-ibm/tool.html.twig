{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}

<div class="architecture-cloud-ibm-tool" data-tool-slug="architecture-cloud-ibm" data-tool-category="ibm" data-tool-family="architecture" data-tool-canonical="architecture_cloud_ibm">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <section class="tool-shell tool-prompt-shell architecture-cloud-ibm-prompt-shell architecture-cloud-ibm-input-card" id="architectureCloudIbmPromptShell" data-section="architecture-prompt" data-root-selector=".architecture-cloud-ibm-tool" aria-label="IBM Cloud architecture prompt">
      <div class="architecture-cloud-ibm-input-brief" data-input-layout="stacked">
        <div class="architecture-cloud-ibm-input-row">
          <div class="architecture-cloud-ibm-input-label-wrap">
            <label for="architectureCloudIbmPrompt" class="tool-main-label architecture-cloud-ibm-input-label">Architecture prompt</label>
            <span class="architecture-cloud-ibm-helper-chip" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
          </div>
          <div class="tool-main-input-grid architecture-cloud-ibm-main-input-grid architecture-cloud-ibm-input-stack">
            <textarea
              id="architectureCloudIbmPrompt"
              class="form-control architecture-cloud-ibm-prompt architecture-cloud-ibm-input-control"
              rows="7"
              placeholder="Describe the IBM Cloud VPC, region, availability zones, subnet tiers, ingress path, workload runtime, data services, security, and hybrid connectivity."
            >Create a medium IBM Cloud architecture across 3 availability zones. Use VPC CIDR 10.80.0.0/16 with public ingress subnet 10.80.0.0/24, private app subnet 10.80.10.0/24, and private data subnet 10.80.20.0/24. Add Cloud Internet Services, IBM Cloud Load Balancer, security groups, network ACLs, Public Gateway egress, Secrets Manager, Key Protect, Monitoring and Logs, VPC flow logs, resource group prod-app-rg, and edge protected ingress.</textarea>
            <div class="architecture-cloud-ibm-input-error d-none" id="architectureCloudIbmInputError" role="alert"></div>
          </div>
        </div>

        <div class="architecture-cloud-ibm-main-actions architecture-cloud-ibm-input-actions">
          <button
            type="button"
            class="tool-action-btn tool-action-btn-primary architecture-cloud-ibm-action-btn architecture-cloud-ibm-action-btn-primary"
            id="architectureCloudIbmGenerate"
          >
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span data-button-label>Generate Architecture</span>
          </button>
          <button
            type="button"
            class="tool-action-btn tool-action-btn-secondary architecture-cloud-ibm-action-btn architecture-cloud-ibm-action-btn-secondary"
            id="architectureCloudIbmReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span data-button-label>Load Default</span>
          </button>
        </div>

        <div class="architecture-cloud-ibm-input-helper-card">
          <span class="architecture-cloud-ibm-input-hint">Use one brief prompt with workload scale, availability zones, VPC CIDR, subnet tiers, ingress, workload runtime, managed services, security controls, operations, and hybrid connectivity. Preset selection or Generate Architecture creates the editable workspace.</span>
          <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-helper-chip-inline" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
        </div>
      </div>
    </section>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureCloudIbmErrorState" hidden></div>

    <section class="tool-shell tool-inspector-shell" id="architectureCloudIbmConfigShell" aria-label="Configuration">

      <div class="tool-shell-body">
        {# ns:start family._base.workspace.02_basic-settings #}
        <div class="tool-inspector-section architecture-cloud-ibm-basic-section architecture-cloud-ibm-basic-card" id="architectureCloudIbmBasicConfig" data-section="basic-tab" data-root-selector=".architecture-cloud-ibm-tool">

          <div class="architecture-cloud-ibm-example-card">
            <span class="architecture-cloud-ibm-example-label">Example architecture settings</span>
            <strong class="architecture-cloud-ibm-example-value">Secure VPC app, medium, 2 availability zones</strong>
            <span class="architecture-cloud-ibm-example-helper">Region, zone count, and preset should change the generated model and exported JSON.</span>
          </div>

          <div class="architecture-cloud-ibm-basic-grid">
            <div class="architecture-cloud-ibm-control-stack architecture-cloud-ibm-setting-card">
              <label class="tool-control-label architecture-cloud-ibm-setting-label" for="architectureCloudIbmPreset">Preset <span class="architecture-cloud-ibm-helper-chip" title="Choose a starting preset that updates the visible controls and generated output." aria-label="Choose a starting preset that updates the visible controls and generated output.">i</span></label>
              <select id="architectureCloudIbmPreset" class="form-select architecture-cloud-ibm-native-select">
                <option value="secure-vpc-app" selected>Secure VPC App</option>
                <option value="openshift-platform">OpenShift Platform</option>
                <option value="data-services">Data Services</option>
                <option value="hybrid-connectivity">Hybrid Connectivity</option>
              </select>
            </div>

            <div class="architecture-cloud-ibm-control-stack architecture-cloud-ibm-setting-card">
              <label class="tool-control-label architecture-cloud-ibm-setting-label" for="architectureCloudIbmSize">Workload scale <span class="architecture-cloud-ibm-helper-chip" title="Choose the workload scale used by generated capacity assumptions." aria-label="Choose the workload scale used by generated capacity assumptions.">i</span></label>
              <select id="architectureCloudIbmSize" class="form-select architecture-cloud-ibm-native-select">
                <option value="small">Small</option>
                <option value="medium" selected>Medium</option>
                <option value="large">Large</option>
              </select>
            </div>

            <div class="architecture-cloud-ibm-control-stack architecture-cloud-ibm-setting-card">
              <label class="tool-control-label architecture-cloud-ibm-setting-label" for="architectureCloudIbmAccessBlocks">Availability zones <span class="architecture-cloud-ibm-helper-chip" title="Choose the zone count used by placement and resilience assumptions." aria-label="Choose the zone count used by placement and resilience assumptions.">i</span></label>
              <select id="architectureCloudIbmAccessBlocks" class="form-select architecture-cloud-ibm-native-select">
                <option value="1">1 zone</option>
                <option value="2">2 zones</option>
                <option value="3" selected>3 zones</option>
              </select>
            </div>
            <p class="tool-control-hint architecture-cloud-ibm-setting-hint" id="architectureCloudIbmPresetDescription">Cloud Internet Services, public ingress, private app/data subnets, security groups, flow logs, and monitored operations.</p>
          </div>
        </div>
        {# ns:end family._base.workspace.02_basic-settings #}

        {# ns:start family._base.workspace.03_custom-settings #}
        <details class="architecture-cloud-ibm-custom-panel" data-custom-layout="tabbed_two_column" id="architectureCloudIbmCustomControls" data-section="custom-tab" data-root-selector=".architecture-cloud-ibm-tool">
          <summary class="architecture-cloud-ibm-custom-panel-summary">
            <span>Custom</span>
              <span class="architecture-cloud-ibm-custom-arrow-slot" aria-hidden="true"></span>
          </summary>

          <div class="architecture-cloud-ibm-custom-panel-body">
            <div class="architecture-cloud-ibm-config-tabs" role="tablist" aria-label="IBM Cloud custom configuration">
              <button type="button" class="architecture-cloud-ibm-config-tab active" id="architectureCloudIbmNetworkTab" data-config-tab-target="architectureCloudIbmNetworkPanel" role="tab" aria-controls="architectureCloudIbmNetworkPanel" aria-selected="true" tabindex="0">Network</button>
              <button type="button" class="architecture-cloud-ibm-config-tab" id="architectureCloudIbmServicesTab" data-config-tab-target="architectureCloudIbmServicesPanel" role="tab" aria-controls="architectureCloudIbmServicesPanel" aria-selected="false" tabindex="-1">Services</button>
              <button type="button" class="architecture-cloud-ibm-config-tab" id="architectureCloudIbmSecurityTab" data-config-tab-target="architectureCloudIbmSecurityPanel" role="tab" aria-controls="architectureCloudIbmSecurityPanel" aria-selected="false" tabindex="-1">Security</button>
            </div>

            <div class="tool-inspector-section architecture-cloud-ibm-config-panel active" id="architectureCloudIbmNetworkPanel" data-config-panel role="tabpanel" aria-labelledby="architectureCloudIbmNetworkTab">
              <div class="architecture-cloud-ibm-config-grid">
                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmRouting">Connectivity pattern <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune connectivity pattern before regenerating the diagram." aria-label="Tune connectivity pattern before regenerating the diagram.">i</span></label>
                  <input type="hidden" id="architectureCloudIbmRouting" value="edge-protected">

                  <details class="architecture-cloud-ibm-custom-dropdown" data-custom-dropdown-for="architectureCloudIbmRouting">
                    <summary class="architecture-cloud-ibm-custom-dropdown-summary">
                      <span data-custom-dropdown-label>Edge protected ingress</span>
                        <span class="architecture-cloud-ibm-custom-arrow-slot" aria-hidden="true"></span>
                    </summary>

                    <div class="architecture-cloud-ibm-custom-dropdown-menu" role="listbox" aria-label="Custom option">
                      <button
                        type="button"
                        class="architecture-cloud-ibm-custom-dropdown-option"
                        data-custom-dropdown-value="public-private"
                        role="option"
                        aria-selected="false"
                      >Public/private tiers</button>

                      <button
                        type="button"
                        class="architecture-cloud-ibm-custom-dropdown-option"
                        data-custom-dropdown-value="private-only"
                        role="option"
                        aria-selected="false"
                      >Private endpoint only</button>

                      <button
                        type="button"
                        class="architecture-cloud-ibm-custom-dropdown-option"
                        data-custom-dropdown-value="hybrid"
                        role="option"
                        aria-selected="false"
                      >Hybrid connectivity</button>

                      <button
                        type="button"
                        class="architecture-cloud-ibm-custom-dropdown-option active"
                        data-custom-dropdown-value="edge-protected"
                        role="option"
                        aria-selected="true"
                      >Edge protected ingress</button>
                    </div>
                  </details>
                </div>

                <div class="architecture-cloud-ibm-control-stack architecture-cloud-ibm-vlan-stack">
                  <label class="tool-control-label" for="architectureCloudIbmVlans">Subnet tiers <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune subnet tiers before regenerating the diagram." aria-label="Tune subnet tiers before regenerating the diagram.">i</span></label>
                  <textarea id="architectureCloudIbmVlans" class="form-control architecture-cloud-ibm-vlan-input">Public ingress subnet 10.80.0.0/24
Private app subnet 10.80.10.0/24
Private data subnet 10.80.20.0/24</textarea>
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmTrunkVlans">VPC CIDR <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune vpc cidr before regenerating the diagram." aria-label="Tune vpc cidr before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmTrunkVlans" class="form-control" value="10.80.0.0/16">
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmNativeVlan">Public subnet CIDR <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune public subnet cidr before regenerating the diagram." aria-label="Tune public subnet cidr before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmNativeVlan" class="form-control" value="10.80.0.0/24">
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmAccessVlan">Private app subnet CIDR <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune private app subnet cidr before regenerating the diagram." aria-label="Tune private app subnet cidr before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmAccessVlan" class="form-control" value="10.80.10.0/24">
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmSviGateway">Data subnet CIDR <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune data subnet cidr before regenerating the diagram." aria-label="Tune data subnet cidr before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmSviGateway" class="form-control" value="10.80.20.0/24">
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmOspfArea">Resource group <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune resource group before regenerating the diagram." aria-label="Tune resource group before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmOspfArea" class="form-control" value="prod-app-rg">
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmBgpAsn">Edge ASN <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune edge asn before regenerating the diagram." aria-label="Tune edge asn before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmBgpAsn" class="form-control" value="64520">
                </div>

                <div class="architecture-cloud-ibm-control-stack">
                  <label class="tool-control-label" for="architectureCloudIbmRedundancyVip">DNS zone <span class="architecture-cloud-ibm-helper-chip architecture-cloud-ibm-custom-helper-chip" title="Tune dns zone before regenerating the diagram." aria-label="Tune dns zone before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCloudIbmRedundancyVip" class="form-control" value="app.example.com">
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-cloud-ibm-config-panel" id="architectureCloudIbmServicesPanel" data-config-panel role="tabpanel" aria-labelledby="architectureCloudIbmServicesTab" hidden>
              <div class="architecture-cloud-ibm-toggle-grid">
                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">OpenShift / IKS</span>
                  <input type="checkbox" id="architectureCloudIbmWireless">
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Security groups / ACLs</span>
                  <input type="checkbox" id="architectureCloudIbmFirewall" checked>
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Transit Gateway</span>
                  <input type="checkbox" id="architectureCloudIbmWan">
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Monitoring / Logs</span>
                  <input type="checkbox" id="architectureCloudIbmMonitoring" checked>
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Secrets Manager / Key Protect</span>
                  <input type="checkbox" id="architectureCloudIbmDhcpDns" checked>
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Cloud Internet Services</span>
                  <input type="checkbox" id="architectureCloudIbmHsrp" checked>
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Load Balancer</span>
                  <input type="checkbox" id="architectureCloudIbmEtherChannel" checked>
                </label>
              </div>
            </div>

            <div class="tool-inspector-section architecture-cloud-ibm-config-panel" id="architectureCloudIbmSecurityPanel" data-config-panel role="tabpanel" aria-labelledby="architectureCloudIbmSecurityTab" hidden>
              <div class="architecture-cloud-ibm-toggle-grid">
                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">VPC flow logs</span>
                  <input type="checkbox" id="architectureCloudIbmAcl" checked>
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Public Gateway egress</span>
                  <input type="checkbox" id="architectureCloudIbmNat" checked>
                </label>

                <label class="architecture-cloud-ibm-toggle-item">
                  <span class="architecture-cloud-ibm-toggle-copy">Direct Link / VPN</span>
                  <input type="checkbox" id="architectureCloudIbmVpn">
                </label>
              </div>
            </div>
          </div>
        </details>
        {# ns:end family._base.workspace.03_custom-settings #}

        {# ns:start family.architecture.workspace.04_selected-item #}
        <div class="tool-inspector-section architecture-cloud-ibm-selected-section" id="architectureCloudIbmSelectedShell" data-section="selected-item" data-root-selector=".architecture-cloud-ibm-tool">
          <h3 class="architecture-cloud-ibm-section-title">Selected item</h3>
          <p class="architecture-cloud-ibm-selected-empty architecture-cloud-ibm-selected-empty-chips" id="architectureCloudIbmSelectedEmpty" aria-label="Select a node or boundary box to move, resize, or highlight it. Select a connector line to adjust its arrow handles. Arrow keys move the selected item; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
            <span class="architecture-cloud-ibm-selected-empty-copy">
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a node or boundary box</span>
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Select a line to adjust arrows</span>
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected item</span>
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
              <span class="architecture-cloud-ibm-selected-hint-chip architecture-cloud-ibm-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
            </span>
          </p>

          <div class="architecture-cloud-ibm-selected-editor d-none" id="architectureCloudIbmSelectedEditor">
            <div class="architecture-cloud-ibm-selected-name" id="architectureCloudIbmSelectedName"></div>

            <div class="architecture-cloud-ibm-selected-grid">
              <div class="architecture-cloud-ibm-control-stack">
                <label class="tool-control-label" for="architectureCloudIbmSelectedX">X position</label>
                <input type="number" id="architectureCloudIbmSelectedX" class="form-control" min="0" step="4">
              </div>

              <div class="architecture-cloud-ibm-control-stack">
                <label class="tool-control-label" for="architectureCloudIbmSelectedY">Y position</label>
                <input type="number" id="architectureCloudIbmSelectedY" class="form-control" min="0" step="4">
              </div>

              <div class="architecture-cloud-ibm-control-stack">
                <label class="tool-control-label" for="architectureCloudIbmSelectedWidth">Width</label>
                <input type="number" id="architectureCloudIbmSelectedWidth" class="form-control" min="120" step="4">
              </div>

              <div class="architecture-cloud-ibm-control-stack">
                <label class="tool-control-label" for="architectureCloudIbmSelectedHeight">Height</label>
                <input type="number" id="architectureCloudIbmSelectedHeight" class="form-control" min="58" step="4">
              </div>
            </div>

            <div class="architecture-cloud-ibm-selected-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureCloudIbmHighlightNode">
                <i class="bi bi-highlighter" aria-hidden="true"></i>
                <span data-button-label>Highlight</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureCloudIbmApplyNode">
                <i class="bi bi-check2" aria-hidden="true"></i>
                <span data-button-label>Apply</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureCloudIbmResetNode">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                <span data-button-label>Reset</span>
              </button>
            </div>
          </div>
        </div>
        {# ns:end family.architecture.workspace.04_selected-item #}
      </div>
    </section>

    <section class="tool-shell tool-stage-shell architecture-cloud-ibm-stage-shell" id="architectureCloudIbmStageShell" data-section="diagram-buttons" data-root-selector=".architecture-cloud-ibm-tool" aria-labelledby="architectureCloudIbmStageTitle">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-shell-header architecture-cloud-ibm-stage-header" id="architectureCloudIbmStageHeader" data-section="title" data-root-selector=".architecture-cloud-ibm-tool">
        <div class="architecture-cloud-ibm-stage-heading">
          <h2 class="tool-shell-title" id="architectureCloudIbmStageTitle">IBM Cloud Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureCloudIbmStageSubtitle">
            <span class="architecture-cloud-ibm-stage-preset-chip">Secure VPC App preset</span>
          </p>
        </div>
        <div class="architecture-cloud-ibm-stage-meta" id="architectureCloudIbmStageMeta"></div>
      </div>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="architecture-cloud-ibm-stage-toolbar-actions">
          <div class="architecture-cloud-ibm-zoom-control" id="architectureCloudIbmZoomControl">
            <button type="button" class="architecture-cloud-ibm-zoom-step" id="architectureCloudIbmZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="architectureCloudIbmZoomInput" class="architecture-cloud-ibm-zoom-input" value="50" min="15" max="240" step="1" aria-label="Zoom percentage">
            <span class="architecture-cloud-ibm-zoom-label" id="architectureCloudIbmZoomLabel">%</span>
            <button type="button" class="architecture-cloud-ibm-zoom-step" id="architectureCloudIbmZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="architecture-cloud-ibm-icon-btn" id="architectureCloudIbmZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-cloud-ibm-icon-btn" id="architectureCloudIbmZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="architecture-cloud-ibm-icon-btn" id="architectureCloudIbmUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-cloud-ibm-icon-btn" id="architectureCloudIbmHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false">
            <i class="bi bi-bounding-box" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-cloud-ibm-icon-btn" id="architectureCloudIbmZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-cloud-ibm-icon-btn" id="architectureCloudIbmFullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-cloud-ibm-stage-toolbar-btn" id="architectureCloudIbmResetLayout" aria-label="Auto arrange layout" title="Auto arrange layout">Auto layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="architectureCloudIbmStageEmpty">Choose a preset to generate diagram.</div>
