{# tool.html.twig #}
{# ns:start family.calculate.workspace.04_visual-contract #}
{# Accepted divergence: calculate visual contract remains tool-local until section-safe extraction is applied. #}
{# ns:end family.calculate.workspace.04_visual-contract #}
{# ns:start family.calculate.workspace.04_selected-item #}
{# Retrofit marker: existing runtime remains tool-local until section-safe extraction is applied. #}
{# ns:end family.calculate.workspace.04_selected-item #}

{# ns:start family._base.workspace.00_shell #}
<div class="calculate-cost-ibm-tool" data-tool-slug="calculate-cost-ibm" data-tool-category="IBM Cloud">
<div class="tool-box">
  <form class="calculate-cost-ibm-form" id="calculateCostIbmForm">
{# ns:start family._base.workspace.01_input-brief #}
    <div class="calculate-cost-ibm-input-card">
      <div class="calculate-cost-ibm-input-brief" data-input-layout="inline">
        <div class="calculate-cost-ibm-main-row calculate-cost-ibm-input-row">
          <div class="calculate-cost-ibm-input-label-wrap">
            <label for="calculateCostIbmLabel" class="calculate-cost-ibm-main-label calculate-cost-ibm-input-label">Estimate label:</label>
            <span class="calculate-cost-ibm-helper-chip" title="Name the workload or environment you want to estimate" aria-label="Name the workload or environment you want to estimate">i</span>
          </div>

          <div class="calculate-cost-ibm-main-input-grid calculate-cost-ibm-input-stack">
            <input
              type="text"
              id="calculateCostIbmLabel"
              class="form-control calculate-cost-ibm-input-control"
              placeholder="Production API stack"
              value="Lean web platform"
            >
            <div class="calculate-cost-ibm-input-error d-none" id="calculateCostIbmInputError" role="alert"></div>
          </div>
        </div>

        <div class="calculate-cost-ibm-main-actions calculate-cost-ibm-input-actions">
          <button
            type="submit"
            class="btn btn-primary calculate-cost-ibm-submit-btn calculate-cost-ibm-action-btn calculate-cost-ibm-action-btn-primary"
            id="calculateCostIbmSubmit"
            data-tool-share-generate
          >
            <i class="bi bi-calculator" aria-hidden="true"></i>
            <span>Estimate</span>
          </button>
          <button
            type="button"
            class="calculate-cost-ibm-secondary-btn calculate-cost-ibm-reset-btn calculate-cost-ibm-action-btn calculate-cost-ibm-action-btn-secondary"
            id="calculateCostIbmReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="calculate-cost-ibm-input-helper-card">
          <span class="calculate-cost-ibm-input-hint">Use a short label that can travel with exported estimate data.</span>
          <span class="calculate-cost-ibm-helper-chip calculate-cost-ibm-helper-chip-inline" title="Name the workload or environment you want to estimate" aria-label="Name the workload or environment you want to estimate">i</span>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.01_input-brief #}

{# ns:start family._base.workspace.02_basic-settings #}
    <div class="calculate-cost-ibm-basic-panel">
      <div class="calculate-cost-ibm-inner-panel calculate-cost-ibm-basic-card">

        <div class="calculate-cost-ibm-example-card">
          <span class="calculate-cost-ibm-example-label">Example estimate settings</span>
          <strong class="calculate-cost-ibm-example-value">Lean web platform, monthly USD, starter catalog</strong>
          <span class="calculate-cost-ibm-example-helper">Preset and basis controls must update totals, tables, and JSON together.</span>
        </div>

        <div class="calculate-cost-ibm-setting-row calculate-cost-ibm-setting-card">
          <label for="calculateCostIbmPreset" class="calculate-cost-ibm-setting-label">
            Preset:
            <span class="info-dot calculate-cost-ibm-helper-chip" title="Load a starting cost shape for a common IBM Cloud workload">i</span>
          </label>

          <div class="calculate-cost-ibm-setting-field">
            <div class="calculate-cost-ibm-inline-grid calculate-cost-ibm-inline-grid-preset">
              <div class="calculate-cost-ibm-native-select-wrap" id="calculateCostIbmPresetSelect">
                <select id="calculateCostIbmPreset" class="form-select calculate-cost-ibm-native-select">
                  <option value="lean-web" selected>Lean web platform</option>
                  <option value="serverless-api">Serverless API</option>
                  <option value="steady-platform">Steady application platform</option>
                  <option value="blank">Blank estimate</option>
                </select>
              </div>

              <button type="button" class="calculate-cost-ibm-secondary-btn" id="calculateCostIbmApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-ibm-setting-row calculate-cost-ibm-setting-card">
          <label class="calculate-cost-ibm-setting-label">
            Pricing basis:
            <span class="info-dot calculate-cost-ibm-helper-chip" title="Starter prices are visible and editable in Custom so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-ibm-setting-field">
            <div class="calculate-cost-ibm-basis-grid">
              <div class="calculate-cost-ibm-basis-card">
                <span class="calculate-cost-ibm-basis-label">Catalog</span>
                <span class="calculate-cost-ibm-basis-value">Starter IBM Cloud mix</span>
                <span class="calculate-cost-ibm-basis-note">Virtual Servers use a compact purchase-model catalog. Storage, Code Engine, API, and egress use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-ibm-basis-card">
                <span class="calculate-cost-ibm-basis-label">Output</span>
                <span class="calculate-cost-ibm-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-ibm-basis-note">Use the result as a planning estimate, then verify material decisions in IBM Cloud pricing, saved estimates, or billing data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-ibm-service-grid">
          <section class="calculate-cost-ibm-service-card" data-service-card="compute">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Virtual Server Compute</h3>
                <p class="calculate-cost-ibm-service-copy">VSI count, runtime, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap calculate-cost-ibm-switch-card">
                <input type="checkbox" id="calculateCostIbmIncludeCompute" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmComputeBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputeInstance" class="calculate-cost-ibm-field-label">VSI profile</label>
                  <div class="calculate-cost-ibm-native-select-wrap" id="calculateCostIbmComputeInstanceSelect">
                    <select id="calculateCostIbmComputeInstance" class="form-select calculate-cost-ibm-native-select">
                      <option value="bx2-2x8" selected>bx2-2x8 - 2 vCPU - 8 GiB</option>
                      <option value="bx2-4x16">bx2-4x16 - 4 vCPU - 16 GiB</option>
                      <option value="cx2-4x8">cx2-4x8 - 4 vCPU - 8 GiB</option>
                      <option value="mx2-4x32">mx2-4x32 - 4 vCPU - 32 GiB</option>
                      <option value="bx3d-4x20">bx3d-4x20 - 4 vCPU - 20 GiB</option>
                      <option id="calculateCostIbmComputeCustomOptionLabel" value="custom">Custom size - user defined</option>
                    </select>
                  </div>
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputePurchase" class="calculate-cost-ibm-field-label">Purchase model</label>
                  <div class="calculate-cost-ibm-native-select-wrap" id="calculateCostIbmComputePurchaseSelect">
                    <select id="calculateCostIbmComputePurchase" class="form-select calculate-cost-ibm-native-select">
                      <option value="onDemand" selected>Hourly</option>
                      <option value="spot">Spot</option>
                      <option value="savings1">Commitment 1yr</option>
                      <option value="savings3">Commitment 3yr</option>
                      <option value="reserved1">Reserved 1yr</option>
                      <option value="reserved3">Reserved 3yr</option>
                    </select>
                  </div>
                </div>

                <div class="calculate-cost-ibm-custom-instance-grid calculate-cost-ibm-card-span-two d-none" id="calculateCostIbmComputeCustomFields">
                  <div class="calculate-cost-ibm-field-stack">
                    <label for="calculateCostIbmComputeCustomLabel" class="calculate-cost-ibm-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostIbmComputeCustomLabel"
                      class="form-control calculate-cost-ibm-text-field"
                      placeholder="Custom instance profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-ibm-field-stack">
                    <label for="calculateCostIbmComputeCustomVcpu" class="calculate-cost-ibm-field-label">Custom vCPU</label>
                    <input
                      type="number"
                      id="calculateCostIbmComputeCustomVcpu"
                      class="form-control calculate-cost-ibm-text-field"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-ibm-field-stack">
                    <label for="calculateCostIbmComputeCustomMemoryGiB" class="calculate-cost-ibm-field-label">Custom memory GiB</label>
                    <input
                      type="number"
                      id="calculateCostIbmComputeCustomMemoryGiB"
                      class="form-control calculate-cost-ibm-text-field"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

                <p class="calculate-cost-ibm-field-hint calculate-cost-ibm-card-span-two d-none" id="calculateCostIbmComputeCustomHint">Custom size uses the VSI hourly override in Custom. Set the custom vCPU and memory here, then price it with the override field.</p>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputeCount" class="calculate-cost-ibm-field-label">VSI count</label>
                  <input type="number" id="calculateCostIbmComputeCount" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputeHours" class="calculate-cost-ibm-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostIbmComputeHours" class="form-control calculate-cost-ibm-text-field" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="disk">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Block Storage</h3>
                <p class="calculate-cost-ibm-service-copy">Block capacity plus optional IOPS and throughput.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap calculate-cost-ibm-switch-card">
                <input type="checkbox" id="calculateCostIbmIncludeDisk" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmDiskBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmDiskStorageGb" class="calculate-cost-ibm-field-label">Storage GB</label>
                  <input type="number" id="calculateCostIbmDiskStorageGb" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmDiskIops" class="calculate-cost-ibm-field-label">Provisioned IOPS</label>
                  <input type="number" id="calculateCostIbmDiskIops" class="form-control calculate-cost-ibm-text-field" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-card-span-two">
                  <label for="calculateCostIbmDiskThroughput" class="calculate-cost-ibm-field-label">Throughput MB/s</label>
                  <input type="number" id="calculateCostIbmDiskThroughput" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="blob">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Cloud Object Storage</h3>
                <p class="calculate-cost-ibm-service-copy">Object storage, request volume, and outbound transfer.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap calculate-cost-ibm-switch-card">
                <input type="checkbox" id="calculateCostIbmIncludeBlob" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmBlobBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobStorageGb" class="calculate-cost-ibm-field-label">Storage GB</label>
                  <input type="number" id="calculateCostIbmBlobStorageGb" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobEgressGb" class="calculate-cost-ibm-field-label">Transfer out GB</label>
                  <input type="number" id="calculateCostIbmBlobEgressGb" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobGetRequestsK" class="calculate-cost-ibm-field-label">GET requests (1k)</label>
                  <input type="number" id="calculateCostIbmBlobGetRequestsK" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobPutRequestsK" class="calculate-cost-ibm-field-label">PUT/LIST requests (1k)</label>
                  <input type="number" id="calculateCostIbmBlobPutRequestsK" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="functions">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Code Engine</h3>
                <p class="calculate-cost-ibm-service-copy">Requests, duration, and memory drive the bill.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap calculate-cost-ibm-switch-card">
                <input type="checkbox" id="calculateCostIbmIncludeFunctions" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmFunctionsBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmFunctionsRequestsMillion" class="calculate-cost-ibm-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostIbmFunctionsRequestsMillion" class="form-control calculate-cost-ibm-text-field" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmFunctionsDurationMs" class="calculate-cost-ibm-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostIbmFunctionsDurationMs" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-card-span-two">
                  <label for="calculateCostIbmFunctionsMemoryMb" class="calculate-cost-ibm-field-label">Memory MB</label>
                  <input type="number" id="calculateCostIbmFunctionsMemoryMb" class="form-control calculate-cost-ibm-text-field" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="api">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">API Connect</h3>
                <p class="calculate-cost-ibm-service-copy">HTTP and REST requests with response egress.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap calculate-cost-ibm-switch-card">
                <input type="checkbox" id="calculateCostIbmIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmApiBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmApiType" class="calculate-cost-ibm-field-label">API type</label>
                  <div class="calculate-cost-ibm-native-select-wrap" id="calculateCostIbmApiTypeSelect">
                    <select id="calculateCostIbmApiType" class="form-select calculate-cost-ibm-native-select">
                      <option value="http" selected>Essentials gateway</option>
                      <option value="rest">Standard gateway</option>
                    </select>
                  </div>
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmApiRequestsMillion" class="calculate-cost-ibm-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostIbmApiRequestsMillion" class="form-control calculate-cost-ibm-text-field" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-card-span-two">
                  <label for="calculateCostIbmApiResponseKb" class="calculate-cost-ibm-field-label">Avg response KB</label>
                  <input type="number" id="calculateCostIbmApiResponseKb" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="32">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="overhead">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Shared Egress And Overhead</h3>
                <p class="calculate-cost-ibm-service-copy">Network, support uplift, and blended buffer.</p>
              </div>
            </div>

            <div class="calculate-cost-ibm-service-body">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmSharedEgressGb" class="calculate-cost-ibm-field-label">Shared egress GB</label>
                  <input type="number" id="calculateCostIbmSharedEgressGb" class="form-control calculate-cost-ibm-text-field" min="0" step="1" value="120">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmSupportPct" class="calculate-cost-ibm-field-label">Support uplift %</label>
                  <input type="number" id="calculateCostIbmSupportPct" class="form-control calculate-cost-ibm-text-field" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmContingencyPct" class="calculate-cost-ibm-field-label">Contingency %</label>
                  <input type="number" id="calculateCostIbmContingencyPct" class="form-control calculate-cost-ibm-text-field" min="0" step="0.1" value="10">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmManualAdjustment" class="calculate-cost-ibm-field-label">Manual adjustment $</label>
                  <input type="number" id="calculateCostIbmManualAdjustment" class="form-control calculate-cost-ibm-text-field" step="0.01" value="0">
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
    <details class="calculate-cost-ibm-advanced" data-custom-layout="compact_two_column_multi_row" id="calculateCostIbmAdvanced">
      <summary class="calculate-cost-ibm-advanced-summary">
        <span>Custom</span>
          <span class="calculate-cost-ibm-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="calculate-cost-ibm-advanced-body">
        <div class="calculate-cost-ibm-inner-panel">
          <div class="calculate-cost-ibm-setting-row calculate-cost-ibm-setting-card">
            <label class="calculate-cost-ibm-setting-label">
              Free tier toggles:
              <span class="info-dot calculate-cost-ibm-helper-chip" title="Apply the starter free-tier allowances that most affect this model">i</span>
            </label>

            <div class="calculate-cost-ibm-setting-field">
              <div class="calculate-cost-ibm-toggle-grid">
                <label class="calculate-cost-ibm-custom-checkbox-option">
                  <input type="checkbox" id="calculateCostIbmFreeTierFunctions" checked>
                  <span>Code Engine requests + GB-s</span>
                </label>

                <label class="calculate-cost-ibm-custom-checkbox-option">
                  <input type="checkbox" id="calculateCostIbmFreeTierApi" checked>
                  <span>API Connect calls</span>
                </label>

                <label class="calculate-cost-ibm-custom-checkbox-option">
                  <input type="checkbox" id="calculateCostIbmFreeTierEgress" checked>
                  <span>Shared 100 GB egress</span>
                </label>
              </div>
            </div>
          </div>

          <div class="calculate-cost-ibm-setting-row calculate-cost-ibm-setting-card">
            <label for="calculateCostIbmRegionalUpliftPct" class="calculate-cost-ibm-setting-label">
              Regional uplift:
              <span class="info-dot calculate-cost-ibm-helper-chip" title="Apply a percentage uplift to starter rates when you want to approximate a pricier region">i</span>
            </label>

            <div class="calculate-cost-ibm-setting-field">
              <div class="calculate-cost-ibm-inline-grid calculate-cost-ibm-inline-grid-regional">
                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-field-stack-compact">
                  <input type="number" id="calculateCostIbmRegionalUpliftPct" class="form-control" min="0" step="0.1" value="0" placeholder="0">
                </div>
                <div class="calculate-cost-ibm-inline-note">Use direct overrides below when you know the real regional rate.</div>
              </div>
            </div>
          </div>

          <div class="calculate-cost-ibm-setting-row calculate-cost-ibm-setting-row-stacked calculate-cost-ibm-setting-card">
            <label class="calculate-cost-ibm-setting-label">
              Rate overrides:
              <span class="info-dot calculate-cost-ibm-helper-chip" title="Set a value here to override the bundled starter rate for that specific cost component">i</span>
            </label>

            <div class="calculate-cost-ibm-setting-field">
              <div class="calculate-cost-ibm-override-grid">
                <section class="calculate-cost-ibm-override-group calculate-cost-ibm-override-group--single">
                  <div class="calculate-cost-ibm-override-group-head">
                    <h4 class="calculate-cost-ibm-override-group-title">Virtual Servers</h4>
                  </div>

                  <div class="calculate-cost-ibm-override-group-body">
                    <div class="calculate-cost-ibm-field-stack">
                      <label for="calculateCostIbmComputeHourlyOverride" class="calculate-cost-ibm-field-label">Hourly rate</label>
