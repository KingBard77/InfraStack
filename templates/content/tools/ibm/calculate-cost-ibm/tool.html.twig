<div class="calculate-cost-ibm-tool" data-tool-slug="calculate-cost-ibm" data-tool-category="IBM Cloud">
<div class="tool-box">
  <form class="calculate-cost-ibm-form" id="calculateCostIbmForm">
    <div class="calculate-cost-ibm-main-row">
      <label for="calculateCostIbmLabel" class="calculate-cost-ibm-main-label">
        Estimate label:
        <span class="info-dot" title="Name the workload or environment you want to estimate">i</span>
      </label>

      <div class="calculate-cost-ibm-main-input-grid">
        <input
          type="text"
          id="calculateCostIbmLabel"
          class="form-control"
          placeholder="Production API stack"
          value="Lean web platform"
        >

        <div class="calculate-cost-ibm-main-actions">
          <button type="submit" class="btn btn-primary calculate-cost-ibm-submit-btn" id="calculateCostIbmSubmit">Estimate</button>
          <button type="button" class="calculate-cost-ibm-secondary-btn calculate-cost-ibm-reset-btn" id="calculateCostIbmReset">Reset</button>
        </div>
      </div>
    </div>

    <div class="calculate-cost-ibm-basic-panel">
      <div class="calculate-cost-ibm-inner-panel">
        <div class="calculate-cost-ibm-setting-row">
          <label for="calculateCostIbmPreset" class="calculate-cost-ibm-setting-label">
            Preset:
            <span class="info-dot" title="Load a starting cost shape for a common IBM Cloud workload">i</span>
          </label>

          <div class="calculate-cost-ibm-setting-field">
            <div class="calculate-cost-ibm-inline-grid calculate-cost-ibm-inline-grid-preset">
              <details class="calculate-cost-ibm-select" id="calculateCostIbmPresetSelect">
                <summary class="calculate-cost-ibm-select-summary">
                  <span id="calculateCostIbmPresetSummary">Lean web platform</span>
                </summary>

                <div class="calculate-cost-ibm-select-body">
                  <div class="calculate-cost-ibm-select-grid calculate-cost-ibm-select-grid-list">
                    <label class="calculate-cost-ibm-select-card">
                      <input type="radio" name="calculateCostIbmPresetOption" value="lean-web" checked>
                      <span class="calculate-cost-ibm-select-title">Lean web platform</span>
                    </label>

                    <label class="calculate-cost-ibm-select-card">
                      <input type="radio" name="calculateCostIbmPresetOption" value="serverless-api">
                      <span class="calculate-cost-ibm-select-title">Serverless API</span>
                    </label>

                    <label class="calculate-cost-ibm-select-card">
                      <input type="radio" name="calculateCostIbmPresetOption" value="steady-platform">
                      <span class="calculate-cost-ibm-select-title">Steady application platform</span>
                    </label>

                    <label class="calculate-cost-ibm-select-card">
                      <input type="radio" name="calculateCostIbmPresetOption" value="blank">
                      <span class="calculate-cost-ibm-select-title">Blank estimate</span>
                    </label>
                  </div>
                </div>
              </details>
              <input type="hidden" id="calculateCostIbmPreset" value="lean-web">

              <button type="button" class="calculate-cost-ibm-secondary-btn" id="calculateCostIbmApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-ibm-setting-row">
          <label class="calculate-cost-ibm-setting-label">
            Pricing basis:
            <span class="info-dot" title="Starter prices are visible and editable in Advanced so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-ibm-setting-field">
            <div class="calculate-cost-ibm-basis-grid">
              <div class="calculate-cost-ibm-basis-card">
                <span class="calculate-cost-ibm-basis-label">Catalog</span>
                <span class="calculate-cost-ibm-basis-value">Starter IBM Cloud mix</span>
                <span class="calculate-cost-ibm-basis-note">Virtual Servers use a compact purchase-model catalog. Storage, Code Engine, API, and egress use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-ibm-basis-card">
                <span class="calculate-cost-ibm-basis-label">Output</span>
                <span class="calculate-cost-ibm-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-ibm-basis-note">Use the result as a planning estimate, then verify material decisions in IBM Cloud pricing, saved estimates, or billing data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-ibm-service-grid">
          <section class="calculate-cost-ibm-service-card" data-service-card="compute">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Virtual Server Compute</h3>
                <p class="calculate-cost-ibm-service-copy">VSI count, runtime, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap">
                <input type="checkbox" id="calculateCostIbmIncludeCompute" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmComputeBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputeInstance" class="calculate-cost-ibm-field-label">VSI profile</label>
                  <details class="calculate-cost-ibm-select" id="calculateCostIbmComputeInstanceSelect">
                    <summary class="calculate-cost-ibm-select-summary">
                      <span id="calculateCostIbmComputeInstanceSummary">bx2-2x8 - 2 vCPU - 8 GiB</span>
                    </summary>

                    <div class="calculate-cost-ibm-select-body">
                      <div class="calculate-cost-ibm-select-grid calculate-cost-ibm-select-grid-list">
                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputeInstanceOption" value="bx2-2x8" checked>
                          <span class="calculate-cost-ibm-select-title">bx2-2x8 - 2 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputeInstanceOption" value="bx2-4x16">
                          <span class="calculate-cost-ibm-select-title">bx2-4x16 - 4 vCPU - 16 GiB</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputeInstanceOption" value="cx2-4x8">
                          <span class="calculate-cost-ibm-select-title">cx2-4x8 - 4 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputeInstanceOption" value="mx2-4x32">
                          <span class="calculate-cost-ibm-select-title">mx2-4x32 - 4 vCPU - 32 GiB</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputeInstanceOption" value="bx3d-4x20">
                          <span class="calculate-cost-ibm-select-title">bx3d-4x20 - 4 vCPU - 20 GiB</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputeInstanceOption" value="custom">
                          <span class="calculate-cost-ibm-select-title" id="calculateCostIbmComputeCustomOptionLabel">Custom size - user defined</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostIbmComputeInstance" value="bx2-2x8">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputePurchase" class="calculate-cost-ibm-field-label">Purchase model</label>
                  <details class="calculate-cost-ibm-select" id="calculateCostIbmComputePurchaseSelect">
                    <summary class="calculate-cost-ibm-select-summary">
                      <span id="calculateCostIbmComputePurchaseSummary">Hourly</span>
                    </summary>

                    <div class="calculate-cost-ibm-select-body">
                      <div class="calculate-cost-ibm-select-grid calculate-cost-ibm-select-grid-two">
                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputePurchaseOption" value="onDemand" checked>
                          <span class="calculate-cost-ibm-select-title">Hourly</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputePurchaseOption" value="spot">
                          <span class="calculate-cost-ibm-select-title">Spot</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputePurchaseOption" value="savings1">
                          <span class="calculate-cost-ibm-select-title">Commitment 1yr</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputePurchaseOption" value="savings3">
                          <span class="calculate-cost-ibm-select-title">Commitment 3yr</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputePurchaseOption" value="reserved1">
                          <span class="calculate-cost-ibm-select-title">Reserved 1yr</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmComputePurchaseOption" value="reserved3">
                          <span class="calculate-cost-ibm-select-title">Reserved 3yr</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostIbmComputePurchase" value="onDemand">
                </div>

                <div class="calculate-cost-ibm-custom-instance-grid calculate-cost-ibm-card-span-two d-none" id="calculateCostIbmComputeCustomFields">
                  <div class="calculate-cost-ibm-field-stack">
                    <label for="calculateCostIbmComputeCustomLabel" class="calculate-cost-ibm-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostIbmComputeCustomLabel"
                      class="form-control"
                      placeholder="Custom instance profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-ibm-field-stack">
                    <label for="calculateCostIbmComputeCustomVcpu" class="calculate-cost-ibm-field-label">Custom vCPU</label>
                    <input
                      type="number"
                      id="calculateCostIbmComputeCustomVcpu"
                      class="form-control"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-ibm-field-stack">
                    <label for="calculateCostIbmComputeCustomMemoryGiB" class="calculate-cost-ibm-field-label">Custom memory GiB</label>
                    <input
                      type="number"
                      id="calculateCostIbmComputeCustomMemoryGiB"
                      class="form-control"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

                <p class="calculate-cost-ibm-field-hint calculate-cost-ibm-card-span-two d-none" id="calculateCostIbmComputeCustomHint">Custom size uses the VSI hourly override in Advanced. Set the custom vCPU and memory here, then price it with the override field.</p>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputeCount" class="calculate-cost-ibm-field-label">VSI count</label>
                  <input type="number" id="calculateCostIbmComputeCount" class="form-control" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmComputeHours" class="calculate-cost-ibm-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostIbmComputeHours" class="form-control" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="disk">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Block Storage</h3>
                <p class="calculate-cost-ibm-service-copy">Block capacity plus optional IOPS and throughput.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap">
                <input type="checkbox" id="calculateCostIbmIncludeDisk" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmDiskBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmDiskStorageGb" class="calculate-cost-ibm-field-label">Storage GB</label>
                  <input type="number" id="calculateCostIbmDiskStorageGb" class="form-control" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmDiskIops" class="calculate-cost-ibm-field-label">Provisioned IOPS</label>
                  <input type="number" id="calculateCostIbmDiskIops" class="form-control" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-card-span-two">
                  <label for="calculateCostIbmDiskThroughput" class="calculate-cost-ibm-field-label">Throughput MB/s</label>
                  <input type="number" id="calculateCostIbmDiskThroughput" class="form-control" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="blob">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Cloud Object Storage</h3>
                <p class="calculate-cost-ibm-service-copy">Object storage, request volume, and outbound transfer.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap">
                <input type="checkbox" id="calculateCostIbmIncludeBlob" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmBlobBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobStorageGb" class="calculate-cost-ibm-field-label">Storage GB</label>
                  <input type="number" id="calculateCostIbmBlobStorageGb" class="form-control" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobEgressGb" class="calculate-cost-ibm-field-label">Transfer out GB</label>
                  <input type="number" id="calculateCostIbmBlobEgressGb" class="form-control" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobGetRequestsK" class="calculate-cost-ibm-field-label">GET requests (1k)</label>
                  <input type="number" id="calculateCostIbmBlobGetRequestsK" class="form-control" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmBlobPutRequestsK" class="calculate-cost-ibm-field-label">PUT/LIST requests (1k)</label>
                  <input type="number" id="calculateCostIbmBlobPutRequestsK" class="form-control" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="functions">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Code Engine</h3>
                <p class="calculate-cost-ibm-service-copy">Requests, duration, and memory drive the bill.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap">
                <input type="checkbox" id="calculateCostIbmIncludeFunctions" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmFunctionsBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmFunctionsRequestsMillion" class="calculate-cost-ibm-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostIbmFunctionsRequestsMillion" class="form-control" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmFunctionsDurationMs" class="calculate-cost-ibm-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostIbmFunctionsDurationMs" class="form-control" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-card-span-two">
                  <label for="calculateCostIbmFunctionsMemoryMb" class="calculate-cost-ibm-field-label">Memory MB</label>
                  <input type="number" id="calculateCostIbmFunctionsMemoryMb" class="form-control" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="api">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">API Connect</h3>
                <p class="calculate-cost-ibm-service-copy">HTTP and REST requests with response egress.</p>
              </div>

              <label class="switch calculate-cost-ibm-switch-wrap">
                <input type="checkbox" id="calculateCostIbmIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-ibm-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-ibm-service-body" id="calculateCostIbmApiBody">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmApiType" class="calculate-cost-ibm-field-label">API type</label>
                  <details class="calculate-cost-ibm-select" id="calculateCostIbmApiTypeSelect">
                    <summary class="calculate-cost-ibm-select-summary">
                      <span id="calculateCostIbmApiTypeSummary">Essentials gateway</span>
                    </summary>

                    <div class="calculate-cost-ibm-select-body">
                      <div class="calculate-cost-ibm-select-grid calculate-cost-ibm-select-grid-two">
                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmApiTypeOption" value="http" checked>
                          <span class="calculate-cost-ibm-select-title">Essentials gateway</span>
                        </label>

                        <label class="calculate-cost-ibm-select-card">
                          <input type="radio" name="calculateCostIbmApiTypeOption" value="rest">
                          <span class="calculate-cost-ibm-select-title">Standard gateway</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostIbmApiType" value="http">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmApiRequestsMillion" class="calculate-cost-ibm-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostIbmApiRequestsMillion" class="form-control" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-ibm-field-stack calculate-cost-ibm-card-span-two">
                  <label for="calculateCostIbmApiResponseKb" class="calculate-cost-ibm-field-label">Avg response KB</label>
                  <input type="number" id="calculateCostIbmApiResponseKb" class="form-control" min="0" step="1" value="32">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-ibm-service-card" data-service-card="overhead">
            <div class="calculate-cost-ibm-service-head">
              <div>
                <h3 class="calculate-cost-ibm-service-title">Shared Egress And Overhead</h3>
                <p class="calculate-cost-ibm-service-copy">Network, support uplift, and blended buffer.</p>
              </div>
            </div>

            <div class="calculate-cost-ibm-service-body">
              <div class="calculate-cost-ibm-card-grid calculate-cost-ibm-card-grid-two">
                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmSharedEgressGb" class="calculate-cost-ibm-field-label">Shared egress GB</label>
                  <input type="number" id="calculateCostIbmSharedEgressGb" class="form-control" min="0" step="1" value="120">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmSupportPct" class="calculate-cost-ibm-field-label">Support uplift %</label>
                  <input type="number" id="calculateCostIbmSupportPct" class="form-control" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmContingencyPct" class="calculate-cost-ibm-field-label">Contingency %</label>
                  <input type="number" id="calculateCostIbmContingencyPct" class="form-control" min="0" step="0.1" value="10">
                </div>

                <div class="calculate-cost-ibm-field-stack">
                  <label for="calculateCostIbmManualAdjustment" class="calculate-cost-ibm-field-label">Manual adjustment $</label>
                  <input type="number" id="calculateCostIbmManualAdjustment" class="form-control" step="0.01" value="0">
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <details class="calculate-cost-ibm-advanced" id="calculateCostIbmAdvanced">
      <summary class="calculate-cost-ibm-advanced-summary">Advanced</summary>

      <div class="calculate-cost-ibm-advanced-body">
        <div class="calculate-cost-ibm-inner-panel">
          <div class="calculate-cost-ibm-setting-row">
            <label class="calculate-cost-ibm-setting-label">
              Free tier toggles:
              <span class="info-dot" title="Apply the starter free-tier allowances that most affect this model">i</span>
            </label>

            <div class="calculate-cost-ibm-setting-field">
              <div class="calculate-cost-ibm-toggle-grid">
                <label class="switch calculate-cost-ibm-switch-wrap calculate-cost-ibm-switch-card">
