{# tool.html.twig #}
{# ns:start family.calculate.workspace.04_selected-item #}
{# Retrofit marker: existing runtime remains tool-local until section-safe extraction is applied. #}
{# ns:end family.calculate.workspace.04_selected-item #}

{# ns:start family._base.workspace.00_shell #}
<div class="calculate-cost-gcp-tool" data-tool-slug="calculate-cost-gcp" data-tool-category="Google Cloud">
<div class="tool-box">
  <form class="calculate-cost-gcp-form" id="calculateCostGcpForm">
{# ns:start family._base.workspace.01_input-brief #}
    <div class="calculate-cost-gcp-input-card">
      <div class="calculate-cost-gcp-input-brief" data-input-layout="inline">
        <div class="calculate-cost-gcp-main-row calculate-cost-gcp-input-row">
          <div class="calculate-cost-gcp-input-label-wrap">
            <label for="calculateCostGcpLabel" class="calculate-cost-gcp-main-label calculate-cost-gcp-input-label">Estimate label:</label>
            <span class="calculate-cost-gcp-helper-chip" title="Name the workload or environment you want to estimate" aria-label="Name the workload or environment you want to estimate">i</span>
          </div>

          <div class="calculate-cost-gcp-main-input-grid calculate-cost-gcp-input-stack">
            <input
              type="text"
              id="calculateCostGcpLabel"
              class="form-control calculate-cost-gcp-input-control"
              placeholder="Production API stack"
              value="Lean web platform"
            >
            <div class="calculate-cost-gcp-input-error d-none" id="calculateCostGcpInputError" role="alert"></div>
          </div>
        </div>

        <div class="calculate-cost-gcp-main-actions calculate-cost-gcp-input-actions">
          <button
            type="submit"
            class="btn btn-primary calculate-cost-gcp-submit-btn calculate-cost-gcp-action-btn calculate-cost-gcp-action-btn-primary"
            id="calculateCostGcpSubmit"
            data-tool-share-generate
          >
            <i class="bi bi-calculator" aria-hidden="true"></i>
            <span>Estimate</span>
          </button>
          <button
            type="button"
            class="calculate-cost-gcp-secondary-btn calculate-cost-gcp-reset-btn calculate-cost-gcp-action-btn calculate-cost-gcp-action-btn-secondary"
            id="calculateCostGcpReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="calculate-cost-gcp-input-helper-card">
          <span class="calculate-cost-gcp-input-hint">Use a short label that can travel with exported estimate data.</span>
          <span class="calculate-cost-gcp-helper-chip calculate-cost-gcp-helper-chip-inline" title="Name the workload or environment you want to estimate" aria-label="Name the workload or environment you want to estimate">i</span>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.01_input-brief #}

{# ns:start family._base.workspace.02_basic-settings #}
    <div class="calculate-cost-gcp-basic-panel">
      <div class="calculate-cost-gcp-inner-panel calculate-cost-gcp-basic-card">

        <div class="calculate-cost-gcp-example-card">
          <span class="calculate-cost-gcp-example-label">Example estimate settings</span>
          <strong class="calculate-cost-gcp-example-value">Lean web platform, monthly USD, starter catalog</strong>
          <span class="calculate-cost-gcp-example-helper">Preset and basis controls must update totals, tables, and JSON together.</span>
        </div>

        <div class="calculate-cost-gcp-setting-row calculate-cost-gcp-setting-card">
          <label for="calculateCostGcpPreset" class="calculate-cost-gcp-setting-label">
            Preset:
            <span class="info-dot calculate-cost-gcp-helper-chip" title="Load a starting cost shape for a common Google Cloud workload">i</span>
          </label>

          <div class="calculate-cost-gcp-setting-field">
            <div class="calculate-cost-gcp-inline-grid calculate-cost-gcp-inline-grid-preset">
              <details class="calculate-cost-gcp-select" id="calculateCostGcpPresetSelect">
                <summary class="calculate-cost-gcp-select-summary">
                  <span id="calculateCostGcpPresetSummary">Lean web platform</span>
                  <span class="calculate-cost-gcp-select-arrow-slot" aria-hidden="true"></span>
                </summary>

                <div class="calculate-cost-gcp-select-body">
                  <div class="calculate-cost-gcp-select-grid calculate-cost-gcp-select-grid-list">
                    <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                      <input type="radio" name="calculateCostGcpPresetOption" value="lean-web" checked>
                      <span class="calculate-cost-gcp-select-title">Lean web platform</span>
                    </label>

                    <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                      <input type="radio" name="calculateCostGcpPresetOption" value="serverless-api">
                      <span class="calculate-cost-gcp-select-title">Serverless API</span>
                    </label>

                    <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                      <input type="radio" name="calculateCostGcpPresetOption" value="steady-platform">
                      <span class="calculate-cost-gcp-select-title">Steady application platform</span>
                    </label>

                    <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                      <input type="radio" name="calculateCostGcpPresetOption" value="blank">
                      <span class="calculate-cost-gcp-select-title">Blank estimate</span>
                    </label>
                  </div>
                </div>
              </details>
              <input type="hidden" id="calculateCostGcpPreset" value="lean-web">

              <button type="button" class="calculate-cost-gcp-secondary-btn" id="calculateCostGcpApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-gcp-setting-row calculate-cost-gcp-setting-card">
          <label class="calculate-cost-gcp-setting-label">
            Pricing basis:
            <span class="info-dot calculate-cost-gcp-helper-chip" title="Starter prices are visible and editable in Custom so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-gcp-setting-field">
            <div class="calculate-cost-gcp-basis-grid">
              <div class="calculate-cost-gcp-basis-card">
                <span class="calculate-cost-gcp-basis-label">Catalog</span>
                <span class="calculate-cost-gcp-basis-value">Starter Google Cloud mix</span>
                <span class="calculate-cost-gcp-basis-note">Compute Engine uses a compact purchase-model catalog. Storage, Cloud Functions, API, and egress use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-gcp-basis-card">
                <span class="calculate-cost-gcp-basis-label">Output</span>
                <span class="calculate-cost-gcp-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-gcp-basis-note">Use the result as a planning estimate, then verify material decisions in Google Cloud pricing, billing, or agreement data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-gcp-service-grid">
          <section class="calculate-cost-gcp-service-card" data-service-card="compute">
            <div class="calculate-cost-gcp-service-head">
              <div>
                <h3 class="calculate-cost-gcp-service-title">Compute Engine</h3>
                <p class="calculate-cost-gcp-service-copy">Instance count, runtime, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-gcp-switch-wrap calculate-cost-gcp-switch-card">
                <input type="checkbox" id="calculateCostGcpIncludeCompute" checked>
                <span class="slider"></span>
                <span class="calculate-cost-gcp-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-gcp-service-body" id="calculateCostGcpComputeBody">
              <div class="calculate-cost-gcp-card-grid calculate-cost-gcp-card-grid-two">
                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpComputeInstance" class="calculate-cost-gcp-field-label">Machine profile</label>
                  <details class="calculate-cost-gcp-select" id="calculateCostGcpComputeInstanceSelect">
                    <summary class="calculate-cost-gcp-select-summary">
                      <span id="calculateCostGcpComputeInstanceSummary">e2-standard-2 - 2 vCPU - 8 GiB</span>
                      <span class="calculate-cost-gcp-select-arrow-slot" aria-hidden="true"></span>
                    </summary>

                    <div class="calculate-cost-gcp-select-body">
                      <div class="calculate-cost-gcp-select-grid calculate-cost-gcp-select-grid-list">
                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="b2s">
                          <span class="calculate-cost-gcp-select-title">e2-medium - 2 vCPU - 4 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="b2ms">
                          <span class="calculate-cost-gcp-select-title">e2-standard-2 - 2 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="d2s-v5" checked>
                          <span class="calculate-cost-gcp-select-title">e2-standard-2 - 2 vCPU - 8 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="d4s-v5">
                          <span class="calculate-cost-gcp-select-title">e2-standard-4 - 4 vCPU - 16 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="d8s-v5">
                          <span class="calculate-cost-gcp-select-title">n2-standard-8 - 8 vCPU - 32 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="f4s-v2">
                          <span class="calculate-cost-gcp-select-title">c3-standard-4 - 4 vCPU - 16 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="e4s-v5">
                          <span class="calculate-cost-gcp-select-title">n2-highmem-4 - 4 vCPU - 32 GiB</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputeInstanceOption" value="custom">
                          <span class="calculate-cost-gcp-select-title" id="calculateCostGcpComputeCustomOptionLabel">Custom size - user defined</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostGcpComputeInstance" value="d2s-v5">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpComputePurchase" class="calculate-cost-gcp-field-label">Purchase model</label>
                  <details class="calculate-cost-gcp-select" id="calculateCostGcpComputePurchaseSelect">
                    <summary class="calculate-cost-gcp-select-summary">
                      <span id="calculateCostGcpComputePurchaseSummary">On-demand</span>
                      <span class="calculate-cost-gcp-select-arrow-slot" aria-hidden="true"></span>
                    </summary>

                    <div class="calculate-cost-gcp-select-body">
                      <div class="calculate-cost-gcp-select-grid calculate-cost-gcp-select-grid-two">
                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputePurchaseOption" value="onDemand" checked>
                          <span class="calculate-cost-gcp-select-title">On-demand</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputePurchaseOption" value="spot">
                          <span class="calculate-cost-gcp-select-title">Spot</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputePurchaseOption" value="savings1">
                          <span class="calculate-cost-gcp-select-title">Committed use 1yr</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputePurchaseOption" value="savings3">
                          <span class="calculate-cost-gcp-select-title">Committed use 3yr</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputePurchaseOption" value="reserved1">
                          <span class="calculate-cost-gcp-select-title">Committed use 1yr</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpComputePurchaseOption" value="reserved3">
                          <span class="calculate-cost-gcp-select-title">Committed use 3yr</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostGcpComputePurchase" value="onDemand">
                </div>

                <div class="calculate-cost-gcp-custom-instance-grid calculate-cost-gcp-card-span-two d-none" id="calculateCostGcpComputeCustomFields">
                  <div class="calculate-cost-gcp-field-stack">
                    <label for="calculateCostGcpComputeCustomLabel" class="calculate-cost-gcp-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostGcpComputeCustomLabel"
                      class="form-control calculate-cost-gcp-text-field"
                      placeholder="Custom instance profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-gcp-field-stack">
                    <label for="calculateCostGcpComputeCustomVcpu" class="calculate-cost-gcp-field-label">Custom vCPU</label>
                    <input
                      type="number"
                      id="calculateCostGcpComputeCustomVcpu"
                      class="form-control calculate-cost-gcp-text-field"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-gcp-field-stack">
                    <label for="calculateCostGcpComputeCustomMemoryGiB" class="calculate-cost-gcp-field-label">Custom memory GiB</label>
                    <input
                      type="number"
                      id="calculateCostGcpComputeCustomMemoryGiB"
                      class="form-control calculate-cost-gcp-text-field"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

                <p class="calculate-cost-gcp-field-hint calculate-cost-gcp-card-span-two d-none" id="calculateCostGcpComputeCustomHint">Custom size uses the Machine hourly override in Custom. Set the custom vCPU and memory here, then price it with the override field.</p>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpComputeCount" class="calculate-cost-gcp-field-label">Instance count</label>
                  <input type="number" id="calculateCostGcpComputeCount" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpComputeHours" class="calculate-cost-gcp-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostGcpComputeHours" class="form-control calculate-cost-gcp-text-field" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-gcp-service-card" data-service-card="disk">
            <div class="calculate-cost-gcp-service-head">
              <div>
                <h3 class="calculate-cost-gcp-service-title">Persistent Disk Storage</h3>
                <p class="calculate-cost-gcp-service-copy">Premium SSD-style capacity plus optional IOPS and throughput.</p>
              </div>

              <label class="switch calculate-cost-gcp-switch-wrap calculate-cost-gcp-switch-card">
                <input type="checkbox" id="calculateCostGcpIncludeDisk" checked>
                <span class="slider"></span>
                <span class="calculate-cost-gcp-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-gcp-service-body" id="calculateCostGcpDiskBody">
              <div class="calculate-cost-gcp-card-grid calculate-cost-gcp-card-grid-two">
                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpDiskStorageGb" class="calculate-cost-gcp-field-label">Storage GB</label>
                  <input type="number" id="calculateCostGcpDiskStorageGb" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpDiskIops" class="calculate-cost-gcp-field-label">Provisioned IOPS</label>
                  <input type="number" id="calculateCostGcpDiskIops" class="form-control calculate-cost-gcp-text-field" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-gcp-field-stack calculate-cost-gcp-card-span-two">
                  <label for="calculateCostGcpDiskThroughput" class="calculate-cost-gcp-field-label">Throughput MB/s</label>
                  <input type="number" id="calculateCostGcpDiskThroughput" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-gcp-service-card" data-service-card="blob">
            <div class="calculate-cost-gcp-service-head">
              <div>
                <h3 class="calculate-cost-gcp-service-title">Cloud Storage</h3>
                <p class="calculate-cost-gcp-service-copy">Object storage, request volume, and outbound transfer.</p>
              </div>

              <label class="switch calculate-cost-gcp-switch-wrap calculate-cost-gcp-switch-card">
                <input type="checkbox" id="calculateCostGcpIncludeBlob" checked>
                <span class="slider"></span>
                <span class="calculate-cost-gcp-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-gcp-service-body" id="calculateCostGcpBlobBody">
              <div class="calculate-cost-gcp-card-grid calculate-cost-gcp-card-grid-two">
                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpBlobStorageGb" class="calculate-cost-gcp-field-label">Storage GB</label>
                  <input type="number" id="calculateCostGcpBlobStorageGb" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpBlobEgressGb" class="calculate-cost-gcp-field-label">Transfer out GB</label>
                  <input type="number" id="calculateCostGcpBlobEgressGb" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpBlobGetRequestsK" class="calculate-cost-gcp-field-label">GET requests (1k)</label>
                  <input type="number" id="calculateCostGcpBlobGetRequestsK" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpBlobPutRequestsK" class="calculate-cost-gcp-field-label">PUT/LIST requests (1k)</label>
                  <input type="number" id="calculateCostGcpBlobPutRequestsK" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-gcp-service-card" data-service-card="functions">
            <div class="calculate-cost-gcp-service-head">
              <div>
                <h3 class="calculate-cost-gcp-service-title">Cloud Functions</h3>
                <p class="calculate-cost-gcp-service-copy">Requests, duration, and memory drive the bill.</p>
              </div>

              <label class="switch calculate-cost-gcp-switch-wrap calculate-cost-gcp-switch-card">
                <input type="checkbox" id="calculateCostGcpIncludeFunctions" checked>
                <span class="slider"></span>
                <span class="calculate-cost-gcp-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-gcp-service-body" id="calculateCostGcpFunctionsBody">
              <div class="calculate-cost-gcp-card-grid calculate-cost-gcp-card-grid-two">
                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpFunctionsRequestsMillion" class="calculate-cost-gcp-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostGcpFunctionsRequestsMillion" class="form-control calculate-cost-gcp-text-field" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpFunctionsDurationMs" class="calculate-cost-gcp-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostGcpFunctionsDurationMs" class="form-control calculate-cost-gcp-text-field" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-gcp-field-stack calculate-cost-gcp-card-span-two">
                  <label for="calculateCostGcpFunctionsMemoryMb" class="calculate-cost-gcp-field-label">Memory MB</label>
                  <input type="number" id="calculateCostGcpFunctionsMemoryMb" class="form-control calculate-cost-gcp-text-field" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-gcp-service-card" data-service-card="api">
            <div class="calculate-cost-gcp-service-head">
              <div>
                <h3 class="calculate-cost-gcp-service-title">API Gateway</h3>
                <p class="calculate-cost-gcp-service-copy">HTTP and REST requests with response egress.</p>
              </div>

              <label class="switch calculate-cost-gcp-switch-wrap calculate-cost-gcp-switch-card">
                <input type="checkbox" id="calculateCostGcpIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-gcp-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-gcp-service-body" id="calculateCostGcpApiBody">
              <div class="calculate-cost-gcp-card-grid calculate-cost-gcp-card-grid-two">
                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpApiType" class="calculate-cost-gcp-field-label">API type</label>
                  <details class="calculate-cost-gcp-select" id="calculateCostGcpApiTypeSelect">
                    <summary class="calculate-cost-gcp-select-summary">
                      <span id="calculateCostGcpApiTypeSummary">Standard gateway</span>
                      <span class="calculate-cost-gcp-select-arrow-slot" aria-hidden="true"></span>
                    </summary>

                    <div class="calculate-cost-gcp-select-body">
                      <div class="calculate-cost-gcp-select-grid calculate-cost-gcp-select-grid-two">
                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpApiTypeOption" value="http" checked>
                          <span class="calculate-cost-gcp-select-title">Standard gateway</span>
                        </label>

                        <label class="calculate-cost-gcp-select-card calculate-cost-gcp-radio-card">
                          <input type="radio" name="calculateCostGcpApiTypeOption" value="rest">
                          <span class="calculate-cost-gcp-select-title">High-volume gateway</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostGcpApiType" value="http">
                </div>

                <div class="calculate-cost-gcp-field-stack">
                  <label for="calculateCostGcpApiRequestsMillion" class="calculate-cost-gcp-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostGcpApiRequestsMillion" class="form-control calculate-cost-gcp-text-field" min="0" step="0.1" value="8">
                </div>

