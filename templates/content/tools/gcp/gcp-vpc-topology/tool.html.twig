<div class="gcp-vpc-topology-tool">
  <div class="tool-box">
    <div class="tool-shell tool-prompt-shell">
      <div class="tool-main-row">
        <label for="gcpVpcPrompt" class="tool-main-label">Architecture prompt</label>
        <div class="tool-main-input-grid gcp-vpc-main-input-grid">
          <textarea
            id="gcpVpcPrompt"
            class="form-control gcp-vpc-prompt"
            placeholder="Describe the GCP VPC layout, region, zones, ingress path, workload tier, data tier, and supporting services."
          >Create a GCP VPC topology in us-central1 with 2 zones. Use public subnets for an internet-facing External HTTP(S) Load Balancer, private app subnets for Managed Instance Groups, and private data subnets for Cloud SQL. Add a single Cloud NAT, Private Service Connect for Cloud Storage and Secret Manager, Cloud Monitoring, and VPC Flow Logs.</textarea>

        </div>
      </div>

      <p class="tool-control-hint gcp-vpc-prompt-hint">
        Use one brief prompt with region, zone count, ingress, private tiers, and supporting GCP services. Presets below can prefill and instantly generate a working layout.
      </p>

      <div class="gcp-vpc-main-actions">
        <button type="button" class="tool-action-btn tool-action-btn-primary" id="gcpVpcGenerate">Generate Diagram</button>
        <button type="button" class="tool-action-btn tool-action-btn-secondary" id="gcpVpcReset">Load Default</button>
      </div>
    </div>

    <div class="tool-error-state d-none" id="gcpVpcErrorState"></div>

    <div class="gcp-vpc-advanced-grid">
      <aside class="tool-shell tool-inspector-shell">
        <div class="tool-shell-header">
          <div>
            <h2 class="tool-shell-title">Basic</h2>
          </div>
        </div>

        <div class="tool-shell-body">
          <div class="tool-inspector-section gcp-vpc-basic-preset-section">
            <div class="gcp-vpc-basic-grid">
              <div class="gcp-vpc-control-stack">
                <label class="tool-control-label" for="gcpVpcPreset">Preset</label>
                <select id="gcpVpcPreset" class="form-select">
                  <option value="three-tier-web" selected>3-Tier Web</option>
                  <option value="ecs-fargate">Cloud Run</option>
                  <option value="eks-platform">Private GKE</option>
                  <option value="hybrid-shared">Hybrid Shared Services</option>
                </select>
                <p class="tool-control-hint" id="gcpVpcPresetDescription">Public HTTP(S) LB, private managed instance groups, Cloud SQL, single Cloud NAT.</p>
              </div>

              <div class="gcp-vpc-control-stack">
                <label class="tool-control-label" for="gcpVpcRegion">Region</label>
                <select id="gcpVpcRegion" class="form-select">
                  <option value="us-central1">us-central1</option>
                  <option value="us-east1">us-east1</option>
                  <option value="us-east4">us-east4</option>
                  <option value="us-west1">us-west1</option>
                  <option value="us-west2">us-west2</option>
                  <option value="europe-west1">europe-west1</option>
                  <option value="asia-southeast1">asia-southeast1</option>
                  <option value="australia-southeast1">australia-southeast1</option>
                </select>
              </div>

              <div class="gcp-vpc-control-stack">
                <label class="tool-control-label" for="gcpVpcAzCount">Zones</label>
                <select id="gcpVpcAzCount" class="form-select">
                  <option value="1">1 zone</option>
                  <option value="2" selected>2 zone</option>
                  <option value="3">3 zone</option>
                </select>
              </div>
            </div>
          </div>

          <details class="gcp-vpc-custom-panel">
            <summary class="gcp-vpc-custom-panel-summary">
              <span>Custom</span>
              <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>

            <div class="gcp-vpc-custom-panel-body">
              <div class="gcp-vpc-config-tabs" role="tablist" aria-label="GCP VPC custom configuration">
                <button type="button" class="gcp-vpc-config-tab active" id="gcpVpcNetworkConfigTab" data-config-tab-target="gcpVpcNetworkConfigPanel" role="tab" aria-controls="gcpVpcNetworkConfigPanel" aria-selected="true" tabindex="0">Network layout</button>
                <button type="button" class="gcp-vpc-config-tab" id="gcpVpcWorkloadConfigTab" data-config-tab-target="gcpVpcWorkloadConfigPanel" role="tab" aria-controls="gcpVpcWorkloadConfigPanel" aria-selected="false" tabindex="-1">Workload</button>
                <button type="button" class="gcp-vpc-config-tab" id="gcpVpcServicesConfigTab" data-config-tab-target="gcpVpcServicesConfigPanel" role="tab" aria-controls="gcpVpcServicesConfigPanel" aria-selected="false" tabindex="-1">Services and controls</button>
              </div>

              <div class="tool-inspector-section gcp-vpc-config-panel active" id="gcpVpcNetworkConfigPanel" data-config-panel role="tabpanel" aria-labelledby="gcpVpcNetworkConfigTab">
                <div class="gcp-vpc-config-grid">
                  <div class="gcp-vpc-control-stack">
                    <label class="tool-control-label" for="gcpVpcCidr">VPC CIDR</label>
                    <input type="text" id="gcpVpcCidr" class="form-control" value="10.0.0.0/16">
                  </div>

                  <div class="gcp-vpc-control-stack">
                    <label class="tool-control-label" for="gcpVpcNatMode">Cloud NAT mode</label>
                    <select id="gcpVpcNatMode" class="form-select">
                      <option value="none">No Cloud NAT</option>
                      <option value="single" selected>Single Cloud NAT</option>
                      <option value="per-az">One per zone</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section gcp-vpc-config-panel" id="gcpVpcWorkloadConfigPanel" data-config-panel role="tabpanel" aria-labelledby="gcpVpcWorkloadConfigTab" hidden>
                <div class="gcp-vpc-config-grid">
                  <div class="gcp-vpc-control-stack">
                    <label class="tool-control-label" for="gcpVpcAppTier">App tier</label>
                    <select id="gcpVpcAppTier" class="form-select">
                      <option value="ec2">Managed Instance Groups</option>
                      <option value="ecs">Cloud Run</option>
                      <option value="eks">GKE</option>
                      <option value="lambda">Cloud Functions with Serverless VPC Access</option>
                    </select>
                  </div>

                  <div class="gcp-vpc-control-stack">
                    <label class="tool-control-label" for="gcpVpcDatabase">Database tier</label>
                    <select id="gcpVpcDatabase" class="form-select">
                      <option value="none">No database tier</option>
                      <option value="rds" selected>Cloud SQL</option>
                      <option value="aurora">Cloud SQL for PostgreSQL</option>
                      <option value="dynamodb">Firestore</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section gcp-vpc-config-panel" id="gcpVpcServicesConfigPanel" data-config-panel role="tabpanel" aria-labelledby="gcpVpcServicesConfigTab" hidden>
                <div class="gcp-vpc-toggle-grid">
                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Cloud DNS</span>
                    <input type="checkbox" id="gcpVpcRoute53" checked>
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Cloud CDN</span>
                    <input type="checkbox" id="gcpVpcCloudFront">
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Cloud Armor</span>
                    <input type="checkbox" id="gcpVpcWaf">
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">External HTTP(S) Load Balancer</span>
                    <input type="checkbox" id="gcpVpcAlb" checked>
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Identity-Aware Proxy</span>
                    <input type="checkbox" id="gcpVpcBastion">
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Private Service Connect</span>
                    <input type="checkbox" id="gcpVpcEndpoints" checked>
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">VPC Flow Logs</span>
                    <input type="checkbox" id="gcpVpcFlowLogs" checked>
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Cloud Monitoring</span>
                    <input type="checkbox" id="gcpVpcCloudWatch" checked>
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Cloud VPN</span>
                    <input type="checkbox" id="gcpVpcSiteToSiteVpn">
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Network Connectivity Center</span>
                    <input type="checkbox" id="gcpVpcTransitGateway">
                  </label>

                  <label class="gcp-vpc-toggle-item">
                    <span class="gcp-vpc-toggle-copy">Memorystore for Redis</span>
                    <input type="checkbox" id="gcpVpcCache">
                  </label>
                </div>
              </div>

            </div>
          </details>

          <div class="tool-inspector-section gcp-vpc-selected-section">
            <h3 class="gcp-vpc-section-title">Selected item</h3>

            <p class="gcp-vpc-selected-empty" id="gcpVpcSelectedEmpty">Select any draggable item in the stage to adjust its position and size. Keyboard: arrow keys move, Alt + arrow keys resize.</p>

            <div class="gcp-vpc-selected-editor d-none" id="gcpVpcSelectedEditor">
              <div class="gcp-vpc-selected-name" id="gcpVpcSelectedName"></div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="gcpVpcSelectedX">X position</label>
                <div class="tool-control-field">
                  <input type="number" id="gcpVpcSelectedX" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="gcpVpcSelectedY">Y position</label>
                <div class="tool-control-field">
                  <input type="number" id="gcpVpcSelectedY" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="gcpVpcSelectedWidth">Width</label>
                <div class="tool-control-field">
                  <input type="number" id="gcpVpcSelectedWidth" class="form-control" min="96" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="gcpVpcSelectedHeight">Height</label>
                <div class="tool-control-field">
                  <input type="number" id="gcpVpcSelectedHeight" class="form-control" min="44" step="4">
                </div>
              </div>

              <div class="gcp-vpc-selected-actions">
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="gcpVpcApplyCardSize">Apply item</button>
                <button type="button" class="tool-action-btn tool-action-btn-ghost" id="gcpVpcResetCardSize">Reset item</button>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <section class="tool-shell tool-stage-shell" id="gcpVpcStageShell">
      <div class="tool-shell-header gcp-vpc-stage-header">
        <div>
          <h2 class="tool-shell-title" id="gcpVpcStageTitle">Visualizer GCP VPC Topology</h2>
          <p class="tool-shell-subtitle" id="gcpVpcStageSubtitle">Generate a prompt-driven VPC layout with editable controls and export-ready output.</p>
        </div>
        <div class="gcp-vpc-stage-meta" id="gcpVpcStageMeta"></div>
      </div>

      <div class="tool-stage-toolbar">
        <div class="gcp-vpc-stage-toolbar-actions">
          <div class="gcp-vpc-zoom-control" id="gcpVpcZoomControl">
            <button type="button" class="gcp-vpc-zoom-step" id="gcpVpcZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="gcpVpcZoomInput" class="gcp-vpc-zoom-input" value="50" min="35" max="240" step="10" aria-label="Zoom percentage">
            <span class="gcp-vpc-zoom-label" id="gcpVpcZoomLabel">%</span>
            <button type="button" class="gcp-vpc-zoom-step" id="gcpVpcZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="gcp-vpc-icon-btn" id="gcpVpcZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="gcp-vpc-icon-btn" id="gcpVpcZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="gcp-vpc-icon-btn" id="gcpVpcZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
          </button>
          <button type="button" class="gcp-vpc-icon-btn" id="gcpVpcFullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost gcp-vpc-stage-toolbar-btn" id="gcpVpcResetLayout">Reset layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="gcpVpcStageEmpty">Generate a diagram to populate the VPC workspace.</div>
        <div class="tool-stage-canvas gcp-vpc-stage-canvas d-none" id="gcpVpcStageCanvas"></div>
      </div>

      <div class="gcp-vpc-stage-footer">
        <div class="gcp-vpc-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" data-tip="Prompt + Preset Aware" aria-label="Prompt + Preset Aware" tabindex="0">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span class="gcp-vpc-visually-hidden">Prompt + Preset Aware</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-inspector" data-tip="Editable Inspector" aria-label="Editable Inspector" tabindex="0">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            <span class="gcp-vpc-visually-hidden">Editable Inspector</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-drag" data-tip="Drag Cards To Customize" aria-label="Drag Cards To Customize" tabindex="0">
            <i class="bi bi-arrows-move" aria-hidden="true"></i>
            <span class="gcp-vpc-visually-hidden">Drag Cards To Customize</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-svg" data-tip="SVG Workspace" aria-label="SVG Workspace" tabindex="0">
            <i class="bi bi-bezier2" aria-hidden="true"></i>
            <span class="gcp-vpc-visually-hidden">SVG Workspace</span>
          </span>
        </div>
      </div>
    </section>

    <section class="tool-shell tool-output-shell">
      <div class="tool-empty-state" id="gcpVpcOutputEmpty">Generate a diagram to unlock exports, technical inventory, and prompt interpretation output.</div>

      <div class="gcp-vpc-output-content d-none" id="gcpVpcOutputContent">
        <div class="gcp-vpc-output-shell">
          <div class="gcp-vpc-output-summary">
            <div class="gcp-vpc-output-status-card" aria-live="polite">
              <div class="gcp-vpc-score-card" id="gcpVpcOutputStatus">
                <div class="gcp-vpc-score-kicker">Architecture Score</div>
                <div class="gcp-vpc-score-value">Ready</div>
                <div class="gcp-vpc-score-summary">Generate a diagram to score the current VPC baseline.</div>
              </div>
            </div>
          </div>

          <div class="gcp-vpc-toolbar-shell">
            <div class="gcp-vpc-toolbar tool-output-toolbar">
              <div class="gcp-vpc-toolbar-main">
                <label for="gcpVpcInventorySort" class="gcp-vpc-sort-label">Sort</label>
                <div class="gcp-vpc-sort-wrap">
                  <details class="gcp-vpc-sort-select" id="gcpVpcInventorySortSelect">
                    <summary class="gcp-vpc-sort-summary">
                      <span id="gcpVpcInventorySortSummary">ID</span>
                    </summary>

                    <div class="gcp-vpc-sort-menu">
                      <div class="gcp-vpc-sort-grid">
                        <button type="button" class="gcp-vpc-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                        <button type="button" class="gcp-vpc-sort-option" data-sort-value="alphabetical" aria-pressed="false">A-Z</button>
                        <button type="button" class="gcp-vpc-sort-option" data-sort-value="component" aria-pressed="false">Component</button>
                        <button type="button" class="gcp-vpc-sort-option" data-sort-value="placement" aria-pressed="false">Placement</button>
                        <button type="button" class="gcp-vpc-sort-option" data-sort-value="purpose" aria-pressed="false">Purpose</button>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="gcpVpcInventorySort" value="id">
                </div>
              </div>

              <div class="tool-output-actions">
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="gcpVpcExportPng">
                  <i class="bi bi-image" aria-hidden="true"></i>
                  <span data-button-label>Export PNG</span>
                </button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="gcpVpcDownloadSvg">
                  <i class="bi bi-download" aria-hidden="true"></i>
                  <span data-button-label>Download SVG</span>
                </button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="gcpVpcCopyJson">
                  <i class="bi bi-clipboard" aria-hidden="true"></i>
                  <span data-button-label>Copy JSON</span>
                </button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="gcpVpcDownloadJson">
                  <i class="bi bi-download" aria-hidden="true"></i>
                  <span data-button-label>Download JSON</span>
                </button>
                <button type="button" class="tool-action-btn tool-action-btn-ghost" id="gcpVpcImportJsonButton">
                  <i class="bi bi-upload" aria-hidden="true"></i>
                  <span data-button-label>Import JSON</span>
                </button>
              </div>
            </div>
          </div>

          <div class="gcp-vpc-tabs-shell">
            <div class="tool-tabs" role="tablist" aria-label="GCP VPC output views">
              <button type="button" class="tool-tab-btn gcp-vpc-tab-btn active" id="gcpVpcInventoryTab" data-tab-target="gcpVpcInventoryPanel" role="tab" aria-controls="gcpVpcInventoryPanel" aria-selected="true" tabindex="0">
                <i class="bi bi-list-check" aria-hidden="true"></i>
                <span>Technical Inventory</span>
              </button>
              <button type="button" class="tool-tab-btn gcp-vpc-tab-btn" id="gcpVpcNotesTab" data-tab-target="gcpVpcNotesPanel" role="tab" aria-controls="gcpVpcNotesPanel" aria-selected="false" tabindex="-1">
                <i class="bi bi-card-text" aria-hidden="true"></i>
                <span>Prompt Notes</span>
              </button>
              <button type="button" class="tool-tab-btn gcp-vpc-tab-btn" id="gcpVpcJsonTab" data-tab-target="gcpVpcJsonPanel" role="tab" aria-controls="gcpVpcJsonPanel" aria-selected="false" tabindex="-1">
                <i class="bi bi-braces" aria-hidden="true"></i>
                <span>JSON</span>
              </button>
            </div>

            <div class="tool-tab-panel gcp-vpc-tab-panel active" id="gcpVpcInventoryPanel" role="tabpanel" aria-labelledby="gcpVpcInventoryTab">
              <div class="gcp-vpc-inventory-panel">
                <div class="gcp-vpc-table-card">
                  <h3 class="gcp-vpc-result-section-title">Technical Inventory</h3>
                  <div class="gcp-vpc-table-wrap">
                    <table class="table gcp-vpc-table mb-0">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Component</th>
                          <th>Placement</th>
                          <th>Purpose</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody id="gcpVpcInventoryTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <div class="tool-tab-panel gcp-vpc-tab-panel" id="gcpVpcNotesPanel" role="tabpanel" aria-labelledby="gcpVpcNotesTab" hidden>
              <div class="gcp-vpc-prompt-notes-card">
                <h3 class="gcp-vpc-result-section-title">Prompt Notes</h3>
                <div class="gcp-vpc-note-grid">
                  <section class="gcp-vpc-note-card">
                    <h3 class="gcp-vpc-note-title">Prompt summary</h3>
                    <p class="gcp-vpc-note-copy" id="gcpVpcPromptSummary"></p>
                  </section>

                  <section class="gcp-vpc-note-card">
                    <h3 class="gcp-vpc-note-title">Detected keywords</h3>
                    <ul class="gcp-vpc-note-list" id="gcpVpcKeywordList"></ul>
                  </section>

                  <section class="gcp-vpc-note-card">
                    <h3 class="gcp-vpc-note-title">Applied assumptions</h3>
                    <ul class="gcp-vpc-note-list" id="gcpVpcAssumptionList"></ul>
                  </section>

                  <section class="gcp-vpc-note-card">
                    <h3 class="gcp-vpc-note-title">Current model</h3>
                    <ul class="gcp-vpc-note-list" id="gcpVpcModelList"></ul>
                  </section>

                  <section class="gcp-vpc-note-card">
                    <h3 class="gcp-vpc-note-title">Architecture pros</h3>
                    <ul class="gcp-vpc-note-list" id="gcpVpcProsList"></ul>
                  </section>

                  <section class="gcp-vpc-note-card">
                    <h3 class="gcp-vpc-note-title">Architecture cons</h3>
                    <ul class="gcp-vpc-note-list" id="gcpVpcConsList"></ul>
                  </section>
                </div>
              </div>
            </div>

            <div class="tool-tab-panel gcp-vpc-tab-panel" id="gcpVpcJsonPanel" role="tabpanel" aria-labelledby="gcpVpcJsonTab" hidden>
              <div class="tool-json-shell">
                <div class="gcp-vpc-json-header">JSON Output</div>
                <pre class="gcp-vpc-json-code" id="gcpVpcJsonOutput"></pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <input type="file" id="gcpVpcImportJson" class="d-none" accept="application/json">
  </div>
</div>
