                <span>Controls</span>
              </button>
              <button type="button" class="tool-tab-btn assess-ubuntu-2404-cis-tab-btn" id="assessUbuntu2404CisSectionsTab" data-tab-target="assessUbuntu2404CisSectionsPanel" role="tab" aria-controls="assessUbuntu2404CisSectionsPanel" aria-selected="false" tabindex="-1">
