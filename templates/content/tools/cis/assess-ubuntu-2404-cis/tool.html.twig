                <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="assess-ubuntu-2404-cis-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="assessUbuntu2404CisDownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="assess-ubuntu-2404-cis-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="assessUbuntu2404CisCopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="assess-ubuntu-2404-cis-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="assessUbuntu2404CisDownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="assess-ubuntu-2404-cis-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="assessUbuntu2404CisImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
          <input type="file" id="assessUbuntu2404CisImportJson" class="assess-ubuntu-2404-cis-import-input d-none" accept="application/json">
        </div>
{# ns:end family._base.workspace.06_output-toolbar #}

{# ns:start family._base.workspace.07_table-output #}
        <div class="assess-ubuntu-2404-cis-tabs-shell">
          <div class="assess-ubuntu-2404-cis-tabs">
            <div class="assess-ubuntu-2404-cis-tab-list tool-tabs" role="tablist" aria-label="Ubuntu CIS benchmark views">
