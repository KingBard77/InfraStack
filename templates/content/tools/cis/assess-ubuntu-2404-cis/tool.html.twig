{# ns:start family._base.workspace.00_shell #}
<div class="assess-ubuntu-2404-cis-tool tool-box mb-4" data-tool-slug="assess-ubuntu-2404-cis">
  <form class="assess-ubuntu-2404-cis-form" id="assessUbuntu2404CisForm">
{# ns:start family._base.workspace.01_input-brief #}
    <div class="assess-ubuntu-2404-cis-input-card">
      <div class="assess-ubuntu-2404-cis-input-brief" data-input-layout="inline">
        <div class="assess-ubuntu-2404-cis-main-row assess-ubuntu-2404-cis-input-row">
          <div class="assess-ubuntu-2404-cis-input-label-wrap">
            <label for="assessUbuntu2404CisQuery" class="assess-ubuntu-2404-cis-main-label assess-ubuntu-2404-cis-input-label">Control filter:</label>
            <span class="assess-ubuntu-2404-cis-helper-chip" title="Filter by control ID, title, section path, or script name" aria-label="Filter by control ID, title, section path, or script name">i</span>
          </div>

          <div class="assess-ubuntu-2404-cis-main-input-grid assess-ubuntu-2404-cis-input-stack">
            <input
              type="text"
              id="assessUbuntu2404CisQuery"
              class="form-control assess-ubuntu-2404-cis-input-control"
              placeholder="1.1.1.1, cramfs, ssh, auditd, pam_unix"
            >
            <div class="assess-ubuntu-2404-cis-input-error d-none" id="assessUbuntu2404CisInputError" role="alert"></div>
          </div>
        </div>

        <div class="assess-ubuntu-2404-cis-main-actions assess-ubuntu-2404-cis-input-actions">
          <button
            type="submit"
            class="btn btn-primary assess-ubuntu-2404-cis-submit-btn assess-ubuntu-2404-cis-action-btn assess-ubuntu-2404-cis-action-btn-primary"
            id="assessUbuntu2404CisSubmit"
            data-tool-share-generate
          >
            <i class="bi bi-search" aria-hidden="true"></i>
            <span>Explore</span>
          </button>
          <button
            type="button"
            class="assess-ubuntu-2404-cis-action-btn assess-ubuntu-2404-cis-action-btn-secondary"
            id="assessUbuntu2404CisReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="assess-ubuntu-2404-cis-input-helper-card">
          <span class="assess-ubuntu-2404-cis-input-hint">Filter the assessment scope before reviewing control evidence and output.</span>
          <span class="assess-ubuntu-2404-cis-helper-chip assess-ubuntu-2404-cis-helper-chip-inline" title="Filter by control ID, title, section path, or script name" aria-label="Filter by control ID, title, section path, or script name">i</span>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.01_input-brief #}

{# ns:start family._base.workspace.02_basic-settings #}
    <div class="assess-ubuntu-2404-cis-basic-panel">
      <div class="assess-ubuntu-2404-cis-inner-panel assess-ubuntu-2404-cis-basic-card">

        <div class="assess-ubuntu-2404-cis-example-card">
          <span class="assess-ubuntu-2404-cis-example-label">Example assessment settings</span>
          <strong class="assess-ubuntu-2404-cis-example-value">All sections, all paths, all criticality</strong>
          <span class="assess-ubuntu-2404-cis-example-helper">Keep primary scope filters visible before reviewing selected scripts and output limits.</span>
        </div>

        <div class="assess-ubuntu-2404-cis-setting-row assess-ubuntu-2404-cis-setting-card">
          <label for="assessUbuntu2404CisFamily" class="assess-ubuntu-2404-cis-setting-label">
            Top-level section:
            <span class="info-dot assess-ubuntu-2404-cis-helper-chip" title="Narrow the benchmark to one family such as initial, firewall, or access control">i</span>
          </label>

          <div class="assess-ubuntu-2404-cis-setting-field">
            <div class="assess-ubuntu-2404-cis-native-select-wrap">
                <select id="assessUbuntu2404CisFamily" class="form-select assess-ubuntu-2404-cis-native-select">
                </select>
              </div>
          </div>
        </div>

        <div class="assess-ubuntu-2404-cis-setting-row assess-ubuntu-2404-cis-setting-card">
          <label for="assessUbuntu2404CisSectionPath" class="assess-ubuntu-2404-cis-setting-label">
            Section path:
            <span class="info-dot assess-ubuntu-2404-cis-helper-chip" title="Choose a benchmark path or keep the whole current family in scope">i</span>
          </label>

          <div class="assess-ubuntu-2404-cis-setting-field">
            <div class="assess-ubuntu-2404-cis-native-select-wrap">
                <select id="assessUbuntu2404CisSectionPath" class="form-select assess-ubuntu-2404-cis-native-select">
                </select>
              </div>
          </div>
        </div>

        <div class="assess-ubuntu-2404-cis-setting-row assess-ubuntu-2404-cis-setting-card">
          <label for="assessUbuntu2404CisCriticality" class="assess-ubuntu-2404-cis-setting-label">
            Criticality:
            <span class="info-dot assess-ubuntu-2404-cis-helper-chip" title="Filter controls by declared benchmark criticality">i</span>
          </label>

          <div class="assess-ubuntu-2404-cis-setting-field">
            <div class="assess-ubuntu-2404-cis-native-select-wrap">
                <select id="assessUbuntu2404CisCriticality" class="form-select assess-ubuntu-2404-cis-native-select">
                </select>
              </div>
          </div>
        </div>

      </div>
    </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
    <details class="assess-ubuntu-2404-cis-advanced" data-custom-layout="compact_two_column_multi_row">
      <summary class="assess-ubuntu-2404-cis-advanced-summary">
        <span>Custom</span>
          <span class="assess-ubuntu-2404-cis-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="assess-ubuntu-2404-cis-advanced-body">
        <div class="assess-ubuntu-2404-cis-inner-panel">
          <div class="assess-ubuntu-2404-cis-setting-row assess-ubuntu-2404-cis-setting-card">
            <label for="assessUbuntu2404CisRowLimit" class="assess-ubuntu-2404-cis-setting-label">
              Visible rows:
              <span class="info-dot assess-ubuntu-2404-cis-helper-chip" title="Limit the controls table while keeping the selected script available">i</span>
            </label>

            <div class="assess-ubuntu-2404-cis-setting-field">
              <div class="assess-ubuntu-2404-cis-native-select-wrap">
                <select id="assessUbuntu2404CisRowLimit" class="form-select assess-ubuntu-2404-cis-native-select">
                  <option value="25">25 rows</option>
                  <option value="50" selected>50 rows</option>
                  <option value="100">100 rows</option>
                  <option value="all">All rows</option>
                </select>
              </div>
            </div>
          </div>

          <div class="assess-ubuntu-2404-cis-setting-row assess-ubuntu-2404-cis-setting-card">
            <label for="assessUbuntu2404CisSelectedControl" class="assess-ubuntu-2404-cis-setting-label">
              Script source:
              <span class="info-dot assess-ubuntu-2404-cis-helper-chip" title="Pick the exact CIS control script to inspect and copy">i</span>
            </label>

            <div class="assess-ubuntu-2404-cis-setting-field">
              <div class="assess-ubuntu-2404-cis-control-picker" data-control-picker>
                <input type="hidden" id="assessUbuntu2404CisSelectedControl" value="">
                <button type="button" id="assessUbuntu2404CisSelectedControlTrigger" class="assess-ubuntu-2404-cis-control-picker-trigger" aria-expanded="false" aria-controls="assessUbuntu2404CisControlPickerPanel">
                  <span id="assessUbuntu2404CisSelectedControlLabel" class="assess-ubuntu-2404-cis-control-picker-label">No script selected</span>
                  <span class="assess-ubuntu-2404-cis-control-picker-arrow" aria-hidden="true"></span>
                </button>
                <div id="assessUbuntu2404CisControlPickerPanel" class="assess-ubuntu-2404-cis-control-picker-panel" hidden>
                  <input id="assessUbuntu2404CisControlPickerSearch" class="form-control assess-ubuntu-2404-cis-control-picker-search" type="search" autocomplete="off" aria-label="Search script source" placeholder="Search script source">
                  <div id="assessUbuntu2404CisControlPickerOptions" class="assess-ubuntu-2404-cis-control-picker-options" role="listbox" aria-label="Script source options"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="assess-ubuntu-2404-cis-setting-row assess-ubuntu-2404-cis-setting-card">
            <label class="assess-ubuntu-2404-cis-setting-label">
              Criticality map:
              <span class="info-dot assess-ubuntu-2404-cis-helper-chip" title="This reflects the metadata declared in the copied benchmark scripts under assets/bin">i</span>
            </label>

            <div class="assess-ubuntu-2404-cis-setting-field">
              <div class="assess-ubuntu-2404-cis-criticality-row" id="assessUbuntu2404CisCriticalityRow"></div>
            </div>
          </div>
        </div>
      </div>
    </details>
{# ns:end family._base.workspace.03_custom-settings #}
  </form>

{# ns:start family._base.workspace.05_result-summary #}
  <div class="assess-ubuntu-2404-cis-result-panel" id="assessUbuntu2404CisResultPanel">
    <div class="assess-ubuntu-2404-cis-result-empty" id="assessUbuntu2404CisResultEmpty">Run Explore to review matching controls, section rollups, the selected script, and exportable JSON.</div>

    <div class="assess-ubuntu-2404-cis-result-error d-none" id="assessUbuntu2404CisResultError"></div>

    <div class="assess-ubuntu-2404-cis-result-content d-none" id="assessUbuntu2404CisResultContent">
      <div class="assess-ubuntu-2404-cis-output-shell">
        <div class="assess-ubuntu-2404-cis-result-summary" id="assessUbuntu2404CisResultSummary" data-share-snapshot-source data-share-kind="assessment-summary"></div>
{# ns:end family._base.workspace.05_result-summary #}

{# ns:start family._base.workspace.06_output-toolbar #}
        <div class="assess-ubuntu-2404-cis-toolbar-shell">
          <div class="assess-ubuntu-2404-cis-toolbar tool-output-toolbar tool-result-toolbar">
            <div class="assess-ubuntu-2404-cis-toolbar-left tool-result-toolbar-main">
              <div class="assess-ubuntu-2404-cis-sort-shell">
                <label for="assessUbuntu2404CisSort" class="assess-ubuntu-2404-cis-sort-label">Sort</label>
                <div class="assess-ubuntu-2404-cis-sort-wrap">
                  <details class="assess-ubuntu-2404-cis-sort-select" id="assessUbuntu2404CisSortSelect">
                    <summary class="assess-ubuntu-2404-cis-sort-summary">
                      <span id="assessUbuntu2404CisSortSummary">ID</span>
                    </summary>

                    <div class="assess-ubuntu-2404-cis-sort-menu">
                      <div class="assess-ubuntu-2404-cis-sort-grid" id="assessUbuntu2404CisSortOptions">
                        <button type="button" class="assess-ubuntu-2404-cis-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                        <button type="button" class="assess-ubuntu-2404-cis-sort-option" data-sort-value="title" aria-pressed="false">A-Z</button>
                        <button type="button" class="assess-ubuntu-2404-cis-sort-option" data-sort-value="section" aria-pressed="false">Section</button>
                        <button type="button" class="assess-ubuntu-2404-cis-sort-option" data-sort-value="criticality" aria-pressed="false">Criticality</button>
                        <button type="button" class="assess-ubuntu-2404-cis-sort-option" data-sort-value="script" aria-pressed="false">Script</button>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="assessUbuntu2404CisSort" value="id">
