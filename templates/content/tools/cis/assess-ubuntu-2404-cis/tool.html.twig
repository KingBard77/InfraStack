              <div class="assess-ubuntu-2404-cis-toolbar-meta" id="assessUbuntu2404CisToolbarMeta"></div>
            </div>

            <div class="assess-ubuntu-2404-cis-toolbar-actions tool-output-actions tool-result-toolbar-actions">
