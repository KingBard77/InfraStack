            <div class="tool-tab-panel assess-ubuntu-2404-cis-tab-panel active" id="assessUbuntu2404CisControlsPanel" data-tab-panel="assessUbuntu2404CisControlsPanel" role="tabpanel" aria-labelledby="assessUbuntu2404CisControlsTab">
