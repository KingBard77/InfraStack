<div class="calculate-cost-aws-tool" data-tool-slug="calculate-cost-aws" data-tool-category="AWS">
<div class="tool-box">
  <form class="calculate-cost-aws-form" id="calculateCostAwsForm">
    <div class="calculate-cost-aws-main-row">
      <label for="calculateCostAwsLabel" class="calculate-cost-aws-main-label">
        Estimate label:
        <span class="info-dot" title="Name the workload or environment you want to estimate">i</span>
      </label>

      <div class="calculate-cost-aws-main-input-grid">
        <input
          type="text"
          id="calculateCostAwsLabel"
          class="form-control"
          placeholder="Production API stack"
          value="Lean web platform"
        >

        <div class="calculate-cost-aws-main-actions">
          <button type="submit" class="btn btn-primary calculate-cost-aws-submit-btn" id="calculateCostAwsSubmit">Estimate</button>
          <button type="button" class="calculate-cost-aws-secondary-btn calculate-cost-aws-reset-btn" id="calculateCostAwsReset">Reset</button>
        </div>
      </div>
    </div>

    <div class="calculate-cost-aws-basic-panel">
      <div class="calculate-cost-aws-inner-panel">
        <div class="calculate-cost-aws-setting-row">
          <label for="calculateCostAwsPreset" class="calculate-cost-aws-setting-label">
            Preset:
            <span class="info-dot" title="Load a starting cost shape for a common AWS workload">i</span>
          </label>

          <div class="calculate-cost-aws-setting-field">
            <div class="calculate-cost-aws-inline-grid calculate-cost-aws-inline-grid-preset">
              <details class="calculate-cost-aws-select" id="calculateCostAwsPresetSelect">
                <summary class="calculate-cost-aws-select-summary">
                  <span id="calculateCostAwsPresetSummary">Lean web platform</span>
                </summary>

                <div class="calculate-cost-aws-select-body">
                  <div class="calculate-cost-aws-select-grid calculate-cost-aws-select-grid-list">
                    <label class="calculate-cost-aws-select-card">
                      <input type="radio" name="calculateCostAwsPresetOption" value="lean-web" checked>
                      <span class="calculate-cost-aws-select-title">Lean web platform</span>
                    </label>

                    <label class="calculate-cost-aws-select-card">
                      <input type="radio" name="calculateCostAwsPresetOption" value="serverless-api">
                      <span class="calculate-cost-aws-select-title">Serverless API</span>
                    </label>

                    <label class="calculate-cost-aws-select-card">
                      <input type="radio" name="calculateCostAwsPresetOption" value="steady-platform">
                      <span class="calculate-cost-aws-select-title">Steady application platform</span>
                    </label>

                    <label class="calculate-cost-aws-select-card">
                      <input type="radio" name="calculateCostAwsPresetOption" value="blank">
                      <span class="calculate-cost-aws-select-title">Blank estimate</span>
                    </label>
                  </div>
                </div>
              </details>
              <input type="hidden" id="calculateCostAwsPreset" value="lean-web">

              <button type="button" class="calculate-cost-aws-secondary-btn" id="calculateCostAwsApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-aws-setting-row">
          <label class="calculate-cost-aws-setting-label">
            Pricing basis:
            <span class="info-dot" title="Starter prices are visible and editable in Advanced so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-aws-setting-field">
            <div class="calculate-cost-aws-basis-grid">
              <div class="calculate-cost-aws-basis-card">
                <span class="calculate-cost-aws-basis-label">Catalog</span>
                <span class="calculate-cost-aws-basis-value">Starter AWS mix</span>
                <span class="calculate-cost-aws-basis-note">EC2 uses a compact purchase-model catalog. Storage, Lambda, API, and egress use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-aws-basis-card">
                <span class="calculate-cost-aws-basis-label">Output</span>
                <span class="calculate-cost-aws-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-aws-basis-note">Use the result as a planning estimate, then verify material decisions in AWS pricing or billing data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-aws-service-grid">
          <section class="calculate-cost-aws-service-card" data-service-card="ec2">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">EC2 Compute</h3>
                <p class="calculate-cost-aws-service-copy">Instance count, runtime, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap">
                <input type="checkbox" id="calculateCostAwsIncludeEc2" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsEc2Body">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Instance" class="calculate-cost-aws-field-label">Instance type</label>
                  <details class="calculate-cost-aws-select" id="calculateCostAwsEc2InstanceSelect">
                    <summary class="calculate-cost-aws-select-summary">
                      <span id="calculateCostAwsEc2InstanceSummary">t4g.medium • 2 vCPU • 4 GiB</span>
                    </summary>

                    <div class="calculate-cost-aws-select-body">
                      <div class="calculate-cost-aws-select-grid calculate-cost-aws-select-grid-list">
                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t4g.micro">
                          <span class="calculate-cost-aws-select-title">t4g.micro • 2 vCPU • 1 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t4g.small">
                          <span class="calculate-cost-aws-select-title">t4g.small • 2 vCPU • 2 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t4g.medium" checked>
                          <span class="calculate-cost-aws-select-title">t4g.medium • 2 vCPU • 4 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t4g.large">
                          <span class="calculate-cost-aws-select-title">t4g.large • 2 vCPU • 8 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t4g.xlarge">
                          <span class="calculate-cost-aws-select-title">t4g.xlarge • 4 vCPU • 16 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t3.micro">
                          <span class="calculate-cost-aws-select-title">t3.micro • 2 vCPU • 1 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t3.small">
                          <span class="calculate-cost-aws-select-title">t3.small • 2 vCPU • 2 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t3.medium">
                          <span class="calculate-cost-aws-select-title">t3.medium • 2 vCPU • 4 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t3.large">
                          <span class="calculate-cost-aws-select-title">t3.large • 2 vCPU • 8 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="t3.xlarge">
                          <span class="calculate-cost-aws-select-title">t3.xlarge • 4 vCPU • 16 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="c6g.medium">
                          <span class="calculate-cost-aws-select-title">c6g.medium • 1 vCPU • 2 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="c6g.large">
                          <span class="calculate-cost-aws-select-title">c6g.large • 2 vCPU • 4 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="c7g.medium">
                          <span class="calculate-cost-aws-select-title">c7g.medium • 1 vCPU • 2 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="c7g.large">
                          <span class="calculate-cost-aws-select-title">c7g.large • 2 vCPU • 4 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="m6g.medium">
                          <span class="calculate-cost-aws-select-title">m6g.medium • 1 vCPU • 4 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="m6g.large">
                          <span class="calculate-cost-aws-select-title">m6g.large • 2 vCPU • 8 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="m7g.medium">
                          <span class="calculate-cost-aws-select-title">m7g.medium • 1 vCPU • 4 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="m7g.large">
                          <span class="calculate-cost-aws-select-title">m7g.large • 2 vCPU • 8 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="r6g.medium">
                          <span class="calculate-cost-aws-select-title">r6g.medium • 1 vCPU • 8 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="r6g.large">
                          <span class="calculate-cost-aws-select-title">r6g.large • 2 vCPU • 16 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="r7g.medium">
                          <span class="calculate-cost-aws-select-title">r7g.medium • 1 vCPU • 8 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="r7g.large">
                          <span class="calculate-cost-aws-select-title">r7g.large • 2 vCPU • 16 GiB</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2InstanceOption" value="custom">
                          <span class="calculate-cost-aws-select-title" id="calculateCostAwsEc2CustomOptionLabel">Custom size • user defined</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostAwsEc2Instance" value="t4g.medium">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Purchase" class="calculate-cost-aws-field-label">Purchase model</label>
                  <details class="calculate-cost-aws-select" id="calculateCostAwsEc2PurchaseSelect">
                    <summary class="calculate-cost-aws-select-summary">
                      <span id="calculateCostAwsEc2PurchaseSummary">On-Demand</span>
                    </summary>

                    <div class="calculate-cost-aws-select-body">
                      <div class="calculate-cost-aws-select-grid calculate-cost-aws-select-grid-two">
                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2PurchaseOption" value="onDemand" checked>
                          <span class="calculate-cost-aws-select-title">On-Demand</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2PurchaseOption" value="spot">
                          <span class="calculate-cost-aws-select-title">Spot</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2PurchaseOption" value="savings1">
                          <span class="calculate-cost-aws-select-title">Savings Plan 1yr</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2PurchaseOption" value="savings3">
                          <span class="calculate-cost-aws-select-title">Savings Plan 3yr</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2PurchaseOption" value="reserved1">
                          <span class="calculate-cost-aws-select-title">Reserved 1yr</span>
                        </label>

                        <label class="calculate-cost-aws-select-card">
                          <input type="radio" name="calculateCostAwsEc2PurchaseOption" value="reserved3">
                          <span class="calculate-cost-aws-select-title">Reserved 3yr</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostAwsEc2Purchase" value="onDemand">
                </div>

                <div class="calculate-cost-aws-custom-instance-grid calculate-cost-aws-card-span-two d-none" id="calculateCostAwsEc2CustomFields">
                  <div class="calculate-cost-aws-field-stack">
                    <label for="calculateCostAwsEc2CustomLabel" class="calculate-cost-aws-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostAwsEc2CustomLabel"
                      class="form-control"
                      placeholder="Custom instance profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-aws-field-stack">
                    <label for="calculateCostAwsEc2CustomVcpu" class="calculate-cost-aws-field-label">Custom vCPU</label>
                    <input
                      type="number"
                      id="calculateCostAwsEc2CustomVcpu"
                      class="form-control"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-aws-field-stack">
                    <label for="calculateCostAwsEc2CustomMemoryGiB" class="calculate-cost-aws-field-label">Custom memory GiB</label>
                    <input
                      type="number"
                      id="calculateCostAwsEc2CustomMemoryGiB"
                      class="form-control"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

                <p class="calculate-cost-aws-field-hint calculate-cost-aws-card-span-two d-none" id="calculateCostAwsEc2CustomHint">Custom size uses the EC2 hourly override in Advanced. Set the custom vCPU and memory here, then price it with the override field.</p>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Count" class="calculate-cost-aws-field-label">Instance count</label>
                  <input type="number" id="calculateCostAwsEc2Count" class="form-control" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Hours" class="calculate-cost-aws-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostAwsEc2Hours" class="form-control" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="ebs">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">EBS Storage</h3>
                <p class="calculate-cost-aws-service-copy">gp3 capacity plus optional IOPS and throughput.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap">
                <input type="checkbox" id="calculateCostAwsIncludeEbs" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsEbsBody">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEbsStorageGb" class="calculate-cost-aws-field-label">Storage GB</label>
                  <input type="number" id="calculateCostAwsEbsStorageGb" class="form-control" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEbsIops" class="calculate-cost-aws-field-label">Provisioned IOPS</label>
                  <input type="number" id="calculateCostAwsEbsIops" class="form-control" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-aws-field-stack calculate-cost-aws-card-span-two">
                  <label for="calculateCostAwsEbsThroughput" class="calculate-cost-aws-field-label">Throughput MB/s</label>
                  <input type="number" id="calculateCostAwsEbsThroughput" class="form-control" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="s3">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">S3 Storage</h3>
                <p class="calculate-cost-aws-service-copy">Object storage, request volume, and outbound transfer.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap">
                <input type="checkbox" id="calculateCostAwsIncludeS3" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsS3Body">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3StorageGb" class="calculate-cost-aws-field-label">Storage GB</label>
                  <input type="number" id="calculateCostAwsS3StorageGb" class="form-control" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3EgressGb" class="calculate-cost-aws-field-label">Transfer out GB</label>
                  <input type="number" id="calculateCostAwsS3EgressGb" class="form-control" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3GetRequestsK" class="calculate-cost-aws-field-label">GET requests (1k)</label>
                  <input type="number" id="calculateCostAwsS3GetRequestsK" class="form-control" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3PutRequestsK" class="calculate-cost-aws-field-label">PUT/LIST requests (1k)</label>
                  <input type="number" id="calculateCostAwsS3PutRequestsK" class="form-control" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="lambda">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">Lambda</h3>
                <p class="calculate-cost-aws-service-copy">Requests, duration, and memory drive the bill.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap">
                <input type="checkbox" id="calculateCostAwsIncludeLambda" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsLambdaBody">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsLambdaRequestsMillion" class="calculate-cost-aws-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostAwsLambdaRequestsMillion" class="form-control" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsLambdaDurationMs" class="calculate-cost-aws-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostAwsLambdaDurationMs" class="form-control" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-aws-field-stack calculate-cost-aws-card-span-two">
                  <label for="calculateCostAwsLambdaMemoryMb" class="calculate-cost-aws-field-label">Memory MB</label>
                  <input type="number" id="calculateCostAwsLambdaMemoryMb" class="form-control" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="api">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">API Gateway</h3>
                <p class="calculate-cost-aws-service-copy">HTTP and REST requests with response egress.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap">
                <input type="checkbox" id="calculateCostAwsIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsApiBody">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsApiType" class="calculate-cost-aws-field-label">API type</label>
                  <details class="calculate-cost-aws-select" id="calculateCostAwsApiTypeSelect">
                    <summary class="calculate-cost-aws-select-summary">
                      <span id="calculateCostAwsApiTypeSummary">HTTP API</span>
