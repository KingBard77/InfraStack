{# ns:start family._base.workspace.00_shell #}
<div class="calculate-cost-aws-tool" data-tool-slug="calculate-cost-aws" data-tool-category="AWS">
<div class="tool-box">
  <form class="calculate-cost-aws-form" id="calculateCostAwsForm">
{# ns:start family._base.workspace.01_input-brief #}
    <div class="calculate-cost-aws-input-card">
      <div class="calculate-cost-aws-input-brief" data-input-layout="inline">
        <div class="calculate-cost-aws-main-row calculate-cost-aws-input-row">
          <div class="calculate-cost-aws-input-label-wrap">
            <label for="calculateCostAwsLabel" class="calculate-cost-aws-main-label calculate-cost-aws-input-label">Estimate label:</label>
            <span class="calculate-cost-aws-helper-chip" title="Name the workload or environment you want to estimate" aria-label="Name the workload or environment you want to estimate">i</span>
          </div>

          <div class="calculate-cost-aws-main-input-grid calculate-cost-aws-input-stack">
            <input
              type="text"
              id="calculateCostAwsLabel"
              class="form-control calculate-cost-aws-input-control"
              placeholder="Production API stack"
              value="Lean web platform"
            >
            <div class="calculate-cost-aws-input-error d-none" id="calculateCostAwsInputError" role="alert"></div>
          </div>
        </div>

        <div class="calculate-cost-aws-main-actions calculate-cost-aws-input-actions">
          <button
            type="submit"
            class="btn btn-primary calculate-cost-aws-submit-btn calculate-cost-aws-action-btn calculate-cost-aws-action-btn-primary"
            id="calculateCostAwsSubmit"
            data-tool-share-generate
          >
            <i class="bi bi-calculator" aria-hidden="true"></i>
            <span>Estimate</span>
          </button>
          <button
            type="button"
            class="calculate-cost-aws-secondary-btn calculate-cost-aws-reset-btn calculate-cost-aws-action-btn calculate-cost-aws-action-btn-secondary"
            id="calculateCostAwsReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="calculate-cost-aws-input-helper-card">
          <span class="calculate-cost-aws-input-hint">Use a short label that can travel with exported estimate data.</span>
          <span class="calculate-cost-aws-helper-chip calculate-cost-aws-helper-chip-inline" title="Name the workload or environment you want to estimate" aria-label="Name the workload or environment you want to estimate">i</span>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.01_input-brief #}

{# ns:start family._base.workspace.02_basic-settings #}
    <div class="calculate-cost-aws-basic-panel">
      <div class="calculate-cost-aws-inner-panel calculate-cost-aws-basic-card">

        <div class="calculate-cost-aws-example-card">
          <span class="calculate-cost-aws-example-label">Example estimate settings</span>
          <strong class="calculate-cost-aws-example-value">Lean web platform, monthly USD, starter catalog</strong>
          <span class="calculate-cost-aws-example-helper">Preset and basis controls must update totals, tables, and JSON together.</span>
        </div>

        <div class="calculate-cost-aws-setting-row calculate-cost-aws-setting-card">
          <label for="calculateCostAwsPreset" class="calculate-cost-aws-setting-label">
            Preset:
            <span class="info-dot calculate-cost-aws-helper-chip" title="Load a starting cost shape for a common AWS workload">i</span>
          </label>

          <div class="calculate-cost-aws-setting-field">
            <div class="calculate-cost-aws-inline-grid calculate-cost-aws-inline-grid-preset">
              <div class="calculate-cost-aws-native-select-wrap" id="calculateCostAwsPresetSelect">
                <select id="calculateCostAwsPreset" class="form-select calculate-cost-aws-native-select">
                  <option value="lean-web" selected>Lean web platform</option>
                  <option value="serverless-api">Serverless API</option>
                  <option value="steady-platform">Steady application platform</option>
                  <option value="blank">Blank estimate</option>
                </select>
              </div>

              <button type="button" class="calculate-cost-aws-secondary-btn" id="calculateCostAwsApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-aws-setting-row calculate-cost-aws-setting-card">
          <label class="calculate-cost-aws-setting-label">
            Pricing basis:
            <span class="info-dot calculate-cost-aws-helper-chip" title="Starter prices are visible and editable in Custom so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-aws-setting-field">
            <div class="calculate-cost-aws-basis-grid">
              <div class="calculate-cost-aws-basis-card">
                <span class="calculate-cost-aws-basis-label">Catalog</span>
                <span class="calculate-cost-aws-basis-value">Starter AWS mix</span>
                <span class="calculate-cost-aws-basis-note">EC2 uses a compact purchase-model catalog. Storage, Lambda, API, and egress use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-aws-basis-card">
                <span class="calculate-cost-aws-basis-label">Output</span>
                <span class="calculate-cost-aws-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-aws-basis-note">Use the result as a planning estimate, then verify material decisions in AWS pricing or billing data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-aws-service-grid">
          <section class="calculate-cost-aws-service-card" data-service-card="ec2">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">EC2 Compute</h3>
                <p class="calculate-cost-aws-service-copy">Instance count, runtime, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap calculate-cost-aws-switch-card">
                <input type="checkbox" id="calculateCostAwsIncludeEc2" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsEc2Body">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Instance" class="calculate-cost-aws-field-label">Instance type</label>
                  <div class="calculate-cost-aws-native-select-wrap" id="calculateCostAwsEc2InstanceSelect">
                    <select id="calculateCostAwsEc2Instance" class="form-select calculate-cost-aws-native-select">
                      <option value="t4g.micro">t4g.micro • 2 vCPU • 1 GiB</option>
                      <option value="t4g.small">t4g.small • 2 vCPU • 2 GiB</option>
                      <option value="t4g.medium" selected>t4g.medium • 2 vCPU • 4 GiB</option>
                      <option value="t4g.large">t4g.large • 2 vCPU • 8 GiB</option>
                      <option value="t4g.xlarge">t4g.xlarge • 4 vCPU • 16 GiB</option>
                      <option value="t3.micro">t3.micro • 2 vCPU • 1 GiB</option>
                      <option value="t3.small">t3.small • 2 vCPU • 2 GiB</option>
                      <option value="t3.medium">t3.medium • 2 vCPU • 4 GiB</option>
                      <option value="t3.large">t3.large • 2 vCPU • 8 GiB</option>
                      <option value="t3.xlarge">t3.xlarge • 4 vCPU • 16 GiB</option>
                      <option value="c6g.medium">c6g.medium • 1 vCPU • 2 GiB</option>
                      <option value="c6g.large">c6g.large • 2 vCPU • 4 GiB</option>
                      <option value="c7g.medium">c7g.medium • 1 vCPU • 2 GiB</option>
                      <option value="c7g.large">c7g.large • 2 vCPU • 4 GiB</option>
                      <option value="m6g.medium">m6g.medium • 1 vCPU • 4 GiB</option>
                      <option value="m6g.large">m6g.large • 2 vCPU • 8 GiB</option>
                      <option value="m7g.medium">m7g.medium • 1 vCPU • 4 GiB</option>
                      <option value="m7g.large">m7g.large • 2 vCPU • 8 GiB</option>
                      <option value="r6g.medium">r6g.medium • 1 vCPU • 8 GiB</option>
                      <option value="r6g.large">r6g.large • 2 vCPU • 16 GiB</option>
                      <option value="r7g.medium">r7g.medium • 1 vCPU • 8 GiB</option>
                      <option value="r7g.large">r7g.large • 2 vCPU • 16 GiB</option>
                      <option id="calculateCostAwsEc2CustomOptionLabel" value="custom">Custom size • user defined</option>
                    </select>
                  </div>
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Purchase" class="calculate-cost-aws-field-label">Purchase model</label>
                  <div class="calculate-cost-aws-native-select-wrap" id="calculateCostAwsEc2PurchaseSelect">
                    <select id="calculateCostAwsEc2Purchase" class="form-select calculate-cost-aws-native-select">
                      <option value="onDemand" selected>On-Demand</option>
                      <option value="spot">Spot</option>
                      <option value="savings1">Savings Plan 1yr</option>
                      <option value="savings3">Savings Plan 3yr</option>
                      <option value="reserved1">Reserved 1yr</option>
                      <option value="reserved3">Reserved 3yr</option>
                    </select>
                  </div>
                </div>

                <div class="calculate-cost-aws-custom-instance-grid calculate-cost-aws-card-span-two d-none" id="calculateCostAwsEc2CustomFields">
                  <div class="calculate-cost-aws-field-stack">
                    <label for="calculateCostAwsEc2CustomLabel" class="calculate-cost-aws-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostAwsEc2CustomLabel"
                      class="form-control calculate-cost-aws-text-field"
                      placeholder="Custom instance profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-aws-field-stack">
                    <label for="calculateCostAwsEc2CustomVcpu" class="calculate-cost-aws-field-label">Custom vCPU</label>
                    <input
                      type="number"
                      id="calculateCostAwsEc2CustomVcpu"
                      class="form-control calculate-cost-aws-text-field"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-aws-field-stack">
                    <label for="calculateCostAwsEc2CustomMemoryGiB" class="calculate-cost-aws-field-label">Custom memory GiB</label>
                    <input
                      type="number"
                      id="calculateCostAwsEc2CustomMemoryGiB"
                      class="form-control calculate-cost-aws-text-field"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

                <p class="calculate-cost-aws-field-hint calculate-cost-aws-card-span-two d-none" id="calculateCostAwsEc2CustomHint">Custom size uses the EC2 hourly override in Custom. Set the custom vCPU and memory here, then price it with the override field.</p>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Count" class="calculate-cost-aws-field-label">Instance count</label>
                  <input type="number" id="calculateCostAwsEc2Count" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEc2Hours" class="calculate-cost-aws-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostAwsEc2Hours" class="form-control calculate-cost-aws-text-field" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="ebs">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">EBS Storage</h3>
                <p class="calculate-cost-aws-service-copy">gp3 capacity plus optional IOPS and throughput.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap calculate-cost-aws-switch-card">
                <input type="checkbox" id="calculateCostAwsIncludeEbs" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsEbsBody">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEbsStorageGb" class="calculate-cost-aws-field-label">Storage GB</label>
                  <input type="number" id="calculateCostAwsEbsStorageGb" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsEbsIops" class="calculate-cost-aws-field-label">Provisioned IOPS</label>
                  <input type="number" id="calculateCostAwsEbsIops" class="form-control calculate-cost-aws-text-field" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-aws-field-stack calculate-cost-aws-card-span-two">
                  <label for="calculateCostAwsEbsThroughput" class="calculate-cost-aws-field-label">Throughput MB/s</label>
                  <input type="number" id="calculateCostAwsEbsThroughput" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="s3">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">S3 Storage</h3>
                <p class="calculate-cost-aws-service-copy">Object storage, request volume, and outbound transfer.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap calculate-cost-aws-switch-card">
                <input type="checkbox" id="calculateCostAwsIncludeS3" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsS3Body">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3StorageGb" class="calculate-cost-aws-field-label">Storage GB</label>
                  <input type="number" id="calculateCostAwsS3StorageGb" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3EgressGb" class="calculate-cost-aws-field-label">Transfer out GB</label>
                  <input type="number" id="calculateCostAwsS3EgressGb" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3GetRequestsK" class="calculate-cost-aws-field-label">GET requests (1k)</label>
                  <input type="number" id="calculateCostAwsS3GetRequestsK" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsS3PutRequestsK" class="calculate-cost-aws-field-label">PUT/LIST requests (1k)</label>
                  <input type="number" id="calculateCostAwsS3PutRequestsK" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="lambda">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">Lambda</h3>
                <p class="calculate-cost-aws-service-copy">Requests, duration, and memory drive the bill.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap calculate-cost-aws-switch-card">
                <input type="checkbox" id="calculateCostAwsIncludeLambda" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsLambdaBody">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsLambdaRequestsMillion" class="calculate-cost-aws-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostAwsLambdaRequestsMillion" class="form-control calculate-cost-aws-text-field" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsLambdaDurationMs" class="calculate-cost-aws-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostAwsLambdaDurationMs" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-aws-field-stack calculate-cost-aws-card-span-two">
                  <label for="calculateCostAwsLambdaMemoryMb" class="calculate-cost-aws-field-label">Memory MB</label>
                  <input type="number" id="calculateCostAwsLambdaMemoryMb" class="form-control calculate-cost-aws-text-field" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="api">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">API Gateway</h3>
                <p class="calculate-cost-aws-service-copy">HTTP and REST requests with response egress.</p>
              </div>

              <label class="switch calculate-cost-aws-switch-wrap calculate-cost-aws-switch-card">
                <input type="checkbox" id="calculateCostAwsIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-aws-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-aws-service-body" id="calculateCostAwsApiBody">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsApiType" class="calculate-cost-aws-field-label">API type</label>
                  <div class="calculate-cost-aws-native-select-wrap" id="calculateCostAwsApiTypeSelect">
                    <select id="calculateCostAwsApiType" class="form-select calculate-cost-aws-native-select">
                      <option value="http" selected>HTTP API</option>
                      <option value="rest">REST API</option>
                    </select>
                  </div>
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsApiRequestsMillion" class="calculate-cost-aws-field-label">Requests (million)</label>
                  <input type="number" id="calculateCostAwsApiRequestsMillion" class="form-control calculate-cost-aws-text-field" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-aws-field-stack calculate-cost-aws-card-span-two">
                  <label for="calculateCostAwsApiResponseKb" class="calculate-cost-aws-field-label">Avg response KB</label>
                  <input type="number" id="calculateCostAwsApiResponseKb" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="32">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-aws-service-card" data-service-card="overhead">
            <div class="calculate-cost-aws-service-head">
              <div>
                <h3 class="calculate-cost-aws-service-title">Shared Egress And Overhead</h3>
                <p class="calculate-cost-aws-service-copy">Network, support uplift, and blended buffer.</p>
              </div>
            </div>

            <div class="calculate-cost-aws-service-body">
              <div class="calculate-cost-aws-card-grid calculate-cost-aws-card-grid-two">
                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsSharedEgressGb" class="calculate-cost-aws-field-label">Shared egress GB</label>
                  <input type="number" id="calculateCostAwsSharedEgressGb" class="form-control calculate-cost-aws-text-field" min="0" step="1" value="120">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsSupportPct" class="calculate-cost-aws-field-label">Support uplift %</label>
                  <input type="number" id="calculateCostAwsSupportPct" class="form-control calculate-cost-aws-text-field" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsContingencyPct" class="calculate-cost-aws-field-label">Contingency %</label>
                  <input type="number" id="calculateCostAwsContingencyPct" class="form-control calculate-cost-aws-text-field" min="0" step="0.1" value="10">
                </div>

                <div class="calculate-cost-aws-field-stack">
                  <label for="calculateCostAwsManualAdjustment" class="calculate-cost-aws-field-label">Manual adjustment $</label>
                  <input type="number" id="calculateCostAwsManualAdjustment" class="form-control calculate-cost-aws-text-field" step="0.01" value="0">
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
    <details class="calculate-cost-aws-advanced" data-custom-layout="compact_two_column_multi_row" id="calculateCostAwsAdvanced">
      <summary class="calculate-cost-aws-advanced-summary">
        <span>Custom</span>
          <span class="calculate-cost-aws-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="calculate-cost-aws-advanced-body">
        <div class="calculate-cost-aws-inner-panel">
          <div class="calculate-cost-aws-setting-row calculate-cost-aws-setting-card">
            <label class="calculate-cost-aws-setting-label">
              Free tier toggles:
              <span class="info-dot calculate-cost-aws-helper-chip" title="Apply the starter free-tier allowances that most affect this model">i</span>
            </label>

            <div class="calculate-cost-aws-setting-field">
              <div class="calculate-cost-aws-toggle-grid">
                <label class="calculate-cost-aws-custom-checkbox-option">
                  <input type="checkbox" id="calculateCostAwsFreeTierLambda" checked>
                  <span>Lambda requests + GB-s</span>
                </label>

                <label class="calculate-cost-aws-custom-checkbox-option">
                  <input type="checkbox" id="calculateCostAwsFreeTierApi" checked>
                  <span>API Gateway calls</span>
                </label>

                <label class="calculate-cost-aws-custom-checkbox-option">
                  <input type="checkbox" id="calculateCostAwsFreeTierEgress" checked>
                  <span>Shared 100 GB egress</span>
                </label>
              </div>
            </div>
          </div>

          <div class="calculate-cost-aws-setting-row calculate-cost-aws-setting-card">
            <label for="calculateCostAwsRegionalUpliftPct" class="calculate-cost-aws-setting-label">
              Regional uplift:
              <span class="info-dot calculate-cost-aws-helper-chip" title="Apply a percentage uplift to starter rates when you want to approximate a pricier region">i</span>
            </label>

            <div class="calculate-cost-aws-setting-field">
              <div class="calculate-cost-aws-inline-grid calculate-cost-aws-inline-grid-regional">
                <div class="calculate-cost-aws-field-stack calculate-cost-aws-field-stack-compact">
                  <input type="number" id="calculateCostAwsRegionalUpliftPct" class="form-control" min="0" step="0.1" value="0" placeholder="0">
                </div>
                <div class="calculate-cost-aws-inline-note">Use direct overrides below when you know the real regional rate.</div>
              </div>
            </div>
          </div>

          <div class="calculate-cost-aws-setting-row calculate-cost-aws-setting-row-stacked calculate-cost-aws-setting-card">
            <label class="calculate-cost-aws-setting-label">
              Rate overrides:
