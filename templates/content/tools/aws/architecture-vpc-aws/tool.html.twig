{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}

<div class="architecture-vpc-aws-tool" data-tool-slug="architecture-vpc-aws">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <div class="tool-shell tool-prompt-shell architecture-vpc-aws-input-card">
      <div class="architecture-vpc-aws-input-brief" data-input-layout="stacked">
        <div class="architecture-vpc-aws-input-row">
          <div class="architecture-vpc-aws-input-label-wrap">
            <label for="architectureVpcAwsPrompt" class="tool-main-label architecture-vpc-aws-input-label">Architecture prompt</label>
            <span class="architecture-vpc-aws-helper-chip" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
          </div>
          <div class="tool-main-input-grid architecture-vpc-aws-main-input-grid architecture-vpc-aws-input-stack">
            <textarea
              id="architectureVpcAwsPrompt"
              class="form-control architecture-vpc-aws-prompt architecture-vpc-aws-input-control"
              rows="7"
              placeholder="Describe the AWS VPC layout, region, availability zones, ingress path, compute tier, database tier, and shared services."
            >Create an AWS VPC architecture in us-east-1 with 2 availability zones. Use public subnets for an internet-facing Application Load Balancer, private app subnets for EC2 application servers, and private data subnets for a Multi-AZ RDS PostgreSQL database. Add a single NAT gateway, VPC endpoints for S3 and Systems Manager, CloudWatch, and VPC flow logs.</textarea>
            <div class="architecture-vpc-aws-input-error d-none" id="architectureVpcAwsInputError" role="alert"></div>
          </div>
        </div>

        <div class="architecture-vpc-aws-main-actions architecture-vpc-aws-input-actions">
          <button
            type="button"
            class="tool-action-btn tool-action-btn-primary architecture-vpc-aws-action-btn architecture-vpc-aws-action-btn-primary"
            id="architectureVpcAwsGenerate"
          >
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span>Generate Diagram</span>
          </button>
          <button
            type="button"
            class="tool-action-btn tool-action-btn-secondary architecture-vpc-aws-action-btn architecture-vpc-aws-action-btn-secondary"
            id="architectureVpcAwsReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="architecture-vpc-aws-input-helper-card">
          <span class="architecture-vpc-aws-input-hint">Use one brief prompt with region, AZ count, ingress, private tiers, and supporting AWS services. Presets below can prefill and instantly generate a working layout.</span>
          <span class="architecture-vpc-aws-helper-chip architecture-vpc-aws-helper-chip-inline" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureVpcAwsErrorState"></div>

    <div class="architecture-vpc-aws-advanced-grid">
      <aside class="tool-shell tool-inspector-shell">

        <div class="tool-shell-body">
          {# ns:start family._base.workspace.02_basic-settings #}
          <div class="tool-inspector-section architecture-vpc-aws-basic-preset-section architecture-vpc-aws-basic-card">

            <div class="architecture-vpc-aws-example-card">
              <span class="architecture-vpc-aws-example-label">Example architecture settings</span>
              <strong class="architecture-vpc-aws-example-value">3-tier web, us-east-1, 2 zones</strong>
              <span class="architecture-vpc-aws-example-helper">Region, zone count, and preset should change the generated model and exported JSON.</span>
            </div>

            <div class="architecture-vpc-aws-basic-grid">
              <div class="architecture-vpc-aws-control-stack architecture-vpc-aws-setting-card">
                <label class="tool-control-label architecture-vpc-aws-setting-label" for="architectureVpcAwsPreset">Preset <span class="architecture-vpc-aws-helper-chip" title="Choose a starting preset that updates the visible controls and generated output." aria-label="Choose a starting preset that updates the visible controls and generated output.">i</span></label>
                <div class="architecture-vpc-aws-native-select-wrap" id="architectureVpcAwsPresetSelect">
                  <select id="architectureVpcAwsPreset" class="form-select architecture-vpc-aws-native-select">
                    <option value="three-tier-web" selected>3-Tier Web</option>
                    <option value="ecs-fargate">ECS Fargate</option>
                    <option value="eks-platform">Private EKS</option>
                    <option value="hybrid-shared">Hybrid Shared Services</option>
                  </select>
                </div>
              </div>

              <div class="architecture-vpc-aws-control-stack architecture-vpc-aws-setting-card">
                <label class="tool-control-label architecture-vpc-aws-setting-label" for="architectureVpcAwsRegion">Region <span class="architecture-vpc-aws-helper-chip" title="Choose the provider region used by the generated model and exported JSON." aria-label="Choose the provider region used by the generated model and exported JSON.">i</span></label>
                <div class="architecture-vpc-aws-native-select-wrap" id="architectureVpcAwsRegionSelect">
                  <select id="architectureVpcAwsRegion" class="form-select architecture-vpc-aws-native-select">
                    <option value="us-east-1">us-east-1</option>
                    <option value="us-east-2">us-east-2</option>
                    <option value="us-west-2">us-west-2</option>
                    <option value="eu-west-1">eu-west-1</option>
                    <option value="ap-southeast-1">ap-southeast-1</option>
                    <option value="ap-southeast-2">ap-southeast-2</option>
                    <option value="ap-northeast-1">ap-northeast-1</option>
                  </select>
                </div>
              </div>

              <div class="architecture-vpc-aws-control-stack architecture-vpc-aws-setting-card">
                <label class="tool-control-label architecture-vpc-aws-setting-label" for="architectureVpcAwsAzCount">Availability zones <span class="architecture-vpc-aws-helper-chip" title="Choose the zone count used by placement and resilience assumptions." aria-label="Choose the zone count used by placement and resilience assumptions.">i</span></label>
                <div class="architecture-vpc-aws-native-select-wrap" id="architectureVpcAwsAzCountSelect">
                  <select id="architectureVpcAwsAzCount" class="form-select architecture-vpc-aws-native-select">
                    <option value="1">1 AZ</option>
                    <option value="2" selected>2 AZ</option>
                    <option value="3">3 AZ</option>
                  </select>
                </div>
              </div>
              <p class="tool-control-hint architecture-vpc-aws-setting-hint" id="architectureVpcAwsPresetDescription">Public ALB, private EC2 app tier, Multi-AZ RDS, single NAT.</p>
            </div>
          </div>
          {# ns:end family._base.workspace.02_basic-settings #}

          {# ns:start family._base.workspace.03_custom-settings #}
          <details class="architecture-vpc-aws-custom-panel" data-custom-layout="tabbed_two_column">
            <summary class="architecture-vpc-aws-custom-panel-summary">
              <span>Custom</span>
                <span class="architecture-vpc-aws-custom-arrow-slot" aria-hidden="true"></span>
            </summary>

            <div class="architecture-vpc-aws-custom-panel-body">
              <div class="architecture-vpc-aws-config-tabs" role="tablist" aria-label="AWS VPC custom configuration">
                <button type="button" class="architecture-vpc-aws-config-tab active" id="architectureVpcAwsNetworkConfigTab" data-config-tab-target="architectureVpcAwsNetworkConfigPanel" role="tab" aria-controls="architectureVpcAwsNetworkConfigPanel" aria-selected="true" tabindex="0">Network layout</button>
                <button type="button" class="architecture-vpc-aws-config-tab" id="architectureVpcAwsWorkloadConfigTab" data-config-tab-target="architectureVpcAwsWorkloadConfigPanel" role="tab" aria-controls="architectureVpcAwsWorkloadConfigPanel" aria-selected="false" tabindex="-1">Workload</button>
                <button type="button" class="architecture-vpc-aws-config-tab" id="architectureVpcAwsServicesConfigTab" data-config-tab-target="architectureVpcAwsServicesConfigPanel" role="tab" aria-controls="architectureVpcAwsServicesConfigPanel" aria-selected="false" tabindex="-1">Services and controls</button>
              </div>

              <div class="tool-inspector-section architecture-vpc-aws-config-panel active" id="architectureVpcAwsNetworkConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVpcAwsNetworkConfigTab">
                <div class="architecture-vpc-aws-config-grid">
                  <div class="architecture-vpc-aws-control-stack">
                    <label class="tool-control-label" for="architectureVpcAwsCidr">VPC CIDR <span class="architecture-vpc-aws-helper-chip architecture-vpc-aws-custom-helper-chip" title="Tune vpc cidr before regenerating the diagram." aria-label="Tune vpc cidr before regenerating the diagram.">i</span></label>
                    <input type="text" id="architectureVpcAwsCidr" class="form-control" value="10.0.0.0/16" placeholder="10.0.0.0/16">
                  </div>

                  <div class="architecture-vpc-aws-control-stack">
                    <label class="tool-control-label" for="architectureVpcAwsNatMode">NAT mode <span class="architecture-vpc-aws-helper-chip architecture-vpc-aws-custom-helper-chip" title="Tune nat mode before regenerating the diagram." aria-label="Tune nat mode before regenerating the diagram.">i</span></label>                    <div class="architecture-vpc-aws-native-select-wrap" id="architectureVpcAwsNatModeSelect">
                      <select id="architectureVpcAwsNatMode" class="form-select architecture-vpc-aws-native-select">
                        <option value="none">No NAT</option>
                        <option value="single" selected>Single NAT</option>
                        <option value="per-az">One per AZ</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section architecture-vpc-aws-config-panel" id="architectureVpcAwsWorkloadConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVpcAwsWorkloadConfigTab" hidden>
                <div class="architecture-vpc-aws-config-grid">
                  <div class="architecture-vpc-aws-control-stack">
                    <label class="tool-control-label" for="architectureVpcAwsAppTier">App tier <span class="architecture-vpc-aws-helper-chip architecture-vpc-aws-custom-helper-chip" title="Tune app tier before regenerating the diagram." aria-label="Tune app tier before regenerating the diagram.">i</span></label>                    <div class="architecture-vpc-aws-native-select-wrap" id="architectureVpcAwsAppTierSelect">
                      <select id="architectureVpcAwsAppTier" class="form-select architecture-vpc-aws-native-select">
                        <option value="ec2" selected>EC2 Auto Scaling</option>
                        <option value="ecs">ECS / Fargate</option>
                        <option value="eks">EKS</option>
                        <option value="lambda">Lambda in VPC</option>
                      </select>
                    </div>
                  </div>

                  <div class="architecture-vpc-aws-control-stack">
                    <label class="tool-control-label" for="architectureVpcAwsDatabase">Database tier <span class="architecture-vpc-aws-helper-chip architecture-vpc-aws-custom-helper-chip" title="Tune database tier before regenerating the diagram." aria-label="Tune database tier before regenerating the diagram.">i</span></label>                    <div class="architecture-vpc-aws-native-select-wrap" id="architectureVpcAwsDatabaseSelect">
                      <select id="architectureVpcAwsDatabase" class="form-select architecture-vpc-aws-native-select">
                        <option value="none">No database tier</option>
                        <option value="rds" selected>RDS</option>
                        <option value="aurora">Aurora</option>
                        <option value="dynamodb">DynamoDB</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section architecture-vpc-aws-config-panel" id="architectureVpcAwsServicesConfigPanel" data-config-panel role="tabpanel" aria-labelledby="architectureVpcAwsServicesConfigTab" hidden>
                <div class="architecture-vpc-aws-toggle-grid">
                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">Route 53</span>
                    <input type="checkbox" id="architectureVpcAwsRoute53" checked>
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">CloudFront</span>
                    <input type="checkbox" id="architectureVpcAwsCloudFront">
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">AWS WAF</span>
                    <input type="checkbox" id="architectureVpcAwsWaf">
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">Application Load Balancer</span>
                    <input type="checkbox" id="architectureVpcAwsAlb" checked>
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">Bastion host</span>
                    <input type="checkbox" id="architectureVpcAwsBastion">
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">VPC endpoints</span>
                    <input type="checkbox" id="architectureVpcAwsEndpoints" checked>
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">VPC flow logs</span>
                    <input type="checkbox" id="architectureVpcAwsFlowLogs" checked>
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">CloudWatch</span>
                    <input type="checkbox" id="architectureVpcAwsCloudWatch" checked>
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">Site-to-site VPN</span>
                    <input type="checkbox" id="architectureVpcAwsSiteToSiteVpn">
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">Transit gateway</span>
                    <input type="checkbox" id="architectureVpcAwsTransitGateway">
                  </label>

                  <label class="architecture-vpc-aws-toggle-item">
                    <span class="architecture-vpc-aws-toggle-copy">ElastiCache</span>
                    <input type="checkbox" id="architectureVpcAwsCache">
                  </label>
                </div>
              </div>

            </div>
          </details>
          {# ns:end family._base.workspace.03_custom-settings #}

          {# ns:start family.architecture.workspace.04_selected-item #}
          <div class="tool-inspector-section architecture-vpc-aws-selected-section" id="architectureVpcAwsSelectedShell">
            <h3 class="architecture-vpc-aws-section-title">Selected item</h3>

            <p class="architecture-vpc-aws-selected-empty architecture-vpc-aws-selected-empty-chips" id="architectureVpcAwsSelectedEmpty" aria-label="Select a draggable box in the stage to move, resize, or highlight it. Select a line to adjust its arrow handles. Arrow keys move the selected box; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
              <span class="architecture-vpc-aws-selected-empty-copy">
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a draggable box</span>
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Select a line to adjust arrows</span>
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected box</span>
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
                <span class="architecture-vpc-aws-selected-hint-chip architecture-vpc-aws-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
              </span>
            </p>

            <div class="architecture-vpc-aws-selected-editor d-none" id="architectureVpcAwsSelectedEditor">
              <div class="architecture-vpc-aws-selected-name" id="architectureVpcAwsSelectedName"></div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVpcAwsSelectedX">X position</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVpcAwsSelectedX" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVpcAwsSelectedY">Y position</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVpcAwsSelectedY" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVpcAwsSelectedWidth">Width</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVpcAwsSelectedWidth" class="form-control" min="96" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="architectureVpcAwsSelectedHeight">Height</label>
                <div class="tool-control-field">
                  <input type="number" id="architectureVpcAwsSelectedHeight" class="form-control" min="44" step="4">
                </div>
              </div>

              <div class="architecture-vpc-aws-selected-actions">
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVpcAwsHighlightCard">Highlight box</button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureVpcAwsApplyCardSize">Apply item</button>
                <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureVpcAwsResetCardSize">Reset item</button>
              </div>
            </div>
          </div>
          {# ns:end family.architecture.workspace.04_selected-item #}
        </div>
      </aside>
    </div>

    <section class="tool-shell tool-stage-shell" id="architectureVpcAwsStageShell" data-section="diagram-buttons" data-root-selector=".architecture-vpc-aws-tool">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-shell-header architecture-vpc-aws-stage-header" data-section="title" data-root-selector=".architecture-vpc-aws-tool">
        <div class="architecture-vpc-aws-stage-heading">
          <h2 class="tool-shell-title" id="architectureVpcAwsStageTitle">AWS VPC Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureVpcAwsStageSubtitle">
            <span class="architecture-vpc-aws-stage-preset-chip">3-Tier Web preset</span>
          </p>
        </div>
        <div class="architecture-vpc-aws-stage-meta" id="architectureVpcAwsStageMeta"></div>
      </div>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="architecture-vpc-aws-stage-toolbar-actions">
          <div class="architecture-vpc-aws-zoom-control" id="architectureVpcAwsZoomControl">
            <button type="button" class="architecture-vpc-aws-zoom-step" id="architectureVpcAwsZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="architectureVpcAwsZoomInput" class="architecture-vpc-aws-zoom-input" value="50" min="15" max="240" step="1" aria-label="Zoom percentage">
            <span class="architecture-vpc-aws-zoom-label" id="architectureVpcAwsZoomLabel">%</span>
            <button type="button" class="architecture-vpc-aws-zoom-step" id="architectureVpcAwsZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="architecture-vpc-aws-icon-btn" id="architectureVpcAwsZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-aws-icon-btn" id="architectureVpcAwsZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="architecture-vpc-aws-icon-btn" id="architectureVpcAwsUndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-aws-icon-btn" id="architectureVpcAwsHighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false">
            <i class="bi bi-bounding-box" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-aws-icon-btn" id="architectureVpcAwsZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
          </button>
          <button type="button" class="architecture-vpc-aws-icon-btn" id="architectureVpcAwsFullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost architecture-vpc-aws-stage-toolbar-btn" id="architectureVpcAwsResetLayout" aria-label="Auto layout" title="Auto layout">Auto layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="architectureVpcAwsStageEmpty">Choose a preset to generate diagram.</div>
        <div class="tool-stage-canvas architecture-vpc-aws-stage-canvas d-none" id="architectureVpcAwsStageCanvas"></div>
      </div>

      <div class="architecture-vpc-aws-stage-footer">
        <div class="architecture-vpc-aws-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" title="Prompt and preset aware" aria-label="Prompt and preset aware" tabindex="0">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span class="architecture-vpc-aws-visually-hidden">Prompt and preset aware</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-inspector" title="Editable inspector controls" aria-label="Editable inspector controls" tabindex="0">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            <span class="architecture-vpc-aws-visually-hidden">Editable inspector controls</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-drag" title="Drag boxes to customize layout" aria-label="Drag boxes to customize layout" tabindex="0">
            <i class="bi bi-arrows-move" aria-hidden="true"></i>
            <span class="architecture-vpc-aws-visually-hidden">Drag boxes to customize layout</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-svg" title="SVG workspace" aria-label="SVG workspace" tabindex="0">
            <i class="bi bi-bezier2" aria-hidden="true"></i>
            <span class="architecture-vpc-aws-visually-hidden">SVG workspace</span>
          </span>
          <button type="button" class="tool-helper-chip tool-helper-chip-keyboard" id="architectureVpcAwsUsageHelpButton" title="Keyboard shortcuts and usage" aria-label="Open keyboard help" aria-controls="architectureVpcAwsUsageHelpPopup" aria-expanded="false">
            <i class="bi bi-keyboard" aria-hidden="true"></i>
            <span class="architecture-vpc-aws-visually-hidden">Keyboard Help</span>
          </button>
        </div>
      </div>

      <div class="architecture-vpc-aws-usage-overlay d-none" id="architectureVpcAwsUsageHelpPopup" role="dialog" aria-modal="false" aria-labelledby="architectureVpcAwsUsageHelpTitle">
        <div class="architecture-vpc-aws-usage-card">
          <button type="button" class="architecture-vpc-aws-usage-close" id="architectureVpcAwsUsageHelpClose" aria-label="Close keyboard help">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>

          <h3 class="architecture-vpc-aws-usage-title" id="architectureVpcAwsUsageHelpTitle">Diagram Controls</h3>
          <p class="architecture-vpc-aws-usage-copy">Select a box in the diagram, then adjust it without leaving the stage.</p>

          <div class="architecture-vpc-aws-usage-panel">Hold the selected box in place visually while you tune layout, size, and zoom.</div>

          <div class="architecture-vpc-aws-usage-divider"></div>

          <div class="architecture-vpc-aws-usage-list" aria-label="Keyboard and pointer controls">
            <div class="architecture-vpc-aws-usage-row">
