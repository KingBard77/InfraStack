{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.architecture-cloud-tmcloud-post-visual,
.architecture-cloud-tmcloud-post-visual * {
    box-sizing: border-box;
}

.architecture-cloud-tmcloud-post-visual {
    --post-start: #06B6D4;
    --post-end: #10B981;
    --post-ink: #ffffff;
    --post-muted: rgba(255, 255, 255, 0.76);
    aspect-ratio: 16 / 10;
    background:
        linear-gradient(rgba(255, 255, 255, 0.11) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px),
        linear-gradient(135deg, var(--post-start), var(--post-end));
    background-size: 28px 28px, 28px 28px, auto;
    border-radius: inherit;
    color: var(--post-ink);
    display: grid;
    gap: 18px;
    min-height: 220px;
    overflow: hidden;
    padding: 22px 24px;
    position: relative;
}

.architecture-cloud-tmcloud-post-visual::after {
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.44));
    content: "";
    inset: 0;
    position: absolute;
}

.architecture-cloud-tmcloud-post-header,
.architecture-cloud-tmcloud-post-stage,
.architecture-cloud-tmcloud-post-footer,
.architecture-cloud-tmcloud-post-detail {
    position: relative;
    z-index: 1;
}

.architecture-cloud-tmcloud-post-header {
    align-items: flex-start;
    display: flex;
    gap: 16px;
    justify-content: space-between;
}

.architecture-cloud-tmcloud-post-kicker {
    color: var(--post-muted);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.architecture-cloud-tmcloud-post-title {
    color: #ffffff;
    font-size: clamp(1.25rem, 2.4vw, 2.05rem);
    font-weight: 900;
    line-height: 1.08;
    margin-top: 10px;
    max-width: 80%;
}

.architecture-cloud-tmcloud-post-icon {
    align-items: center;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 12px;
    display: inline-flex;
    height: 46px;
    justify-content: center;
    width: 46px;
}

.architecture-cloud-tmcloud-post-icon i {
    color: #ffffff;
    font-size: 1.45rem;
}

.architecture-cloud-tmcloud-post-stage {
    display: grid;
    gap: 10px;
    grid-template-columns: 0.9fr 1fr 1fr 1fr;
    margin-top: 8px;
    max-width: 590px;
}

.architecture-cloud-tmcloud-post-node,
.architecture-cloud-tmcloud-post-line {
    min-height: 42px;
}

.architecture-cloud-tmcloud-post-node {
    align-items: center;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 10px;
    display: flex;
    font-size: 0.76rem;
    font-weight: 800;
    justify-content: center;
    padding: 8px;
    text-align: center;
}

.architecture-cloud-tmcloud-post-line {
    align-items: center;
    display: flex;
}

.architecture-cloud-tmcloud-post-line::before {
    background: rgba(255, 255, 255, 0.62);
    content: "";
    display: block;
    height: 3px;
    width: 100%;
}

.architecture-cloud-tmcloud-post-footer {
    align-items: center;
    color: var(--post-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.82rem;
    font-weight: 800;
    gap: 10px;
}

.architecture-cloud-tmcloud-post-footer span + span::before {
    content: "•";
    margin-right: 10px;
}

.architecture-cloud-tmcloud-post-detail {
    background: rgba(15, 23, 42, 0.34);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    display: grid;
    gap: 8px;
    margin-top: auto;
    padding: 12px;
}

.architecture-cloud-tmcloud-post-detail-title {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 900;
}

.architecture-cloud-tmcloud-post-meta {
    color: var(--post-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.74rem;
    font-weight: 800;
    gap: 10px;
}
</style>
{% else %}
<div
  class="architecture-cloud-tmcloud-post-visual architecture-cloud-tmcloud-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#06B6D4') }}; --post-end: {{ post.card_gradient_end|default('#10B981') }};"
>
  <div class="architecture-cloud-tmcloud-post-header">
    <div>
      <span class="architecture-cloud-tmcloud-post-kicker">{{ post.card_kicker|default(post.category|default('TM Cloud Alpha')) }}</span>
      <div class="architecture-cloud-tmcloud-post-title">{{ post.card_image_title|default(post.title|default('TM Cloud Alpha Architecture')) }}</div>
    </div>
    <span class="architecture-cloud-tmcloud-post-icon"><i class="{{ post.card_icon_class|default('bi bi-cloud') }}"></i></span>
  </div>
  <div class="architecture-cloud-tmcloud-post-stage" aria-hidden="true">
    <span class="architecture-cloud-tmcloud-post-node">Edge</span>
    <span class="architecture-cloud-tmcloud-post-line"></span>
    <span class="architecture-cloud-tmcloud-post-node">VPC</span>
    <span class="architecture-cloud-tmcloud-post-node">Subnets</span>
  </div>
  <div class="architecture-cloud-tmcloud-post-footer">
    <span>Zones</span>
    <span>Load Balancer</span>
    <span>Secure Digital Connectivity</span>
    <span>Flow Logs</span>
  </div>
  {% if showPostDetail %}
    <div class="architecture-cloud-tmcloud-post-detail">
      <div class="architecture-cloud-tmcloud-post-meta">
        <span>{{ post.date_display|default('May. 13th, 2026') }}</span>
        <span>{{ post.category|default('TM Cloud Alpha') }}</span>
        <span>{{ post.reading_time|default('4 min read') }}</span>
      </div>
      <div class="architecture-cloud-tmcloud-post-detail-title">{{ post.title|default('TM Cloud Alpha Architecture') }}</div>
    </div>
  {% endif %}
</div>
{% endif %}
