{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.generate-netcat-shell-post-visual {
    --post-start: #0f766e;
    --post-end: #14B8A6;
    --post-accent: #ccfbf1;
}

.generate-netcat-shell-post-visual .tool-post-node:nth-child(1),
.generate-netcat-shell-post-visual .tool-post-node:nth-child(3),
.generate-netcat-shell-post-visual .tool-post-node:nth-child(5) {
    background: rgba(204, 251, 241, 0.24);
}

.generate-netcat-shell-post-visual .tool-post-icon {
    background: rgba(14, 165, 164, 0.28);
}
</style>
{% else %}
<div
  class="tool-post-visual generate-netcat-shell-post-visual tool-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#0f766e') }}; --post-end: {{ post.card_gradient_end|default('#14B8A6') }};"
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="bi bi-diagram-3"></i>
    <i class="bi bi-hdd-network"></i>
    <i class="bi bi-terminal"></i>
    <i class="bi bi-broadcast"></i>
    <i class="bi bi-shield-lock"></i>
  </div>
  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('Shell')) }}</span>
    <span class="tool-post-icon"><i class="{{ post.card_icon_class|default('bi bi-diagram-3') }}"></i></span>
  </div>
  <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('Netcat Command Generator')) }}</div>
  <div class="tool-post-map" aria-hidden="true">
    <span class="tool-post-node"><i class="bi bi-terminal"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-hdd-network"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-broadcast"></i></span>
  </div>
  <div class="tool-post-footer">
    <span>{{ post.reading_time|default('9 min read') }}</span>
    <span>{{ post.category|default('Shell') }}</span>
  </div>
  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-chevron-down"></i> {{ post.date_display|default('Apr. 3rd, 2026') }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('Shell') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('9 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('Netcat Command Generator') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
