{# tool.html.twig #}

<div class="generate-ufw-command-tool tool-box mb-4" data-tool-slug="generate-ufw-command" data-tool-category="Shell">
  {# ns:start family._base.workspace.00_shell #}
  <form class="generate-ufw-command-form" id="generateUfwCommandForm" aria-label="UFW command builder">
    {# ns:start family._base.workspace.01_input-brief #}
    <div class="generate-ufw-command-input-card">
      <div class="generate-ufw-command-input-brief" data-input-layout="inline">
        <div class="generate-ufw-command-main-row generate-ufw-command-input-row">
          <div class="generate-ufw-command-input-label-wrap">
            <label for="generateUfwCommandInput" class="generate-ufw-command-main-label generate-ufw-command-input-label">Rule target:</label>
            <span class="generate-ufw-command-helper-chip" title="Use a destination address, application name, or short rule label" aria-label="Use a destination address, application name, or short rule label">i</span>
          </div>

          <div class="generate-ufw-command-main-input-grid generate-ufw-command-input-stack">
            <input
              type="text"
              id="generateUfwCommandInput"
              class="form-control generate-ufw-command-input-control"
              placeholder="any, 192.0.2.10, OpenSSH, 443/tcp"
              value="22/tcp"
            >
            <div class="generate-ufw-command-input-error d-none" id="generateUfwCommandInputError" role="alert"></div>
          </div>
        </div>

        <div class="generate-ufw-command-main-actions generate-ufw-command-input-actions">
          <button
            type="submit"
            class="btn btn-primary generate-ufw-command-submit-btn generate-ufw-command-action-btn generate-ufw-command-action-btn-primary"
            id="generateUfwCommandPrimaryAction"
            data-tool-share-generate
          >
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            <span>Generate</span>
          </button>
          <button
            type="button"
            class="generate-ufw-command-secondary-btn generate-ufw-command-secondary-btn-ghost generate-ufw-command-reset-btn generate-ufw-command-action-btn generate-ufw-command-action-btn-secondary"
            id="generateUfwCommandSecondaryAction"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="generate-ufw-command-input-helper-card">
          <span class="generate-ufw-command-input-hint">Generate UFW rule command text locally. This workspace does not run firewall changes or validate host policy.</span>
          <span class="generate-ufw-command-helper-chip generate-ufw-command-helper-chip-inline" title="Review the command before using it in a terminal" aria-label="Review the command before using it in a terminal">i</span>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.01_input-brief #}

    {# ns:start family._base.workspace.02_basic-settings #}
    <div class="generate-ufw-command-basic-panel">
      <div class="generate-ufw-command-inner-panel generate-ufw-command-basic-card">
        <div class="generate-ufw-command-example-card">
          <span class="generate-ufw-command-example-label">Example</span>
          <span class="generate-ufw-command-example-value">sudo ufw allow in proto tcp from 192.0.2.10 to any port 22</span>
          <span class="generate-ufw-command-example-helper">Start from a common rule profile, then adjust action, source, destination, protocol, interface, and restore data.</span>
        </div>

        <div class="generate-ufw-command-setting-row generate-ufw-command-setting-card">
          <label class="generate-ufw-command-setting-label">
            Rule profile:
            <span class="info-dot generate-ufw-command-helper-chip" title="Profiles seed common UFW command patterns without locking later edits">i</span>
          </label>

          <div class="generate-ufw-command-setting-field">
            <div class="generate-ufw-command-stacked-grid">
              <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-two">
                <div class="generate-ufw-command-native-select-wrap" id="generateUfwCommandProfileSelect">
                  <select id="generateUfwCommandBasicPrimary" class="form-select generate-ufw-command-native-select" aria-label="Rule profile">
                    <option value="ssh-admin" selected>Allow SSH admin</option>
                    <option value="web-service">Allow web service</option>
                    <option value="deny-source">Deny source host</option>
                    <option value="route-service">Route forwarded service</option>
                    <option value="app-profile">Application profile</option>
                  </select>
                </div>

                <button type="button" class="generate-ufw-command-secondary-btn" id="generateUfwCommandApplyPreset">Apply profile</button>
              </div>
            </div>
          </div>
        </div>

        <div class="generate-ufw-command-setting-row generate-ufw-command-setting-card">
          <label class="generate-ufw-command-setting-label">
            Command shape:
            <span class="info-dot generate-ufw-command-helper-chip" title="Shell style, source, destination, and sudo posture shape the generated command">i</span>
          </label>

          <div class="generate-ufw-command-setting-field">
            <div class="generate-ufw-command-stacked-grid">
              <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-two">
                <div class="generate-ufw-command-native-select-wrap" id="generateUfwCommandShellStyleSelect">
                  <select id="generateUfwCommandShellStyle" class="form-select generate-ufw-command-native-select" aria-label="Command shape">
                    <option value="posix" selected>POSIX shell</option>
                    <option value="bash">Bash script</option>
                    <option value="review-note">Review note</option>
                  </select>
                </div>

                <input
                  type="text"
                  id="generateUfwCommandBasicText"
                  class="form-control generate-ufw-command-text-field"
                  placeholder="Source address or CIDR"
                  value="192.0.2.10"
                >
              </div>

              <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-two">
                <label class="switch generate-ufw-command-switch-wrap generate-ufw-command-switch-card">
                  <input type="checkbox" id="generateUfwCommandBasicToggle" checked>
                  <span class="slider"></span>
                  <span class="generate-ufw-command-switch-label">Use sudo</span>
                </label>

                <input
                  type="text"
                  id="generateUfwCommandDestination"
                  class="form-control generate-ufw-command-text-field"
                  placeholder="Destination address"
                  value="any"
                >
              </div>

              <div class="generate-ufw-command-flag-hint">Source and destination can be host addresses, CIDR ranges, or <code>any</code>. Application profile mode uses the application profile field instead.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.02_basic-settings #}

    {# ns:start family._base.workspace.03_custom-settings #}
    <details class="generate-ufw-command-custom-settings generate-ufw-command-advanced" id="generateUfwCommandCustomSettings" data-custom-layout="compact_two_column_multi_row">
      <summary class="generate-ufw-command-custom-summary generate-ufw-command-advanced-summary">
        <span>Custom</span>
        <span class="generate-ufw-command-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="generate-ufw-command-advanced-body generate-ufw-command-custom-body">
        <div class="generate-ufw-command-setting-row generate-ufw-command-setting-card generate-ufw-command-custom-card">
          <label class="generate-ufw-command-setting-label generate-ufw-command-custom-label">
            Rule modifiers:
            <span class="info-dot generate-ufw-command-helper-chip" title="Optional UFW flags and rule modes that change the emitted command">i</span>
          </label>

          <div class="generate-ufw-command-setting-field">
            <div class="generate-ufw-command-stacked-grid">
              <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-two">
                <label class="generate-ufw-command-toggle-item">
                  <span class="generate-ufw-command-toggle-copy">Log matching packets</span>
                  <input type="checkbox" id="generateUfwCommandVerbose">
                </label>

                <label class="generate-ufw-command-toggle-item">
                  <span class="generate-ufw-command-toggle-copy">Dry run (--dry-run)</span>
                  <input type="checkbox" id="generateUfwCommandQuiet">
                </label>
              </div>

              <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-two">
                <label class="generate-ufw-command-toggle-item">
                  <span class="generate-ufw-command-toggle-copy">Route forwarded traffic</span>
                  <input type="checkbox" id="generateUfwCommandIpv4">
                </label>

                <label class="generate-ufw-command-toggle-item">
                  <span class="generate-ufw-command-toggle-copy">Insert before existing rules</span>
                  <input type="checkbox" id="generateUfwCommandIpv6">
                </label>
              </div>

              <div class="generate-ufw-command-flag-hint">Route mode emits <code>ufw route</code>. Insert mode emits <code>ufw insert</code> with the position below.</div>
            </div>
          </div>
        </div>

        <div class="generate-ufw-command-setting-row generate-ufw-command-setting-card generate-ufw-command-custom-card">
          <label for="generateUfwCommandCustomNumber" class="generate-ufw-command-setting-label generate-ufw-command-custom-label">
            Port and interface:
            <span class="info-dot generate-ufw-command-helper-chip" title="Destination port and interface selectors are emitted as UFW rule tokens">i</span>
          </label>

          <div class="generate-ufw-command-setting-field">
            <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-three">
              <input
                type="number"
                id="generateUfwCommandCustomNumber"
                class="form-control generate-ufw-command-custom-number-field"
                min="1"
                max="65535"
                value="22"
                placeholder="Port"
              >

              <input
                type="text"
                id="generateUfwCommandCustomText"
                class="form-control generate-ufw-command-custom-text-field"
                placeholder="Inbound interface"
                value="eth0"
              >

              <label class="generate-ufw-command-toggle-item">
                <span class="generate-ufw-command-toggle-copy">Attach comment</span>
                <input type="checkbox" id="generateUfwCommandCustomToggle" checked>
              </label>
            </div>

            <div class="generate-ufw-command-custom-info">Leave the port empty for source-only or application-profile rules. Interface values are omitted when blank.</div>
          </div>
        </div>

        <div class="generate-ufw-command-setting-row generate-ufw-command-setting-card generate-ufw-command-custom-card">
          <label class="generate-ufw-command-setting-label generate-ufw-command-custom-label">
            Rule posture:
            <span class="info-dot generate-ufw-command-helper-chip" title="Choose the rule action, protocol, comment, and inbound or outbound direction">i</span>
          </label>

          <div class="generate-ufw-command-setting-field">
            <div class="generate-ufw-command-stacked-grid">
              <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-three">
                <div class="generate-ufw-command-native-select-wrap" id="generateUfwCommandCustomSelect">
                  <select id="generateUfwCommandAction" class="form-select generate-ufw-command-native-select" aria-label="Rule action">
                    <option value="allow" selected>allow</option>
                    <option value="deny">deny</option>
                    <option value="reject">reject</option>
                    <option value="limit">limit</option>
                  </select>
                </div>

                <div class="generate-ufw-command-native-select-wrap" id="generateUfwCommandProtocolSelect">
                  <select id="generateUfwCommandProtocol" class="form-select generate-ufw-command-native-select" aria-label="Protocol">
                    <option value="tcp" selected>tcp</option>
                    <option value="udp">udp</option>
                    <option value="any">any protocol</option>
                  </select>
                </div>

                <input
                  type="text"
                  id="generateUfwCommandComment"
                  class="form-control generate-ufw-command-text-field"
                  placeholder="Comment"
                  value="Allow SSH administration"
                >
              </div>

              <div class="generate-ufw-command-radio-grid" role="radiogroup" aria-label="UFW rule direction">
                <label class="generate-ufw-command-radio-card">
                  <input type="radio" name="generateUfwCommandSessionMode" value="in" checked>
                  <span class="generate-ufw-command-radio-copy">Inbound</span>
                </label>
                <label class="generate-ufw-command-radio-card">
                  <input type="radio" name="generateUfwCommandSessionMode" value="out">
                  <span class="generate-ufw-command-radio-copy">Outbound</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="generate-ufw-command-setting-row generate-ufw-command-setting-card generate-ufw-command-custom-card">
          <label class="generate-ufw-command-setting-label generate-ufw-command-custom-label">
            Advanced targets:
            <span class="info-dot generate-ufw-command-helper-chip" title="Source port, insert position, route output interface, and application profiles are optional UFW command pieces">i</span>
          </label>

          <div class="generate-ufw-command-setting-field">
            <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-three">
              <input
                type="number"
                id="generateUfwCommandInsertPosition"
                class="form-control generate-ufw-command-custom-number-field"
                min="1"
                max="999"
                placeholder="Insert position"
              >

              <input
                type="number"
                id="generateUfwCommandSourcePort"
                class="form-control generate-ufw-command-custom-number-field"
                min="1"
                max="65535"
                placeholder="Source port"
              >

              <input
                type="text"
                id="generateUfwCommandRouteOutInterface"
                class="form-control generate-ufw-command-custom-text-field"
                placeholder="Route out interface"
                value=""
              >
            </div>

            <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-three">
              <input
                type="text"
                id="generateUfwCommandSourceAddress"
                class="form-control generate-ufw-command-text-field"
                placeholder="Source address"
                value="192.0.2.10"
              >
              <input
                type="text"
                id="generateUfwCommandDestinationAddress"
                class="form-control generate-ufw-command-text-field"
                placeholder="Destination address"
                value="any"
              >
              <input
                type="text"
                id="generateUfwCommandAppProfile"
                class="form-control generate-ufw-command-text-field"
                placeholder="Application profile"
                value="OpenSSH"
              >
            </div>

            <div class="generate-ufw-command-inline-grid generate-ufw-command-inline-grid-two">
              <label class="generate-ufw-command-toggle-item">
                <span class="generate-ufw-command-toggle-copy">Use application profile</span>
                <input type="checkbox" id="generateUfwCommandAppMode">
              </label>
              <label class="generate-ufw-command-toggle-item">
                <span class="generate-ufw-command-toggle-copy">Append extra UFW options</span>
                <input type="checkbox" id="generateUfwCommandAppendExtraOptions">
              </label>
            </div>

            <textarea
              id="generateUfwCommandExtraArgs"
              class="form-control generate-ufw-command-extra-args"
              rows="3"
              placeholder="Optional UFW options, one per line, such as --dry-run"
            ></textarea>
          </div>
        </div>
      </div>
    </details>
    {# ns:end family._base.workspace.03_custom-settings #}
  </form>

  {# ns:start family._base.workspace.05_result-summary #}
  {# ns:start family.shell.workspace.04_result-text #}
  <div class="generate-ufw-command-result-shell">
    <div class="generate-ufw-command-result-empty" id="generateUfwCommandResultEmpty">
      <i class="bi bi-shield-lock" aria-hidden="true"></i>
      <span>Choose a UFW rule profile and generate a command preview.</span>
    </div>

    <div class="generate-ufw-command-result-content d-none" id="generateUfwCommandResultContent">
      <div class="generate-ufw-command-result-summary" id="generateUfwCommandResultSummary" aria-live="polite"></div>
      {# ns:end family.shell.workspace.04_result-text #}
      {# ns:end family._base.workspace.05_result-summary #}

      <div class="generate-ufw-command-output-panel generate-ufw-command-result-panel" id="generateUfwCommandResultPanel" aria-label="Command output">
        {# ns:start family.shell.workspace.04_visual-contract #}
        <div class="generate-ufw-command-output-heading">
          <div>
            <span class="generate-ufw-command-output-kicker">Generated Output</span>
            <h2 class="generate-ufw-command-output-title">UFW Command Preview</h2>
          </div>
          <span class="generate-ufw-command-output-chip"><i class="bi bi-terminal" aria-hidden="true"></i> Browser Generated</span>
        </div>
        {# ns:end family.shell.workspace.04_visual-contract #}

        {# ns:start family._base.workspace.06_output-toolbar #}
        <div class="generate-ufw-command-toolbar-shell">
          <div class="generate-ufw-command-toolbar tool-output-toolbar tool-result-toolbar">
            <div class="generate-ufw-command-toolbar-main">
              <label for="generateUfwCommandSort" class="generate-ufw-command-sort-label">Sort</label>
              <div class="generate-ufw-command-sort-wrap">
                <details class="generate-ufw-command-sort-select" id="generateUfwCommandSortSelect">
                  <summary class="generate-ufw-command-sort-summary" aria-haspopup="listbox" aria-expanded="false" aria-controls="generateUfwCommandSortMenu">
                    <span id="generateUfwCommandSortSummary">ID</span>
                  </summary>

                  <div class="generate-ufw-command-sort-menu" id="generateUfwCommandSortMenu" role="listbox" aria-label="Sort generated rows">
                    <div class="generate-ufw-command-sort-grid">
                      <button type="button" class="generate-ufw-command-sort-option is-active" data-sort-value="id" aria-pressed="true" role="option">ID</button>
                      <button type="button" class="generate-ufw-command-sort-option" data-sort-value="alphabetical" aria-pressed="false" role="option">A-Z</button>
                      <button type="button" class="generate-ufw-command-sort-option" data-sort-value="field" aria-pressed="false" role="option">Field</button>
                      <button type="button" class="generate-ufw-command-sort-option" data-sort-value="value" aria-pressed="false" role="option">Value</button>
                      <button type="button" class="generate-ufw-command-sort-option" data-sort-value="length" aria-pressed="false" role="option">Length</button>
                    </div>
                  </div>
                </details>
                <input type="hidden" id="generateUfwCommandSort" value="id">
              </div>
            </div>

            <div class="tool-output-actions generate-ufw-command-toolbar-actions tool-result-toolbar-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ufw-command-action-btn tool-result-action-btn" id="generateUfwCommandExportPdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ufw-command-action-btn tool-result-action-btn" id="generateUfwCommandDownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ufw-command-action-btn tool-result-action-btn" id="generateUfwCommandCopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ufw-command-action-btn tool-result-action-btn" id="generateUfwCommandDownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ufw-command-action-btn tool-result-action-btn" id="generateUfwCommandImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
        </div>
        {# ns:end family._base.workspace.06_output-toolbar #}

        {# ns:start family._base.workspace.07_table-output #}
        <div class="generate-ufw-command-tabs tool-tabs" role="tablist" aria-label="UFW command output tabs">
          <button type="button" class="tool-tab-btn generate-ufw-command-tab active" id="generateUfwCommandOperationsTab" data-tab-target="generateUfwCommandOperationsPanel" role="tab" aria-selected="true">
            <i class="bi bi-list-check" aria-hidden="true"></i>
            <span>Operations</span>
          </button>
          <button type="button" class="tool-tab-btn generate-ufw-command-tab" id="generateUfwCommandCommandTab" data-tab-target="generateUfwCommandCommandPanel" role="tab" aria-selected="false" tabindex="-1">
            <i class="bi bi-terminal" aria-hidden="true"></i>
            <span>Command</span>
          </button>
          <button type="button" class="tool-tab-btn generate-ufw-command-tab" id="generateUfwCommandDetailsTab" data-tab-target="generateUfwCommandDetailsPanel" role="tab" aria-selected="false" tabindex="-1">
            <i class="bi bi-card-checklist" aria-hidden="true"></i>
            <span>Details</span>
          </button>
          <button type="button" class="tool-tab-btn generate-ufw-command-tab" id="generateUfwCommandWarningsTab" data-tab-target="generateUfwCommandWarningsPanel" role="tab" aria-selected="false" tabindex="-1">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>Warnings</span>
          </button>
          <button type="button" class="tool-tab-btn generate-ufw-command-tab" id="generateUfwCommandJsonTab" data-tab-target="generateUfwCommandJsonPanel" role="tab" aria-selected="false" tabindex="-1">
            <i class="bi bi-braces" aria-hidden="true"></i>
            <span>JSON</span>
          </button>
        </div>

        <div class="generate-ufw-command-tab-panels">
          <div class="tool-tab-panel generate-ufw-command-tab-panel active" id="generateUfwCommandOperationsPanel" data-tab-panel="generateUfwCommandOperationsPanel" role="tabpanel" aria-labelledby="generateUfwCommandOperationsTab">
            <div class="generate-ufw-command-inventory-panel" aria-labelledby="generateUfwCommandOperationsTitle">
              <div class="generate-ufw-command-table-card">
                <h3 class="generate-ufw-command-result-section-title" id="generateUfwCommandOperationsTitle">Operation Summary</h3>
                <div class="generate-ufw-command-table-wrap tool-result-table-wrap">
                  <table class="table generate-ufw-command-table generate-ufw-command-operations-table mb-0 tool-result-table tool-result-table--compact">
                    <thead>
                      <tr>
                        <th scope="col" class="tool-generated-rownum-head">#</th>
                        <th scope="col">Field</th>
                        <th scope="col">Value</th>
                        <th scope="col" class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                      </tr>
                    </thead>
                    <tbody id="generateUfwCommandOperationsTableBody"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <div class="tool-tab-panel generate-ufw-command-tab-panel" id="generateUfwCommandCommandPanel" data-tab-panel="generateUfwCommandCommandPanel" role="tabpanel" aria-labelledby="generateUfwCommandCommandTab" hidden>
            <div class="generate-ufw-command-surface-stack tool-result-section-stack">
              <section class="generate-ufw-command-section-card tool-result-section-card">
                <div class="generate-ufw-command-section-head">
                  <h3 class="generate-ufw-command-section-title tool-result-section-title">UFW Command</h3>
                  <div class="generate-ufw-command-section-actions">
                    <button type="button" class="generate-ufw-command-action-btn" id="generateUfwCommandCopyCommand" aria-label="Copy generated UFW command" title="Copy generated UFW command">
                      <i class="bi bi-clipboard" aria-hidden="true"></i>
                      <span class="generate-ufw-command-command-copy-label tool-sr-only">Copy</span>
                    </button>
                  </div>
                </div>
                <pre class="generate-ufw-command-code-pre"><code id="generateUfwCommandCommand" data-share-snapshot-source data-share-kind="shell-command"></code></pre>
              </section>

              <section class="generate-ufw-command-section-card tool-result-section-card">
                <h3 class="generate-ufw-command-section-title tool-result-section-title">Result Summary</h3>
                <div class="generate-ufw-command-table-wrap tool-result-table-wrap">
                  <table class="table generate-ufw-command-summary-table mb-0 tool-result-table tool-result-table--compact">
                    <thead>
                      <tr>
                        <th scope="col" class="tool-generated-rownum-head">#</th>
                        <th scope="col">Field</th>
                        <th scope="col">Value</th>
                      </tr>
                    </thead>
                    <tbody id="generateUfwCommandSummaryTableBody"></tbody>
                  </table>
                </div>
              </section>
            </div>
          </div>

          <div class="tool-tab-panel generate-ufw-command-tab-panel" id="generateUfwCommandDetailsPanel" data-tab-panel="generateUfwCommandDetailsPanel" role="tabpanel" aria-labelledby="generateUfwCommandDetailsTab" hidden>
