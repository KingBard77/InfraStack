{# tool.html.twig #}

<div class="generate-chmod-shell-tool tool-box mb-4" data-tool-slug="generate-chmod-shell" data-tool-category="Shell">
  {# ns:start family._base.workspace.00_shell #}
  {# ns:start family._base.workspace.01_input-brief #}
  <form class="generate-chmod-shell-form" id="generateChmodShellForm" aria-label="Chmod command builder">
    <div class="generate-chmod-shell-input-card">
      <div class="generate-chmod-shell-input-brief" data-input-layout="inline">
        <div class="generate-chmod-shell-main-row generate-chmod-shell-input-row">
          <div class="generate-chmod-shell-input-label-wrap">
            <label for="generateChmodShellTarget" class="generate-chmod-shell-main-label generate-chmod-shell-input-label">Target path:</label>
            <span class="generate-chmod-shell-helper-chip" title="Enter the file or directory path that the generated chmod command should target" aria-label="Enter the file or directory path that the generated chmod command should target">i</span>
          </div>

          <div class="generate-chmod-shell-main-input-grid generate-chmod-shell-input-stack">
            <input
              type="text"
              id="generateChmodShellTarget"
              class="form-control generate-chmod-shell-input-control"
              placeholder="/srv/app/current"
              value="./deploy.sh"
            >
            <div class="generate-chmod-shell-input-error d-none" id="generateChmodShellInputError" role="alert"></div>
          </div>
        </div>

        <div class="generate-chmod-shell-main-actions generate-chmod-shell-input-actions">
          <button
            type="submit"
            class="btn btn-primary generate-chmod-shell-submit-btn generate-chmod-shell-action-btn generate-chmod-shell-action-btn-primary"
            id="generateChmodShellSubmit"
            data-tool-share-generate
          >
            <i class="bi bi-terminal" aria-hidden="true"></i>
            <span>Generate</span>
          </button>
          <button
            type="button"
            class="generate-chmod-shell-secondary-btn generate-chmod-shell-secondary-btn-ghost generate-chmod-shell-reset-btn generate-chmod-shell-action-btn generate-chmod-shell-action-btn-secondary"
            id="generateChmodShellReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="generate-chmod-shell-input-helper-card">
          <span class="generate-chmod-shell-input-hint">Use a concrete path, command target, or scope before generating shell output.</span>
          <span class="generate-chmod-shell-helper-chip generate-chmod-shell-helper-chip-inline" title="Enter the file or directory path that the generated chmod command should target" aria-label="Enter the file or directory path that the generated chmod command should target">i</span>
        </div>
      </div>
    </div>

  {# ns:end family._base.workspace.01_input-brief #}
    {# ns:start family._base.workspace.02_basic-settings #}
    <div class="generate-chmod-shell-basic-panel">
      <div class="generate-chmod-shell-inner-panel generate-chmod-shell-basic-card">

        <div class="generate-chmod-shell-example-card">
          <span class="generate-chmod-shell-example-label">Example</span>
          <span class="generate-chmod-shell-example-value">chmod 0755 ./deploy.sh</span>
          <span class="generate-chmod-shell-example-helper">Directory mode affects the leading character in the preview and lets symbolic <code>X</code> add execute where directory semantics make sense.</span>
        </div>

        <div class="generate-chmod-shell-setting-row generate-chmod-shell-setting-card">
          <label class="generate-chmod-shell-setting-label">
            Target profile:
            <span class="info-dot generate-chmod-shell-helper-chip" title="Preset, target type, and directory recursion define the normal chmod target shape">i</span>
          </label>

          <div class="generate-chmod-shell-setting-field">
            <div class="generate-chmod-shell-stacked-grid">
              <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-two">
                <div class="generate-chmod-shell-native-select-wrap">
                  <select id="generateChmodShellPreset" class="form-select generate-chmod-shell-native-select" aria-label="Target preset">
                    <option value="deploy-script" selected>Deploy script (0755)</option>
                    <option value="private-config">Private config (0640)</option>
                    <option value="web-file">Web file (0644)</option>
                    <option value="web-directory">Web directory (0755)</option>
                    <option value="group-directory">Group directory (2775)</option>
                    <option value="shared-temp">Shared temp (1777)</option>
                    <option value="manual">Current mode</option>
                  </select>
                </div>

                <button type="button" class="generate-chmod-shell-secondary-btn" id="generateChmodShellApplyPreset">Apply preset</button>
              </div>

              <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-two">
                <div class="generate-chmod-shell-native-select-wrap">
                  <select id="generateChmodShellTargetType" class="form-select generate-chmod-shell-native-select" aria-label="Target type">
                    <option value="file" selected>File</option>
                    <option value="directory">Directory</option>
                  </select>
                </div>

                <label class="switch generate-chmod-shell-switch-wrap generate-chmod-shell-switch-card">
                  <input type="checkbox" id="generateChmodShellRecursive">
                  <span class="slider"></span>
                  <span class="generate-chmod-shell-switch-label">Recursive (-R)</span>
                </label>
              </div>

            </div>
          </div>
        </div>

        <div class="generate-chmod-shell-setting-row generate-chmod-shell-setting-card">
          <label class="generate-chmod-shell-setting-label">
            Permissions:
            <span class="info-dot generate-chmod-shell-helper-chip" title="Toggle read, write, and execute for user, group, and others">i</span>
          </label>

          <div class="generate-chmod-shell-setting-field">
            <div class="generate-chmod-shell-permission-grid">
              <section class="generate-chmod-shell-scope-card">
                <div class="generate-chmod-shell-scope-head">
                  <div>
                    <span class="generate-chmod-shell-scope-title">User</span>
                    <span class="generate-chmod-shell-scope-copy">Owner bits</span>
                  </div>
                  <span class="generate-chmod-shell-scope-octal" data-scope-octal="user">7</span>
                </div>

                <div class="generate-chmod-shell-scope-toggle-grid">
                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="user" data-permission="read" checked>
                    <span class="generate-chmod-shell-perm-token">r</span>
                    <span class="generate-chmod-shell-perm-copy">Read</span>
                  </label>

                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="user" data-permission="write" checked>
                    <span class="generate-chmod-shell-perm-token">w</span>
                    <span class="generate-chmod-shell-perm-copy">Write</span>
                  </label>

                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="user" data-permission="execute" checked>
                    <span class="generate-chmod-shell-perm-token">x</span>
                    <span class="generate-chmod-shell-perm-copy">Execute</span>
                  </label>
                </div>
              </section>

              <section class="generate-chmod-shell-scope-card">
                <div class="generate-chmod-shell-scope-head">
                  <div>
                    <span class="generate-chmod-shell-scope-title">Group</span>
                    <span class="generate-chmod-shell-scope-copy">Shared bits</span>
                  </div>
                  <span class="generate-chmod-shell-scope-octal" data-scope-octal="group">5</span>
                </div>

                <div class="generate-chmod-shell-scope-toggle-grid">
                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="group" data-permission="read" checked>
                    <span class="generate-chmod-shell-perm-token">r</span>
                    <span class="generate-chmod-shell-perm-copy">Read</span>
                  </label>

                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="group" data-permission="write">
                    <span class="generate-chmod-shell-perm-token">w</span>
                    <span class="generate-chmod-shell-perm-copy">Write</span>
                  </label>

                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="group" data-permission="execute" checked>
                    <span class="generate-chmod-shell-perm-token">x</span>
                    <span class="generate-chmod-shell-perm-copy">Execute</span>
                  </label>
                </div>
              </section>

              <section class="generate-chmod-shell-scope-card">
                <div class="generate-chmod-shell-scope-head">
                  <div>
                    <span class="generate-chmod-shell-scope-title">Others</span>
                    <span class="generate-chmod-shell-scope-copy">Public bits</span>
                  </div>
                  <span class="generate-chmod-shell-scope-octal" data-scope-octal="others">5</span>
                </div>

                <div class="generate-chmod-shell-scope-toggle-grid">
                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="others" data-permission="read" checked>
                    <span class="generate-chmod-shell-perm-token">r</span>
                    <span class="generate-chmod-shell-perm-copy">Read</span>
                  </label>

                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="others" data-permission="write">
                    <span class="generate-chmod-shell-perm-token">w</span>
                    <span class="generate-chmod-shell-perm-copy">Write</span>
                  </label>

                  <label class="generate-chmod-shell-perm-toggle">
                    <input type="checkbox" data-scope="others" data-permission="execute" checked>
                    <span class="generate-chmod-shell-perm-token">x</span>
                    <span class="generate-chmod-shell-perm-copy">Execute</span>
                  </label>
                </div>
              </section>
            </div>
          </div>
        </div>

      </div>
    </div>

    {# ns:end family._base.workspace.02_basic-settings #}
    {# ns:start family._base.workspace.03_custom-settings #}
    <details class="generate-chmod-shell-advanced" data-custom-layout="compact_two_column_multi_row">
      <summary class="generate-chmod-shell-advanced-summary">
        <span>Custom</span>
          <span class="generate-chmod-shell-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="generate-chmod-shell-advanced-body">
          <div class="generate-chmod-shell-setting-row generate-chmod-shell-setting-card">
            <label class="generate-chmod-shell-setting-label">
              Command flags:
              <span class="info-dot generate-chmod-shell-helper-chip" title="Optional chmod flags that change command output or traversal behavior">i</span>
            </label>

            <div class="generate-chmod-shell-setting-field">
              <div class="generate-chmod-shell-stacked-grid">
                <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-two">
                  <label class="generate-chmod-shell-toggle-item">
                    <span class="generate-chmod-shell-toggle-copy">Verbose output (-v)</span>
                    <input type="checkbox" id="generateChmodShellVerbose">
                  </label>
                </div>

                <div class="generate-chmod-shell-flag-hint">Verbose mode adds <code>-v</code> so chmod reports changed files when the command runs in a real shell.</div>
              </div>
            </div>
          </div>

          <div class="generate-chmod-shell-setting-row generate-chmod-shell-setting-card">
            <label class="generate-chmod-shell-setting-label">
              Special bits:
              <span class="info-dot generate-chmod-shell-helper-chip" title="Setuid, setgid, and sticky add the leading chmod digit and alter ls output">i</span>
            </label>

            <div class="generate-chmod-shell-setting-field">
              <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-three">
                <label class="generate-chmod-shell-special-toggle">
                  <input type="checkbox" id="generateChmodShellSetuid">
                  <span class="generate-chmod-shell-special-token">u+s</span>
                  <span class="generate-chmod-shell-special-body">
                    <span class="generate-chmod-shell-special-title">Setuid</span>
                    <span class="generate-chmod-shell-special-copy">Owner identity on execution.</span>
                  </span>
                </label>

                <label class="generate-chmod-shell-special-toggle">
                  <input type="checkbox" id="generateChmodShellSetgid">
                  <span class="generate-chmod-shell-special-token">g+s</span>
                  <span class="generate-chmod-shell-special-body">
                    <span class="generate-chmod-shell-special-title">Setgid</span>
                    <span class="generate-chmod-shell-special-copy">Group inheritance or execution identity.</span>
                  </span>
                </label>

                <label class="generate-chmod-shell-special-toggle">
                  <input type="checkbox" id="generateChmodShellSticky">
                  <span class="generate-chmod-shell-special-token">o+t</span>
                  <span class="generate-chmod-shell-special-body">
                    <span class="generate-chmod-shell-special-title">Sticky</span>
                    <span class="generate-chmod-shell-special-copy">Delete protection on shared directories.</span>
                  </span>
                </label>
              </div>
            </div>
          </div>

          <div class="generate-chmod-shell-setting-row generate-chmod-shell-setting-card">
            <label for="generateChmodShellNumericMode" class="generate-chmod-shell-setting-label">
              Direct editing:
              <span class="info-dot generate-chmod-shell-helper-chip" title="Numeric and symbolic modes replace the current state; operations mutate it">i</span>
            </label>

            <div class="generate-chmod-shell-setting-field">
              <div class="generate-chmod-shell-stacked-grid">
                <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-two">
                  <div class="generate-chmod-shell-editor-stack">
                    <input
                      type="text"
                      id="generateChmodShellNumericMode"
                      class="form-control generate-chmod-shell-text-field"
                      placeholder="0755 or 2755"
                      value="0755"
                    >
                    <div class="generate-chmod-shell-feedback d-none" id="generateChmodShellNumericFeedback"></div>
                  </div>

                  <div class="generate-chmod-shell-editor-stack">
                    <input
                      type="text"
                      id="generateChmodShellSymbolicMode"
                      class="form-control generate-chmod-shell-text-field"
                      placeholder="u=rwx,g=rx,o=rx"
                      value="u=rwx,g=rx,o=rx"
                    >
                    <div class="generate-chmod-shell-feedback d-none" id="generateChmodShellSymbolicFeedback"></div>
                  </div>
                </div>

                <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-operation">
                  <input
                    type="text"
                    id="generateChmodShellOperation"
                    class="form-control generate-chmod-shell-text-field"
                    placeholder="a+rwX, g=u, u-s"
                  >

                  <button type="button" class="generate-chmod-shell-secondary-btn" id="generateChmodShellApplyOperation">Apply</button>
                </div>

                <div class="generate-chmod-shell-quick-actions">
                  <button type="button" class="generate-chmod-shell-action-chip" data-operation="u=rwx,go=rx">u=rwx,go=rx</button>
                  <button type="button" class="generate-chmod-shell-action-chip" data-operation="a+rwX">a+rwX</button>
                  <button type="button" class="generate-chmod-shell-action-chip" data-operation="g+w">g+w</button>
                  <button type="button" class="generate-chmod-shell-action-chip" data-operation="o-rwx">o-rwx</button>
                  <button type="button" class="generate-chmod-shell-action-chip" data-operation="u-s,g-s,o-t">clear s/t</button>
                </div>

                <div class="generate-chmod-shell-feedback d-none" id="generateChmodShellOperationFeedback"></div>
                <div class="generate-chmod-shell-field-hint">Absolute symbolic mode expects assignment clauses such as <code>u=rw,g=r,o=</code>. Use the operation field for incremental changes.</div>
              </div>
            </div>
          </div>

          <div class="generate-chmod-shell-setting-row generate-chmod-shell-setting-row-stacked generate-chmod-shell-setting-card">
            <label for="generateChmodShellUmask" class="generate-chmod-shell-setting-label">
              Umask explorer:
              <span class="info-dot generate-chmod-shell-helper-chip" title="Preview how a umask clears bits from standard file and directory base modes">i</span>
            </label>

            <div class="generate-chmod-shell-setting-field">
              <div class="generate-chmod-shell-stacked-grid">
                <div class="generate-chmod-shell-inline-grid generate-chmod-shell-inline-grid-three">
                  <div class="generate-chmod-shell-umask-input">
                    <label class="generate-chmod-shell-field-label" for="generateChmodShellUmask">Umask</label>
                    <input
                      type="text"
                      id="generateChmodShellUmask"
                      class="form-control"
                      inputmode="numeric"
                      placeholder="Umask, e.g. 022"
                      value="022"
                    >
                  </div>

                  <div class="generate-chmod-shell-umask-input">
                    <label class="generate-chmod-shell-field-label" for="generateChmodShellUmaskFileBase">File base</label>
                    <input
                      type="text"
                      id="generateChmodShellUmaskFileBase"
                      class="form-control"
                      inputmode="numeric"
                      placeholder="File base, e.g. 666"
                      value="666"
                    >
                  </div>

                  <div class="generate-chmod-shell-umask-input">
                    <label class="generate-chmod-shell-field-label" for="generateChmodShellUmaskDirBase">Directory base</label>
                    <input
                      type="text"
                      id="generateChmodShellUmaskDirBase"
                      class="form-control"
                      inputmode="numeric"
                      placeholder="Directory base, e.g. 777"
                      value="777"
                    >
                  </div>
                </div>

                <div class="generate-chmod-shell-umask-grid">
                  <div class="generate-chmod-shell-umask-card">
                    <span class="generate-chmod-shell-umask-label">File result</span>
                    <span class="generate-chmod-shell-umask-mode" id="generateChmodShellUmaskFileNumeric">0644</span>
                    <span class="generate-chmod-shell-umask-symbolic" id="generateChmodShellUmaskFileSymbolic">u=rw,g=r,o=r</span>
                  </div>

                  <div class="generate-chmod-shell-umask-card">
                    <span class="generate-chmod-shell-umask-label">Directory result</span>
                    <span class="generate-chmod-shell-umask-mode" id="generateChmodShellUmaskDirNumeric">0755</span>
                    <span class="generate-chmod-shell-umask-symbolic" id="generateChmodShellUmaskDirSymbolic">u=rwx,g=rx,o=rx</span>
                  </div>
                </div>

                <div class="generate-chmod-shell-feedback d-none" id="generateChmodShellUmaskFeedback"></div>
                <div class="generate-chmod-shell-flag-hint generate-chmod-shell-umask-note">
                  <span>Files commonly start from <code>0666</code>.</span>
                  <span>Directories commonly start from <code>0777</code>.</span>
                  <span>The umask removes bits from those bases.</span>
                </div>
              </div>
            </div>
          </div>
      </div>
    </details>
  </form>
    {# ns:end family._base.workspace.03_custom-settings #}

  {# ns:start family._base.workspace.05_result-summary #}
  {# ns:start family.shell.workspace.04_result-text #}
  <div class="generate-chmod-shell-result-panel" id="generateChmodShellResultPanel" aria-label="Command output">
    <div class="tool-empty-state generate-chmod-shell-result-empty" id="generateChmodShellResultEmpty">Generate a chmod mode to inspect the command, permission tables, operation effects, warnings, and normalized JSON payload.</div>

    <div class="generate-chmod-shell-output-content generate-chmod-shell-result-content d-none" id="generateChmodShellResultContent">
      <div class="generate-chmod-shell-output-inner generate-chmod-shell-result-shell">
  {# ns:end family.shell.workspace.04_result-text #}
  {# ns:end family._base.workspace.05_result-summary #}
        <div class="generate-chmod-shell-result-summary" id="generateChmodShellResultSummary" data-share-snapshot-source data-share-kind="shell-summary"></div>

        {# ns:start family._base.workspace.06_output-toolbar #}
        <div class="generate-chmod-shell-toolbar-shell">
          <div class="generate-chmod-shell-toolbar tool-output-toolbar tool-result-toolbar">
            <div class="generate-chmod-shell-toolbar-main">
              <label for="generateChmodShellSort" class="generate-chmod-shell-sort-label">Sort</label>
              <div class="generate-chmod-shell-sort-wrap">
                <details class="generate-chmod-shell-sort-select" id="generateChmodShellSortSelect">
                  <summary class="generate-chmod-shell-sort-summary" aria-haspopup="listbox" aria-expanded="false" aria-controls="generateChmodShellSortMenu">
                    <span id="generateChmodShellSortSummary">ID</span>
                  </summary>

                  <div class="generate-chmod-shell-sort-menu" id="generateChmodShellSortMenu" role="listbox">
                    <div class="generate-chmod-shell-sort-grid">
                      <button type="button" class="generate-chmod-shell-sort-option is-active" data-sort-value="id" aria-pressed="true" role="option">ID</button>
                      <button type="button" class="generate-chmod-shell-sort-option" data-sort-value="alphabetical" aria-pressed="false" role="option">A-Z</button>
                      <button type="button" class="generate-chmod-shell-sort-option" data-sort-value="field" aria-pressed="false" role="option">Field</button>
                      <button type="button" class="generate-chmod-shell-sort-option" data-sort-value="value" aria-pressed="false" role="option">Value</button>
                      <button type="button" class="generate-chmod-shell-sort-option" data-sort-value="length" aria-pressed="false" role="option">Length</button>
                    </div>
                  </div>
                </details>
                <input type="hidden" id="generateChmodShellSort" value="id">
              </div>
            </div>

            <div class="tool-output-actions generate-chmod-shell-toolbar-actions tool-result-toolbar-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-chmod-shell-action-btn tool-result-action-btn" id="generateChmodShellExportPdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-chmod-shell-action-btn tool-result-action-btn" id="generateChmodShellDownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-chmod-shell-action-btn tool-result-action-btn" id="generateChmodShellCopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-chmod-shell-action-btn tool-result-action-btn" id="generateChmodShellDownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost generate-chmod-shell-action-btn tool-result-action-btn" id="generateChmodShellImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
        </div>

        {# ns:end family._base.workspace.06_output-toolbar #}
        {# ns:start family._base.workspace.07_table-output #}
        <div class="generate-chmod-shell-tabs-shell">
          <div class="tool-tabs generate-chmod-shell-tabs" role="tablist" aria-label="chmod command output views">

            <button type="button" class="tool-tab-btn generate-chmod-shell-tab-btn active" id="generateChmodShellOperationsTab" data-tab-target="generateChmodShellOperationsPanel" role="tab" aria-controls="generateChmodShellOperationsPanel" aria-selected="true" tabindex="0">
              <i class="bi bi-list-check" aria-hidden="true"></i>
              <span>Operations</span>
            </button>
<button type="button" class="tool-tab-btn generate-chmod-shell-tab-btn" id="generateChmodShellCommandTab" data-tab-target="generateChmodShellCommandPanel" role="tab" aria-controls="generateChmodShellCommandPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-terminal" aria-hidden="true"></i>
              <span>Command</span>
            </button>
            <button type="button" class="tool-tab-btn generate-chmod-shell-tab-btn" id="generateChmodShellDetailsTab" data-tab-target="generateChmodShellDetailsPanel" role="tab" aria-controls="generateChmodShellDetailsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-card-text" aria-hidden="true"></i>
              <span>Details</span>
            </button>
            <button type="button" class="tool-tab-btn generate-chmod-shell-tab-btn" id="generateChmodShellWarningsTab" data-tab-target="generateChmodShellWarningsPanel" role="tab" aria-controls="generateChmodShellWarningsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-card-text" aria-hidden="true"></i>
              <span>Warnings</span>
            </button>
