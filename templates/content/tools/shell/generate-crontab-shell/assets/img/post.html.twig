{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.generate-crontab-shell-post-visual {
    --post-start: #115e59;
    --post-end: #0f766e;
    --post-accent: #99f6e4;
}

.generate-crontab-shell-post-visual .tool-post-node:nth-child(1),
.generate-crontab-shell-post-visual .tool-post-node:nth-child(3),
.generate-crontab-shell-post-visual .tool-post-node:nth-child(5) {
    background: rgba(153, 246, 228, 0.22);
}

.generate-crontab-shell-post-visual .tool-post-icon {
    background: rgba(15, 118, 110, 0.28);
}
</style>
{% else %}
<div
  class="tool-post-visual generate-crontab-shell-post-visual tool-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#115e59') }}; --post-end: {{ post.card_gradient_end|default('#0f766e') }};"
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="bi bi-calendar4-week"></i>
    <i class="bi bi-clock-history"></i>
    <i class="bi bi-terminal"></i>
    <i class="bi bi-list-check"></i>
    <i class="bi bi-filetype-json"></i>
  </div>
  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('Shell')) }}</span>
    <span class="tool-post-icon"><i class="{{ post.card_icon_class|default('bi bi-calendar4-week') }}"></i></span>
  </div>
  <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('Crontab Command Generator')) }}</div>
  <div class="tool-post-map" aria-hidden="true">
    <span class="tool-post-node"><i class="bi bi-calendar4-week"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-clock-history"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-terminal"></i></span>
  </div>
  <div class="tool-post-footer">
    <span>{{ post.reading_time|default('8 min read') }}</span>
    <span>{{ post.category|default('Shell') }}</span>
  </div>
  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-chevron-down"></i> {{ post.date_display|default('Apr. 1st, 2026') }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('Shell') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('8 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('Crontab Command Generator') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
