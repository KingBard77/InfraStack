{# post.html.twig #}
{% set visualVariant = variant|default('card') %}
{% set showPostDetail = show_detail is defined ? show_detail : visualVariant in ['hero', 'hero-small'] %}
{% set showTitle = show_title is defined ? show_title : true %}
{% set showMap = show_map is defined ? show_map : true %}
{% set showFooter = show_footer is defined ? show_footer : true %}
{% set defaultBackgroundIcons = [
  'bi bi-terminal',
  'bi bi-key',
  'bi bi-hdd-network',
  'bi bi-router',
  'bi bi-shield-lock'
] %}
{% set defaultMapIcons = [
  post.card_icon_class|default('bi bi-terminal'),
  'bi bi-key',
  'bi bi-hdd-network'
] %}
{% set backgroundIcons = post.card_background_icons|default(defaultBackgroundIcons) %}
{% set mapIcons = post.card_map_icons|default(defaultMapIcons) %}
{% set visualClass = post.card_visual_class|default((post.slug|default('tool')) ~ '-post-visual') %}

{% if visualVariant != 'style' %}
<div
  class="tool-post-visual tool-post-visual-shared {{ visualClass }} tool-post-visual-{{ visualVariant }}"
  style="
    --post-start: {{ post.card_gradient_start|default('#0F766E') }};
    --post-end: {{ post.card_gradient_end|default('#14B8A6') }};
    --post-ink: {{ post.card_text_color|default('#ffffff') }};
  "
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="{{ backgroundIcons[0]|default(defaultBackgroundIcons[0]) }}"></i>
    <i class="{{ backgroundIcons[1]|default(defaultBackgroundIcons[1]) }}"></i>
    <i class="{{ backgroundIcons[2]|default(defaultBackgroundIcons[2]) }}"></i>
    <i class="{{ backgroundIcons[3]|default(defaultBackgroundIcons[3]) }}"></i>
    <i class="{{ backgroundIcons[4]|default(defaultBackgroundIcons[4]) }}"></i>
  </div>

  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('Shell')) }}</span>
    <span class="tool-post-icon"><i class="{{ post.card_icon_class|default('bi bi-terminal') }}"></i></span>
  </div>

  {% if showTitle %}
    <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('Generate SSH Shell')) }}</div>
  {% endif %}

  {% if showMap %}
    <div class="tool-post-map" aria-hidden="true">
      <span class="tool-post-node"><i class="{{ mapIcons[0]|default(defaultMapIcons[0]) }}"></i></span>
      <span class="tool-post-node"></span>
      <span class="tool-post-node"><i class="{{ mapIcons[1]|default(defaultMapIcons[1]) }}"></i></span>
      <span class="tool-post-node"></span>
      <span class="tool-post-node"><i class="{{ mapIcons[2]|default(defaultMapIcons[2]) }}"></i></span>
    </div>
  {% endif %}

  {% if showFooter %}
    <div class="tool-post-footer">
      <span>{{ post.reading_time|default('3 min read') }}</span>
      <span>{{ post.category|default('Shell') }}</span>
    </div>
  {% endif %}

  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-calendar3"></i> {{ post.date_display|default(post.date|default('')) }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('Shell') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('3 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('Generate SSH Shell') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
