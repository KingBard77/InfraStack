{# tool.html.twig #}

<div class="generate-ssh-shell-tool" data-tool-slug="generate-ssh-shell" data-tool-category="Shell" data-tool-family-shell="base">
  {# ns:start family._base.workspace.00_shell #}
  <div class="tool-box mb-4">
    {# ns:start family._base.workspace.01_input-brief #}
    <form class="generate-ssh-shell-form" id="generateSshShellForm" aria-label="SSH command preview builder">
      <div class="generate-ssh-shell-input-card">
        <div class="generate-ssh-shell-input-brief" data-input-layout="inline">
          <div class="generate-ssh-shell-main-row generate-ssh-shell-input-row">
            <div class="generate-ssh-shell-input-label-wrap">
              <label for="generateSshShellInput" class="generate-ssh-shell-main-label generate-ssh-shell-input-label">SSH target:</label>
              <span class="generate-ssh-shell-helper-chip" title="Enter the target host, short SSH intent, or review note for command planning" aria-label="Enter the target host, short SSH intent, or review note for command planning">i</span>
            </div>

            <div class="generate-ssh-shell-main-input-grid generate-ssh-shell-input-stack">
              <input
                type="text"
                id="generateSshShellInput"
                class="form-control generate-ssh-shell-input-control"
                placeholder="host.example.com or connect to staging app through jump host"
                autocomplete="off"
              >
              <div class="generate-ssh-shell-input-error d-none" id="generateSshShellInputError" role="alert"></div>
            </div>
          </div>

          <div class="generate-ssh-shell-main-actions generate-ssh-shell-input-actions">
            <button
              type="submit"
              class="btn btn-primary generate-ssh-shell-submit-btn generate-ssh-shell-action-btn generate-ssh-shell-action-btn-primary"
              id="generateSshShellPrimaryAction"
              data-tool-share-generate
            >
              <i class="bi bi-terminal" aria-hidden="true"></i>
              <span>Generate</span>
            </button>
            <button
              type="button"
              class="generate-ssh-shell-secondary-btn generate-ssh-shell-secondary-btn-ghost generate-ssh-shell-reset-btn generate-ssh-shell-action-btn generate-ssh-shell-action-btn-secondary"
              id="generateSshShellSecondaryAction"
            >
              <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
              <span>Reset</span>
            </button>
          </div>

          <div class="generate-ssh-shell-input-helper-card">
            <span class="generate-ssh-shell-input-hint">Use a concrete target, user, port, and route before generating SSH command output.</span>
            <span class="generate-ssh-shell-helper-chip generate-ssh-shell-helper-chip-inline" title="This workspace previews command text only and never opens an SSH session" aria-label="This workspace previews command text only and never opens an SSH session">i</span>
          </div>
        </div>
      </div>
    {# ns:end family._base.workspace.01_input-brief #}

    {# ns:start family._base.workspace.02_basic-settings #}
      <div class="generate-ssh-shell-basic-panel">
        <div class="generate-ssh-shell-inner-panel generate-ssh-shell-basic-card">
          <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
            <label for="generateSshShellBasicPrimary" class="generate-ssh-shell-setting-label">
              Command profile:
              <span class="info-dot generate-ssh-shell-helper-chip" title="Pick the SSH route profile and shell quoting style for the preview command">i</span>
            </label>

            <div class="generate-ssh-shell-setting-field">
              <div class="generate-ssh-shell-stacked-grid">
	                <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
	                  <input type="hidden" id="generateSshShellBasicPrimary" value="Direct SSH">
	                  <details class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" id="generateSshShellBasicPrimarySelect" data-dropdown-target="generateSshShellBasicPrimary" data-dropdown-summary="generateSshShellBasicPrimarySummary">
	                    <summary class="generate-ssh-shell-custom-dropdown-summary">
	                      <span id="generateSshShellBasicPrimarySummary">Direct SSH</span>
	                      <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                    </summary>
	                    <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="Command profile">
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="Direct SSH" role="option" aria-selected="true">Direct SSH</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="Jump host" role="option" aria-selected="false">Jump host</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="Verbose debug" role="option" aria-selected="false">Verbose debug</button>
	                    </div>
	                  </details>

	                  <input type="hidden" id="generateSshShellBasicOption" value="Bash / Zsh">
	                  <details class="generate-ssh-shell-select generate-ssh-shell-css-dropdown" id="generateSshShellBasicSelect" data-dropdown-target="generateSshShellBasicOption" data-dropdown-summary="generateSshShellBasicSelectSummary">
	                    <summary class="generate-ssh-shell-select-summary">
	                      <span id="generateSshShellBasicSelectSummary">Bash / Zsh</span>
	                      <span class="generate-ssh-shell-select-arrow-slot" aria-hidden="true"></span>
	                    </summary>
	                    <div class="generate-ssh-shell-select-body" id="generateSshShellBasicSelectMenu" role="listbox" aria-label="Shell quoting style">
	                      <button type="button" class="generate-ssh-shell-select-option active" data-dropdown-value="Bash / Zsh" role="option" aria-selected="true">
	                        <span class="generate-ssh-shell-select-option-title">Bash / Zsh</span>
	                      </button>
	                      <button type="button" class="generate-ssh-shell-select-option" data-dropdown-value="PowerShell" role="option" aria-selected="false">
	                        <span class="generate-ssh-shell-select-option-title">PowerShell</span>
	                      </button>
	                      <button type="button" class="generate-ssh-shell-select-option" data-dropdown-value="POSIX sh" role="option" aria-selected="false">
	                        <span class="generate-ssh-shell-select-option-title">POSIX sh</span>
	                      </button>
	                    </div>
	                  </details>
                </div>

                <div class="generate-ssh-shell-flag-hint">Direct SSH is active by default. Jump host and verbose debug stay in preview mode until this tool is promoted.</div>
              </div>
            </div>
          </div>

          <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
            <label for="generateSshShellBasicText" class="generate-ssh-shell-setting-label">
              Target route:
              <span class="info-dot generate-ssh-shell-helper-chip" title="Set the visible user, host, and port tokens used by the command preview">i</span>
            </label>

            <div class="generate-ssh-shell-setting-field">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                <input
                  type="text"
                  id="generateSshShellCustomText"
                  class="form-control generate-ssh-shell-text-field"
                  placeholder="User"
                  value="admin"
                >
                <input
                  type="text"
                  id="generateSshShellBasicText"
                  class="form-control generate-ssh-shell-text-field"
                  placeholder="host.example.com"
                  value="host.example.com"
                >
                <input
                  type="number"
                  id="generateSshShellCustomNumber"
                  class="form-control generate-ssh-shell-text-field"
                  min="1"
                  max="65535"
                  step="1"
                  placeholder="Port"
                  value="22"
                >
              </div>
            </div>
          </div>

          <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
            <label for="generateSshShellBasicToggle" class="generate-ssh-shell-setting-label">
              Safety defaults:
              <span class="info-dot generate-ssh-shell-helper-chip" title="Keep common OpenSSH safety and keepalive options visible before custom tuning">i</span>
            </label>

            <div class="generate-ssh-shell-setting-field">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                  <input type="checkbox" id="generateSshShellBasicToggle" checked>
                  <span class="slider"></span>
                  <span class="generate-ssh-shell-switch-label">Keepalive</span>
                </label>

                <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                  <input type="checkbox" id="generateSshShellCustomToggle" checked>
                  <span class="slider"></span>
                  <span class="generate-ssh-shell-switch-label">Strict host key</span>
                </label>

                <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                  <input type="checkbox" id="generateSshShellIdentitiesOnly">
                  <span class="slider"></span>
                  <span class="generate-ssh-shell-switch-label">IdentitiesOnly</span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    {# ns:end family._base.workspace.02_basic-settings #}

    {# ns:start family._base.workspace.03_custom-settings #}
      <details class="generate-ssh-shell-custom-settings generate-ssh-shell-advanced" id="generateSshShellCustomSettings" data-custom-layout="compact_two_column_multi_row">
        <summary class="generate-ssh-shell-custom-summary generate-ssh-shell-advanced-summary">
          <span>Custom</span>
          <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
        </summary>

        <div class="generate-ssh-shell-custom-body generate-ssh-shell-advanced-body">
          <div class="generate-ssh-shell-inner-panel">
            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellBinary" class="generate-ssh-shell-setting-label">
                Output shape:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Control the SSH binary, optional config file, and command wrapping style">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-stacked-grid">
                  <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                    <input
                      type="text"
                      id="generateSshShellBinary"
                      class="form-control generate-ssh-shell-text-field"
                      placeholder="ssh"
                    >

                    <input
                      type="text"
                      id="generateSshShellConfigFile"
                      class="form-control generate-ssh-shell-text-field"
                      placeholder="Config file, for example ~/.ssh/config"
                    >

                    <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                      <input type="checkbox" id="generateSshShellMultiline" checked>
                      <span class="slider"></span>
                      <span class="generate-ssh-shell-switch-label">Multi-line command</span>
                    </label>
                  </div>

                  <div class="generate-ssh-shell-flag-hint">Use the binary and config fields when the preview should show an alternate SSH client path or a named OpenSSH config file.</div>
                </div>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellProxyJump" class="generate-ssh-shell-setting-label">
                Connection path:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Tune jump-host mode, connection mode, and keepalive count for the preview command">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                  <input
                    type="text"
                    id="generateSshShellProxyJump"
                    class="form-control generate-ssh-shell-text-field"
                    placeholder="jump.example.com"
                  >

	                  <input type="hidden" id="generateSshShellCustomSelectValueInput" value="Direct SSH">
	                  <details id="generateSshShellCustomSelect" class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" data-dropdown-target="generateSshShellCustomSelectValueInput" data-dropdown-summary="generateSshShellCustomSelectValue">
	                    <summary class="generate-ssh-shell-custom-dropdown-summary">
	                      <span id="generateSshShellCustomSelectValue">Direct SSH</span>
	                      <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                    </summary>
	                    <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="Connection mode">
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="Direct SSH" role="option" aria-selected="true">Direct SSH</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="Jump host" role="option" aria-selected="false">Jump host</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="Verbose debug" role="option" aria-selected="false">Verbose debug</button>
	                    </div>
	                  </details>

                  <input
                    type="number"
                    id="generateSshShellServerAliveCountMax"
                    class="form-control generate-ssh-shell-text-field"
                    min="1"
                    step="1"
                    placeholder="Alive count"
                    value="3"
                  >
                </div>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellConnectTimeout" class="generate-ssh-shell-setting-label">
                Transport:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Tune connection timeout, retry count, address family, and compression options">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-stacked-grid">
                  <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                    <input
                      type="number"
                      id="generateSshShellConnectTimeout"
                      class="form-control generate-ssh-shell-text-field"
                      min="0"
                      step="1"
                      placeholder="Connect timeout (s)"
                      value="10"
                    >

                    <input
                      type="number"
                      id="generateSshShellConnectionAttempts"
                      class="form-control generate-ssh-shell-text-field"
                      min="1"
                      step="1"
                      placeholder="Connection attempts"
                      value="1"
                    >

	                    <input type="hidden" id="generateSshShellAddressFamily" value="auto">
	                    <details class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" data-dropdown-target="generateSshShellAddressFamily" data-dropdown-summary="generateSshShellAddressFamilySummary">
	                      <summary class="generate-ssh-shell-custom-dropdown-summary">
	                        <span id="generateSshShellAddressFamilySummary">Any address family</span>
	                        <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                      </summary>
	                      <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="Address family">
	                        <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="auto" role="option" aria-selected="true">Any address family</button>
	                        <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="ipv4" role="option" aria-selected="false">Force IPv4 (-4)</button>
	                        <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="ipv6" role="option" aria-selected="false">Force IPv6 (-6)</button>
	                      </div>
	                    </details>
                  </div>

                  <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                    <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                      <input type="checkbox" id="generateSshShellCompression">
                      <span class="slider"></span>
                      <span class="generate-ssh-shell-switch-label">Compression (-C)</span>
                    </label>

                    <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                      <input type="checkbox" id="generateSshShellExitOnForwardFailure" checked>
                      <span class="slider"></span>
                      <span class="generate-ssh-shell-switch-label">Exit on forward failure</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellKnownHostsFile" class="generate-ssh-shell-setting-label">
                Host-key review:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Tune known-hosts file, CheckHostIP, and SSH log verbosity for the preview">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                  <input
                    type="text"
                    id="generateSshShellKnownHostsFile"
                    class="form-control generate-ssh-shell-text-field"
                    placeholder="Known hosts file"
                  >

	                  <input type="hidden" id="generateSshShellLogLevel" value="INFO">
	                  <details class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" data-dropdown-target="generateSshShellLogLevel" data-dropdown-summary="generateSshShellLogLevelSummary">
	                    <summary class="generate-ssh-shell-custom-dropdown-summary">
	                      <span id="generateSshShellLogLevelSummary">LogLevel INFO</span>
	                      <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                    </summary>
	                    <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="SSH log level">
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="INFO" role="option" aria-selected="true">LogLevel INFO</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="ERROR" role="option" aria-selected="false">LogLevel ERROR</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="QUIET" role="option" aria-selected="false">LogLevel QUIET</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="VERBOSE" role="option" aria-selected="false">LogLevel VERBOSE</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="DEBUG" role="option" aria-selected="false">LogLevel DEBUG</button>
	                    </div>
	                  </details>

                  <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                    <input type="checkbox" id="generateSshShellCheckHostIp" checked>
                    <span class="slider"></span>
                    <span class="generate-ssh-shell-switch-label">CheckHostIP</span>
                  </label>
                </div>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <span class="generate-ssh-shell-setting-label">
                Identity policy:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Choose whether an identity file is optional or required in the preview output">i</span>
              </span>

              <div class="generate-ssh-shell-setting-field">
	                <input type="hidden" id="generateSshShellIdentityPolicy" value="Optional">
	                <details class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" data-dropdown-target="generateSshShellIdentityPolicy" data-dropdown-summary="generateSshShellIdentityPolicySummary">
	                  <summary class="generate-ssh-shell-custom-dropdown-summary">
	                    <span id="generateSshShellIdentityPolicySummary">Optional</span>
	                    <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                  </summary>
	                  <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="Identity handling">
	                    <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="Optional" role="option" aria-selected="true">Optional</button>
	                    <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="Required" role="option" aria-selected="false">Required</button>
	                  </div>
	                </details>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellPreferredAuth" class="generate-ssh-shell-setting-label">
                Authentication:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Tune preferred authentication methods, agent forwarding, and non-interactive BatchMode">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
	                  <input type="hidden" id="generateSshShellPreferredAuth" value="default">
	                  <details class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" data-dropdown-target="generateSshShellPreferredAuth" data-dropdown-summary="generateSshShellPreferredAuthSummary">
	                    <summary class="generate-ssh-shell-custom-dropdown-summary">
	                      <span id="generateSshShellPreferredAuthSummary">Default auth order</span>
	                      <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                    </summary>
	                    <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="Preferred authentication">
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="default" role="option" aria-selected="true">Default auth order</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="publickey" role="option" aria-selected="false">Public key only</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="publickey,password" role="option" aria-selected="false">Public key then password</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="password" role="option" aria-selected="false">Password only</button>
	                      <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="keyboard-interactive" role="option" aria-selected="false">Keyboard interactive</button>
	                    </div>
	                  </details>

                  <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                    <input type="checkbox" id="generateSshShellAgentForward">
                    <span class="slider"></span>
                    <span class="generate-ssh-shell-switch-label">Agent forwarding (-A)</span>
                  </label>

                  <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                    <input type="checkbox" id="generateSshShellBatchMode">
                    <span class="slider"></span>
                    <span class="generate-ssh-shell-switch-label">BatchMode</span>
                  </label>
                </div>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellCustomTextarea" class="generate-ssh-shell-setting-label">
                Identity and forwarding:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Preview identity and forwarding tokens without opening a remote session">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                  <textarea
                    id="generateSshShellCustomTextarea"
                    class="form-control generate-ssh-shell-custom-textarea"
                    rows="3"
                    placeholder="~/.ssh/id_ed25519&#10;ServerAliveInterval=30"
                  ></textarea>

                  <textarea
                    id="generateSshShellForwardTextarea"
                    class="form-control generate-ssh-shell-custom-textarea"
                    rows="3"
                    placeholder="-L 127.0.0.1:8443:10.0.0.10:443&#10;-D 127.0.0.1:1080"
                  ></textarea>
                </div>
              </div>
            </div>

            <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
              <label for="generateSshShellRemoteCommand" class="generate-ssh-shell-setting-label">
                Session behavior:
                <span class="info-dot generate-ssh-shell-helper-chip" title="Tune TTY request mode, remote command, X11 forwarding, and environment sending">i</span>
              </label>

              <div class="generate-ssh-shell-setting-field">
                <div class="generate-ssh-shell-stacked-grid">
                  <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
	                    <input type="hidden" id="generateSshShellTtyMode" value="default">
	                    <details class="generate-ssh-shell-custom-dropdown generate-ssh-shell-css-dropdown" data-dropdown-target="generateSshShellTtyMode" data-dropdown-summary="generateSshShellTtyModeSummary">
	                      <summary class="generate-ssh-shell-custom-dropdown-summary">
	                        <span id="generateSshShellTtyModeSummary">Default TTY</span>
	                        <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
	                      </summary>
	                      <div class="generate-ssh-shell-custom-dropdown-menu" role="listbox" aria-label="TTY mode">
	                        <button type="button" class="generate-ssh-shell-custom-dropdown-option active" data-dropdown-value="default" role="option" aria-selected="true">Default TTY</button>
	                        <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="force" role="option" aria-selected="false">Force TTY (-t)</button>
	                        <button type="button" class="generate-ssh-shell-custom-dropdown-option" data-dropdown-value="disable" role="option" aria-selected="false">Disable TTY (-T)</button>
	                      </div>
	                    </details>

                    <input
                      type="text"
                      id="generateSshShellRemoteCommand"
                      class="form-control generate-ssh-shell-text-field"
                      placeholder="Remote command, for example uptime"
                    >

                    <input
                      type="text"
                      id="generateSshShellSendEnv"
                      class="form-control generate-ssh-shell-text-field"
                      placeholder="SendEnv, for example LANG LC_*"
                    >
                  </div>

                  <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                    <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                      <input type="checkbox" id="generateSshShellX11Forward">
                      <span class="slider"></span>
                      <span class="generate-ssh-shell-switch-label">X11 forwarding (-X)</span>
                    </label>

                    <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
