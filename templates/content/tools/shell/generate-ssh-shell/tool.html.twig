{# tool.html.twig #}

<div class="generate-ssh-shell-tool tool-box mb-4" data-tool-slug="generate-ssh-shell" data-tool-category="Shell">
  {# ns:start family._base.workspace.00_shell #}
  {# ns:start family._base.workspace.01_input-brief #}
  <form class="generate-ssh-shell-form" id="generateSshShellForm" aria-label="SSH command builder">
    <div class="generate-ssh-shell-input-card">
      <div class="generate-ssh-shell-input-brief" data-input-layout="inline">
        <div class="generate-ssh-shell-main-row generate-ssh-shell-input-row">
          <div class="generate-ssh-shell-input-label-wrap">
            <label for="generateSshShellInput" class="generate-ssh-shell-main-label generate-ssh-shell-input-label">SSH target:</label>
            <span class="generate-ssh-shell-helper-chip" title="Enter a host, user@host, or ssh-style target before generating a command" aria-label="Enter a host, user@host, or ssh-style target before generating a command">i</span>
          </div>

          <div class="generate-ssh-shell-main-input-grid generate-ssh-shell-input-stack">
            <input
              type="text"
              id="generateSshShellInput"
              class="form-control generate-ssh-shell-input-control"
              placeholder="deploy@server.example.com"
              value="deploy@app01.example.com"
            >
            <div class="generate-ssh-shell-input-error d-none" id="generateSshShellInputError" role="alert"></div>
          </div>
        </div>

        <div class="generate-ssh-shell-main-actions generate-ssh-shell-input-actions">
          <button
            type="submit"
            class="btn btn-primary generate-ssh-shell-submit-btn generate-ssh-shell-action-btn generate-ssh-shell-action-btn-primary"
            id="generateSshShellPrimaryAction"
            data-tool-share-generate
          >
            <i class="bi bi-terminal" aria-hidden="true"></i>
            <span>Generate</span>
          </button>
          <button
            type="button"
            class="generate-ssh-shell-secondary-btn generate-ssh-shell-secondary-btn-ghost generate-ssh-shell-reset-btn generate-ssh-shell-action-btn generate-ssh-shell-action-btn-secondary"
            id="generateSshShellSecondaryAction"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="generate-ssh-shell-input-helper-card">
          <span class="generate-ssh-shell-input-hint">Generate OpenSSH command text locally. This workspace does not connect to, scan, or validate the host.</span>
          <span class="generate-ssh-shell-helper-chip generate-ssh-shell-helper-chip-inline" title="Review the command before using it in a terminal" aria-label="Review the command before using it in a terminal">i</span>
        </div>
      </div>
    </div>

    {# ns:end family._base.workspace.01_input-brief #}
    {# ns:start family._base.workspace.02_basic-settings #}
    <div class="generate-ssh-shell-basic-panel">
      <div class="generate-ssh-shell-inner-panel generate-ssh-shell-basic-card">

        <div class="generate-ssh-shell-example-card">
          <span class="generate-ssh-shell-example-label">Example</span>
          <span class="generate-ssh-shell-example-value">ssh deploy@app01.example.com</span>
          <span class="generate-ssh-shell-example-helper">Start with a target, then add port, identity, host-key, and forwarding controls.</span>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
          <label class="generate-ssh-shell-setting-label">
            Target profile:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Profiles seed common OpenSSH option groups without locking later edits">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-stacked-grid">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                <div class="generate-ssh-shell-native-select-wrap">
                  <select id="generateSshShellBasicPrimary" class="form-select generate-ssh-shell-native-select" aria-label="Target profile">
                    <option value="interactive" selected>Interactive login</option>
                    <option value="bastion">Bastion jump</option>
                    <option value="port-forward">Port forward</option>
                    <option value="batch">Batch automation</option>
                  </select>
                </div>

                <button type="button" class="generate-ssh-shell-secondary-btn" id="generateSshShellApplyPreset">Apply profile</button>
              </div>

            </div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card">
          <label class="generate-ssh-shell-setting-label">
            Command shape:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Shell style, login user, and jump host posture shape the generated command">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-stacked-grid">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                <div class="generate-ssh-shell-native-select-wrap">
                  <select id="generateSshShellShellStyle" class="form-select generate-ssh-shell-native-select" aria-label="Shell style">
                    <option value="posix" selected>POSIX shell</option>
                    <option value="bash">Bash script</option>
                    <option value="powershell">PowerShell note</option>
                  </select>
                </div>

                <input
                  type="text"
                  id="generateSshShellBasicText"
                  class="form-control generate-ssh-shell-text-field"
                  placeholder="Optional login user"
                  value="deploy"
                >
              </div>

              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                <label class="switch generate-ssh-shell-switch-wrap generate-ssh-shell-switch-card">
                  <input type="checkbox" id="generateSshShellBasicToggle">
                  <span class="slider"></span>
                  <span class="generate-ssh-shell-switch-label">Use ProxyJump (-J)</span>
                </label>

                <input
                  type="text"
                  id="generateSshShellProxyJump"
                  class="form-control generate-ssh-shell-text-field"
                  placeholder="bastion.example.com"
                  value="bastion.example.com"
                >
              </div>

              <div class="generate-ssh-shell-flag-hint">ProxyJump is only included when the toggle is enabled. The target host stays explicit in the generated command.</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    {# ns:end family._base.workspace.02_basic-settings #}
    {# ns:start family._base.workspace.03_custom-settings #}
    <details class="generate-ssh-shell-custom-settings generate-ssh-shell-advanced" id="generateSshShellCustomSettings" data-custom-layout="compact_two_column_multi_row">
      <summary class="generate-ssh-shell-custom-summary generate-ssh-shell-advanced-summary">
        <span>Custom</span>
        <span class="generate-ssh-shell-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="generate-ssh-shell-advanced-body generate-ssh-shell-custom-body">
        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Command flags:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Optional OpenSSH flags that change command verbosity or address-family selection">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-stacked-grid">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                <label class="generate-ssh-shell-toggle-item">
                  <span class="generate-ssh-shell-toggle-copy">Verbose output (-v)</span>
                  <input type="checkbox" id="generateSshShellVerbose">
                </label>

                <label class="generate-ssh-shell-toggle-item">
                  <span class="generate-ssh-shell-toggle-copy">Quiet mode (-q)</span>
                  <input type="checkbox" id="generateSshShellQuiet">
                </label>
              </div>

              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
                <label class="generate-ssh-shell-toggle-item">
                  <span class="generate-ssh-shell-toggle-copy">IPv4 only (-4)</span>
                  <input type="checkbox" id="generateSshShellIpv4">
                </label>

                <label class="generate-ssh-shell-toggle-item">
                  <span class="generate-ssh-shell-toggle-copy">IPv6 only (-6)</span>
                  <input type="checkbox" id="generateSshShellIpv6">
                </label>
              </div>

              <div class="generate-ssh-shell-flag-hint">Use address-family flags only when DNS or routing behavior needs to be constrained.</div>
            </div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label for="generateSshShellCustomNumber" class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Connection options:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Port, identity file, compression, and extra options are emitted as OpenSSH flags">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
              <input
                type="number"
                id="generateSshShellCustomNumber"
                class="form-control generate-ssh-shell-custom-number-field"
                min="1"
                max="65535"
                value="22"
              >

              <input
                type="text"
                id="generateSshShellCustomText"
                class="form-control generate-ssh-shell-custom-text-field"
                placeholder="~/.ssh/id_ed25519"
                value="~/.ssh/id_ed25519"
              >

              <label class="generate-ssh-shell-toggle-item">
                <span class="generate-ssh-shell-toggle-copy">Compression (-C)</span>
                <input type="checkbox" id="generateSshShellCustomToggle">
              </label>
            </div>

            <div class="generate-ssh-shell-custom-info">Port and identity values are quoted only when needed; the output is a command preview, not an SSH connection test.</div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Host-key posture:
            <span class="info-dot generate-ssh-shell-helper-chip" title="StrictHostKeyChecking posture is emitted as an OpenSSH -o option">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-native-select-wrap" id="generateSshShellCustomSelect">
              <select id="generateSshShellStrictHostKey" class="form-select generate-ssh-shell-native-select" aria-label="Host-key posture">
                <option value="accept-new" selected>Strict accept-new</option>
                <option value="yes">Strict yes</option>
                <option value="no">Strict no</option>
              </select>
            </div>

            <div class="generate-ssh-shell-custom-info">Use relaxed host-key options only for controlled troubleshooting, and review the warning tab before copying the command.</div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label for="generateSshShellKnownHostsFile" class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Known hosts:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Known-hosts file and log level become OpenSSH -o options when present">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
              <input
                type="text"
                id="generateSshShellKnownHostsFile"
                class="form-control generate-ssh-shell-custom-text-field"
                placeholder="~/.ssh/known_hosts"
              >

              <div class="generate-ssh-shell-native-select-wrap">
                <select id="generateSshShellLogLevel" class="form-select generate-ssh-shell-native-select" aria-label="Log level">
                  <option value="" selected>Default log level</option>
                  <option value="ERROR">ERROR</option>
                  <option value="QUIET">QUIET</option>
                  <option value="VERBOSE">VERBOSE</option>
                  <option value="DEBUG">DEBUG</option>
                </select>
              </div>
            </div>

            <div class="generate-ssh-shell-custom-info">Leave the known-hosts field empty to use the user's normal OpenSSH known_hosts search path.</div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Session mode:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Session mode controls TTY and batch automation options">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-custom-radio-grid" role="radiogroup" aria-label="SSH session mode">
              <label class="generate-ssh-shell-custom-radio-card">
                <input type="radio" name="generateSshShellSessionMode" id="generateSshShellCustomRadioStandard" value="interactive" checked>
                <span>Interactive</span>
              </label>
              <label class="generate-ssh-shell-custom-radio-card">
                <input type="radio" name="generateSshShellSessionMode" id="generateSshShellCustomRadioOverride" value="batch">
                <span>Batch</span>
              </label>
            </div>

            <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-two">
              <label class="generate-ssh-shell-toggle-item">
                <span class="generate-ssh-shell-toggle-copy">Agent forwarding (-A)</span>
                <input type="checkbox" id="generateSshShellAgentForward">
              </label>

              <label class="generate-ssh-shell-toggle-item">
                <span class="generate-ssh-shell-toggle-copy">TTY allocation (-tt)</span>
                <input type="checkbox" id="generateSshShellTty">
              </label>
            </div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-row-stacked generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label for="generateSshShellConnectTimeout" class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Timeouts:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Connection timeout and keepalive controls are emitted as OpenSSH -o options">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-stacked-grid">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                <div class="generate-ssh-shell-umask-input">
                  <label class="generate-ssh-shell-field-label" for="generateSshShellConnectTimeout">ConnectTimeout</label>
                  <input
                    type="number"
                    id="generateSshShellConnectTimeout"
                    class="form-control generate-ssh-shell-custom-number-field"
                    min="1"
                    max="600"
                    placeholder="10"
                  >
                </div>

                <div class="generate-ssh-shell-umask-input">
                  <label class="generate-ssh-shell-field-label" for="generateSshShellServerAliveInterval">ServerAliveInterval</label>
                  <input
                    type="number"
                    id="generateSshShellServerAliveInterval"
                    class="form-control generate-ssh-shell-custom-number-field"
                    min="1"
                    max="3600"
                    placeholder="30"
                  >
                </div>

                <div class="generate-ssh-shell-umask-input">
                  <label class="generate-ssh-shell-field-label" for="generateSshShellServerAliveCountMax">ServerAliveCountMax</label>
                  <input
                    type="number"
                    id="generateSshShellServerAliveCountMax"
                    class="form-control generate-ssh-shell-custom-number-field"
                    min="1"
                    max="20"
                    placeholder="3"
                  >
                </div>
              </div>

              <div class="generate-ssh-shell-flag-hint generate-ssh-shell-umask-note">
                <span>Timeouts are optional review controls.</span>
                <span>They are included only when a value is entered.</span>
                <span>Use integers that match your operational policy.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-row-stacked generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label for="generateSshShellLocalForward" class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Forwarding:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Local, remote, and dynamic forwarding values become -L, -R, and -D options">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <div class="generate-ssh-shell-stacked-grid">
              <div class="generate-ssh-shell-inline-grid generate-ssh-shell-inline-grid-three">
                <input
                  type="text"
                  id="generateSshShellLocalForward"
                  class="form-control generate-ssh-shell-custom-text-field"
                  placeholder="15432:db.internal:5432"
                >

                <input
                  type="text"
                  id="generateSshShellRemoteForward"
                  class="form-control generate-ssh-shell-custom-text-field"
                  placeholder="8080:localhost:80"
                >

                <input
                  type="text"
                  id="generateSshShellDynamicForward"
                  class="form-control generate-ssh-shell-custom-text-field"
                  placeholder="1080"
                >
              </div>

              <div class="generate-ssh-shell-flag-hint">Forwarding options are appended before the target. Review the final command before copying it into a terminal.</div>
            </div>
          </div>
        </div>

        <div class="generate-ssh-shell-setting-row generate-ssh-shell-setting-card generate-ssh-shell-custom-card">
          <label for="generateSshShellCustomTextarea" class="generate-ssh-shell-setting-label generate-ssh-shell-custom-label">
            Extra arguments:
            <span class="info-dot generate-ssh-shell-helper-chip" title="Optional OpenSSH arguments appended before the target">i</span>
          </label>

          <div class="generate-ssh-shell-setting-field">
            <textarea
              id="generateSshShellCustomTextarea"
              class="form-control generate-ssh-shell-custom-textarea"
              rows="3"
              placeholder="-L 15432:db.internal:5432"
            ></textarea>
            <div class="generate-ssh-shell-custom-info">One option group per line is easiest to review. Newlines are flattened into the final command preview.</div>
          </div>
        </div>
      </div>
    </details>
  </form>
  {# ns:end family._base.workspace.03_custom-settings #}

  {# ns:start family._base.workspace.05_result-summary #}
  {# ns:start family.shell.workspace.04_result-text #}
  <div class="generate-ssh-shell-result-panel" id="generateSshShellResultPanel" aria-label="Command output">
    <div class="tool-empty-state generate-ssh-shell-result-empty" id="generateSshShellResultEmpty">Generate an SSH command to inspect command text, option rows, warnings, and normalized JSON payload.</div>

    <div class="generate-ssh-shell-output-content generate-ssh-shell-result-content d-none" id="generateSshShellResultContent">
      <div class="generate-ssh-shell-output-inner generate-ssh-shell-result-shell">
  {# ns:end family.shell.workspace.04_result-text #}
  {# ns:end family._base.workspace.05_result-summary #}
        <div class="generate-ssh-shell-result-summary" id="generateSshShellResultSummary" data-share-snapshot-source data-share-kind="shell-summary"></div>
        {# ns:start family.shell.workspace.04_visual-contract #}
        {# ns:end family.shell.workspace.04_visual-contract #}

        {# ns:start family._base.workspace.06_output-toolbar #}
        <div class="generate-ssh-shell-toolbar-shell">
          <div class="generate-ssh-shell-toolbar tool-output-toolbar tool-result-toolbar">
            <div class="generate-ssh-shell-toolbar-main">
              <label for="generateSshShellSort" class="generate-ssh-shell-sort-label">Sort</label>
              <div class="generate-ssh-shell-sort-wrap">
                <details class="generate-ssh-shell-sort-select" id="generateSshShellSortSelect">
                  <summary class="generate-ssh-shell-sort-summary" aria-haspopup="listbox" aria-expanded="false" aria-controls="generateSshShellSortMenu">
                    <span id="generateSshShellSortSummary">ID</span>
                  </summary>

                  <div class="generate-ssh-shell-sort-menu" id="generateSshShellSortMenu" role="listbox">
                    <div class="generate-ssh-shell-sort-grid">
                      <button type="button" class="generate-ssh-shell-sort-option is-active" data-sort-value="id" aria-pressed="true" role="option">ID</button>
                      <button type="button" class="generate-ssh-shell-sort-option" data-sort-value="alphabetical" aria-pressed="false" role="option">A-Z</button>
                      <button type="button" class="generate-ssh-shell-sort-option" data-sort-value="field" aria-pressed="false" role="option">Field</button>
                      <button type="button" class="generate-ssh-shell-sort-option" data-sort-value="value" aria-pressed="false" role="option">Value</button>
                      <button type="button" class="generate-ssh-shell-sort-option" data-sort-value="length" aria-pressed="false" role="option">Length</button>
                    </div>
                  </div>
                </details>
                <input type="hidden" id="generateSshShellSort" value="id">
              </div>
            </div>

            <div class="tool-output-actions generate-ssh-shell-toolbar-actions tool-result-toolbar-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ssh-shell-action-btn tool-result-action-btn" id="generateSshShellExportPdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ssh-shell-action-btn tool-result-action-btn" id="generateSshShellDownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ssh-shell-action-btn tool-result-action-btn" id="generateSshShellCopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary generate-ssh-shell-action-btn tool-result-action-btn" id="generateSshShellDownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost generate-ssh-shell-action-btn tool-result-action-btn" id="generateSshShellImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
        </div>
        {# ns:end family._base.workspace.06_output-toolbar #}

        {# ns:start family._base.workspace.07_table-output #}
        <div class="generate-ssh-shell-tabs-shell">
          <div class="tool-tabs generate-ssh-shell-tabs" role="tablist" aria-label="SSH command output views">
            <button type="button" class="tool-tab-btn generate-ssh-shell-tab-btn active" id="generateSshShellOperationsTab" data-tab-target="generateSshShellOperationsPanel" role="tab" aria-controls="generateSshShellOperationsPanel" aria-selected="true" tabindex="0">
              <i class="bi bi-list-check" aria-hidden="true"></i>
              <span>Operations</span>
            </button>
            <button type="button" class="tool-tab-btn generate-ssh-shell-tab-btn" id="generateSshShellCommandTab" data-tab-target="generateSshShellCommandPanel" role="tab" aria-controls="generateSshShellCommandPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-terminal" aria-hidden="true"></i>
              <span>Command</span>
            </button>
            <button type="button" class="tool-tab-btn generate-ssh-shell-tab-btn" id="generateSshShellDetailsTab" data-tab-target="generateSshShellDetailsPanel" role="tab" aria-controls="generateSshShellDetailsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-card-text" aria-hidden="true"></i>
              <span>Details</span>
            </button>
            <button type="button" class="tool-tab-btn generate-ssh-shell-tab-btn" id="generateSshShellWarningsTab" data-tab-target="generateSshShellWarningsPanel" role="tab" aria-controls="generateSshShellWarningsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
              <span>Warnings</span>
            </button>
            <button type="button" class="tool-tab-btn generate-ssh-shell-tab-btn" id="generateSshShellJsonTab" data-tab-target="generateSshShellJsonPanel" role="tab" aria-controls="generateSshShellJsonPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-braces" aria-hidden="true"></i>
              <span>JSON</span>
            </button>
          </div>

          <div class="tool-tab-panel generate-ssh-shell-tab-panel active" id="generateSshShellOperationsPanel" data-tab-panel="generateSshShellOperationsPanel" role="tabpanel" aria-labelledby="generateSshShellOperationsTab">
            <div class="generate-ssh-shell-inventory-panel" aria-labelledby="generateSshShellOperationsTitle">
              <div class="generate-ssh-shell-table-card">
                <h3 class="generate-ssh-shell-result-section-title" id="generateSshShellOperationsTitle">Operation Summary</h3>
                <div class="generate-ssh-shell-table-wrap tool-result-table-wrap">
                  <table class="table generate-ssh-shell-table generate-ssh-shell-operations-table mb-0 tool-result-table tool-result-table--compact">
                    <thead>
                      <tr>
                        <th scope="col" class="tool-generated-rownum-head">#</th>
                        <th scope="col">Field</th>
