{# tool.html.twig #}

<div class="automate-afs-service-tool tool-box mb-4" data-tool-slug="automate-afs-service" data-tool-category="Shell">
  {# ns:start family._base.workspace.00_shell #}
  {# ns:start family._base.workspace.01_input-brief #}
  <form class="automate-afs-service-form" id="automateAfsServiceForm" aria-label="AFS service automation command builder">
    <div class="automate-afs-service-input-card">
      <div class="automate-afs-service-input-brief" data-input-layout="inline">
        <div class="automate-afs-service-main-row automate-afs-service-input-row">
          <div class="automate-afs-service-input-label-wrap">
            <label for="automateAfsServiceInput" class="automate-afs-service-main-label automate-afs-service-input-label">Script path:</label>
            <span class="automate-afs-service-helper-chip" title="Path to the service-afs.sh script that receives the generated action and mode" aria-label="Path to the service-afs.sh script that receives the generated action and mode">i</span>
          </div>

          <div class="automate-afs-service-main-input-grid automate-afs-service-input-stack">
            <input
              type="text"
              id="automateAfsServiceInput"
              class="form-control automate-afs-service-input-control"
              value="/Users/badrulamin/Dropbox/Project/IaS/service/service-afs/Workspace/service-afs/service-afs.sh"
              autocomplete="off"
            >
            <div class="automate-afs-service-input-error d-none" id="automateAfsServiceInputError" role="alert"></div>
          </div>
        </div>

        <div class="automate-afs-service-main-actions automate-afs-service-input-actions">
          <button
            type="submit"
            class="btn btn-primary automate-afs-service-submit-btn automate-afs-service-action-btn automate-afs-service-action-btn-primary"
            id="automateAfsServicePrimaryAction"
            data-tool-share-generate
          >
            <i class="bi bi-terminal" aria-hidden="true"></i>
            <span>Generate</span>
          </button>
          <button
            type="button"
            class="automate-afs-service-secondary-btn automate-afs-service-secondary-btn-ghost automate-afs-service-reset-btn automate-afs-service-action-btn automate-afs-service-action-btn-secondary"
            id="automateAfsServiceSecondaryAction"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="automate-afs-service-input-helper-card">
          <span class="automate-afs-service-input-hint">Compose commands for the existing IaS AFS service script. InfraStack generates the runbook command; it does not execute it.</span>
          <span class="automate-afs-service-helper-chip automate-afs-service-helper-chip-inline" title="The script currently skips setup.conf when IS_REMOTE=TRUE, so export variables are generated explicitly" aria-label="The script currently skips setup.conf when IS_REMOTE=TRUE, so export variables are generated explicitly">i</span>
        </div>
      </div>
    </div>
  {# ns:end family._base.workspace.01_input-brief #}

    {# ns:start family._base.workspace.02_basic-settings #}
    <div class="automate-afs-service-basic-panel">
      <div class="automate-afs-service-inner-panel automate-afs-service-basic-card">

        <div class="automate-afs-service-example-card">
          <span class="automate-afs-service-example-label">Example</span>
          <span class="automate-afs-service-example-value">env AFS_EXPORT_PATH='/exportfs/etc/sudoers' ... service-afs.sh -i test</span>
          <span class="automate-afs-service-example-helper">Keep <code>test</code> mode selected first to preview package, export, and service commands without changing the host.</span>
        </div>

        <div class="automate-afs-service-setting-row automate-afs-service-setting-card">
          <label class="automate-afs-service-setting-label">
            Service action:
            <span class="info-dot automate-afs-service-helper-chip" title="Maps to the service-afs.sh action flags -i, -c, -r, and -d">i</span>
          </label>

          <div class="automate-afs-service-setting-field">
            <div class="automate-afs-service-stacked-grid">
              <div class="automate-afs-service-inline-grid automate-afs-service-inline-grid-two">
                <div class="automate-afs-service-native-select-wrap">
                  <select id="automateAfsServiceBasicPrimary" class="form-select automate-afs-service-native-select" aria-label="Service action">
                    <option value="install" selected>Install (-i)</option>
                    <option value="check">Check (-c)</option>
                    <option value="remove">Remove (-r)</option>
                    <option value="delete">Delete (-d)</option>
                  </select>
                </div>

                <div class="automate-afs-service-native-select-wrap">
                  <select id="automateAfsServiceMode" class="form-select automate-afs-service-native-select" aria-label="Execution mode">
                    <option value="test" selected>Test preview</option>
                    <option value="default">Default root run</option>
                    <option value="sudo">Script sudo mode</option>
                  </select>
                </div>
              </div>

              <div class="automate-afs-service-inline-grid automate-afs-service-inline-grid-two">
                <input
                  type="text"
                  id="automateAfsServiceEnvironment"
                  class="form-control automate-afs-service-text-field"
                  value="lab"
                  autocomplete="off"
                  aria-label="Environment label"
                >

                <div class="automate-afs-service-native-select-wrap">
                  <select id="automateAfsServiceDebug" class="form-select automate-afs-service-native-select" aria-label="Debug level">
                    <option value="0">Debug 0 quiet</option>
                    <option value="1" selected>Debug 1 normal</option>
                    <option value="2">Debug 2 verbose</option>
                  </select>
                </div>
              </div>

              <div class="automate-afs-service-flag-hint">Action and mode are passed to <code>service-afs.sh</code>. Environment and debug are generated as shell-safe command inputs.</div>
            </div>
          </div>
        </div>

        <div class="automate-afs-service-setting-row automate-afs-service-setting-card">
          <label class="automate-afs-service-setting-label">
            Export target:
            <span class="info-dot automate-afs-service-helper-chip" title="NFS export path and client subnet used by the generated AFS command">i</span>
          </label>

          <div class="automate-afs-service-setting-field">
            <div class="automate-afs-service-inline-grid automate-afs-service-inline-grid-two">
              <input
                type="text"
                id="automateAfsServiceExportPath"
                class="form-control automate-afs-service-text-field"
                value="/exportfs/etc/sudoers"
                autocomplete="off"
                aria-label="AFS export path"
              >

              <input
                type="text"
                id="automateAfsServiceSubnet"
                class="form-control automate-afs-service-text-field"
                value="172.16.64.0/24"
                autocomplete="off"
                aria-label="AFS allowed subnet"
              >
            </div>
          </div>
        </div>

      </div>
    </div>
    {# ns:end family._base.workspace.02_basic-settings #}

    {# ns:start family._base.workspace.03_custom-settings #}
    <details class="automate-afs-service-advanced automate-afs-service-custom-settings" id="automateAfsServiceCustomSettings" data-custom-layout="compact_two_column_multi_row">
      <summary class="automate-afs-service-advanced-summary automate-afs-service-custom-summary">
        <span>Custom</span>
        <span class="automate-afs-service-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="automate-afs-service-advanced-body">
        <div class="automate-afs-service-setting-row automate-afs-service-setting-card">
          <label class="automate-afs-service-setting-label">
            Export file and options:
            <span class="info-dot automate-afs-service-helper-chip" title="Values generated as AFS_CONF_EXPORT and AFS_CONF_OPTIONS">i</span>
          </label>

          <div class="automate-afs-service-setting-field">
            <div class="automate-afs-service-inline-grid automate-afs-service-inline-grid-two">
              <input
                type="text"
                id="automateAfsServiceExportFile"
                class="form-control automate-afs-service-text-field"
                value="/etc/exports"
                autocomplete="off"
                aria-label="NFS exports file"
              >

              <input
                type="text"
                id="automateAfsServiceOptions"
                class="form-control automate-afs-service-text-field"
                value="rw,sync,no_subtree_check,no_root_squash"
                autocomplete="off"
                aria-label="NFS export options"
              >
            </div>

            <div class="automate-afs-service-flag-hint">Options are comma-separated and become the generated export line.</div>
          </div>
        </div>

        <div class="automate-afs-service-setting-row automate-afs-service-setting-card">
          <label class="automate-afs-service-setting-label">
            Delete guard:
            <span class="info-dot automate-afs-service-helper-chip" title="Live delete needs CONFIRM_DELETE=TRUE in the service script">i</span>
          </label>

          <div class="automate-afs-service-setting-field">
            <label class="automate-afs-service-toggle-item">
              <span class="automate-afs-service-toggle-copy">Add <code>CONFIRM_DELETE=TRUE</code> for delete action</span>
              <input type="checkbox" id="automateAfsServiceConfirmDelete">
            </label>
            <div class="automate-afs-service-flag-hint">Delete preview in <code>test</code> mode does not require confirmation. Live delete does.</div>
          </div>
        </div>
      </div>
    </details>
  </form>
  {# ns:end family._base.workspace.03_custom-settings #}

  {# ns:start family._base.workspace.05_result-summary #}
  {# ns:start family.shell.workspace.04_result-text #}
  {# ns:start family.shell.workspace.04_visual-contract #}
  <div class="automate-afs-service-result-panel" id="automateAfsServiceResultPanel" aria-label="AFS service command output">
    <div class="tool-empty-state automate-afs-service-result-empty" id="automateAfsServiceResultEmpty">Generate an AFS service command to inspect the command, operation preview, warnings, and normalized JSON payload.</div>

    <div class="automate-afs-service-output-content automate-afs-service-result-content d-none" id="automateAfsServiceResultContent">
      <div class="automate-afs-service-output-inner automate-afs-service-result-shell">
  {# ns:end family.shell.workspace.04_result-text #}
  {# ns:end family._base.workspace.05_result-summary #}
        <div class="automate-afs-service-result-summary" id="automateAfsServiceResultSummary" data-share-snapshot-source data-share-kind="shell-summary" aria-label="Result Summary"></div>

        {# ns:start family._base.workspace.06_output-toolbar #}
        <div class="automate-afs-service-toolbar-shell">
          <div class="automate-afs-service-toolbar tool-output-toolbar tool-result-toolbar">
            <div class="automate-afs-service-toolbar-main">
              <label for="automateAfsServiceSort" class="automate-afs-service-sort-label">Sort</label>
              <div class="automate-afs-service-sort-wrap">
                <details class="automate-afs-service-sort-select" id="automateAfsServiceSortSelect">
                  <summary class="automate-afs-service-sort-summary" aria-haspopup="listbox" aria-expanded="false" aria-controls="automateAfsServiceSortMenu">
                    <span id="automateAfsServiceSortSummary">ID</span>
                  </summary>

                  <div class="automate-afs-service-sort-menu" id="automateAfsServiceSortMenu" role="listbox">
                    <div class="automate-afs-service-sort-grid">
                      <button type="button" class="automate-afs-service-sort-option is-active" data-sort-value="id" aria-pressed="true" role="option">ID</button>
                      <button type="button" class="automate-afs-service-sort-option" data-sort-value="alphabetical" aria-pressed="false" role="option">A-Z</button>
                      <button type="button" class="automate-afs-service-sort-option" data-sort-value="field" aria-pressed="false" role="option">Field</button>
                      <button type="button" class="automate-afs-service-sort-option" data-sort-value="value" aria-pressed="false" role="option">Value</button>
                      <button type="button" class="automate-afs-service-sort-option" data-sort-value="length" aria-pressed="false" role="option">Length</button>
                    </div>
                  </div>
                </details>
                <input type="hidden" id="automateAfsServiceSort" value="id">
              </div>
            </div>

            <div class="tool-output-actions automate-afs-service-toolbar-actions tool-result-toolbar-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary automate-afs-service-action-btn tool-result-action-btn" id="automateAfsServiceExportPdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary automate-afs-service-action-btn tool-result-action-btn" id="automateAfsServiceDownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary automate-afs-service-action-btn tool-result-action-btn" id="automateAfsServiceCopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary automate-afs-service-action-btn tool-result-action-btn" id="automateAfsServiceDownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost automate-afs-service-action-btn tool-result-action-btn" id="automateAfsServiceImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
        </div>
        {# ns:end family._base.workspace.06_output-toolbar #}

        {# ns:start family._base.workspace.07_table-output #}
        <div class="automate-afs-service-tabs-shell">
          <div class="tool-tabs automate-afs-service-tabs" role="tablist" aria-label="AFS service output views">
            <button type="button" class="tool-tab-btn automate-afs-service-tab-btn active" id="automateAfsServiceOperationsTab" data-tab-target="automateAfsServiceOperationsPanel" role="tab" aria-controls="automateAfsServiceOperationsPanel" aria-selected="true" tabindex="0">
              <i class="bi bi-list-check" aria-hidden="true"></i>
              <span>Operations</span>
            </button>
            <button type="button" class="tool-tab-btn automate-afs-service-tab-btn" id="automateAfsServiceCommandTab" data-tab-target="automateAfsServiceCommandPanel" role="tab" aria-controls="automateAfsServiceCommandPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-terminal" aria-hidden="true"></i>
              <span>Command</span>
            </button>
            <button type="button" class="tool-tab-btn automate-afs-service-tab-btn" id="automateAfsServiceDetailsTab" data-tab-target="automateAfsServiceDetailsPanel" role="tab" aria-controls="automateAfsServiceDetailsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-hdd-network" aria-hidden="true"></i>
              <span>Details</span>
            </button>
            <button type="button" class="tool-tab-btn automate-afs-service-tab-btn" id="automateAfsServiceWarningsTab" data-tab-target="automateAfsServiceWarningsPanel" role="tab" aria-controls="automateAfsServiceWarningsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
              <span>Warnings</span>
            </button>
            <button type="button" class="tool-tab-btn automate-afs-service-tab-btn" id="automateAfsServiceJsonTab" data-tab-target="automateAfsServiceJsonPanel" role="tab" aria-controls="automateAfsServiceJsonPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-braces" aria-hidden="true"></i>
              <span>JSON</span>
            </button>
          </div>

          <div class="tool-tab-panel automate-afs-service-tab-panel active" id="automateAfsServiceOperationsPanel" data-tab-panel="automateAfsServiceOperationsPanel" role="tabpanel" aria-labelledby="automateAfsServiceOperationsTab">
            <div class="automate-afs-service-inventory-panel" aria-labelledby="automateAfsServiceOperationsTitle">
              <div class="automate-afs-service-table-card">
                <h3 class="automate-afs-service-result-section-title" id="automateAfsServiceOperationsTitle">Operation Summary</h3>
                <div class="automate-afs-service-table-wrap tool-result-table-wrap">
                  <table class="table automate-afs-service-table automate-afs-service-operations-table mb-0 tool-result-table tool-result-table--compact">
                    <thead>
                      <tr>
                        <th scope="col" class="tool-generated-rownum-head">#</th>
                        <th scope="col">Operation</th>
                        <th scope="col">Effect</th>
                        <th scope="col">Result</th>
                        <th scope="col" class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                      </tr>
                    </thead>
                    <tbody id="automateAfsServiceOperationsTableBody"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <div class="tool-tab-panel automate-afs-service-tab-panel" id="automateAfsServiceCommandPanel" data-tab-panel="automateAfsServiceCommandPanel" role="tabpanel" aria-labelledby="automateAfsServiceCommandTab" hidden>
            <div class="automate-afs-service-surface-stack tool-result-section-stack">
              <section class="automate-afs-service-section-card tool-result-section-card">
                <div class="automate-afs-service-section-head">
                  <h3 class="automate-afs-service-section-title tool-result-section-title">AFS Service Command</h3>
                  <div class="automate-afs-service-section-actions">
                    <button type="button" class="automate-afs-service-action-btn" id="automateAfsServiceCopyCommand" aria-label="Copy generated AFS service command" title="Copy generated AFS service command">
                      <i class="bi bi-clipboard" aria-hidden="true"></i>
                      <span class="automate-afs-service-command-copy-label tool-sr-only">Copy</span>
                    </button>
                  </div>
                </div>
                <pre class="automate-afs-service-code-pre"><code id="automateAfsServiceCommandOutput" data-share-snapshot-source data-share-kind="shell-command"></code></pre>
              </section>

              <section class="automate-afs-service-section-card tool-result-section-card">
                <h3 class="automate-afs-service-section-title tool-result-section-title">Export Line</h3>
                <pre class="automate-afs-service-code-pre"><code id="automateAfsServiceExportLineOutput"></code></pre>
              </section>
            </div>
          </div>

          <div class="tool-tab-panel automate-afs-service-tab-panel" id="automateAfsServiceDetailsPanel" data-tab-panel="automateAfsServiceDetailsPanel" role="tabpanel" aria-labelledby="automateAfsServiceDetailsTab" hidden>
            <section class="automate-afs-service-section-card tool-result-section-card">
              <h3 class="automate-afs-service-section-title tool-result-section-title">Environment Payload</h3>
              <div class="automate-afs-service-table-wrap tool-result-table-wrap">
                <table class="table automate-afs-service-table automate-afs-service-environment-table mb-0 tool-result-table tool-result-table--compact">
                  <thead>
                    <tr>
                      <th scope="col" class="tool-generated-rownum-head">#</th>
                      <th scope="col">Field</th>
                      <th scope="col">Value</th>
                      <th scope="col" class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                    </tr>
                  </thead>
                  <tbody id="automateAfsServiceEnvironmentTableBody"></tbody>
                </table>
              </div>
            </section>
          </div>

          <div class="tool-tab-panel automate-afs-service-tab-panel" id="automateAfsServiceWarningsPanel" data-tab-panel="automateAfsServiceWarningsPanel" data-share-snapshot-source data-share-kind="shell-warnings" role="tabpanel" aria-labelledby="automateAfsServiceWarningsTab" hidden>
            <div class="automate-afs-service-warning-grid">
              <div class="automate-afs-service-message-card">
                <h3 class="automate-afs-service-message-title">Warnings</h3>
                <ul class="automate-afs-service-message-list" id="automateAfsServiceWarningsList"></ul>
              </div>

              <div class="automate-afs-service-message-card">
                <h3 class="automate-afs-service-message-title">Errors</h3>
                <ul class="automate-afs-service-message-list" id="automateAfsServiceErrorsList"></ul>
              </div>
            </div>
          </div>

          <div class="tool-tab-panel automate-afs-service-tab-panel" id="automateAfsServiceJsonPanel" data-tab-panel="automateAfsServiceJsonPanel" role="tabpanel" aria-labelledby="automateAfsServiceJsonTab" hidden>
            {# ns:start family._base.workspace.08_json-restore #}
            <div class="automate-afs-service-json-restore-shell" id="automateAfsServiceJsonRestoreShell">
              <section class="automate-afs-service-json-card tool-json-panel" aria-label="Command JSON output and restore state">
                <div class="automate-afs-service-json-head tool-json-head">
                  <div class="automate-afs-service-json-title-wrap">
                    <span class="automate-afs-service-json-title tool-json-title">JSON Output</span>
                    <span class="automate-afs-service-json-helper">Exported command state includes action, mode, export values, generated command, warnings, and rows.</span>
                  </div>
                  <span class="automate-afs-service-json-status is-hidden" id="automateAfsServiceJsonRestoreStatus" role="status" aria-live="polite"></span>
                </div>
                <div class="automate-afs-service-json-empty is-hidden" id="automateAfsServiceJsonRestoreEmpty">Generate a command before exporting JSON.</div>
                <pre class="automate-afs-service-json-output tool-json-output"><code id="automateAfsServiceJsonOutput"></code></pre>
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="automate-afs-service-result-error d-none" id="automateAfsServiceResultError"></div>
    <input type="file" id="automateAfsServiceImportJson" class="automate-afs-service-import-input d-none" accept="application/json">
    {# ns:end family._base.workspace.08_json-restore #}
  </div>
  {# ns:end family._base.workspace.07_table-output #}
  {# ns:end family.shell.workspace.04_visual-contract #}
  {# ns:end family._base.workspace.00_shell #}
</div>
