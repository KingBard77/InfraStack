<div class="scan-header-security-tool" data-tool-slug="scan-header-security" data-tool-category="Security">
  <div class="tool-box mb-4">
    <section class="tool-shell scan-header-security-input-shell" id="scanHeaderSecurityInputShell" aria-label="Header review target">
      <div class="tool-shell-body">
        <form class="scan-header-security-form" id="scanHeaderSecurityForm">
          <div class="scan-header-security-input-card">
            <div class="scan-header-security-input-brief" data-input-layout="inline">
              <div class="scan-header-security-main-row scan-header-security-input-row">
                <div class="scan-header-security-input-label-wrap">
                  <label for="scanHeaderSecurityInput" class="scan-header-security-main-label scan-header-security-input-label">Header target:</label>
                  <span class="scan-header-security-helper-chip" title="Enter the public URL or route whose security headers you want to review" aria-label="Enter the public URL or route whose security headers you want to review">i</span>
                </div>

                <div class="scan-header-security-target-grid scan-header-security-main-input-grid scan-header-security-input-stack">
                  <input
                    type="text"
                    id="scanHeaderSecurityInput"
                    class="form-control scan-header-security-input-control scan-header-security-text-field"
                    placeholder="https://app.example.com/login"
                    value="https://app.example.com/login"
                  >
                  <div class="scan-header-security-input-error d-none" id="scanHeaderSecurityInputError" role="alert"></div>
                </div>
              </div>

              <div class="scan-header-security-main-actions scan-header-security-input-actions">
                <button
                  type="submit"
                  class="btn btn-primary scan-header-security-submit-btn scan-header-security-action-btn scan-header-security-action-btn-primary"
                  id="scanHeaderSecurityPrimaryAction"
                  data-tool-share-generate
                >
                  <i class="bi bi-search" aria-hidden="true"></i>
                  <span>Prepare Review</span>
                </button>
                <button
                  type="button"
                  class="scan-header-security-action-btn scan-header-security-action-btn-secondary"
                  id="scanHeaderSecuritySecondaryAction"
                >
                  <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                  <span>Reset</span>
                </button>
              </div>

              <div class="scan-header-security-input-helper-card">
                <span class="scan-header-security-input-hint">Build a browser-owned security-header review artifact. This workspace does not fetch the target or prove security.</span>
                <span class="scan-header-security-helper-chip scan-header-security-helper-chip-inline" title="The output is generated from local controls and optional pasted notes" aria-label="The output is generated from local controls and optional pasted notes">i</span>
              </div>
            </div>
          </div>

{# ns:start family._base.workspace.02_basic-settings #}
          <div class="scan-header-security-basic-panel">
            <div class="scan-header-security-inner-panel scan-header-security-basic-card">
              <div class="scan-header-security-example-card">
                <span class="scan-header-security-example-label">Example header review</span>
                <strong class="scan-header-security-example-value">Balanced browser headers, HEAD intent, redirects on</strong>
                <span class="scan-header-security-example-helper">Use Basic settings for the first-pass policy model, then open Custom for CSP, HSTS, cookies, and notes.</span>
              </div>

              <div class="scan-header-security-setting-row scan-header-security-setting-card">
                <label for="scanHeaderSecurityBasicPrimary" class="scan-header-security-setting-label">
                  Review baseline:
                  <span class="info-dot scan-header-security-helper-chip" title="Choose the security-header baseline used to generate local findings">i</span>
                </label>

                <div class="scan-header-security-setting-field">
                                    <div class="scan-header-security-native-select-wrap" id="scanHeaderSecurityBasicPrimarySelect">
                    <select id="scanHeaderSecurityBasicPrimary" class="form-select scan-header-security-native-select">
                      <option value="balanced" selected>Balanced browser security</option>
                      <option value="strict">Strict public web baseline</option>
                      <option value="api">API response baseline</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="scan-header-security-setting-row scan-header-security-setting-card">
                <label for="scanHeaderSecurityMethod" class="scan-header-security-setting-label">
                  Request method intent:
                  <span class="info-dot scan-header-security-helper-chip" title="Record whether the future observed evidence should use HEAD or GET">i</span>
                </label>

                <div class="scan-header-security-setting-field">
                                    <div class="scan-header-security-native-select-wrap" id="scanHeaderSecurityMethodSelect">
                    <select id="scanHeaderSecurityMethod" class="form-select scan-header-security-native-select">
                      <option value="HEAD" selected>HEAD</option>
                      <option value="GET">GET</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="scan-header-security-setting-row scan-header-security-setting-card">
                <label for="scanHeaderSecurityTimeout" class="scan-header-security-setting-label">
                  Timeout budget:
                  <span class="info-dot scan-header-security-helper-chip" title="Record the request timeout to use when observed evidence is gathered later">i</span>
                </label>

                <div class="scan-header-security-setting-field scan-header-security-timeout-wrap">
                  <input
                    type="number"
                    id="scanHeaderSecurityTimeout"
                    class="form-control scan-header-security-text-field"
                    value="12"
                    min="1"
                    max="30"
                    step="1"
                    placeholder="12"
                  >
                  <span class="scan-header-security-timeout-unit">s</span>
                </div>
              </div>

              <div class="scan-header-security-setting-row scan-header-security-setting-card">
                <label for="scanHeaderSecurityBasicText" class="scan-header-security-setting-label">
                  Target context:
                  <span class="info-dot scan-header-security-helper-chip" title="Name the app, route, API, or environment being reviewed">i</span>
                </label>

                <div class="scan-header-security-setting-field">
                  <input
                    type="text"
                    id="scanHeaderSecurityBasicText"
                    class="form-control scan-header-security-text-field"
                    value="Web application"
                    placeholder="Web application"
                  >
                </div>
              </div>

              <div class="scan-header-security-setting-row scan-header-security-setting-card">
                <label for="scanHeaderSecurityBasicToggle" class="scan-header-security-setting-label">
                  Follow redirects:
                  <span class="info-dot scan-header-security-helper-chip" title="Record whether final-destination headers should be reviewed">i</span>
                </label>

                <div class="scan-header-security-setting-field">
                  <label class="scan-header-security-custom-checkbox-option scan-header-security-switch-card">
                    <input type="checkbox" id="scanHeaderSecurityBasicToggle" checked>
                    <span>Enabled</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
          <details class="scan-header-security-custom-settings scan-header-security-advanced" id="scanHeaderSecurityCustomSettings" data-custom-layout="compact_one_column">
            <summary class="scan-header-security-custom-summary scan-header-security-advanced-summary">
              <span>Custom</span>
              <span class="scan-header-security-custom-arrow-slot" aria-hidden="true"></span>
            </summary>

            <div class="scan-header-security-advanced-body">
              <div class="scan-header-security-inner-panel">
                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityValidateTls" class="scan-header-security-setting-label">
                    TLS expectation:
                    <span class="info-dot scan-header-security-helper-chip" title="Keep enabled for normal public endpoint header review">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                    <label class="scan-header-security-custom-checkbox-option">
                      <input type="checkbox" id="scanHeaderSecurityValidateTls" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityFallbackGet" class="scan-header-security-setting-label">
                    GET fallback note:
                    <span class="info-dot scan-header-security-helper-chip" title="Keep this when a HEAD-only review may miss application-delivered headers">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                    <label class="scan-header-security-custom-checkbox-option">
                      <input type="checkbox" id="scanHeaderSecurityFallbackGet" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityUserAgent" class="scan-header-security-setting-label">
                    Client profile:
                    <span class="info-dot scan-header-security-helper-chip" title="Record the requester profile expected for later observed evidence">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                                        <div class="scan-header-security-native-select-wrap" id="scanHeaderSecurityUserAgentSelect">
                      <select id="scanHeaderSecurityUserAgent" class="form-select scan-header-security-native-select">
                        <option value="default" selected>Default client</option>
                        <option value="desktop">Desktop browser</option>
                        <option value="mobile">Mobile browser</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityCspMode" class="scan-header-security-setting-label">
                    CSP mode:
                    <span class="info-dot scan-header-security-helper-chip" title="Choose the Content Security Policy rollout mode for the review rows">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                                        <div class="scan-header-security-native-select-wrap" id="scanHeaderSecurityCspModeSelect">
                      <select id="scanHeaderSecurityCspMode" class="form-select scan-header-security-native-select">
                        <option value="enforced" selected>Enforced policy</option>
                        <option value="report-only">Report-only policy</option>
                        <option value="both">Enforce plus report-only</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityHstsMaxAge" class="scan-header-security-setting-label">
                    HSTS max-age:
                    <span class="info-dot scan-header-security-helper-chip" title="Expected Strict-Transport-Security max-age value in seconds">i</span>
                  </label>

                  <div class="scan-header-security-setting-field scan-header-security-timeout-wrap">
                    <input
                      type="number"
                      id="scanHeaderSecurityHstsMaxAge"
                      class="form-control scan-header-security-custom-number-field scan-header-security-text-field"
                      value="31536000"
                      min="0"
                      step="1"
                      placeholder="31536000"
                    >
                    <span class="scan-header-security-timeout-unit">s</span>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityCookieMode" class="scan-header-security-setting-label">
                    Cookie posture:
                    <span class="info-dot scan-header-security-helper-chip" title="Decide how Set-Cookie flags should appear in the review output">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                                        <div class="scan-header-security-native-select-wrap" id="scanHeaderSecurityCookieModeSelect">
                      <select id="scanHeaderSecurityCookieMode" class="form-select scan-header-security-native-select">
                        <option value="include" selected>Include cookie flags</option>
                        <option value="separate">Track separately</option>
                        <option value="skip">Skip for now</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityWellKnown" class="scan-header-security-setting-label">
                    Include evidence notes:
                    <span class="info-dot scan-header-security-helper-chip" title="Add security.txt, robots.txt, and review-evidence rows to the output model">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                    <label class="scan-header-security-custom-checkbox-option">
                      <input type="checkbox" id="scanHeaderSecurityWellKnown" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityHttpUpgrade" class="scan-header-security-setting-label">
                    Include upgrade notes:
                    <span class="info-dot scan-header-security-helper-chip" title="Add HTTP-to-HTTPS upgrade expectation rows to the review model">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                    <label class="scan-header-security-custom-checkbox-option">
                      <input type="checkbox" id="scanHeaderSecurityHttpUpgrade" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityHeaderList" class="scan-header-security-setting-label">
                    Headers to emphasize:
                    <span class="info-dot scan-header-security-helper-chip" title="Optional newline list of headers that should receive review rows">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                    <textarea
                      id="scanHeaderSecurityHeaderList"
                      class="form-control scan-header-security-custom-textarea"
                      rows="3"
                      placeholder="content-security-policy&#10;strict-transport-security&#10;permissions-policy"
                    ></textarea>
                  </div>
                </div>

                <div class="scan-header-security-setting-row scan-header-security-setting-card">
                  <label for="scanHeaderSecurityPolicyNotes" class="scan-header-security-setting-label">
                    Policy notes:
                    <span class="info-dot scan-header-security-helper-chip" title="Optional CSP, Referrer-Policy, Permissions-Policy, CORS, or rollout notes">i</span>
                  </label>

                  <div class="scan-header-security-setting-field">
                    <textarea
                      id="scanHeaderSecurityPolicyNotes"
                      class="form-control scan-header-security-custom-textarea"
                      rows="3"
                      placeholder="CSP: default-src 'self'&#10;Referrer-Policy: strict-origin-when-cross-origin"
                    ></textarea>
                  </div>
                </div>
              </div>
            </div>
          </details>
{# ns:end family._base.workspace.03_custom-settings #}
        </form>
      </div>
    </section>

    <div class="scan-header-security-result-panel" id="scanHeaderSecurityPanel" aria-label="Header review results">
          <div class="scan-header-security-result-empty" id="scanHeaderSecurityResultEmpty">Prepare a header review to inspect findings, evidence rows, surface notes, policy notes, and JSON restore data.</div>

          <div class="scan-header-security-result-content d-none" id="scanHeaderSecurityResultContent">
            <div class="scan-header-security-result-summary" id="scanHeaderSecurityResultSummary" aria-label="Result Summary" data-share-snapshot-source data-share-kind="scan-summary"></div>

{# ns:start family._base.workspace.06_output-toolbar #}
            <div class="scan-header-security-toolbar-shell">
              <div class="scan-header-security-toolbar tool-output-toolbar">
                <div class="scan-header-security-toolbar-left tool-result-toolbar-main">
                  <label for="scanHeaderSecuritySort" class="scan-header-security-sort-label">Sort</label>
                  <div class="scan-header-security-sort-wrap">
                    <details class="scan-header-security-sort-select" id="scanHeaderSecuritySortSelect">
                      <summary class="scan-header-security-sort-summary">
                        <span id="scanHeaderSecuritySortSummary">ID</span>
                      </summary>

                      <div class="scan-header-security-sort-menu">
                        <div class="scan-header-security-sort-grid">
                          <button type="button" class="scan-header-security-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                          <button type="button" class="scan-header-security-sort-option" data-sort-value="severity" aria-pressed="false">Severity</button>
                          <button type="button" class="scan-header-security-sort-option" data-sort-value="status" aria-pressed="false">Status</button>
                          <button type="button" class="scan-header-security-sort-option" data-sort-value="category" aria-pressed="false">Category</button>
                          <button type="button" class="scan-header-security-sort-option" data-sort-value="evidence" aria-pressed="false">Evidence</button>
                        </div>
                      </div>
                    </details>
                    <input type="hidden" id="scanHeaderSecuritySort" value="id">
                  </div>
                </div>

                <div class="scan-header-security-toolbar-actions tool-output-actions">
                  <button type="button" class="scan-header-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanHeaderSecurityExportPdf">
                    <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                    <span data-button-label>Export PDF</span>
                  </button>
                  <button type="button" class="scan-header-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanHeaderSecurityDownloadCsv">
                    <i class="bi bi-table" aria-hidden="true"></i>
                    <span data-button-label>Download CSV</span>
                  </button>
                  <button type="button" class="scan-header-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanHeaderSecurityCopyJson">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                    <span data-button-label>Copy JSON</span>
                  </button>
                  <button type="button" class="scan-header-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanHeaderSecurityDownloadJson">
                    <i class="bi bi-download" aria-hidden="true"></i>
                    <span data-button-label>Download JSON</span>
                  </button>
                  <button type="button" class="scan-header-security-action-btn tool-action-btn tool-action-btn-ghost" id="scanHeaderSecurityImportJsonButton">
                    <i class="bi bi-upload" aria-hidden="true"></i>
                    <span data-button-label>Import JSON</span>
                  </button>
                </div>
              </div>
            </div>
{# ns:end family._base.workspace.06_output-toolbar #}

            <div class="scan-header-security-tabs-shell">
              <div class="scan-header-security-tabs tool-tabs" role="tablist" aria-label="Security header output views">
                <button type="button" class="tool-tab-btn scan-header-security-tab-btn active" id="scanHeaderSecurityFindingsTab" data-tab-target="findings" role="tab" aria-controls="scanHeaderSecurityFindingsPanel" aria-selected="true" tabindex="0">
                  <i class="bi bi-list-check" aria-hidden="true"></i>
                  <span>Findings</span>
                </button>
                <button type="button" class="tool-tab-btn scan-header-security-tab-btn" id="scanHeaderSecurityHeadersTab" data-tab-target="headers" role="tab" aria-controls="scanHeaderSecurityHeadersPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-table" aria-hidden="true"></i>
                  <span>Evidence</span>
                </button>
                <button type="button" class="tool-tab-btn scan-header-security-tab-btn" id="scanHeaderSecurityTransportTab" data-tab-target="transport" role="tab" aria-controls="scanHeaderSecurityTransportPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-hdd-network" aria-hidden="true"></i>
                  <span>Surface</span>
                </button>
                <button type="button" class="tool-tab-btn scan-header-security-tab-btn" id="scanHeaderSecuritySurfaceTab" data-tab-target="surface" role="tab" aria-controls="scanHeaderSecuritySurfacePanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  <span>Notes</span>
                </button>
                <button type="button" class="tool-tab-btn scan-header-security-tab-btn" id="scanHeaderSecurityJsonTab" data-tab-target="json" role="tab" aria-controls="scanHeaderSecurityJsonPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-braces" aria-hidden="true"></i>
                  <span>JSON</span>
                </button>
              </div>
              <div class="scan-header-security-tab-panel" id="scanHeaderSecurityFindingsPanel" data-tab-panel="findings" role="tabpanel" aria-labelledby="scanHeaderSecurityFindingsTab">
                <div class="scan-header-security-section-card tool-result-section-card">
                  <h3 class="scan-header-security-section-title tool-result-section-title">Findings</h3>
                  <div class="table-responsive scan-header-security-table-wrap tool-result-table-wrap">
                    <table class="table scan-header-security-findings-table mb-0 tool-result-table" data-share-snapshot-source data-share-kind="severity-table">
                      <thead>
                        <tr>
                          <th class="tool-generated-rownum-head">#</th>
                          <th>Category</th>
                          <th>Control</th>
                          <th>Status</th>
                          <th>Evidence</th>
                          <th>Recommendation</th>
                          <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                        </tr>
                      </thead>
                      <tbody id="scanHeaderSecurityFindingTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div class="scan-header-security-tab-panel d-none" id="scanHeaderSecurityHeadersPanel" data-tab-panel="headers" role="tabpanel" aria-labelledby="scanHeaderSecurityHeadersTab" hidden>
                <div class="scan-header-security-section-card tool-result-section-card">
                  <h3 class="scan-header-security-section-title tool-result-section-title">Evidence Rows</h3>
                  <div class="table-responsive scan-header-security-table-wrap tool-result-table-wrap">
                    <table class="table scan-header-security-headers-table mb-0 tool-result-table">
                      <thead>
                        <tr>
                          <th class="tool-generated-rownum-head">#</th>
                          <th>Category</th>
                          <th>Header</th>
                          <th>Value</th>
                          <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                        </tr>
                      </thead>
                      <tbody id="scanHeaderSecurityHeaderTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div class="scan-header-security-tab-panel d-none" id="scanHeaderSecurityTransportPanel" data-tab-panel="transport" role="tabpanel" aria-labelledby="scanHeaderSecurityTransportTab" hidden>
                <section class="scan-header-security-section-card tool-result-section-card">
                    <h3 class="scan-header-security-section-title tool-result-section-title">Review Surface</h3>
                    <div class="table-responsive scan-header-security-table-wrap tool-result-table-wrap">
                      <table class="table scan-header-security-surface-table mb-0 tool-result-table tool-result-table--compact">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Field</th>
                            <th>Value</th>
                            <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                          </tr>
                        </thead>
                        <tbody id="scanHeaderSecurityTransportTableBody"></tbody>
                      </table>
                    </div>
                  </section>
              </div>

              <div class="scan-header-security-tab-panel d-none" id="scanHeaderSecuritySurfacePanel" data-tab-panel="surface" role="tabpanel" aria-labelledby="scanHeaderSecuritySurfaceTab" hidden>
                <div class="scan-header-security-surface-stack tool-result-section-stack">

                  <section class="scan-header-security-section-card tool-result-section-card">
                    <h3 class="scan-header-security-section-title tool-result-section-title">Policy Notes</h3>
                    <div class="table-responsive scan-header-security-table-wrap tool-result-table-wrap">
                      <table class="table scan-header-security-surface-table scan-header-security-known-files-table mb-0 tool-result-table tool-result-table--compact">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Topic</th>
                            <th>Status</th>
                            <th>Note</th>
                            <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                          </tr>
                        </thead>
                        <tbody id="scanHeaderSecurityKnownFileTableBody"></tbody>
                      </table>
                    </div>
                  </section>

                  <section class="scan-header-security-section-card tool-result-section-card">
                    <h3 class="scan-header-security-section-title tool-result-section-title">Cookie Review</h3>
