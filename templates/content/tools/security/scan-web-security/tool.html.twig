<div class="scan-web-security-tool" data-tool-slug="scan-web-security" data-tool-category="Security">
  <div class="tool-box mb-4">
    <section class="tool-shell scan-web-security-input-shell" id="scanWebSecurityInputShell" aria-label="Scan target">
      <div class="tool-shell-body">
        <form class="scan-web-security-form" id="scanWebSecurityForm">
          <div class="scan-web-security-input-card">
            <div class="scan-web-security-input-brief" data-input-layout="inline">
              <div class="scan-web-security-main-row scan-web-security-input-row">
                <div class="scan-web-security-input-label-wrap">
                  <label for="scanWebSecurityUrl" class="scan-web-security-main-label scan-web-security-input-label">URL target:</label>
                  <span class="scan-web-security-helper-chip" title="Enter the public URL you want to review for visible security posture signals" aria-label="Enter the public URL you want to review for visible security posture signals">i</span>
                </div>

                <div class="scan-web-security-target-grid scan-web-security-main-input-grid scan-web-security-input-stack">
                  <input
                    type="text"
                    id="scanWebSecurityUrl"
                    class="form-control scan-web-security-input-control scan-web-security-text-field"
                    placeholder="https://example.com"
                    value="https://example.com"
                  >
                  <div class="scan-web-security-input-error d-none" id="scanWebSecurityInputError" role="alert"></div>
                </div>
              </div>

              <div class="scan-web-security-main-actions scan-web-security-input-actions">
                <button
                  type="submit"
                  class="btn btn-primary scan-web-security-submit-btn scan-web-security-action-btn scan-web-security-action-btn-primary"
                  id="scanWebSecuritySubmit"
                  data-tool-share-generate
                >
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  <span>Scan</span>
                </button>
              </div>

              <div class="scan-web-security-input-helper-card">
                <span class="scan-web-security-input-hint">Use a valid target and review evidence before treating scan output as actionable.</span>
                <span class="scan-web-security-helper-chip scan-web-security-helper-chip-inline" title="Enter the public URL you want to review for visible security posture signals" aria-label="Enter the public URL you want to review for visible security posture signals">i</span>
              </div>
            </div>
          </div>

{# ns:start family._base.workspace.02_basic-settings #}
          <div class="scan-web-security-basic-panel">
            <div class="scan-web-security-inner-panel scan-web-security-basic-card">
              <div class="scan-web-security-example-card">
                <span class="scan-web-security-example-label">Example scan settings</span>
                <strong class="scan-web-security-example-value">HEAD method, redirects on, 12 second timeout</strong>
                <span class="scan-web-security-example-helper">Keep the request path short before opening deeper probe behavior.</span>
              </div>

              <div class="scan-web-security-setting-row scan-web-security-setting-card">
                <label for="scanWebSecurityMethod" class="scan-web-security-setting-label">
                  Method preference:
                  <span class="info-dot scan-web-security-helper-chip" title="Use HEAD for lightweight checks or GET when the server behaves differently for normal content delivery">i</span>
                </label>

                <div class="scan-web-security-setting-field">
                  <details class="scan-web-security-custom-dropdown" data-custom-dropdown-for="scanWebSecurityMethod">
                    <summary class="scan-web-security-custom-dropdown-summary">
                      <span data-custom-dropdown-label>HEAD</span>
                      <span class="scan-web-security-custom-arrow-slot" aria-hidden="true"></span>
                    </summary>

                    <div class="scan-web-security-custom-dropdown-menu" role="listbox" aria-label="Custom option">
                      <button
                        type="button"
                        class="scan-web-security-custom-dropdown-option active"
                        data-custom-dropdown-value="HEAD"
                        role="option"
                        aria-selected="true"
                      >HEAD</button>

                      <button
                        type="button"
                        class="scan-web-security-custom-dropdown-option"
                        data-custom-dropdown-value="GET"
                        role="option"
                        aria-selected="false"
                      >GET</button>
                    </div>
                  </details>
                  <input type="hidden" id="scanWebSecurityMethod" value="HEAD">
                </div>
              </div>

              <div class="scan-web-security-setting-row scan-web-security-setting-card">
                <label for="scanWebSecurityTimeout" class="scan-web-security-setting-label">
                  Timeout (seconds):
                  <span class="info-dot scan-web-security-helper-chip" title="Maximum wait time for the primary scan and companion probes">i</span>
                </label>

                <div class="scan-web-security-setting-field scan-web-security-timeout-wrap">
                  <input
                    type="number"
                    id="scanWebSecurityTimeout"
                    class="form-control scan-web-security-text-field"
                    value="12"
                    min="1"
                    max="30"
                    step="1"
                    placeholder="12"
                  >
                  <span class="scan-web-security-timeout-unit">s</span>
                </div>
              </div>

              <div class="scan-web-security-setting-row scan-web-security-setting-card">
                <label for="scanWebSecurityFollowRedirects" class="scan-web-security-setting-label">
                  Follow redirects:
                  <span class="info-dot scan-web-security-helper-chip" title="Keep enabled to inspect the final destination reached by the target">i</span>
                </label>

                <div class="scan-web-security-setting-field">
                  <label class="scan-web-security-custom-checkbox-option">
                    <input type="checkbox" id="scanWebSecurityFollowRedirects" checked>
                    <span>Enabled</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
          <details class="scan-web-security-advanced" data-custom-layout="compact_one_column">
            <summary class="scan-web-security-advanced-summary">
              <span>Custom</span>
              <span class="scan-web-security-custom-arrow-slot" aria-hidden="true"></span>
            </summary>

            <div class="scan-web-security-advanced-body">
              <div class="scan-web-security-inner-panel">
                <div class="scan-web-security-setting-row scan-web-security-setting-card">
                  <label for="scanWebSecurityValidateTls" class="scan-web-security-setting-label">
                    Validate TLS certificate:
                    <span class="info-dot scan-web-security-helper-chip" title="Keep enabled unless you are intentionally reviewing an invalid or staging certificate">i</span>
                  </label>

                  <div class="scan-web-security-setting-field">
                    <label class="scan-web-security-custom-checkbox-option">
                      <input type="checkbox" id="scanWebSecurityValidateTls" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-web-security-setting-row scan-web-security-setting-card">
                  <label for="scanWebSecurityFallbackGet" class="scan-web-security-setting-label">
                    Fallback GET on 405:
                    <span class="info-dot scan-web-security-helper-chip" title="Retry the target with GET when HEAD is rejected by the server">i</span>
                  </label>

                  <div class="scan-web-security-setting-field">
                    <label class="scan-web-security-custom-checkbox-option">
                      <input type="checkbox" id="scanWebSecurityFallbackGet" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-web-security-setting-row scan-web-security-setting-card">
                  <label for="scanWebSecurityUserAgent" class="scan-web-security-setting-label">
                    User-Agent profile:
                    <span class="info-dot scan-web-security-helper-chip" title="Use a different client profile when response behavior depends on the requester">i</span>
                  </label>

                  <div class="scan-web-security-setting-field">
                    <details class="scan-web-security-custom-dropdown" data-custom-dropdown-for="scanWebSecurityUserAgent">
                      <summary class="scan-web-security-custom-dropdown-summary">
                        <span data-custom-dropdown-label>Default client</span>
                        <span class="scan-web-security-custom-arrow-slot" aria-hidden="true"></span>
                      </summary>

                      <div class="scan-web-security-custom-dropdown-menu" role="listbox" aria-label="Custom option">
                        <button
                          type="button"
                          class="scan-web-security-custom-dropdown-option active"
                          data-custom-dropdown-value="default"
                          role="option"
                          aria-selected="true"
                        >Default client</button>

                        <button
                          type="button"
                          class="scan-web-security-custom-dropdown-option"
                          data-custom-dropdown-value="desktop"
                          role="option"
                          aria-selected="false"
                        >Desktop browser</button>

                        <button
                          type="button"
                          class="scan-web-security-custom-dropdown-option"
                          data-custom-dropdown-value="mobile"
                          role="option"
                          aria-selected="false"
                        >Mobile browser</button>
                      </div>
                    </details>
                    <input type="hidden" id="scanWebSecurityUserAgent" value="default">
                  </div>
                </div>

                <div class="scan-web-security-setting-row scan-web-security-setting-card">
                  <label for="scanWebSecurityWellKnown" class="scan-web-security-setting-label">
                    Check well-known files:
                    <span class="info-dot scan-web-security-helper-chip" title="Probe for standard public files such as security.txt and robots.txt">i</span>
                  </label>

                  <div class="scan-web-security-setting-field">
                    <label class="scan-web-security-custom-checkbox-option">
                      <input type="checkbox" id="scanWebSecurityWellKnown" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="scan-web-security-setting-row scan-web-security-setting-card">
                  <label for="scanWebSecurityHttpUpgrade" class="scan-web-security-setting-label">
                    Probe HTTP upgrade path:
                    <span class="info-dot scan-web-security-helper-chip" title="Test whether the HTTP version of the target upgrades to HTTPS">i</span>
                  </label>

                  <div class="scan-web-security-setting-field">
                    <label class="scan-web-security-custom-checkbox-option">
                      <input type="checkbox" id="scanWebSecurityHttpUpgrade" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </details>
{# ns:end family._base.workspace.03_custom-settings #}
        </form>
      </div>
    </section>

    <div class="scan-web-security-result-panel" id="scanWebSecurityPanel" aria-label="Scan results">
          <div class="scan-web-security-result-empty" id="scanWebSecurityResultEmpty">Run a web security scan to review visible hardening gaps, response headers, cookies, and well-known security files.</div>

          <div class="scan-web-security-result-content d-none" id="scanWebSecurityResultContent">
            <div class="scan-web-security-result-summary" id="scanWebSecurityResultSummary" data-share-snapshot-source data-share-kind="scan-summary"></div>

{# ns:start family._base.workspace.06_output-toolbar #}
            <div class="scan-web-security-toolbar-shell">
              <div class="scan-web-security-toolbar tool-output-toolbar">
                <div class="scan-web-security-toolbar-left tool-result-toolbar-main">
                  <label for="scanWebSecuritySort" class="scan-web-security-sort-label">Sort</label>
                  <div class="scan-web-security-sort-wrap">
                    <details class="scan-web-security-sort-select" id="scanWebSecuritySortSelect">
                      <summary class="scan-web-security-sort-summary">
                        <span id="scanWebSecuritySortSummary">ID</span>
                      </summary>

                      <div class="scan-web-security-sort-menu">
                        <div class="scan-web-security-sort-grid">
                          <button type="button" class="scan-web-security-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                          <button type="button" class="scan-web-security-sort-option" data-sort-value="severity" aria-pressed="false">Severity</button>
                          <button type="button" class="scan-web-security-sort-option" data-sort-value="status" aria-pressed="false">Status</button>
                          <button type="button" class="scan-web-security-sort-option" data-sort-value="category" aria-pressed="false">Category</button>
                          <button type="button" class="scan-web-security-sort-option" data-sort-value="evidence" aria-pressed="false">Evidence</button>
                        </div>
                      </div>
                    </details>
                    <input type="hidden" id="scanWebSecuritySort" value="id">
                  </div>
                </div>

                <div class="scan-web-security-toolbar-actions tool-output-actions">
                  <button type="button" class="scan-web-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanWebSecurityExportPdf">
                    <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                    <span data-button-label>Export PDF</span>
                  </button>
                  <button type="button" class="scan-web-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanWebSecurityDownloadCsv">
                    <i class="bi bi-table" aria-hidden="true"></i>
                    <span data-button-label>Download CSV</span>
                  </button>
                  <button type="button" class="scan-web-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanWebSecurityCopyJson">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                    <span data-button-label>Copy JSON</span>
                  </button>
                  <button type="button" class="scan-web-security-action-btn tool-action-btn tool-action-btn-secondary" id="scanWebSecurityDownloadJson">
                    <i class="bi bi-download" aria-hidden="true"></i>
                    <span data-button-label>Download JSON</span>
                  </button>
                  <button type="button" class="scan-web-security-action-btn tool-action-btn tool-action-btn-ghost" id="scanWebSecurityImportJsonButton">
                    <i class="bi bi-upload" aria-hidden="true"></i>
                    <span data-button-label>Import JSON</span>
                  </button>
                </div>
              </div>
            </div>
{# ns:end family._base.workspace.06_output-toolbar #}

            <div class="scan-web-security-tabs-shell">
              <div class="scan-web-security-tabs tool-tabs" role="tablist" aria-label="Web security output views">
                <button type="button" class="tool-tab-btn scan-web-security-tab-btn active" id="scanWebSecurityFindingsTab" data-tab-target="findings" role="tab" aria-controls="scanWebSecurityFindingsPanel" aria-selected="true" tabindex="0">
                  <i class="bi bi-list-check" aria-hidden="true"></i>
                  <span>Findings</span>
                </button>
                <button type="button" class="tool-tab-btn scan-web-security-tab-btn" id="scanWebSecurityHeadersTab" data-tab-target="headers" role="tab" aria-controls="scanWebSecurityHeadersPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-table" aria-hidden="true"></i>
                  <span>Header Matrix</span>
                </button>
                <button type="button" class="tool-tab-btn scan-web-security-tab-btn" id="scanWebSecurityTransportTab" data-tab-target="transport" role="tab" aria-controls="scanWebSecurityTransportPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-hdd-network" aria-hidden="true"></i>
                  <span>Transport</span>
                </button>
                <button type="button" class="tool-tab-btn scan-web-security-tab-btn" id="scanWebSecuritySurfaceTab" data-tab-target="surface" role="tab" aria-controls="scanWebSecuritySurfacePanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  <span>Files &amp; Cookies</span>
                </button>
                <button type="button" class="tool-tab-btn scan-web-security-tab-btn" id="scanWebSecurityJsonTab" data-tab-target="json" role="tab" aria-controls="scanWebSecurityJsonPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-braces" aria-hidden="true"></i>
                  <span>JSON</span>
                </button>
              </div>
              <div class="scan-web-security-tab-panel" id="scanWebSecurityFindingsPanel" data-tab-panel="findings" role="tabpanel" aria-labelledby="scanWebSecurityFindingsTab">
                <div class="scan-web-security-section-card tool-result-section-card">
                  <h3 class="scan-web-security-section-title tool-result-section-title">Findings</h3>
                  <div class="table-responsive scan-web-security-table-wrap tool-result-table-wrap">
                    <table class="table scan-web-security-findings-table mb-0 tool-result-table" data-share-snapshot-source data-share-kind="severity-table">
                      <thead>
                        <tr>
                          <th class="tool-generated-rownum-head">#</th>
                          <th>Category</th>
                          <th>Control</th>
                          <th>Status</th>
                          <th>Evidence</th>
                          <th>Recommendation</th>
                          <th>Copy</th>
                        </tr>
                      </thead>
                      <tbody id="scanWebSecurityFindingTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div class="scan-web-security-tab-panel d-none" id="scanWebSecurityHeadersPanel" data-tab-panel="headers" role="tabpanel" aria-labelledby="scanWebSecurityHeadersTab" hidden>
                <div class="scan-web-security-section-card tool-result-section-card">
                  <h3 class="scan-web-security-section-title tool-result-section-title">Header Matrix</h3>
                  <div class="table-responsive scan-web-security-table-wrap tool-result-table-wrap">
                    <table class="table scan-web-security-headers-table mb-0 tool-result-table">
                      <thead>
                        <tr>
                          <th class="tool-generated-rownum-head">#</th>
                          <th>Category</th>
                          <th>Header</th>
                          <th>Value</th>
                          <th>Copy</th>
                        </tr>
                      </thead>
                      <tbody id="scanWebSecurityHeaderTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div class="scan-web-security-tab-panel d-none" id="scanWebSecurityTransportPanel" data-tab-panel="transport" role="tabpanel" aria-labelledby="scanWebSecurityTransportTab" hidden>
                <section class="scan-web-security-section-card tool-result-section-card">
                    <h3 class="scan-web-security-section-title tool-result-section-title">Transport Summary</h3>
                    <div class="table-responsive scan-web-security-table-wrap tool-result-table-wrap">
                      <table class="table scan-web-security-surface-table mb-0 tool-result-table tool-result-table--compact">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Field</th>
                            <th>Value</th>
                            <th>Copy</th>
                          </tr>
                        </thead>
                        <tbody id="scanWebSecurityTransportTableBody"></tbody>
                      </table>
                    </div>
                  </section>
              </div>

              <div class="scan-web-security-tab-panel d-none" id="scanWebSecuritySurfacePanel" data-tab-panel="surface" role="tabpanel" aria-labelledby="scanWebSecuritySurfaceTab" hidden>
                <div class="scan-web-security-surface-stack tool-result-section-stack">

                  <section class="scan-web-security-section-card tool-result-section-card">
                    <h3 class="scan-web-security-section-title tool-result-section-title">Well-Known Files</h3>
                    <div class="table-responsive scan-web-security-table-wrap tool-result-table-wrap">
                      <table class="table scan-web-security-surface-table scan-web-security-known-files-table mb-0 tool-result-table tool-result-table--compact">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Path</th>
                            <th>Status</th>
                            <th>Note</th>
                            <th>Copy</th>
                          </tr>
                        </thead>
                        <tbody id="scanWebSecurityKnownFileTableBody"></tbody>
                      </table>
                    </div>
                  </section>

                  <section class="scan-web-security-section-card tool-result-section-card">
                    <h3 class="scan-web-security-section-title tool-result-section-title">Cookies</h3>
                    <div class="table-responsive scan-web-security-table-wrap tool-result-table-wrap">
                      <table class="table scan-web-security-cookies-table mb-0 tool-result-table">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Name</th>
                            <th>Secure</th>
                            <th>HttpOnly</th>
                            <th>SameSite</th>
                            <th>Issues</th>
                            <th>Copy</th>
                          </tr>
                        </thead>
                        <tbody id="scanWebSecurityCookieTableBody"></tbody>
                      </table>
                    </div>
                  </section>
                </div>
              </div>

              <div class="scan-web-security-tab-panel d-none" id="scanWebSecurityJsonPanel" data-tab-panel="json" role="tabpanel" aria-labelledby="scanWebSecurityJsonTab" hidden>
                              <div class="scan-web-security-json-restore-shell" id="scanWebSecurityJsonRestoreShell">
                <section class="scan-web-security-json-card tool-json-panel" aria-label="Scanner JSON evidence and restore state">
                  <div class="scan-web-security-json-head tool-json-head">
                    <div class="scan-web-security-json-title-wrap">
                      <span class="scan-web-security-json-title tool-json-title">JSON Output</span>
                      <span class="scan-web-security-json-helper">Exported scan state should include target, options, evidence, findings, and generated output.</span>
                    </div>
                    <span class="scan-web-security-json-status is-hidden" id="scanWebSecurityJsonRestoreStatus" role="status" aria-live="polite"></span>
                  </div>
                  <div class="scan-web-security-json-empty is-hidden" id="scanWebSecurityJsonRestoreEmpty">Run a scan before exporting JSON.</div>
                  <pre class="scan-web-security-json-output tool-json-output"><code id="scanWebSecurityJsonOutput"></code></pre>
                </section>
              </div>
            </div>
          </div>

          <div class="scan-web-security-result-error d-none" id="scanWebSecurityResultError"></div>
    </div>
    <input type="file" id="scanWebSecurityImportJson" class="scan-web-security-import-input d-none" accept="application/json">
  </div>
</div>
</div>
