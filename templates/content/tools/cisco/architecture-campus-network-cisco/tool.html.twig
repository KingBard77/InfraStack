{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}

<div class="architecture-campus-network-cisco-tool" data-tool-slug="architecture-campus-network-cisco" data-tool-category="cisco" data-tool-family="architecture" data-tool-canonical="architecture_campus_network_cisco">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <section class="tool-shell tool-prompt-shell architecture-campus-network-cisco-prompt-shell architecture-campus-network-cisco-input-card" id="architectureCampusNetworkCiscoPromptShell" data-section="architecture-prompt" data-root-selector=".architecture-campus-network-cisco-tool" aria-label="Cisco campus architecture prompt">
      <div class="architecture-campus-network-cisco-input-brief" data-input-layout="stacked">
        <div class="architecture-campus-network-cisco-input-row">
          <div class="architecture-campus-network-cisco-input-label-wrap">
            <label for="architectureCampusNetworkCiscoPrompt" class="tool-main-label architecture-campus-network-cisco-input-label">Architecture prompt</label>
            <span class="architecture-campus-network-cisco-helper-chip" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
          </div>
          <div class="tool-main-input-grid architecture-campus-network-cisco-main-input-grid architecture-campus-network-cisco-input-stack">
            <textarea
              id="architectureCampusNetworkCiscoPrompt"
              class="form-control architecture-campus-network-cisco-prompt architecture-campus-network-cisco-input-control"
              rows="7"
              placeholder="Describe the Cisco campus size, access blocks, VLANs, routing, wireless, firewall, WAN edge, services, and redundancy."
            >Create a medium Cisco campus topology with 3 access blocks. Use VLAN 10 Staff, VLAN 20 Voice, VLAN 30 Guest, VLAN 40 Servers. Add wireless controller, WAN edge, Cisco Secure Firewall, ACL policy boundary, NAT at the edge, DHCP, DNS, monitoring, HSRP, EtherChannel trunks, and OSPF routing.</textarea>
            <div class="architecture-campus-network-cisco-input-error d-none" id="architectureCampusNetworkCiscoInputError" role="alert"></div>
          </div>
        </div>

        <div class="architecture-campus-network-cisco-main-actions architecture-campus-network-cisco-input-actions">
          <button
            type="button"
            class="tool-action-btn tool-action-btn-primary architecture-campus-network-cisco-action-btn architecture-campus-network-cisco-action-btn-primary"
            id="architectureCampusNetworkCiscoGenerate"
          >
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span data-button-label>Generate Topology</span>
          </button>
          <button
            type="button"
            class="tool-action-btn tool-action-btn-secondary architecture-campus-network-cisco-action-btn architecture-campus-network-cisco-action-btn-secondary"
            id="architectureCampusNetworkCiscoReset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span data-button-label>Load Default</span>
          </button>
        </div>

        <div class="architecture-campus-network-cisco-input-helper-card">
          <span class="architecture-campus-network-cisco-input-hint">Use one brief prompt with campus size, access blocks, VLANs, routing mode, wireless, security edge, WAN, services, and redundancy. Preset selection or Generate Topology creates the editable workspace.</span>
          <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-helper-chip-inline" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
        </div>
      </div>
    </section>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="architectureCampusNetworkCiscoErrorState" hidden></div>

    <section class="tool-shell tool-inspector-shell" id="architectureCampusNetworkCiscoConfigShell" aria-label="Configuration">

      <div class="tool-shell-body">
        {# ns:start family._base.workspace.02_basic-settings #}
        <div class="tool-inspector-section architecture-campus-network-cisco-basic-section architecture-campus-network-cisco-basic-card" id="architectureCampusNetworkCiscoBasicConfig" data-section="basic-tab" data-root-selector=".architecture-campus-network-cisco-tool">

          <div class="architecture-campus-network-cisco-example-card">
            <span class="architecture-campus-network-cisco-example-label">Example architecture settings</span>
            <strong class="architecture-campus-network-cisco-example-value">Enterprise campus, medium, 3 access blocks</strong>
            <span class="architecture-campus-network-cisco-example-helper">Region, zone count, and preset should change the generated model and exported JSON.</span>
          </div>

          <div class="architecture-campus-network-cisco-basic-grid">
            <div class="architecture-campus-network-cisco-control-stack architecture-campus-network-cisco-setting-card">
              <label class="tool-control-label architecture-campus-network-cisco-setting-label" for="architectureCampusNetworkCiscoPreset">Preset <span class="architecture-campus-network-cisco-helper-chip" title="Choose a starting preset that updates the visible controls and generated output." aria-label="Choose a starting preset that updates the visible controls and generated output.">i</span></label>
              <select id="architectureCampusNetworkCiscoPreset" class="form-select architecture-campus-network-cisco-native-select">
                <option value="enterprise-campus" selected>Enterprise Campus</option>
                <option value="branch-campus">Branch Campus</option>
                <option value="wireless-campus">Wireless Campus</option>
                <option value="data-center-edge">Data Center Edge</option>
              </select>
            </div>

            <div class="architecture-campus-network-cisco-control-stack architecture-campus-network-cisco-setting-card">
              <label class="tool-control-label architecture-campus-network-cisco-setting-label" for="architectureCampusNetworkCiscoSize">Campus size <span class="architecture-campus-network-cisco-helper-chip" title="Choose the campus scale used by access, distribution, and core assumptions." aria-label="Choose the campus scale used by access, distribution, and core assumptions.">i</span></label>
              <select id="architectureCampusNetworkCiscoSize" class="form-select architecture-campus-network-cisco-native-select">
                <option value="small">Small</option>
                <option value="medium" selected>Medium</option>
                <option value="large">Large</option>
              </select>
            </div>

            <div class="architecture-campus-network-cisco-control-stack architecture-campus-network-cisco-setting-card">
              <label class="tool-control-label architecture-campus-network-cisco-setting-label" for="architectureCampusNetworkCiscoAccessBlocks">Access blocks <span class="architecture-campus-network-cisco-helper-chip" title="Choose the access block count used by the layout assumptions." aria-label="Choose the access block count used by the layout assumptions.">i</span></label>
              <select id="architectureCampusNetworkCiscoAccessBlocks" class="form-select architecture-campus-network-cisco-native-select">
                <option value="1">1 block</option>
                <option value="2">2 blocks</option>
                <option value="3" selected>3 blocks</option>
                <option value="4">4 blocks</option>
                <option value="5">5 blocks</option>
                <option value="6">6 blocks</option>
              </select>
            </div>
            <p class="tool-control-hint architecture-campus-network-cisco-setting-hint" id="architectureCampusNetworkCiscoPresetDescription">Redundant core, dual distribution, access blocks, OSPF, HSRP, services, wireless, and edge security.</p>
          </div>
        </div>
        {# ns:end family._base.workspace.02_basic-settings #}

        {# ns:start family._base.workspace.03_custom-settings #}
        <details class="architecture-campus-network-cisco-custom-panel" data-custom-layout="tabbed_two_column" id="architectureCampusNetworkCiscoCustomControls" data-section="custom-tab" data-root-selector=".architecture-campus-network-cisco-tool">
          <summary class="architecture-campus-network-cisco-custom-panel-summary">
            <span>Custom</span>
              <span class="architecture-campus-network-cisco-custom-arrow-slot" aria-hidden="true"></span>
          </summary>

          <div class="architecture-campus-network-cisco-custom-panel-body">
            <div class="architecture-campus-network-cisco-config-tabs" role="tablist" aria-label="Cisco campus custom configuration">
              <button type="button" class="architecture-campus-network-cisco-config-tab active" id="architectureCampusNetworkCiscoNetworkTab" data-config-tab-target="architectureCampusNetworkCiscoNetworkPanel" role="tab" aria-controls="architectureCampusNetworkCiscoNetworkPanel" aria-selected="true" tabindex="0">Network</button>
              <button type="button" class="architecture-campus-network-cisco-config-tab" id="architectureCampusNetworkCiscoServicesTab" data-config-tab-target="architectureCampusNetworkCiscoServicesPanel" role="tab" aria-controls="architectureCampusNetworkCiscoServicesPanel" aria-selected="false" tabindex="-1">Services</button>
              <button type="button" class="architecture-campus-network-cisco-config-tab" id="architectureCampusNetworkCiscoSecurityTab" data-config-tab-target="architectureCampusNetworkCiscoSecurityPanel" role="tab" aria-controls="architectureCampusNetworkCiscoSecurityPanel" aria-selected="false" tabindex="-1">Security</button>
            </div>

            <div class="tool-inspector-section architecture-campus-network-cisco-config-panel active" id="architectureCampusNetworkCiscoNetworkPanel" data-config-panel role="tabpanel" aria-labelledby="architectureCampusNetworkCiscoNetworkTab">
              <div class="architecture-campus-network-cisco-config-grid">
                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoRouting">Routing mode <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune routing mode before regenerating the diagram." aria-label="Tune routing mode before regenerating the diagram.">i</span></label>
                  <input type="hidden" id="architectureCampusNetworkCiscoRouting" value="ospf">

                  <details class="architecture-campus-network-cisco-custom-dropdown" data-custom-dropdown-for="architectureCampusNetworkCiscoRouting">
                    <summary class="architecture-campus-network-cisco-custom-dropdown-summary">
                      <span data-custom-dropdown-label>OSPF</span>
                        <span class="architecture-campus-network-cisco-custom-arrow-slot" aria-hidden="true"></span>
                    </summary>

                    <div class="architecture-campus-network-cisco-custom-dropdown-menu" role="listbox" aria-label="Custom option">
                      <button
                        type="button"
                        class="architecture-campus-network-cisco-custom-dropdown-option"
                        data-custom-dropdown-value="static"
                        role="option"
                        aria-selected="false"
                      >Static</button>

                      <button
                        type="button"
                        class="architecture-campus-network-cisco-custom-dropdown-option active"
                        data-custom-dropdown-value="ospf"
                        role="option"
                        aria-selected="true"
                      >OSPF</button>

                      <button
                        type="button"
                        class="architecture-campus-network-cisco-custom-dropdown-option"
                        data-custom-dropdown-value="eigrp"
                        role="option"
                        aria-selected="false"
                      >EIGRP</button>

                      <button
                        type="button"
                        class="architecture-campus-network-cisco-custom-dropdown-option"
                        data-custom-dropdown-value="bgp"
                        role="option"
                        aria-selected="false"
                      >BGP</button>
                    </div>
                  </details>
                </div>

                <div class="architecture-campus-network-cisco-control-stack architecture-campus-network-cisco-vlan-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoVlans">VLANs <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune vlans before regenerating the diagram." aria-label="Tune vlans before regenerating the diagram.">i</span></label>
                  <textarea id="architectureCampusNetworkCiscoVlans" class="form-control architecture-campus-network-cisco-vlan-input">VLAN 10 Staff
VLAN 20 Voice
VLAN 30 Guest
VLAN 40 Servers</textarea>
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoTrunkVlans">Trunk allowed VLANs <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune trunk allowed vlans before regenerating the diagram." aria-label="Tune trunk allowed vlans before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCampusNetworkCiscoTrunkVlans" class="form-control" value="10,20,30,40">
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoNativeVlan">Native VLAN <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune native vlan before regenerating the diagram." aria-label="Tune native vlan before regenerating the diagram.">i</span></label>
                  <input type="number" id="architectureCampusNetworkCiscoNativeVlan" class="form-control" min="1" max="4094" value="999" placeholder="999">
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoAccessVlan">Access VLAN <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune access vlan before regenerating the diagram." aria-label="Tune access vlan before regenerating the diagram.">i</span></label>
                  <input type="number" id="architectureCampusNetworkCiscoAccessVlan" class="form-control" min="1" max="4094" value="10" placeholder="10">
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoSviGateway">SVI gateway <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune svi gateway before regenerating the diagram." aria-label="Tune svi gateway before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCampusNetworkCiscoSviGateway" class="form-control" value="10.10.10.1">
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoOspfArea">OSPF area <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune ospf area before regenerating the diagram." aria-label="Tune ospf area before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCampusNetworkCiscoOspfArea" class="form-control" value="0">
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoBgpAsn">BGP ASN <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune bgp asn before regenerating the diagram." aria-label="Tune bgp asn before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCampusNetworkCiscoBgpAsn" class="form-control" value="65010">
                </div>

                <div class="architecture-campus-network-cisco-control-stack">
                  <label class="tool-control-label" for="architectureCampusNetworkCiscoRedundancyVip">HSRP / VRRP VIP <span class="architecture-campus-network-cisco-helper-chip architecture-campus-network-cisco-custom-helper-chip" title="Tune hsrp / vrrp vip before regenerating the diagram." aria-label="Tune hsrp / vrrp vip before regenerating the diagram.">i</span></label>
                  <input type="text" id="architectureCampusNetworkCiscoRedundancyVip" class="form-control" value="10.10.10.254">
                </div>
              </div>
            </div>

            <div class="tool-inspector-section architecture-campus-network-cisco-config-panel" id="architectureCampusNetworkCiscoServicesPanel" data-config-panel role="tabpanel" aria-labelledby="architectureCampusNetworkCiscoServicesTab" hidden>
              <div class="architecture-campus-network-cisco-toggle-grid">
                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">Wireless controller</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoWireless" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">Cisco Secure Firewall</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoFirewall" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">WAN edge</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoWan" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">Monitoring / Syslog</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoMonitoring" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">DHCP / DNS</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoDhcpDns" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">HSRP</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoHsrp" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">EtherChannel</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoEtherChannel" checked>
                </label>
              </div>
            </div>

            <div class="tool-inspector-section architecture-campus-network-cisco-config-panel" id="architectureCampusNetworkCiscoSecurityPanel" data-config-panel role="tabpanel" aria-labelledby="architectureCampusNetworkCiscoSecurityTab" hidden>
              <div class="architecture-campus-network-cisco-toggle-grid">
                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">ACL policy boundary</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoAcl" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">NAT at edge</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoNat" checked>
                </label>

                <label class="architecture-campus-network-cisco-toggle-item">
                  <span class="architecture-campus-network-cisco-toggle-copy">VPN tunnel</span>
                  <input type="checkbox" id="architectureCampusNetworkCiscoVpn">
                </label>
              </div>
            </div>
          </div>
        </details>
        {# ns:end family._base.workspace.03_custom-settings #}

        {# ns:start family.architecture.workspace.04_selected-item #}
        <div class="tool-inspector-section architecture-campus-network-cisco-selected-section" id="architectureCampusNetworkCiscoSelectedShell" data-section="selected-item" data-root-selector=".architecture-campus-network-cisco-tool">
          <h3 class="architecture-campus-network-cisco-section-title">Selected item</h3>
          <p class="architecture-campus-network-cisco-selected-empty architecture-campus-network-cisco-selected-empty-chips" id="architectureCampusNetworkCiscoSelectedEmpty" aria-label="Select a node or boundary box to move, resize, or highlight it. Select a connector line to adjust its arrow handles. Arrow keys move the selected item; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
            <span class="architecture-campus-network-cisco-selected-empty-copy">
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a node or boundary box</span>
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Select a line to adjust arrows</span>
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected item</span>
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
              <span class="architecture-campus-network-cisco-selected-hint-chip architecture-campus-network-cisco-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
            </span>
          </p>

          <div class="architecture-campus-network-cisco-selected-editor d-none" id="architectureCampusNetworkCiscoSelectedEditor">
            <div class="architecture-campus-network-cisco-selected-name" id="architectureCampusNetworkCiscoSelectedName"></div>

            <div class="architecture-campus-network-cisco-selected-grid">
              <div class="architecture-campus-network-cisco-control-stack">
                <label class="tool-control-label" for="architectureCampusNetworkCiscoSelectedX">X position</label>
                <input type="number" id="architectureCampusNetworkCiscoSelectedX" class="form-control" min="0" step="4">
              </div>

              <div class="architecture-campus-network-cisco-control-stack">
                <label class="tool-control-label" for="architectureCampusNetworkCiscoSelectedY">Y position</label>
                <input type="number" id="architectureCampusNetworkCiscoSelectedY" class="form-control" min="0" step="4">
              </div>

              <div class="architecture-campus-network-cisco-control-stack">
                <label class="tool-control-label" for="architectureCampusNetworkCiscoSelectedWidth">Width</label>
                <input type="number" id="architectureCampusNetworkCiscoSelectedWidth" class="form-control" min="120" step="4">
              </div>

              <div class="architecture-campus-network-cisco-control-stack">
                <label class="tool-control-label" for="architectureCampusNetworkCiscoSelectedHeight">Height</label>
                <input type="number" id="architectureCampusNetworkCiscoSelectedHeight" class="form-control" min="58" step="4">
              </div>
            </div>

            <div class="architecture-campus-network-cisco-selected-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureCampusNetworkCiscoHighlightNode">
                <i class="bi bi-highlighter" aria-hidden="true"></i>
                <span data-button-label>Highlight</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary" id="architectureCampusNetworkCiscoApplyNode">
                <i class="bi bi-check2" aria-hidden="true"></i>
                <span data-button-label>Apply</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost" id="architectureCampusNetworkCiscoResetNode">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                <span data-button-label>Reset</span>
              </button>
            </div>
          </div>
        </div>
        {# ns:end family.architecture.workspace.04_selected-item #}
      </div>
    </section>

    <section class="tool-shell tool-stage-shell architecture-campus-network-cisco-stage-shell" id="architectureCampusNetworkCiscoStageShell" data-section="diagram-buttons" data-root-selector=".architecture-campus-network-cisco-tool" aria-labelledby="architectureCampusNetworkCiscoStageTitle">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-shell-header architecture-campus-network-cisco-stage-header" id="architectureCampusNetworkCiscoStageHeader" data-section="title" data-root-selector=".architecture-campus-network-cisco-tool">
        <div class="architecture-campus-network-cisco-stage-heading">
          <h2 class="tool-shell-title" id="architectureCampusNetworkCiscoStageTitle">Cisco Campus Network Architecture</h2>
          <p class="tool-shell-subtitle" id="architectureCampusNetworkCiscoStageSubtitle">
            <span class="architecture-campus-network-cisco-stage-preset-chip">Enterprise Campus preset</span>
          </p>
        </div>
        <div class="architecture-campus-network-cisco-stage-meta" id="architectureCampusNetworkCiscoStageMeta"></div>
      </div>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="architecture-campus-network-cisco-stage-toolbar-actions">
          <div class="architecture-campus-network-cisco-zoom-control" id="architectureCampusNetworkCiscoZoomControl">
            <button type="button" class="architecture-campus-network-cisco-zoom-step" id="architectureCampusNetworkCiscoZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
