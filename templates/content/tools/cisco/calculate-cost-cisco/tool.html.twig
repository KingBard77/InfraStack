    <details class="calculate-cost-cisco-advanced" id="calculateCostCiscoAdvanced">
      <summary class="calculate-cost-cisco-advanced-summary">Advanced</summary>

      <div class="calculate-cost-cisco-advanced-body">
        <div class="calculate-cost-cisco-inner-panel">
