<div class="calculate-cost-cisco-tool" data-tool-slug="calculate-cost-cisco" data-tool-category="Cisco">
<div class="tool-box">
  <form class="calculate-cost-cisco-form" id="calculateCostCiscoForm">
    <div class="calculate-cost-cisco-main-row">
      <label for="calculateCostCiscoLabel" class="calculate-cost-cisco-main-label">
        Estimate label:
        <span class="info-dot" title="Name the workload or environment you want to estimate">i</span>
      </label>

      <div class="calculate-cost-cisco-main-input-grid">
        <input
          type="text"
          id="calculateCostCiscoLabel"
          class="form-control"
          placeholder="Production API stack"
          value="Lean web platform"
        >

        <div class="calculate-cost-cisco-main-actions">
          <button type="submit" class="btn btn-primary calculate-cost-cisco-submit-btn" id="calculateCostCiscoSubmit">Estimate</button>
          <button type="button" class="calculate-cost-cisco-secondary-btn calculate-cost-cisco-reset-btn" id="calculateCostCiscoReset">Reset</button>
        </div>
      </div>
    </div>

    <div class="calculate-cost-cisco-basic-panel">
      <div class="calculate-cost-cisco-inner-panel">
        <div class="calculate-cost-cisco-setting-row">
          <label for="calculateCostCiscoPreset" class="calculate-cost-cisco-setting-label">
            Preset:
            <span class="info-dot" title="Load a starting cost shape for a common Cisco workload">i</span>
          </label>

          <div class="calculate-cost-cisco-setting-field">
            <div class="calculate-cost-cisco-inline-grid calculate-cost-cisco-inline-grid-preset">
              <details class="calculate-cost-cisco-select" id="calculateCostCiscoPresetSelect">
                <summary class="calculate-cost-cisco-select-summary">
                  <span id="calculateCostCiscoPresetSummary">Lean web platform</span>
                </summary>

                <div class="calculate-cost-cisco-select-body">
                  <div class="calculate-cost-cisco-select-grid calculate-cost-cisco-select-grid-list">
                    <label class="calculate-cost-cisco-select-card">
                      <input type="radio" name="calculateCostCiscoPresetOption" value="lean-web" checked>
                      <span class="calculate-cost-cisco-select-title">Branch access bundle</span>
                    </label>

                    <label class="calculate-cost-cisco-select-card">
                      <input type="radio" name="calculateCostCiscoPresetOption" value="serverless-api">
                      <span class="calculate-cost-cisco-select-title">Wireless refresh</span>
                    </label>

                    <label class="calculate-cost-cisco-select-card">
                      <input type="radio" name="calculateCostCiscoPresetOption" value="steady-platform">
                      <span class="calculate-cost-cisco-select-title">Campus core refresh</span>
                    </label>

                    <label class="calculate-cost-cisco-select-card">
                      <input type="radio" name="calculateCostCiscoPresetOption" value="blank">
                      <span class="calculate-cost-cisco-select-title">Blank estimate</span>
                    </label>
                  </div>
                </div>
              </details>
              <input type="hidden" id="calculateCostCiscoPreset" value="lean-web">

              <button type="button" class="calculate-cost-cisco-secondary-btn" id="calculateCostCiscoApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="calculate-cost-cisco-setting-row">
          <label class="calculate-cost-cisco-setting-label">
            Pricing basis:
            <span class="info-dot" title="Starter prices are visible and editable in Advanced so the estimate stays auditable">i</span>
          </label>

          <div class="calculate-cost-cisco-setting-field">
            <div class="calculate-cost-cisco-basis-grid">
              <div class="calculate-cost-cisco-basis-card">
                <span class="calculate-cost-cisco-basis-label">Catalog</span>
                <span class="calculate-cost-cisco-basis-value">Starter Cisco network mix</span>
                <span class="calculate-cost-cisco-basis-note">Switching hardware uses a compact purchase-model catalog. Wireless, licensing, automation, management, and support use visible starter rates that you can override.</span>
              </div>

              <div class="calculate-cost-cisco-basis-card">
                <span class="calculate-cost-cisco-basis-label">Output</span>
                <span class="calculate-cost-cisco-basis-value">USD monthly run rate</span>
                <span class="calculate-cost-cisco-basis-note">Use the result as a planning estimate, then verify material decisions in Cisco commercial pricing, billing, or agreement data.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="calculate-cost-cisco-service-grid">
          <section class="calculate-cost-cisco-service-card" data-service-card="compute">
            <div class="calculate-cost-cisco-service-head">
              <div>
                <h3 class="calculate-cost-cisco-service-title">Cisco switching</h3>
                <p class="calculate-cost-cisco-service-copy">Switch count, lifecycle window, and purchase model.</p>
              </div>

              <label class="switch calculate-cost-cisco-switch-wrap">
                <input type="checkbox" id="calculateCostCiscoIncludeCompute" checked>
                <span class="slider"></span>
                <span class="calculate-cost-cisco-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-cisco-service-body" id="calculateCostCiscoComputeBody">
              <div class="calculate-cost-cisco-card-grid calculate-cost-cisco-card-grid-two">
                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoComputeInstance" class="calculate-cost-cisco-field-label">Switch platform</label>
                  <details class="calculate-cost-cisco-select" id="calculateCostCiscoComputeInstanceSelect">
                    <summary class="calculate-cost-cisco-select-summary">
                      <span id="calculateCostCiscoComputeInstanceSummary">Catalyst 9200 access switch</span>
                    </summary>

                    <div class="calculate-cost-cisco-select-body">
                      <div class="calculate-cost-cisco-select-grid calculate-cost-cisco-select-grid-list">
                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="b2s">
                          <span class="calculate-cost-cisco-select-title">Cisco Business switch</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="b2ms">
                          <span class="calculate-cost-cisco-select-title">Catalyst 9200 access switch</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="d2s-v5" checked>
                          <span class="calculate-cost-cisco-select-title">Catalyst 9200 access switch</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="d4s-v5">
                          <span class="calculate-cost-cisco-select-title">Catalyst 9300 access switch</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="d8s-v5">
                          <span class="calculate-cost-cisco-select-title">Catalyst 9500 distribution switch</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="f4s-v2">
                          <span class="calculate-cost-cisco-select-title">Meraki MS access switch</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="e4s-v5">
                          <span class="calculate-cost-cisco-select-title">Catalyst 9600 core allocation</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputeInstanceOption" value="custom">
                          <span class="calculate-cost-cisco-select-title" id="calculateCostCiscoComputeCustomOptionLabel">Custom size - user defined</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostCiscoComputeInstance" value="d2s-v5">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoComputePurchase" class="calculate-cost-cisco-field-label">Purchase model</label>
                  <details class="calculate-cost-cisco-select" id="calculateCostCiscoComputePurchaseSelect">
                    <summary class="calculate-cost-cisco-select-summary">
                      <span id="calculateCostCiscoComputePurchaseSummary">Monthly allocation</span>
                    </summary>

                    <div class="calculate-cost-cisco-select-body">
                      <div class="calculate-cost-cisco-select-grid calculate-cost-cisco-select-grid-two">
                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputePurchaseOption" value="onDemand" checked>
                          <span class="calculate-cost-cisco-select-title">Monthly allocation</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputePurchaseOption" value="spot">
                          <span class="calculate-cost-cisco-select-title">Lab or spare allocation</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputePurchaseOption" value="savings1">
                          <span class="calculate-cost-cisco-select-title">EA 1yr</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputePurchaseOption" value="savings3">
                          <span class="calculate-cost-cisco-select-title">EA 3yr</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputePurchaseOption" value="reserved1">
                          <span class="calculate-cost-cisco-select-title">Smart Net 1yr</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoComputePurchaseOption" value="reserved3">
                          <span class="calculate-cost-cisco-select-title">Smart Net 3yr</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostCiscoComputePurchase" value="onDemand">
                </div>

                <div class="calculate-cost-cisco-custom-instance-grid calculate-cost-cisco-card-span-two d-none" id="calculateCostCiscoComputeCustomFields">
                  <div class="calculate-cost-cisco-field-stack">
                    <label for="calculateCostCiscoComputeCustomLabel" class="calculate-cost-cisco-field-label">Custom profile label</label>
                    <input
                      type="text"
                      id="calculateCostCiscoComputeCustomLabel"
                      class="form-control"
	                      placeholder="Custom switching profile"
                      value=""
                    >
                  </div>

                  <div class="calculate-cost-cisco-field-stack">
	                    <label for="calculateCostCiscoComputeCustomVcpu" class="calculate-cost-cisco-field-label">Planning units</label>
                    <input
                      type="number"
                      id="calculateCostCiscoComputeCustomVcpu"
                      class="form-control"
                      min="1"
                      step="1"
                      value="4"
                    >
                  </div>

                  <div class="calculate-cost-cisco-field-stack">
	                    <label for="calculateCostCiscoComputeCustomMemoryGiB" class="calculate-cost-cisco-field-label">Management footprint GiB</label>
                    <input
                      type="number"
                      id="calculateCostCiscoComputeCustomMemoryGiB"
                      class="form-control"
                      min="1"
                      step="0.5"
                      value="16"
                    >
                  </div>
                </div>

	                <p class="calculate-cost-cisco-field-hint calculate-cost-cisco-card-span-two d-none" id="calculateCostCiscoComputeCustomHint">Custom profile uses the device monthly override in Advanced. Set planning units and management footprint here, then price it with the override field.</p>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoComputeCount" class="calculate-cost-cisco-field-label">Device count</label>
                  <input type="number" id="calculateCostCiscoComputeCount" class="form-control" min="0" step="1" value="2">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoComputeHours" class="calculate-cost-cisco-field-label">Monthly hours</label>
                  <input type="number" id="calculateCostCiscoComputeHours" class="form-control" min="0" max="744" step="1" value="730">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-cisco-service-card" data-service-card="disk">
            <div class="calculate-cost-cisco-service-head">
              <div>
                <h3 class="calculate-cost-cisco-service-title">Wireless access</h3>
                <p class="calculate-cost-cisco-service-copy">Access point units, controller capacity, and throughput allowance.</p>
              </div>

              <label class="switch calculate-cost-cisco-switch-wrap">
                <input type="checkbox" id="calculateCostCiscoIncludeDisk" checked>
                <span class="slider"></span>
                <span class="calculate-cost-cisco-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-cisco-service-body" id="calculateCostCiscoDiskBody">
              <div class="calculate-cost-cisco-card-grid calculate-cost-cisco-card-grid-two">
                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoDiskStorageGb" class="calculate-cost-cisco-field-label">Access point units</label>
                  <input type="number" id="calculateCostCiscoDiskStorageGb" class="form-control" min="0" step="1" value="160">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoDiskIops" class="calculate-cost-cisco-field-label">Controller capacity units</label>
                  <input type="number" id="calculateCostCiscoDiskIops" class="form-control" min="0" step="100" value="3000">
                </div>

                <div class="calculate-cost-cisco-field-stack calculate-cost-cisco-card-span-two">
                  <label for="calculateCostCiscoDiskThroughput" class="calculate-cost-cisco-field-label">Throughput allowance Mbps</label>
                  <input type="number" id="calculateCostCiscoDiskThroughput" class="form-control" min="0" step="1" value="125">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-cisco-service-card" data-service-card="blob">
            <div class="calculate-cost-cisco-service-head">
              <div>
                <h3 class="calculate-cost-cisco-service-title">Licensing</h3>
                <p class="calculate-cost-cisco-service-copy">License units, telemetry checks, and entitlement changes.</p>
              </div>

              <label class="switch calculate-cost-cisco-switch-wrap">
                <input type="checkbox" id="calculateCostCiscoIncludeBlob" checked>
                <span class="slider"></span>
                <span class="calculate-cost-cisco-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-cisco-service-body" id="calculateCostCiscoBlobBody">
              <div class="calculate-cost-cisco-card-grid calculate-cost-cisco-card-grid-two">
                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoBlobStorageGb" class="calculate-cost-cisco-field-label">License units</label>
                  <input type="number" id="calculateCostCiscoBlobStorageGb" class="form-control" min="0" step="1" value="250">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoBlobEgressGb" class="calculate-cost-cisco-field-label">Telemetry transfer GB</label>
                  <input type="number" id="calculateCostCiscoBlobEgressGb" class="form-control" min="0" step="1" value="180">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoBlobGetRequestsK" class="calculate-cost-cisco-field-label">Policy checks (1k)</label>
                  <input type="number" id="calculateCostCiscoBlobGetRequestsK" class="form-control" min="0" step="1" value="2200">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoBlobPutRequestsK" class="calculate-cost-cisco-field-label">Config changes (1k)</label>
                  <input type="number" id="calculateCostCiscoBlobPutRequestsK" class="form-control" min="0" step="1" value="120">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-cisco-service-card" data-service-card="functions">
            <div class="calculate-cost-cisco-service-head">
              <div>
                <h3 class="calculate-cost-cisco-service-title">Controller automation</h3>
                <p class="calculate-cost-cisco-service-copy">Automation jobs, runtime, and worker sizing.</p>
              </div>

              <label class="switch calculate-cost-cisco-switch-wrap">
                <input type="checkbox" id="calculateCostCiscoIncludeFunctions" checked>
                <span class="slider"></span>
                <span class="calculate-cost-cisco-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-cisco-service-body" id="calculateCostCiscoFunctionsBody">
              <div class="calculate-cost-cisco-card-grid calculate-cost-cisco-card-grid-two">
                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoFunctionsRequestsMillion" class="calculate-cost-cisco-field-label">Jobs (million)</label>
                  <input type="number" id="calculateCostCiscoFunctionsRequestsMillion" class="form-control" min="0" step="0.1" value="1.2">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoFunctionsDurationMs" class="calculate-cost-cisco-field-label">Avg duration ms</label>
                  <input type="number" id="calculateCostCiscoFunctionsDurationMs" class="form-control" min="0" step="1" value="140">
                </div>

                <div class="calculate-cost-cisco-field-stack calculate-cost-cisco-card-span-two">
                  <label for="calculateCostCiscoFunctionsMemoryMb" class="calculate-cost-cisco-field-label">Memory MB</label>
                  <input type="number" id="calculateCostCiscoFunctionsMemoryMb" class="form-control" min="128" step="128" value="512">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-cisco-service-card" data-service-card="api">
            <div class="calculate-cost-cisco-service-head">
              <div>
                <h3 class="calculate-cost-cisco-service-title">Cloud management</h3>
                <p class="calculate-cost-cisco-service-copy">Dashboard calls, API activity, and response transfer.</p>
              </div>

              <label class="switch calculate-cost-cisco-switch-wrap">
                <input type="checkbox" id="calculateCostCiscoIncludeApi" checked>
                <span class="slider"></span>
                <span class="calculate-cost-cisco-switch-label">Include</span>
              </label>
            </div>

            <div class="calculate-cost-cisco-service-body" id="calculateCostCiscoApiBody">
              <div class="calculate-cost-cisco-card-grid calculate-cost-cisco-card-grid-two">
                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoApiType" class="calculate-cost-cisco-field-label">API type</label>
                  <details class="calculate-cost-cisco-select" id="calculateCostCiscoApiTypeSelect">
                    <summary class="calculate-cost-cisco-select-summary">
                      <span id="calculateCostCiscoApiTypeSummary">Essentials management</span>
                    </summary>

                    <div class="calculate-cost-cisco-select-body">
                      <div class="calculate-cost-cisco-select-grid calculate-cost-cisco-select-grid-two">
                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoApiTypeOption" value="http" checked>
                          <span class="calculate-cost-cisco-select-title">Essentials management</span>
                        </label>

                        <label class="calculate-cost-cisco-select-card">
                          <input type="radio" name="calculateCostCiscoApiTypeOption" value="rest">
                          <span class="calculate-cost-cisco-select-title">Advantage management</span>
                        </label>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="calculateCostCiscoApiType" value="http">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoApiRequestsMillion" class="calculate-cost-cisco-field-label">Calls (million)</label>
                  <input type="number" id="calculateCostCiscoApiRequestsMillion" class="form-control" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-cisco-field-stack calculate-cost-cisco-card-span-two">
                  <label for="calculateCostCiscoApiResponseKb" class="calculate-cost-cisco-field-label">Avg response KB</label>
                  <input type="number" id="calculateCostCiscoApiResponseKb" class="form-control" min="0" step="1" value="32">
                </div>
              </div>
            </div>
          </section>

          <section class="calculate-cost-cisco-service-card" data-service-card="overhead">
            <div class="calculate-cost-cisco-service-head">
              <div>
                <h3 class="calculate-cost-cisco-service-title">Shared Transfer And Overhead</h3>
                <p class="calculate-cost-cisco-service-copy">Telemetry transfer, support uplift, and blended buffer.</p>
              </div>
            </div>

            <div class="calculate-cost-cisco-service-body">
              <div class="calculate-cost-cisco-card-grid calculate-cost-cisco-card-grid-two">
                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoSharedEgressGb" class="calculate-cost-cisco-field-label">Shared transfer GB</label>
                  <input type="number" id="calculateCostCiscoSharedEgressGb" class="form-control" min="0" step="1" value="120">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoSupportPct" class="calculate-cost-cisco-field-label">Support uplift %</label>
                  <input type="number" id="calculateCostCiscoSupportPct" class="form-control" min="0" step="0.1" value="8">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoContingencyPct" class="calculate-cost-cisco-field-label">Contingency %</label>
                  <input type="number" id="calculateCostCiscoContingencyPct" class="form-control" min="0" step="0.1" value="10">
                </div>

                <div class="calculate-cost-cisco-field-stack">
                  <label for="calculateCostCiscoManualAdjustment" class="calculate-cost-cisco-field-label">Manual adjustment $</label>
