<div class="__PREFIX__-toolbar-shell">
          <div class="__PREFIX__-toolbar tool-output-toolbar tool-result-toolbar">
            <div class="__PREFIX__-toolbar-main">
              <label for="__DOM_PREFIX__Sort" class="__PREFIX__-sort-label">Sort</label>
              <div class="__PREFIX__-sort-wrap">
                <details class="__PREFIX__-sort-select" id="__DOM_PREFIX__SortSelect">
                  <summary class="__PREFIX__-sort-summary">
                    <span id="__DOM_PREFIX__SortSummary">ID</span>
                  </summary>

                  <div class="__PREFIX__-sort-menu">
                    <div class="__PREFIX__-sort-grid">
                      <button type="button" class="__PREFIX__-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="alphabetical" aria-pressed="false">A-Z</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="field" aria-pressed="false">Field</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="value" aria-pressed="false">Value</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="length" aria-pressed="false">Length</button>
                    </div>
                  </div>
                </details>
                <input type="hidden" id="__DOM_PREFIX__Sort" value="id">
              </div>
            </div>

            <div class="tool-output-actions __PREFIX__-toolbar-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__ExportPdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__DownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__CopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__DownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost __PREFIX__-action-btn" id="__DOM_PREFIX__ImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
        </div>
