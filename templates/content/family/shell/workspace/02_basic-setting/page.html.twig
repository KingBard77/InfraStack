<div class="__PREFIX__-basic-panel">
      <div class="__PREFIX__-inner-panel">
        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__Preset" class="__PREFIX__-setting-label">
            Preset:
            <span class="info-dot" title="Load a realistic netcat workflow as a starting point">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two">
              <select id="__DOM_PREFIX__Preset" class="form-select">
                <option value="tcp-client" selected>TCP client</option>
                <option value="udp-check">UDP payload check</option>
                <option value="listen-verbose">Verbose listener</option>
                <option value="port-scan">Port sweep</option>
                <option value="tls-listener">TLS listener</option>
                <option value="proxy-tunnel">Proxy tunnel</option>
                <option value="custom">Current settings</option>
              </select>

              <button type="button" class="__PREFIX__-secondary-btn" id="__DOM_PREFIX__ApplyPreset">Apply preset</button>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__Shell" class="__PREFIX__-setting-label">
            Environment:
            <span class="info-dot" title="Pick the shell, netcat implementation, and flag style the generated command should match">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-stacked-grid">
              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
                <select id="__DOM_PREFIX__Shell" class="form-select">
                  <option value="bash" selected>Bash / Zsh</option>
                  <option value="powershell">PowerShell</option>
                  <option value="cmd">Windows CMD</option>
                </select>

                <select id="__DOM_PREFIX__Implementation" class="form-select">
                  <option value="openbsd" selected>OpenBSD nc</option>
                  <option value="traditional">Traditional netcat</option>
                  <option value="busybox">BusyBox nc</option>
                  <option value="ncat">Nmap ncat</option>
                </select>

                <select id="__DOM_PREFIX__FlagStyle" class="form-select">
                  <option value="mixed" selected>Mixed flags</option>
                  <option value="short">Short flags</option>
                  <option value="long">Long flags when available</option>
                </select>
              </div>

              <div class="__PREFIX__-flag-hint" id="__DOM_PREFIX__CapabilityHint">OpenBSD nc is active. TLS and execution helpers are dropped with warnings, while listen mode, UDP, scans, and shutdown-after-stdin EOF stay available.</div>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__CustomBinary" class="__PREFIX__-setting-label">
            Output shape:
            <span class="info-dot" title="Control how the command is formatted and optionally override the binary prefix">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-stacked-grid">
              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
                <input
                  type="text"
                  id="__DOM_PREFIX__CustomBinary"
                  class="form-control"
                  placeholder="Optional override, for example sudo ncat"
                >

                <label class="switch __PREFIX__-switch-wrap">
                  <input type="checkbox" id="__DOM_PREFIX__CombineShortFlags" checked>
                  <span class="slider"></span>
                  <span class="__PREFIX__-switch-label">Combine short flags</span>
                </label>

                <label class="switch __PREFIX__-switch-wrap">
                  <input type="checkbox" id="__DOM_PREFIX__Multiline" checked>
                  <span class="slider"></span>
                  <span class="__PREFIX__-switch-label">Multi-line command</span>
                </label>
              </div>

              <div class="__PREFIX__-flag-hint" id="__DOM_PREFIX__ShellHint">Bash and PowerShell can use multi-line output. CMD is forced to a single line so carets do not become a paperwork incident.</div>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__ConnectionType" class="__PREFIX__-setting-label">
            Session mode:
            <span class="info-dot" title="Choose whether the command connects out, listens for inbound sessions, or scans a port range">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
              <select id="__DOM_PREFIX__ConnectionType" class="form-select">
                <option value="client" selected>Client</option>
                <option value="listen">Listen</option>
                <option value="scan">Scan</option>
              </select>

              <label class="switch __PREFIX__-switch-wrap">
                <input type="checkbox" id="__DOM_PREFIX__UseUdp">
                <span class="slider"></span>
                <span class="__PREFIX__-switch-label">Use UDP</span>
              </label>

              <label class="switch __PREFIX__-switch-wrap">
                <input type="checkbox" id="__DOM_PREFIX__ForceIpv6">
                <span class="slider"></span>
                <span class="__PREFIX__-switch-label">Force IPv6</span>
              </label>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__TargetPort" class="__PREFIX__-setting-label">
            Ports:
            <span class="info-dot" title="The visible fields change with client, listen, and scan mode so the generated command stays anchored to one socket role at a time">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-stacked-grid">
              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-four">
                <div id="__DOM_PREFIX__TargetPortWrap">
                  <input
                    type="number"
                    id="__DOM_PREFIX__TargetPort"
                    class="form-control"
                    min="1"
                    max="65535"
                    step="1"
                    value="443"
                    placeholder="Target port"
                  >
                </div>

                <div class="d-none" id="__DOM_PREFIX__ListenPortWrap">
                  <input
                    type="number"
                    id="__DOM_PREFIX__ListenPort"
                    class="form-control"
                    min="1"
                    max="65535"
                    step="1"
                    value="9000"
                    placeholder="Listen port"
                  >
                </div>

                <div class="d-none" id="__DOM_PREFIX__StartPortWrap">
                  <input
                    type="number"
                    id="__DOM_PREFIX__StartPort"
                    class="form-control"
                    min="1"
                    max="65535"
                    step="1"
                    value="20"
                    placeholder="Start port"
                  >
                </div>

                <div class="d-none" id="__DOM_PREFIX__EndPortWrap">
                  <input
                    type="number"
                    id="__DOM_PREFIX__EndPort"
                    class="form-control"
                    min="1"
                    max="65535"
                    step="1"
                    value="1024"
                    placeholder="End port"
                  >
                </div>
              </div>

              <div class="__PREFIX__-flag-hint" id="__DOM_PREFIX__ModeHint">Client mode uses one remote port. Listen mode swaps to a local port, and scan mode forces a start and end range plus zero-I/O probing.</div>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__KeepListening" class="__PREFIX__-setting-label">
            Behavior:
            <span class="info-dot" title="Turn on classic session flags such as keep-open listeners, verbose output, zero-I/O probes, and numeric-only resolution">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two">
              <label class="switch __PREFIX__-switch-wrap">
                <input type="checkbox" id="__DOM_PREFIX__KeepListening">
                <span class="slider"></span>
                <span class="__PREFIX__-switch-label">Keep listening (-k)</span>
              </label>

              <label class="switch __PREFIX__-switch-wrap">
                <input type="checkbox" id="__DOM_PREFIX__Verbose">
                <span class="slider"></span>
                <span class="__PREFIX__-switch-label">Verbose output (-v)</span>
              </label>

              <label class="switch __PREFIX__-switch-wrap">
                <input type="checkbox" id="__DOM_PREFIX__ZeroIo">
                <span class="slider"></span>
                <span class="__PREFIX__-switch-label">Zero I/O probe (-z)</span>
              </label>

              <label class="switch __PREFIX__-switch-wrap">
                <input type="checkbox" id="__DOM_PREFIX__NumericOnly">
                <span class="slider"></span>
                <span class="__PREFIX__-switch-label">Numeric only (-n)</span>
              </label>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__Timeout" class="__PREFIX__-setting-label">
            Timers:
            <span class="info-dot" title="Timeouts, quit-after-EOF delays, and line pacing vary by implementation, so unsupported requests are surfaced in warnings">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
              <input
                type="number"
                id="__DOM_PREFIX__Timeout"
                class="form-control"
                min="0"
                step="1"
                value="5"
                placeholder="Timeout (s)"
              >

              <input
                type="number"
                id="__DOM_PREFIX__QuitAfterEof"
                class="form-control"
                min="0"
                step="1"
                placeholder="Quit after EOF (s)"
              >

              <input
                type="number"
                id="__DOM_PREFIX__SendDelay"
                class="form-control"
                min="0"
                step="0.1"
                placeholder="Send delay (-i)"
              >
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__SourceAddress" class="__PREFIX__-setting-label">
            Local socket:
            <span class="info-dot" title="Set the local source address and port, then optionally attach an execution handler for supported flavours">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
              <input
                type="text"
                id="__DOM_PREFIX__SourceAddress"
                class="form-control"
                placeholder="Source address (-s)"
              >

              <input
                type="number"
                id="__DOM_PREFIX__SourcePort"
                class="form-control"
                min="1"
                max="65535"
                step="1"
                placeholder="Source port (-p)"
              >

              <select id="__DOM_PREFIX__ExecutionMode" class="form-select">
                <option value="none" selected>No execution</option>
                <option value="exec">Execute command (-e)</option>
              </select>
            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__CommandToRun" class="__PREFIX__-setting-label">
            Handler:
            <span class="info-dot" title="Execution and TLS options are intentionally narrow because not every netcat flavour or session mode can honor them">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-stacked-grid">
              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
                <div class="d-none" id="__DOM_PREFIX__CommandToRunWrap">
                  <input
                    type="text"
                    id="__DOM_PREFIX__CommandToRun"
                    class="form-control"
                    placeholder="/bin/sh"
                  >
                </div>

                <label class="switch __PREFIX__-switch-wrap">
                  <input type="checkbox" id="__DOM_PREFIX__UseTls">
                  <span class="slider"></span>
                  <span class="__PREFIX__-switch-label">Use TLS / SSL</span>
                </label>

                <div class="d-none" id="__DOM_PREFIX__VerifyCertWrap">
                  <label class="switch __PREFIX__-switch-wrap">
                    <input type="checkbox" id="__DOM_PREFIX__VerifyCert" checked>
                    <span class="slider"></span>
                    <span class="__PREFIX__-switch-label">Verify certificate</span>
                  </label>
                </div>
              </div>

              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two d-none" id="__DOM_PREFIX__TlsCredentialsWrap">
                <input
                  type="text"
                  id="__DOM_PREFIX__ClientCertPath"
                  class="form-control"
                  placeholder="Client cert path"
                >

                <input
                  type="text"
                  id="__DOM_PREFIX__ClientKeyPath"
                  class="form-control"
                  placeholder="Client key path"
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
