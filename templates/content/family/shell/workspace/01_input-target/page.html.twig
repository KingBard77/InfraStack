<form class="__PREFIX__-form" id="__DOM_PREFIX__Form" aria-label="Netcat command builder">
    <div class="__PREFIX__-main-row">
      <label for="__DOM_PREFIX__PrimaryHost" class="__PREFIX__-main-label">
        <span id="__DOM_PREFIX__PrimaryHostLabel">Target host:</span>
        <span class="info-dot" title="This field is the remote target in client and scan modes, or the bind address in listen mode">i</span>
      </label>

      <div class="__PREFIX__-main-input-grid">
        <input
          type="text"
          id="__DOM_PREFIX__PrimaryHost"
          class="form-control"
          placeholder="example.com"
          value="example.com"
        >

        <div class="__PREFIX__-main-actions">
          <button type="submit" class="btn btn-primary __PREFIX__-submit-btn" id="__DOM_PREFIX__Submit">Generate</button>
          <button type="button" class="__PREFIX__-secondary-btn __PREFIX__-secondary-btn-ghost __PREFIX__-reset-btn" id="__DOM_PREFIX__Reset">Reset</button>
        </div>
      </div>
    </div>
