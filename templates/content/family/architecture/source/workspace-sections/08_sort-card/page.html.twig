{# Source section: 08_sort-card #}
<div class="__PREFIX__-toolbar-shell">
    <div class="__PREFIX__-toolbar tool-output-toolbar tool-result-toolbar">
        <div class="__PREFIX__-toolbar-main">
            <label for="__DOM_PREFIX__InventorySort" class="__PREFIX__-sort-label">Sort</label>
            <div class="__PREFIX__-sort-wrap">
                <details class="__PREFIX__-sort-select" id="__DOM_PREFIX__InventorySortSelect">
                    <summary class="__PREFIX__-sort-summary" aria-haspopup="listbox" aria-expanded="false" aria-controls="__DOM_PREFIX__SortMenu">
                        <span id="__DOM_PREFIX__InventorySortSummary">ID</span>
                    </summary>

                    <div class="__PREFIX__-sort-menu" id="__DOM_PREFIX__SortMenu" role="listbox">
                        <div class="__PREFIX__-sort-grid">
                            <button type="button" class="__PREFIX__-sort-option is-active" data-sort-value="id" aria-pressed="true" role="option">ID</button>
                            <button type="button" class="__PREFIX__-sort-option" data-sort-value="alphabetical" aria-pressed="false" role="option">A-Z</button>
                            <button type="button" class="__PREFIX__-sort-option" data-sort-value="component" aria-pressed="false" role="option">Component</button>
                            <button type="button" class="__PREFIX__-sort-option" data-sort-value="placement" aria-pressed="false" role="option">Placement</button>
                            <button type="button" class="__PREFIX__-sort-option" data-sort-value="purpose" aria-pressed="false" role="option">Purpose</button>
                        </div>
                    </div>
                </details>
                <input type="hidden" id="__DOM_PREFIX__InventorySort" value="id">
            </div>
        </div>

        <div class="tool-output-actions tool-result-toolbar-actions __PREFIX__-toolbar-actions">
            <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__ExportPng">
                <i class="bi bi-image" aria-hidden="true"></i>
                <span data-button-label>Export PNG</span>
            </button>
            <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__DownloadSvg">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download SVG</span>
            </button>
            <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__CopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
            </button>
            <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__DownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
            </button>
            <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn" id="__DOM_PREFIX__ImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
            </button>
        </div>
    </div>
</div>
<input type="file" id="__DOM_PREFIX__ImportJson" class="d-none" accept="application/json,.json">
