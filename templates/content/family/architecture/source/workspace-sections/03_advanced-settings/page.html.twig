{# Source section: 03_advanced-settings #}
          <details class="__PREFIX__-custom-panel">
            <summary class="__PREFIX__-custom-panel-summary">
              <span>Custom</span>
              <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>

            <div class="__PREFIX__-custom-panel-body">
              <div class="__PREFIX__-config-tabs" role="tablist" aria-label="AWS VPC custom configuration">
                <button type="button" class="__PREFIX__-config-tab active" id="__DOM_PREFIX__NetworkConfigTab" data-config-tab-target="__DOM_PREFIX__NetworkConfigPanel" role="tab" aria-controls="__DOM_PREFIX__NetworkConfigPanel" aria-selected="true" tabindex="0">Network layout</button>
                <button type="button" class="__PREFIX__-config-tab" id="__DOM_PREFIX__WorkloadConfigTab" data-config-tab-target="__DOM_PREFIX__WorkloadConfigPanel" role="tab" aria-controls="__DOM_PREFIX__WorkloadConfigPanel" aria-selected="false" tabindex="-1">Workload</button>
                <button type="button" class="__PREFIX__-config-tab" id="__DOM_PREFIX__ServicesConfigTab" data-config-tab-target="__DOM_PREFIX__ServicesConfigPanel" role="tab" aria-controls="__DOM_PREFIX__ServicesConfigPanel" aria-selected="false" tabindex="-1">Services and controls</button>
              </div>

              <div class="tool-inspector-section __PREFIX__-config-panel active" id="__DOM_PREFIX__NetworkConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__NetworkConfigTab">
                <div class="__PREFIX__-config-grid">
                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_PREFIX__Cidr">VPC CIDR</label>
                    <input type="text" id="__DOM_PREFIX__Cidr" class="form-control" value="10.0.0.0/16">
                  </div>

                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_PREFIX__NatMode">NAT mode</label>
                    <select id="__DOM_PREFIX__NatMode" class="form-select">
                      <option value="none">No NAT</option>
                      <option value="single" selected>Single NAT</option>
                      <option value="per-az">One per AZ</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section __PREFIX__-config-panel" id="__DOM_PREFIX__WorkloadConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__WorkloadConfigTab" hidden>
                <div class="__PREFIX__-config-grid">
                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_PREFIX__AppTier">App tier</label>
                    <select id="__DOM_PREFIX__AppTier" class="form-select">
                      <option value="ec2">EC2 Auto Scaling</option>
                      <option value="ecs">ECS / Fargate</option>
                      <option value="eks">EKS</option>
                      <option value="lambda">Lambda in VPC</option>
                    </select>
                  </div>

                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_PREFIX__Database">Database tier</label>
                    <select id="__DOM_PREFIX__Database" class="form-select">
                      <option value="none">No database tier</option>
                      <option value="rds" selected>RDS</option>
                      <option value="aurora">Aurora</option>
                      <option value="dynamodb">DynamoDB</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section __PREFIX__-config-panel" id="__DOM_PREFIX__ServicesConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_PREFIX__ServicesConfigTab" hidden>
                <div class="__PREFIX__-toggle-grid">
                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Route 53</span>
                    <input type="checkbox" id="__DOM_PREFIX__Route53" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">CloudFront</span>
                    <input type="checkbox" id="__DOM_PREFIX__CloudFront">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">AWS WAF</span>
                    <input type="checkbox" id="__DOM_PREFIX__Waf">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Application Load Balancer</span>
                    <input type="checkbox" id="__DOM_PREFIX__Alb" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Bastion host</span>
                    <input type="checkbox" id="__DOM_PREFIX__Bastion">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">VPC endpoints</span>
                    <input type="checkbox" id="__DOM_PREFIX__Endpoints" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">VPC flow logs</span>
                    <input type="checkbox" id="__DOM_PREFIX__FlowLogs" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">CloudWatch</span>
                    <input type="checkbox" id="__DOM_PREFIX__CloudWatch" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Site-to-site VPN</span>
                    <input type="checkbox" id="__DOM_PREFIX__SiteToSiteVpn">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Transit gateway</span>
                    <input type="checkbox" id="__DOM_PREFIX__TransitGateway">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">ElastiCache</span>
                    <input type="checkbox" id="__DOM_PREFIX__Cache">
                  </label>
                </div>
              </div>

            </div>
          </details>
