                  <span id="__DOM_PREFIX__PresetSummary">Lean web platform</span>
                </summary>

                <div class="__PREFIX__-select-body">
                  <div class="__PREFIX__-select-grid __PREFIX__-select-grid-list">
                    <label class="__PREFIX__-select-card">
                      <input type="radio" name="__DOM_PREFIX__PresetOption" value="lean-web" checked>
