    <div class="__PREFIX__-basic-panel">
      <div class="__PREFIX__-inner-panel">
        <div class="__PREFIX__-setting-row">
          <label for="__DOM_PREFIX__Preset" class="__PREFIX__-setting-label">
            Preset:
            <span class="info-dot" title="Load a starting cost shape for a common AWS workload">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-preset">
              <details class="__PREFIX__-select" id="__DOM_PREFIX__PresetSelect">
