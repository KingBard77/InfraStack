                    </label>
                  </div>
                </div>
              </details>
              <input type="hidden" id="__DOM_PREFIX__Preset" value="lean-web">

              <button type="button" class="__PREFIX__-secondary-btn" id="__DOM_PREFIX__ApplyPreset">Apply preset</button>
