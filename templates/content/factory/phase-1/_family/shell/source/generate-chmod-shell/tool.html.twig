{# tool.html.twig #}

<div class="__TOOL_CLASS__ tool-box mb-4" data-tool-slug="__TOOL_SLUG__" data-tool-category="Shell">
  {# ns:start family._base.workspace.00_shell #}
  {# ns:start family._base.workspace.01_input-brief #}
  <form class="__PREFIX__-form" id="__DOM_ID_PREFIX__Form" aria-label="Chmod command builder">
    <div class="__PREFIX__-input-card">
      <div class="__PREFIX__-input-brief" data-input-layout="inline">
        <div class="__PREFIX__-main-row __PREFIX__-input-row">
          <div class="__PREFIX__-input-label-wrap">
            <label for="__DOM_ID_PREFIX__Target" class="__PREFIX__-main-label __PREFIX__-input-label">Target path:</label>
            <span class="__PREFIX__-helper-chip" title="Enter the file or directory path that the generated chmod command should target" aria-label="Enter the file or directory path that the generated chmod command should target">i</span>
          </div>

          <div class="__PREFIX__-main-input-grid __PREFIX__-input-stack">
            <input
              type="text"
              id="__DOM_ID_PREFIX__Target"
              class="form-control __PREFIX__-input-control"
              placeholder="/srv/app/current"
              value="./deploy.sh"
            >
            <div class="__PREFIX__-input-error d-none" id="__DOM_ID_PREFIX__InputError" role="alert"></div>
          </div>
        </div>

        <div class="__PREFIX__-main-actions __PREFIX__-input-actions">
          <button
            type="submit"
            class="btn btn-primary __PREFIX__-submit-btn __PREFIX__-action-btn __PREFIX__-action-btn-primary"
            id="__DOM_ID_PREFIX__Submit"
            data-tool-share-generate
          >
            <i class="bi bi-terminal" aria-hidden="true"></i>
            <span>Generate</span>
          </button>
          <button
            type="button"
            class="__PREFIX__-secondary-btn __PREFIX__-secondary-btn-ghost __PREFIX__-reset-btn __PREFIX__-action-btn __PREFIX__-action-btn-secondary"
            id="__DOM_ID_PREFIX__Reset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="__PREFIX__-input-helper-card">
          <span class="__PREFIX__-input-hint">Use a concrete path, command target, or scope before generating shell output.</span>
          <span class="__PREFIX__-helper-chip __PREFIX__-helper-chip-inline" title="Enter the file or directory path that the generated chmod command should target" aria-label="Enter the file or directory path that the generated chmod command should target">i</span>
        </div>
      </div>
    </div>

  {# ns:end family._base.workspace.01_input-brief #}
    {# ns:start family._base.workspace.02_basic-settings #}
    <div class="__PREFIX__-basic-panel">
      <div class="__PREFIX__-inner-panel __PREFIX__-basic-card">

        <div class="__PREFIX__-example-card">
          <span class="__PREFIX__-example-label">Example</span>
          <span class="__PREFIX__-example-value">chmod 0755 ./deploy.sh</span>
          <span class="__PREFIX__-example-helper">Directory mode affects the leading character in the preview and lets symbolic <code>X</code> add execute where directory semantics make sense.</span>
        </div>

        <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
          <label class="__PREFIX__-setting-label">
            Target profile:
            <span class="info-dot __PREFIX__-helper-chip" title="Preset, target type, and directory recursion define the normal chmod target shape">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-stacked-grid">
              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two">
                <div class="__PREFIX__-native-select-wrap">
                  <select id="__DOM_ID_PREFIX__Preset" class="form-select __PREFIX__-native-select">
                    <option value="deploy-script" selected>Deploy script (0755)</option>
                    <option value="private-config">Private config (0640)</option>
                    <option value="web-file">Web file (0644)</option>
                    <option value="web-directory">Web directory (0755)</option>
                    <option value="group-directory">Group directory (2775)</option>
                    <option value="shared-temp">Shared temp (1777)</option>
                    <option value="manual">Current mode</option>
                  </select>
                </div>

                <button type="button" class="__PREFIX__-secondary-btn" id="__DOM_ID_PREFIX__ApplyPreset">Apply preset</button>
              </div>

              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two">
                <div class="__PREFIX__-native-select-wrap">
                  <select id="__DOM_ID_PREFIX__TargetType" class="form-select __PREFIX__-native-select">
                    <option value="file" selected>File</option>
                    <option value="directory">Directory</option>
                  </select>
                </div>

                <label class="switch __PREFIX__-switch-wrap __PREFIX__-switch-card">
                  <input type="checkbox" id="__DOM_ID_PREFIX__Recursive">
                  <span class="slider"></span>
                  <span class="__PREFIX__-switch-label">Recursive (-R)</span>
                </label>
              </div>

            </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
          <label class="__PREFIX__-setting-label">
            Permissions:
            <span class="info-dot __PREFIX__-helper-chip" title="Toggle read, write, and execute for user, group, and others">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-permission-grid">
              <section class="__PREFIX__-scope-card">
                <div class="__PREFIX__-scope-head">
                  <div>
                    <span class="__PREFIX__-scope-title">User</span>
                    <span class="__PREFIX__-scope-copy">Owner bits</span>
                  </div>
                  <span class="__PREFIX__-scope-octal" data-scope-octal="user">7</span>
                </div>

                <div class="__PREFIX__-scope-toggle-grid">
                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="user" data-permission="read" checked>
                    <span class="__PREFIX__-perm-token">r</span>
                    <span class="__PREFIX__-perm-copy">Read</span>
                  </label>

                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="user" data-permission="write" checked>
                    <span class="__PREFIX__-perm-token">w</span>
                    <span class="__PREFIX__-perm-copy">Write</span>
                  </label>

                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="user" data-permission="execute" checked>
                    <span class="__PREFIX__-perm-token">x</span>
                    <span class="__PREFIX__-perm-copy">Execute</span>
                  </label>
                </div>
              </section>

              <section class="__PREFIX__-scope-card">
                <div class="__PREFIX__-scope-head">
                  <div>
                    <span class="__PREFIX__-scope-title">Group</span>
                    <span class="__PREFIX__-scope-copy">Shared bits</span>
                  </div>
                  <span class="__PREFIX__-scope-octal" data-scope-octal="group">5</span>
                </div>

                <div class="__PREFIX__-scope-toggle-grid">
                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="group" data-permission="read" checked>
                    <span class="__PREFIX__-perm-token">r</span>
                    <span class="__PREFIX__-perm-copy">Read</span>
                  </label>

                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="group" data-permission="write">
                    <span class="__PREFIX__-perm-token">w</span>
                    <span class="__PREFIX__-perm-copy">Write</span>
                  </label>

                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="group" data-permission="execute" checked>
                    <span class="__PREFIX__-perm-token">x</span>
                    <span class="__PREFIX__-perm-copy">Execute</span>
                  </label>
                </div>
              </section>

              <section class="__PREFIX__-scope-card">
                <div class="__PREFIX__-scope-head">
                  <div>
                    <span class="__PREFIX__-scope-title">Others</span>
                    <span class="__PREFIX__-scope-copy">Public bits</span>
                  </div>
                  <span class="__PREFIX__-scope-octal" data-scope-octal="others">5</span>
                </div>

                <div class="__PREFIX__-scope-toggle-grid">
                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="others" data-permission="read" checked>
                    <span class="__PREFIX__-perm-token">r</span>
                    <span class="__PREFIX__-perm-copy">Read</span>
                  </label>

                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="others" data-permission="write">
                    <span class="__PREFIX__-perm-token">w</span>
                    <span class="__PREFIX__-perm-copy">Write</span>
                  </label>

                  <label class="__PREFIX__-perm-toggle">
                    <input type="checkbox" data-scope="others" data-permission="execute" checked>
                    <span class="__PREFIX__-perm-token">x</span>
                    <span class="__PREFIX__-perm-copy">Execute</span>
                  </label>
                </div>
              </section>
            </div>
          </div>
        </div>

      </div>
    </div>

    {# ns:end family._base.workspace.02_basic-settings #}
    {# ns:start family._base.workspace.03_custom-settings #}
    <details class="__PREFIX__-advanced" data-custom-layout="compact_two_column_multi_row">
      <summary class="__PREFIX__-advanced-summary">
        <span>Custom</span>
          <span class="__PREFIX__-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="__PREFIX__-advanced-body">
          <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
            <label class="__PREFIX__-setting-label">
              Command flags:
              <span class="info-dot __PREFIX__-helper-chip" title="Optional chmod flags that change command output or traversal behavior">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-stacked-grid">
                <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two">
                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Verbose output (-v)</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Verbose">
                  </label>
                </div>

                <div class="__PREFIX__-flag-hint">Verbose mode adds <code>-v</code> so chmod reports changed files when the command runs in a real shell.</div>
              </div>
            </div>
          </div>

          <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
            <label class="__PREFIX__-setting-label">
              Special bits:
              <span class="info-dot __PREFIX__-helper-chip" title="Setuid, setgid, and sticky add the leading chmod digit and alter ls output">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
                <label class="__PREFIX__-special-toggle">
                  <input type="checkbox" id="__DOM_ID_PREFIX__Setuid">
                  <span class="__PREFIX__-special-token">u+s</span>
                  <span class="__PREFIX__-special-body">
                    <span class="__PREFIX__-special-title">Setuid</span>
                    <span class="__PREFIX__-special-copy">Owner identity on execution.</span>
                  </span>
                </label>

                <label class="__PREFIX__-special-toggle">
                  <input type="checkbox" id="__DOM_ID_PREFIX__Setgid">
                  <span class="__PREFIX__-special-token">g+s</span>
                  <span class="__PREFIX__-special-body">
                    <span class="__PREFIX__-special-title">Setgid</span>
                    <span class="__PREFIX__-special-copy">Group inheritance or execution identity.</span>
                  </span>
                </label>

                <label class="__PREFIX__-special-toggle">
                  <input type="checkbox" id="__DOM_ID_PREFIX__Sticky">
                  <span class="__PREFIX__-special-token">o+t</span>
                  <span class="__PREFIX__-special-body">
                    <span class="__PREFIX__-special-title">Sticky</span>
                    <span class="__PREFIX__-special-copy">Delete protection on shared directories.</span>
                  </span>
                </label>
              </div>
            </div>
          </div>

          <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
            <label for="__DOM_ID_PREFIX__NumericMode" class="__PREFIX__-setting-label">
              Direct editing:
              <span class="info-dot __PREFIX__-helper-chip" title="Numeric and symbolic modes replace the current state; operations mutate it">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-stacked-grid">
                <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-two">
                  <div class="__PREFIX__-editor-stack">
                    <input
                      type="text"
                      id="__DOM_ID_PREFIX__NumericMode"
                      class="form-control __PREFIX__-text-field"
                      placeholder="0755 or 2755"
                      value="0755"
                    >
                    <div class="__PREFIX__-feedback d-none" id="__DOM_ID_PREFIX__NumericFeedback"></div>
                  </div>

                  <div class="__PREFIX__-editor-stack">
                    <input
                      type="text"
                      id="__DOM_ID_PREFIX__SymbolicMode"
                      class="form-control __PREFIX__-text-field"
                      placeholder="u=rwx,g=rx,o=rx"
                      value="u=rwx,g=rx,o=rx"
                    >
                    <div class="__PREFIX__-feedback d-none" id="__DOM_ID_PREFIX__SymbolicFeedback"></div>
                  </div>
                </div>

                <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-operation">
                  <input
                    type="text"
                    id="__DOM_ID_PREFIX__Operation"
                    class="form-control __PREFIX__-text-field"
                    placeholder="a+rwX, g=u, u-s"
                  >

                  <button type="button" class="__PREFIX__-secondary-btn" id="__DOM_ID_PREFIX__ApplyOperation">Apply</button>
                </div>

                <div class="__PREFIX__-quick-actions">
                  <button type="button" class="__PREFIX__-action-chip" data-operation="u=rwx,go=rx">u=rwx,go=rx</button>
                  <button type="button" class="__PREFIX__-action-chip" data-operation="a+rwX">a+rwX</button>
                  <button type="button" class="__PREFIX__-action-chip" data-operation="g+w">g+w</button>
                  <button type="button" class="__PREFIX__-action-chip" data-operation="o-rwx">o-rwx</button>
                  <button type="button" class="__PREFIX__-action-chip" data-operation="u-s,g-s,o-t">clear s/t</button>
                </div>

                <div class="__PREFIX__-feedback d-none" id="__DOM_ID_PREFIX__OperationFeedback"></div>
                <div class="__PREFIX__-field-hint">Absolute symbolic mode expects assignment clauses such as <code>u=rw,g=r,o=</code>. Use the operation field for incremental changes.</div>
              </div>
            </div>
          </div>

          <div class="__PREFIX__-setting-row __PREFIX__-setting-row-stacked __PREFIX__-setting-card">
            <label for="__DOM_ID_PREFIX__Umask" class="__PREFIX__-setting-label">
              Umask explorer:
              <span class="info-dot __PREFIX__-helper-chip" title="Preview how a umask clears bits from standard file and directory base modes">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-stacked-grid">
                <div class="__PREFIX__-inline-grid __PREFIX__-inline-grid-three">
                  <div class="__PREFIX__-umask-input">
                    <label class="__PREFIX__-field-label" for="__DOM_ID_PREFIX__Umask">Umask</label>
                    <input
                      type="text"
                      id="__DOM_ID_PREFIX__Umask"
                      class="form-control"
                      inputmode="numeric"
                      placeholder="Umask, e.g. 022"
                      value="022"
                    >
                  </div>

                  <div class="__PREFIX__-umask-input">
                    <label class="__PREFIX__-field-label" for="__DOM_ID_PREFIX__UmaskFileBase">File base</label>
                    <input
                      type="text"
                      id="__DOM_ID_PREFIX__UmaskFileBase"
                      class="form-control"
                      inputmode="numeric"
                      placeholder="File base, e.g. 666"
                      value="666"
                    >
                  </div>

                  <div class="__PREFIX__-umask-input">
                    <label class="__PREFIX__-field-label" for="__DOM_ID_PREFIX__UmaskDirBase">Directory base</label>
                    <input
                      type="text"
                      id="__DOM_ID_PREFIX__UmaskDirBase"
                      class="form-control"
                      inputmode="numeric"
                      placeholder="Directory base, e.g. 777"
                      value="777"
                    >
                  </div>
                </div>

                <div class="__PREFIX__-umask-grid">
                  <div class="__PREFIX__-umask-card">
                    <span class="__PREFIX__-umask-label">File result</span>
                    <span class="__PREFIX__-umask-mode" id="__DOM_ID_PREFIX__UmaskFileNumeric">0644</span>
                    <span class="__PREFIX__-umask-symbolic" id="__DOM_ID_PREFIX__UmaskFileSymbolic">u=rw,g=r,o=r</span>
                  </div>

                  <div class="__PREFIX__-umask-card">
                    <span class="__PREFIX__-umask-label">Directory result</span>
                    <span class="__PREFIX__-umask-mode" id="__DOM_ID_PREFIX__UmaskDirNumeric">0755</span>
                    <span class="__PREFIX__-umask-symbolic" id="__DOM_ID_PREFIX__UmaskDirSymbolic">u=rwx,g=rx,o=rx</span>
                  </div>
                </div>

                <div class="__PREFIX__-feedback d-none" id="__DOM_ID_PREFIX__UmaskFeedback"></div>
                <div class="__PREFIX__-flag-hint __PREFIX__-umask-note">
                  <span>Files commonly start from <code>0666</code>.</span>
                  <span>Directories commonly start from <code>0777</code>.</span>
                  <span>The umask removes bits from those bases.</span>
                </div>
              </div>
            </div>
          </div>
      </div>
    </details>
  </form>
    {# ns:end family._base.workspace.03_custom-settings #}

  {# ns:start family._base.workspace.05_result-summary #}
  {# ns:start family.shell.workspace.04_result-text #}
  <div class="__PREFIX__-result-panel" id="__DOM_ID_PREFIX__ResultPanel" aria-label="Command output">
    <div class="tool-empty-state __PREFIX__-result-empty" id="__DOM_ID_PREFIX__ResultEmpty">Generate a chmod mode to inspect the command, permission tables, operation effects, warnings, and normalized JSON payload.</div>

    <div class="__PREFIX__-output-content __PREFIX__-result-content d-none" id="__DOM_ID_PREFIX__ResultContent">
      <div class="__PREFIX__-output-inner __PREFIX__-result-shell">
  {# ns:end family.shell.workspace.04_result-text #}
  {# ns:end family._base.workspace.05_result-summary #}
        <div class="__PREFIX__-result-summary" id="__DOM_ID_PREFIX__ResultSummary" data-share-snapshot-source data-share-kind="shell-summary"></div>

        {# ns:start family._base.workspace.06_output-toolbar #}
        <div class="__TOOL_CLASS__bar-shell">
          <div class="__TOOL_CLASS__bar tool-output-toolbar tool-result-toolbar">
            <div class="__TOOL_CLASS__bar-main">
              <label for="__DOM_ID_PREFIX__Sort" class="__PREFIX__-sort-label">Sort</label>
              <div class="__PREFIX__-sort-wrap">
                <details class="__PREFIX__-sort-select" id="__DOM_ID_PREFIX__SortSelect">
                  <summary class="__PREFIX__-sort-summary" aria-haspopup="listbox" aria-expanded="false" aria-controls="__DOM_ID_PREFIX__SortMenu">
                    <span id="__DOM_ID_PREFIX__SortSummary">ID</span>
                  </summary>

                  <div class="__PREFIX__-sort-menu" id="__DOM_ID_PREFIX__SortMenu" role="listbox">
                    <div class="__PREFIX__-sort-grid">
                      <button type="button" class="__PREFIX__-sort-option is-active" data-sort-value="id" aria-pressed="true" role="option">ID</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="alphabetical" aria-pressed="false" role="option">A-Z</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="field" aria-pressed="false" role="option">Field</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="value" aria-pressed="false" role="option">Value</button>
                      <button type="button" class="__PREFIX__-sort-option" data-sort-value="length" aria-pressed="false" role="option">Length</button>
                    </div>
                  </div>
                </details>
                <input type="hidden" id="__DOM_ID_PREFIX__Sort" value="id">
              </div>
            </div>

            <div class="tool-output-actions __TOOL_CLASS__bar-actions tool-result-toolbar-actions">
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn tool-result-action-btn" id="__DOM_ID_PREFIX__ExportPdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn tool-result-action-btn" id="__DOM_ID_PREFIX__DownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn tool-result-action-btn" id="__DOM_ID_PREFIX__CopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn tool-result-action-btn" id="__DOM_ID_PREFIX__DownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="tool-action-btn tool-action-btn-ghost __PREFIX__-action-btn tool-result-action-btn" id="__DOM_ID_PREFIX__ImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
        </div>

        {# ns:end family._base.workspace.06_output-toolbar #}
        {# ns:start family._base.workspace.07_table-output #}
        <div class="__PREFIX__-tabs-shell">
          <div class="tool-tabs __PREFIX__-tabs" role="tablist" aria-label="chmod command output views">

            <button type="button" class="tool-tab-btn __PREFIX__-tab-btn active" id="__DOM_ID_PREFIX__OperationsTab" data-tab-target="__DOM_ID_PREFIX__OperationsPanel" role="tab" aria-controls="__DOM_ID_PREFIX__OperationsPanel" aria-selected="true" tabindex="0">
              <i class="bi bi-list-check" aria-hidden="true"></i>
              <span>Operations</span>
            </button>
<button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__CommandTab" data-tab-target="__DOM_ID_PREFIX__CommandPanel" role="tab" aria-controls="__DOM_ID_PREFIX__CommandPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-terminal" aria-hidden="true"></i>
              <span>Command</span>
            </button>
            <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__DetailsTab" data-tab-target="__DOM_ID_PREFIX__DetailsPanel" role="tab" aria-controls="__DOM_ID_PREFIX__DetailsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-card-text" aria-hidden="true"></i>
              <span>Details</span>
            </button>
            <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__WarningsTab" data-tab-target="__DOM_ID_PREFIX__WarningsPanel" role="tab" aria-controls="__DOM_ID_PREFIX__WarningsPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-card-text" aria-hidden="true"></i>
              <span>Warnings</span>
            </button>
            <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__JsonTab" data-tab-target="__DOM_ID_PREFIX__JsonPanel" role="tab" aria-controls="__DOM_ID_PREFIX__JsonPanel" aria-selected="false" tabindex="-1">
              <i class="bi bi-braces" aria-hidden="true"></i>
              <span>JSON</span>
            </button>
          </div>

          <div class="tool-tab-panel __PREFIX__-tab-panel" id="__DOM_ID_PREFIX__CommandPanel" data-tab-panel="__DOM_ID_PREFIX__CommandPanel" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__CommandTab" hidden>
            <div class="__PREFIX__-surface-stack tool-result-section-stack">
              <section class="__PREFIX__-section-card tool-result-section-card">
                <div class="__PREFIX__-section-head">
                  <h3 class="__PREFIX__-section-title tool-result-section-title">Chmod Command</h3>
                  <div class="__PREFIX__-section-actions">
                    <button type="button" class="__PREFIX__-action-btn" id="__DOM_ID_PREFIX__CopyCommand" aria-label="Copy generated chmod command" title="Copy generated chmod command">
                      <i class="bi bi-clipboard" aria-hidden="true"></i>
                      <span class="__PREFIX__-command-copy-label tool-sr-only">Copy</span>
                    </button>
                  </div>
                </div>
                <pre class="__PREFIX__-code-pre"><code id="__DOM_ID_PREFIX__CommandOutput" data-share-snapshot-source data-share-kind="shell-command"></code></pre>
              </section>

              <section class="__PREFIX__-section-card tool-result-section-card">
                <h3 class="__PREFIX__-section-title tool-result-section-title">ls -l Preview</h3>
