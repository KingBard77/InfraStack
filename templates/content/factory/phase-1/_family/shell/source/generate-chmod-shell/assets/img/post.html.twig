{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.__PREFIX__-post-visual {
    --post-start: #0d9488;
    --post-end: #2dd4bf;
    --post-accent: #ccfbf1;
}

.__PREFIX__-post-visual .tool-post-node:nth-child(1),
.__PREFIX__-post-visual .tool-post-node:nth-child(3),
.__PREFIX__-post-visual .tool-post-node:nth-child(5) {
    background: rgba(204, 251, 241, 0.24);
}

.__PREFIX__-post-visual .tool-post-icon {
    background: rgba(13, 148, 136, 0.28);
}
</style>
{% else %}
<div
  class="tool-post-visual __PREFIX__-post-visual tool-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#0d9488') }}; --post-end: {{ post.card_gradient_end|default('#2dd4bf') }};"
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="bi bi-shield-lock"></i>
    <i class="bi bi-terminal"></i>
    <i class="bi bi-file-lock2"></i>
    <i class="bi bi-braces"></i>
    <i class="bi bi-clipboard-check"></i>
  </div>
  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('Shell')) }}</span>
    <span class="tool-post-icon"><i class="{{ post.card_icon_class|default('bi bi-shield-lock') }}"></i></span>
  </div>
  <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('__TOOL_TITLE__')) }}</div>
  <div class="tool-post-map" aria-hidden="true">
    <span class="tool-post-node"><i class="bi bi-terminal"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-shield-lock"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-clipboard-check"></i></span>
  </div>
  <div class="tool-post-footer">
    <span>{{ post.reading_time|default('8 min read') }}</span>
    <span>{{ post.category|default('Shell') }}</span>
  </div>
  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-chevron-down"></i> {{ post.date_display|default('Apr. 5th, 2026') }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('Shell') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('8 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('__TOOL_TITLE__') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
