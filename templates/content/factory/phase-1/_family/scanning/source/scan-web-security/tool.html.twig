<div class="__TOOL_CLASS__" data-tool-slug="__TOOL_SLUG__" data-tool-category="Security">
  <div class="tool-box mb-4">
    <section class="tool-shell __PREFIX__-input-shell" id="__DOM_ID_PREFIX__InputShell" aria-label="Scan target">
      <div class="tool-shell-body">
        <form class="__PREFIX__-form" id="__DOM_ID_PREFIX__Form">
          <div class="__PREFIX__-input-card">
            <div class="__PREFIX__-input-brief" data-input-layout="inline">
              <div class="__PREFIX__-main-row __PREFIX__-input-row">
                <div class="__PREFIX__-input-label-wrap">
                  <label for="__DOM_ID_PREFIX__Url" class="__PREFIX__-main-label __PREFIX__-input-label">URL target:</label>
                  <span class="__PREFIX__-helper-chip" title="Enter the public URL you want to review for visible security posture signals" aria-label="Enter the public URL you want to review for visible security posture signals">i</span>
                </div>

                <div class="__PREFIX__-target-grid __PREFIX__-main-input-grid __PREFIX__-input-stack">
                  <input
                    type="text"
                    id="__DOM_ID_PREFIX__Url"
                    class="form-control __PREFIX__-input-control __PREFIX__-text-field"
                    placeholder="https://example.com"
                    value="https://example.com"
                  >
                  <div class="__PREFIX__-input-error d-none" id="__DOM_ID_PREFIX__InputError" role="alert"></div>
                </div>
              </div>

              <div class="__PREFIX__-main-actions __PREFIX__-input-actions">
                <button
                  type="submit"
                  class="btn btn-primary __PREFIX__-submit-btn __PREFIX__-action-btn __PREFIX__-action-btn-primary"
                  id="__DOM_ID_PREFIX__Submit"
                  data-tool-share-generate
                >
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  <span>Scan</span>
                </button>
              </div>

              <div class="__PREFIX__-input-helper-card">
                <span class="__PREFIX__-input-hint">Use a valid target and review evidence before treating scan output as actionable.</span>
                <span class="__PREFIX__-helper-chip __PREFIX__-helper-chip-inline" title="Enter the public URL you want to review for visible security posture signals" aria-label="Enter the public URL you want to review for visible security posture signals">i</span>
              </div>
            </div>
          </div>

{# ns:start family._base.workspace.02_basic-settings #}
          <div class="__PREFIX__-basic-panel">
            <div class="__PREFIX__-inner-panel __PREFIX__-basic-card">
              <div class="__PREFIX__-example-card">
                <span class="__PREFIX__-example-label">Example scan settings</span>
                <strong class="__PREFIX__-example-value">HEAD method, redirects on, 12 second timeout</strong>
                <span class="__PREFIX__-example-helper">Keep the request path short before opening deeper probe behavior.</span>
              </div>

              <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                <label for="__DOM_ID_PREFIX__Method" class="__PREFIX__-setting-label">
                  Method preference:
                  <span class="info-dot __PREFIX__-helper-chip" title="Use HEAD for lightweight checks or GET when the server behaves differently for normal content delivery">i</span>
                </label>

                <div class="__PREFIX__-setting-field">
                                    <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__MethodSelect">
                    <select id="__DOM_ID_PREFIX__Method" class="form-select __PREFIX__-native-select">
                      <option value="HEAD" selected>HEAD</option>
                      <option value="GET">GET</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                <label for="__DOM_ID_PREFIX__Timeout" class="__PREFIX__-setting-label">
                  Timeout (seconds):
                  <span class="info-dot __PREFIX__-helper-chip" title="Maximum wait time for the primary scan and companion probes">i</span>
                </label>

                <div class="__PREFIX__-setting-field __PREFIX__-timeout-wrap">
                  <input
                    type="number"
                    id="__DOM_ID_PREFIX__Timeout"
                    class="form-control __PREFIX__-text-field"
                    value="12"
                    min="1"
                    max="30"
                    step="1"
                    placeholder="12"
                  >
                  <span class="__PREFIX__-timeout-unit">s</span>
                </div>
              </div>

              <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                <label for="__DOM_ID_PREFIX__FollowRedirects" class="__PREFIX__-setting-label">
                  Follow redirects:
                  <span class="info-dot __PREFIX__-helper-chip" title="Keep enabled to inspect the final destination reached by the target">i</span>
                </label>

                <div class="__PREFIX__-setting-field">
                  <label class="__PREFIX__-custom-checkbox-option">
                    <input type="checkbox" id="__DOM_ID_PREFIX__FollowRedirects" checked>
                    <span>Enabled</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
          <details class="__PREFIX__-advanced" data-custom-layout="compact_one_column">
            <summary class="__PREFIX__-advanced-summary">
              <span>Custom</span>
              <span class="__PREFIX__-custom-arrow-slot" aria-hidden="true"></span>
            </summary>

            <div class="__PREFIX__-advanced-body">
              <div class="__PREFIX__-inner-panel">
                <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                  <label for="__DOM_ID_PREFIX__ValidateTls" class="__PREFIX__-setting-label">
                    Validate TLS certificate:
                    <span class="info-dot __PREFIX__-helper-chip" title="Keep enabled unless you are intentionally reviewing an invalid or staging certificate">i</span>
                  </label>

                  <div class="__PREFIX__-setting-field">
                    <label class="__PREFIX__-custom-checkbox-option">
                      <input type="checkbox" id="__DOM_ID_PREFIX__ValidateTls" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                  <label for="__DOM_ID_PREFIX__FallbackGet" class="__PREFIX__-setting-label">
                    Fallback GET on 405:
                    <span class="info-dot __PREFIX__-helper-chip" title="Retry the target with GET when HEAD is rejected by the server">i</span>
                  </label>

                  <div class="__PREFIX__-setting-field">
                    <label class="__PREFIX__-custom-checkbox-option">
                      <input type="checkbox" id="__DOM_ID_PREFIX__FallbackGet" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                  <label for="__DOM_ID_PREFIX__UserAgent" class="__PREFIX__-setting-label">
                    User-Agent profile:
                    <span class="info-dot __PREFIX__-helper-chip" title="Use a different client profile when response behavior depends on the requester">i</span>
                  </label>

                  <div class="__PREFIX__-setting-field">
                                        <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__UserAgentSelect">
                      <select id="__DOM_ID_PREFIX__UserAgent" class="form-select __PREFIX__-native-select">
                        <option value="default" selected>Default client</option>
                        <option value="desktop">Desktop browser</option>
                        <option value="mobile">Mobile browser</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                  <label for="__DOM_ID_PREFIX__WellKnown" class="__PREFIX__-setting-label">
                    Check well-known files:
                    <span class="info-dot __PREFIX__-helper-chip" title="Probe for standard public files such as security.txt and robots.txt">i</span>
                  </label>

                  <div class="__PREFIX__-setting-field">
                    <label class="__PREFIX__-custom-checkbox-option">
                      <input type="checkbox" id="__DOM_ID_PREFIX__WellKnown" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>

                <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
                  <label for="__DOM_ID_PREFIX__HttpUpgrade" class="__PREFIX__-setting-label">
                    Probe HTTP upgrade path:
                    <span class="info-dot __PREFIX__-helper-chip" title="Test whether the HTTP version of the target upgrades to HTTPS">i</span>
                  </label>

                  <div class="__PREFIX__-setting-field">
                    <label class="__PREFIX__-custom-checkbox-option">
                      <input type="checkbox" id="__DOM_ID_PREFIX__HttpUpgrade" checked>
                      <span>Enabled</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </details>
{# ns:end family._base.workspace.03_custom-settings #}
        </form>
      </div>
    </section>

    <div class="__PREFIX__-result-panel" id="__DOM_ID_PREFIX__Panel" aria-label="Scan results">
          <div class="__PREFIX__-result-empty" id="__DOM_ID_PREFIX__ResultEmpty">Run a web security scan to review visible hardening gaps, response headers, cookies, and well-known security files.</div>

          <div class="__PREFIX__-result-content d-none" id="__DOM_ID_PREFIX__ResultContent">
            <div class="__PREFIX__-result-summary" id="__DOM_ID_PREFIX__ResultSummary" data-share-snapshot-source data-share-kind="scan-summary"></div>

{# ns:start family._base.workspace.06_output-toolbar #}
            <div class="__TOOL_CLASS__bar-shell">
              <div class="__TOOL_CLASS__bar tool-output-toolbar">
                <div class="__TOOL_CLASS__bar-left tool-result-toolbar-main">
                  <label for="__DOM_ID_PREFIX__Sort" class="__PREFIX__-sort-label">Sort</label>
                  <div class="__PREFIX__-sort-wrap">
                    <details class="__PREFIX__-sort-select" id="__DOM_ID_PREFIX__SortSelect">
                      <summary class="__PREFIX__-sort-summary">
                        <span id="__DOM_ID_PREFIX__SortSummary">ID</span>
                      </summary>

                      <div class="__PREFIX__-sort-menu">
                        <div class="__PREFIX__-sort-grid">
                          <button type="button" class="__PREFIX__-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                          <button type="button" class="__PREFIX__-sort-option" data-sort-value="severity" aria-pressed="false">Severity</button>
                          <button type="button" class="__PREFIX__-sort-option" data-sort-value="status" aria-pressed="false">Status</button>
                          <button type="button" class="__PREFIX__-sort-option" data-sort-value="category" aria-pressed="false">Category</button>
                          <button type="button" class="__PREFIX__-sort-option" data-sort-value="evidence" aria-pressed="false">Evidence</button>
                        </div>
                      </div>
                    </details>
                    <input type="hidden" id="__DOM_ID_PREFIX__Sort" value="id">
                  </div>
                </div>

                <div class="__TOOL_CLASS__bar-actions tool-output-actions">
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__ExportPdf">
                    <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                    <span data-button-label>Export PDF</span>
                  </button>
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__DownloadCsv">
                    <i class="bi bi-table" aria-hidden="true"></i>
                    <span data-button-label>Download CSV</span>
                  </button>
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__CopyJson">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                    <span data-button-label>Copy JSON</span>
                  </button>
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__DownloadJson">
                    <i class="bi bi-download" aria-hidden="true"></i>
                    <span data-button-label>Download JSON</span>
                  </button>
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-ghost" id="__DOM_ID_PREFIX__ImportJsonButton">
                    <i class="bi bi-upload" aria-hidden="true"></i>
                    <span data-button-label>Import JSON</span>
                  </button>
                </div>
              </div>
            </div>
{# ns:end family._base.workspace.06_output-toolbar #}

            <div class="__PREFIX__-tabs-shell">
              <div class="__PREFIX__-tabs tool-tabs" role="tablist" aria-label="Web security output views">
                <button type="button" class="tool-tab-btn __PREFIX__-tab-btn active" id="__DOM_ID_PREFIX__FindingsTab" data-tab-target="findings" role="tab" aria-controls="__DOM_ID_PREFIX__FindingsPanel" aria-selected="true" tabindex="0">
                  <i class="bi bi-list-check" aria-hidden="true"></i>
                  <span>Findings</span>
                </button>
                <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__HeadersTab" data-tab-target="headers" role="tab" aria-controls="__DOM_ID_PREFIX__HeadersPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-table" aria-hidden="true"></i>
                  <span>Header Matrix</span>
                </button>
                <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__TransportTab" data-tab-target="transport" role="tab" aria-controls="__DOM_ID_PREFIX__TransportPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-hdd-network" aria-hidden="true"></i>
                  <span>Transport</span>
                </button>
                <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__SurfaceTab" data-tab-target="surface" role="tab" aria-controls="__DOM_ID_PREFIX__SurfacePanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  <span>Files &amp; Cookies</span>
                </button>
                <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__JsonTab" data-tab-target="json" role="tab" aria-controls="__DOM_ID_PREFIX__JsonPanel" aria-selected="false" tabindex="-1">
                  <i class="bi bi-braces" aria-hidden="true"></i>
                  <span>JSON</span>
                </button>
              </div>
              <div class="__PREFIX__-tab-panel" id="__DOM_ID_PREFIX__FindingsPanel" data-tab-panel="findings" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__FindingsTab">
                <div class="__PREFIX__-section-card tool-result-section-card">
                  <h3 class="__PREFIX__-section-title tool-result-section-title">Findings</h3>
                  <div class="table-responsive __PREFIX__-table-wrap tool-result-table-wrap">
                    <table class="table __PREFIX__-findings-table mb-0 tool-result-table" data-share-snapshot-source data-share-kind="severity-table">
                      <thead>
                        <tr>
                          <th class="tool-generated-rownum-head">#</th>
                          <th>Category</th>
                          <th>Control</th>
                          <th>Status</th>
                          <th>Evidence</th>
                          <th>Recommendation</th>
                          <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                        </tr>
                      </thead>
                      <tbody id="__DOM_ID_PREFIX__FindingTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div class="__PREFIX__-tab-panel d-none" id="__DOM_ID_PREFIX__HeadersPanel" data-tab-panel="headers" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__HeadersTab" hidden>
                <div class="__PREFIX__-section-card tool-result-section-card">
                  <h3 class="__PREFIX__-section-title tool-result-section-title">Header Matrix</h3>
                  <div class="table-responsive __PREFIX__-table-wrap tool-result-table-wrap">
                    <table class="table __PREFIX__-headers-table mb-0 tool-result-table">
                      <thead>
                        <tr>
                          <th class="tool-generated-rownum-head">#</th>
                          <th>Category</th>
                          <th>Header</th>
                          <th>Value</th>
                          <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                        </tr>
                      </thead>
                      <tbody id="__DOM_ID_PREFIX__HeaderTableBody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <div class="__PREFIX__-tab-panel d-none" id="__DOM_ID_PREFIX__TransportPanel" data-tab-panel="transport" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__TransportTab" hidden>
                <section class="__PREFIX__-section-card tool-result-section-card">
                    <h3 class="__PREFIX__-section-title tool-result-section-title">Transport Summary</h3>
                    <div class="table-responsive __PREFIX__-table-wrap tool-result-table-wrap">
                      <table class="table __PREFIX__-surface-table mb-0 tool-result-table tool-result-table--compact">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Field</th>
                            <th>Value</th>
                            <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                          </tr>
                        </thead>
                        <tbody id="__DOM_ID_PREFIX__TransportTableBody"></tbody>
                      </table>
                    </div>
                  </section>
              </div>

              <div class="__PREFIX__-tab-panel d-none" id="__DOM_ID_PREFIX__SurfacePanel" data-tab-panel="surface" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__SurfaceTab" hidden>
                <div class="__PREFIX__-surface-stack tool-result-section-stack">

                  <section class="__PREFIX__-section-card tool-result-section-card">
                    <h3 class="__PREFIX__-section-title tool-result-section-title">Well-Known Files</h3>
                    <div class="table-responsive __PREFIX__-table-wrap tool-result-table-wrap">
                      <table class="table __PREFIX__-surface-table __PREFIX__-known-files-table mb-0 tool-result-table tool-result-table--compact">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Path</th>
                            <th>Status</th>
                            <th>Note</th>
                            <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                          </tr>
                        </thead>
                        <tbody id="__DOM_ID_PREFIX__KnownFileTableBody"></tbody>
                      </table>
                    </div>
                  </section>

                  <section class="__PREFIX__-section-card tool-result-section-card">
                    <h3 class="__PREFIX__-section-title tool-result-section-title">Cookies</h3>
                    <div class="table-responsive __PREFIX__-table-wrap tool-result-table-wrap">
                      <table class="table __PREFIX__-cookies-table mb-0 tool-result-table">
                        <thead>
                          <tr>
                            <th class="tool-generated-rownum-head">#</th>
                            <th>Name</th>
                            <th>Secure</th>
                            <th>HttpOnly</th>
                            <th>SameSite</th>
                            <th>Issues</th>
                            <th class="tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                          </tr>
                        </thead>
                        <tbody id="__DOM_ID_PREFIX__CookieTableBody"></tbody>
                      </table>
                    </div>
                  </section>
                </div>
              </div>

              <div class="__PREFIX__-tab-panel d-none" id="__DOM_ID_PREFIX__JsonPanel" data-tab-panel="json" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__JsonTab" hidden>
                              <div class="__PREFIX__-json-restore-shell" id="__DOM_ID_PREFIX__JsonRestoreShell">
                <section class="__PREFIX__-json-card tool-json-panel" aria-label="Scanner JSON evidence and restore state">
                  <div class="__PREFIX__-json-head tool-json-head">
                    <div class="__PREFIX__-json-title-wrap">
                      <span class="__PREFIX__-json-title tool-json-title">JSON Output</span>
                      <span class="__PREFIX__-json-helper">Exported scan state should include target, options, evidence, findings, and generated output.</span>
                    </div>
                    <span class="__PREFIX__-json-status is-hidden" id="__DOM_ID_PREFIX__JsonRestoreStatus" role="status" aria-live="polite"></span>
                  </div>
                  <div class="__PREFIX__-json-empty is-hidden" id="__DOM_ID_PREFIX__JsonRestoreEmpty">Run a scan before exporting JSON.</div>
                  <pre class="__PREFIX__-json-output tool-json-output"><code id="__DOM_ID_PREFIX__JsonOutput"></code></pre>
                </section>
              </div>
            </div>
          </div>

          <div class="__PREFIX__-result-error d-none" id="__DOM_ID_PREFIX__ResultError"></div>
    </div>
    <input type="file" id="__DOM_ID_PREFIX__ImportJson" class="__PREFIX__-import-input d-none" accept="application/json">
  </div>
</div>
</div>
