{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.__PREFIX__-post-visual {
    --post-start: #475569;
    --post-end: #64748B;
    --post-accent: #facc15;
}

.__PREFIX__-post-visual .tool-post-node:nth-child(1),
.__PREFIX__-post-visual .tool-post-node:nth-child(3),
.__PREFIX__-post-visual .tool-post-node:nth-child(5) {
    background: rgba(250, 204, 21, 0.18);
}

.__PREFIX__-post-visual .tool-post-icon {
    background: rgba(22, 163, 74, 0.26);
}

.__PREFIX__-post-visual .tool-post-icon svg {
    width: 1.75rem;
    height: 1.75rem;
    display: block;
}
</style>
{% else %}
<div
  class="tool-post-visual __PREFIX__-post-visual tool-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#475569') }}; --post-end: {{ post.card_gradient_end|default('#64748B') }};"
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="bi bi-shield-check"></i>
    <i class="bi bi-terminal"></i>
    <i class="bi bi-lock"></i>
    <i class="bi bi-file-earmark-code"></i>
    <i class="bi bi-ui-checks-grid"></i>
  </div>
  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('CIS')) }}</span>
    <span class="tool-post-icon">{{ include('content/tools/__CATEGORY__/__TOOL_SLUG__/assets/icon/cis-tool-__TOOL_SLUG__.svg')|raw }}</span>
  </div>
  <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('__TOOL_TITLE__')) }}</div>
  <div class="tool-post-map" aria-hidden="true">
    <span class="tool-post-node"><i class="bi bi-terminal"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-shield-check"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-file-earmark-code"></i></span>
  </div>
  <div class="tool-post-footer">
    <span>{{ post.reading_time|default('7 min read') }}</span>
    <span>{{ post.category|default('CIS') }}</span>
  </div>
  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-chevron-down"></i> {{ post.date_display|default('Mar. 20th, 2026') }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('CIS') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('7 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('__TOOL_TITLE__') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
