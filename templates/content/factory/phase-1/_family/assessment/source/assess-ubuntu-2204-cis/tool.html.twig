{# ns:start family._base.workspace.00_shell #}
<div class="__TOOL_CLASS__ tool-box mb-4" data-tool-slug="__TOOL_SLUG__">
  <form class="__PREFIX__-form" id="__DOM_ID_PREFIX__Form">
{# ns:start family._base.workspace.01_input-brief #}
    <div class="__PREFIX__-input-card">
      <div class="__PREFIX__-input-brief" data-input-layout="inline">
        <div class="__PREFIX__-main-row __PREFIX__-input-row">
          <div class="__PREFIX__-input-label-wrap">
            <label for="__DOM_ID_PREFIX__Query" class="__PREFIX__-main-label __PREFIX__-input-label">Control filter:</label>
            <span class="__PREFIX__-helper-chip" title="Filter by control ID, title, section path, or script name" aria-label="Filter by control ID, title, section path, or script name">i</span>
          </div>

          <div class="__PREFIX__-main-input-grid __PREFIX__-input-stack">
            <input
              type="text"
              id="__DOM_ID_PREFIX__Query"
              class="form-control __PREFIX__-input-control"
              placeholder="1.1.1.1, cramfs, ssh, auditd, pam_unix"
            >
            <div class="__PREFIX__-input-error d-none" id="__DOM_ID_PREFIX__InputError" role="alert"></div>
          </div>
        </div>

        <div class="__PREFIX__-main-actions __PREFIX__-input-actions">
          <button
            type="submit"
            class="btn btn-primary __PREFIX__-submit-btn __PREFIX__-action-btn __PREFIX__-action-btn-primary"
            id="__DOM_ID_PREFIX__Submit"
            data-tool-share-generate
          >
            <i class="bi bi-search" aria-hidden="true"></i>
            <span>Explore</span>
          </button>
          <button
            type="button"
            class="__PREFIX__-action-btn __PREFIX__-action-btn-secondary"
            id="__DOM_ID_PREFIX__Reset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="__PREFIX__-input-helper-card">
          <span class="__PREFIX__-input-hint">Filter the assessment scope before reviewing control evidence and output.</span>
          <span class="__PREFIX__-helper-chip __PREFIX__-helper-chip-inline" title="Filter by control ID, title, section path, or script name" aria-label="Filter by control ID, title, section path, or script name">i</span>
        </div>
      </div>
    </div>
{# ns:end family._base.workspace.01_input-brief #}

{# ns:start family._base.workspace.02_basic-settings #}
    <div class="__PREFIX__-basic-panel">
      <div class="__PREFIX__-inner-panel __PREFIX__-basic-card">

        <div class="__PREFIX__-example-card">
          <span class="__PREFIX__-example-label">Example assessment settings</span>
          <strong class="__PREFIX__-example-value">All sections, all paths, all criticality</strong>
          <span class="__PREFIX__-example-helper">Keep primary scope filters visible before reviewing selected scripts and output limits.</span>
        </div>

        <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
          <label for="__DOM_ID_PREFIX__Family" class="__PREFIX__-setting-label">
            Top-level section:
            <span class="info-dot __PREFIX__-helper-chip" title="Narrow the benchmark to one family such as initial, firewall, or access control">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-native-select-wrap">
                <select id="__DOM_ID_PREFIX__Family" class="form-select __PREFIX__-native-select">
                </select>
              </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
          <label for="__DOM_ID_PREFIX__SectionPath" class="__PREFIX__-setting-label">
            Section path:
            <span class="info-dot __PREFIX__-helper-chip" title="Choose a benchmark path or keep the whole current family in scope">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-native-select-wrap">
                <select id="__DOM_ID_PREFIX__SectionPath" class="form-select __PREFIX__-native-select">
                </select>
              </div>
          </div>
        </div>

        <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
          <label for="__DOM_ID_PREFIX__Criticality" class="__PREFIX__-setting-label">
            Criticality:
            <span class="info-dot __PREFIX__-helper-chip" title="Filter controls by declared benchmark criticality or missing metadata">i</span>
          </label>

          <div class="__PREFIX__-setting-field">
            <div class="__PREFIX__-native-select-wrap">
                <select id="__DOM_ID_PREFIX__Criticality" class="form-select __PREFIX__-native-select">
                </select>
              </div>
          </div>
        </div>

      </div>
    </div>
{# ns:end family._base.workspace.02_basic-settings #}

{# ns:start family._base.workspace.03_custom-settings #}
    <details class="__PREFIX__-advanced" data-custom-layout="compact_two_column_multi_row">
      <summary class="__PREFIX__-advanced-summary">
        <span>Custom</span>
          <span class="__PREFIX__-custom-arrow-slot" aria-hidden="true"></span>
      </summary>

      <div class="__PREFIX__-advanced-body">
        <div class="__PREFIX__-inner-panel">
          <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
            <label for="__DOM_ID_PREFIX__RowLimit" class="__PREFIX__-setting-label">
              Visible rows:
              <span class="info-dot __PREFIX__-helper-chip" title="Limit the controls table while keeping the selected script available">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-native-select-wrap">
                <select id="__DOM_ID_PREFIX__RowLimit" class="form-select __PREFIX__-native-select">
                  <option value="25">25 rows</option>
                  <option value="50" selected>50 rows</option>
                  <option value="100">100 rows</option>
                  <option value="all">All rows</option>
                </select>
              </div>
            </div>
          </div>

          <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
            <label for="__DOM_ID_PREFIX__SelectedControl" class="__PREFIX__-setting-label">
              Script source:
              <span class="info-dot __PREFIX__-helper-chip" title="Pick the exact CIS control script to inspect and copy">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-control-picker" data-control-picker>
                <input type="hidden" id="__DOM_ID_PREFIX__SelectedControl" value="">
                <button type="button" id="__DOM_ID_PREFIX__SelectedControlTrigger" class="__PREFIX__-control-picker-trigger" aria-expanded="false" aria-controls="__DOM_ID_PREFIX__ControlPickerPanel">
                  <span id="__DOM_ID_PREFIX__SelectedControlLabel" class="__PREFIX__-control-picker-label">No script selected</span>
                  <span class="__PREFIX__-control-picker-arrow" aria-hidden="true"></span>
                </button>
                <div id="__DOM_ID_PREFIX__ControlPickerPanel" class="__PREFIX__-control-picker-panel" hidden>
                  <input id="__DOM_ID_PREFIX__ControlPickerSearch" class="form-control __PREFIX__-control-picker-search" type="search" autocomplete="off" aria-label="Search script source" placeholder="Search script source">
                  <div id="__DOM_ID_PREFIX__ControlPickerOptions" class="__PREFIX__-control-picker-options" role="listbox" aria-label="Script source options"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="__PREFIX__-setting-row __PREFIX__-setting-card">
            <label class="__PREFIX__-setting-label">
              Criticality map:
              <span class="info-dot __PREFIX__-helper-chip" title="This reflects the metadata declared in the copied benchmark scripts under assets/bin">i</span>
            </label>

            <div class="__PREFIX__-setting-field">
              <div class="__PREFIX__-criticality-row" id="__DOM_ID_PREFIX__CriticalityRow"></div>
            </div>
          </div>
        </div>
      </div>
    </details>
{# ns:end family._base.workspace.03_custom-settings #}
  </form>

{# ns:start family._base.workspace.05_result-summary #}
  <div class="__PREFIX__-result-panel" id="__DOM_ID_PREFIX__ResultPanel">
    <div class="__PREFIX__-result-empty" id="__DOM_ID_PREFIX__ResultEmpty">Run Explore to review matching controls, section rollups, the selected script, and exportable JSON.</div>

    <div class="__PREFIX__-result-error d-none" id="__DOM_ID_PREFIX__ResultError"></div>

    <div class="__PREFIX__-result-content d-none" id="__DOM_ID_PREFIX__ResultContent">
      <div class="__PREFIX__-output-shell">
        <div class="__PREFIX__-result-summary" id="__DOM_ID_PREFIX__ResultSummary" data-share-snapshot-source data-share-kind="assessment-summary"></div>
{# ns:end family._base.workspace.05_result-summary #}

{# ns:start family._base.workspace.06_output-toolbar #}
        <div class="__TOOL_CLASS__bar-shell">
          <div class="__TOOL_CLASS__bar tool-output-toolbar tool-result-toolbar">
            <div class="__TOOL_CLASS__bar-left tool-result-toolbar-main">
              <div class="__PREFIX__-sort-shell">
                <label for="__DOM_ID_PREFIX__Sort" class="__PREFIX__-sort-label">Sort</label>
                <div class="__PREFIX__-sort-wrap">
                  <details class="__PREFIX__-sort-select" id="__DOM_ID_PREFIX__SortSelect">
                    <summary class="__PREFIX__-sort-summary">
                      <span id="__DOM_ID_PREFIX__SortSummary">ID</span>
                    </summary>

                    <div class="__PREFIX__-sort-menu">
                      <div class="__PREFIX__-sort-grid" id="__DOM_ID_PREFIX__SortOptions">
                        <button type="button" class="__PREFIX__-sort-option is-active" data-sort-value="id" aria-pressed="true">ID</button>
                        <button type="button" class="__PREFIX__-sort-option" data-sort-value="title" aria-pressed="false">A-Z</button>
                        <button type="button" class="__PREFIX__-sort-option" data-sort-value="section" aria-pressed="false">Section</button>
                        <button type="button" class="__PREFIX__-sort-option" data-sort-value="criticality" aria-pressed="false">Criticality</button>
                        <button type="button" class="__PREFIX__-sort-option" data-sort-value="script" aria-pressed="false">Script</button>
                      </div>
                    </div>
                  </details>
                  <input type="hidden" id="__DOM_ID_PREFIX__Sort" value="id">
                </div>
              </div>

              <div class="__TOOL_CLASS__bar-meta" id="__DOM_ID_PREFIX__ToolbarMeta"></div>
            </div>

            <div class="__TOOL_CLASS__bar-actions tool-output-actions tool-result-toolbar-actions">
              <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="__DOM_ID_PREFIX__ExportPdf">
                <i class="bi bi-filetype-pdf" aria-hidden="true"></i>
                <span data-button-label>Export PDF</span>
              </button>
              <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="__DOM_ID_PREFIX__DownloadCsv">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download CSV</span>
              </button>
              <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="__DOM_ID_PREFIX__CopyJson">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                <span data-button-label>Copy JSON</span>
              </button>
              <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="__DOM_ID_PREFIX__DownloadJson">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span data-button-label>Download JSON</span>
              </button>
              <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary tool-result-action-btn" id="__DOM_ID_PREFIX__ImportJsonButton">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span data-button-label>Import JSON</span>
              </button>
            </div>
          </div>
          <input type="file" id="__DOM_ID_PREFIX__ImportJson" class="__PREFIX__-import-input d-none" accept="application/json">
        </div>
{# ns:end family._base.workspace.06_output-toolbar #}

{# ns:start family._base.workspace.07_table-output #}
        <div class="__PREFIX__-tabs-shell">
          <div class="__PREFIX__-tabs">
            <div class="__PREFIX__-tab-list tool-tabs" role="tablist" aria-label="Ubuntu CIS benchmark views">
              <button type="button" class="tool-tab-btn __PREFIX__-tab-btn active" id="__DOM_ID_PREFIX__ControlsTab" data-tab-target="__DOM_ID_PREFIX__ControlsPanel" role="tab" aria-controls="__DOM_ID_PREFIX__ControlsPanel" aria-selected="true" tabindex="0">
                <i class="bi bi-list-check" aria-hidden="true"></i>
                <span>Controls</span>
              </button>
              <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__SectionsTab" data-tab-target="__DOM_ID_PREFIX__SectionsPanel" role="tab" aria-controls="__DOM_ID_PREFIX__SectionsPanel" aria-selected="false" tabindex="-1">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                <span>Sections</span>
              </button>
              <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__ScriptTab" data-tab-target="__DOM_ID_PREFIX__ScriptPanel" role="tab" aria-controls="__DOM_ID_PREFIX__ScriptPanel" aria-selected="false" tabindex="-1">
                <i class="bi bi-terminal" aria-hidden="true"></i>
                <span>Script</span>
              </button>
              <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__ScopeTab" data-tab-target="__DOM_ID_PREFIX__ScopePanel" role="tab" aria-controls="__DOM_ID_PREFIX__ScopePanel" aria-selected="false" tabindex="-1">
                <i class="bi bi-journal-check" aria-hidden="true"></i>
                <span>Scope Notes</span>
              </button>
              <button type="button" class="tool-tab-btn __PREFIX__-tab-btn" id="__DOM_ID_PREFIX__JsonTab" data-tab-target="__DOM_ID_PREFIX__JsonPanel" role="tab" aria-controls="__DOM_ID_PREFIX__JsonPanel" aria-selected="false" tabindex="-1">
                <i class="bi bi-braces" aria-hidden="true"></i>
                <span>JSON</span>
              </button>
            </div>

            <div class="tool-tab-panel __PREFIX__-tab-panel active" id="__DOM_ID_PREFIX__ControlsPanel" data-tab-panel="__DOM_ID_PREFIX__ControlsPanel" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__ControlsTab">
              <section class="__PREFIX__-section-card __PREFIX__-table-card">
                <h3 class="__PREFIX__-section-title">Controls</h3>

                <div class="__PREFIX__-table-wrap tool-result-table-wrap">
                  <table class="table __PREFIX__-table __PREFIX__-controls-table mb-0 tool-result-table" data-share-snapshot-source data-share-kind="assessment-table">
                    <thead>
                      <tr>
                        <th scope="col" class="__PREFIX__-col-index tool-generated-rownum-head">#</th>
                        <th scope="col" class="__PREFIX__-col-id">Control</th>
                        <th scope="col" class="__PREFIX__-col-title">Title</th>
                        <th scope="col" class="__PREFIX__-col-section">Section</th>
                        <th scope="col" class="__PREFIX__-col-criticality">Criticality</th>
                        <th scope="col" class="__PREFIX__-col-script">Script</th>
                        <th scope="col" class="__PREFIX__-col-copy tool-table-action-head"><span class="tool-table-action-head-label">Action</span></th>
                      </tr>
                    </thead>
                    <tbody id="__DOM_ID_PREFIX__ControlsTableBody"></tbody>
                  </table>
                </div>
              </section>
            </div>

            <div class="tool-tab-panel __PREFIX__-tab-panel" id="__DOM_ID_PREFIX__SectionsPanel" data-tab-panel="__DOM_ID_PREFIX__SectionsPanel" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__SectionsTab" hidden>
              <section class="__PREFIX__-section-card __PREFIX__-table-card">
                <h3 class="__PREFIX__-section-title">Sections</h3>

                <div class="__PREFIX__-table-wrap __PREFIX__-table-wrap-compact tool-result-table-wrap">
                  <table class="table __PREFIX__-table __PREFIX__-sections-table mb-0 tool-result-table tool-result-table--compact">
                    <thead>
                      <tr>
                        <th scope="col" class="__PREFIX__-col-index tool-generated-rownum-head">#</th>
                        <th scope="col" class="__PREFIX__-col-path">Section path</th>
                        <th scope="col" class="__PREFIX__-col-depth">Depth</th>
                        <th scope="col" class="__PREFIX__-col-controls">Controls</th>
                        <th scope="col" class="__PREFIX__-col-children">Children</th>
                        <th scope="col" class="__PREFIX__-col-range">Range</th>
                      </tr>
                    </thead>
                    <tbody id="__DOM_ID_PREFIX__SectionsTableBody"></tbody>
                  </table>
                </div>
              </section>
            </div>

            <div class="tool-tab-panel __PREFIX__-tab-panel" id="__DOM_ID_PREFIX__ScriptPanel" data-tab-panel="__DOM_ID_PREFIX__ScriptPanel" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__ScriptTab" hidden>
              <section class="__PREFIX__-section-card">
                <h3 class="__PREFIX__-section-title">Selected Script</h3>

                <div class="__PREFIX__-script-meta" id="__DOM_ID_PREFIX__ScriptMeta" data-share-snapshot-source data-share-kind="assessment-selected"></div>

                <div class="__PREFIX__-script-actions">
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__CopyScript" disabled>
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                    <span data-button-label>Copy script</span>
                  </button>
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__DownloadScript" disabled>
                    <i class="bi bi-download" aria-hidden="true"></i>
                    <span data-button-label>Download script</span>
                  </button>
                  <button type="button" class="__PREFIX__-action-btn tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__FullScript" disabled>
                    <i class="bi bi-collection" aria-hidden="true"></i>
                    <span data-button-label>Full script</span>
                  </button>
                </div>

                <div class="__PREFIX__-script-shell">
                  <pre class="__PREFIX__-script-pre"><code id="__DOM_ID_PREFIX__ScriptOutput"></code></pre>
                </div>
              </section>
            </div>

            <div class="tool-tab-panel __PREFIX__-tab-panel" id="__DOM_ID_PREFIX__ScopePanel" data-tab-panel="__DOM_ID_PREFIX__ScopePanel" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__ScopeTab" hidden>
              <section class="__PREFIX__-section-card">
                <h3 class="__PREFIX__-section-title">Scope Notes</h3>
                <div class="__PREFIX__-table-output-note-grid">
                  <article class="__PREFIX__-table-output-note-card">
                    <h4 class="__PREFIX__-table-output-note-title">Filtered Result</h4>
                    <p class="__PREFIX__-table-output-note-copy">Controls, sections, and selected script output follow the active benchmark family, section, criticality, and row-limit filters.</p>
                  </article>
                  <article class="__PREFIX__-table-output-note-card">
                    <h4 class="__PREFIX__-table-output-note-title">Copy Boundary</h4>
                    <p class="__PREFIX__-table-output-note-copy">Row copy actions copy the visible control metadata. Script copy and download actions stay bound to the selected script panel.</p>
                  </article>
                  <article class="__PREFIX__-table-output-note-card">
                    <h4 class="__PREFIX__-table-output-note-title">JSON Boundary</h4>
                    <p class="__PREFIX__-table-output-note-copy">The JSON tab keeps the normalized filter state, visible rows, selected script metadata, and restore payload together.</p>
                  </article>
                </div>
              </section>
            </div>

            <div class="tool-tab-panel __PREFIX__-tab-panel" id="__DOM_ID_PREFIX__JsonPanel" data-tab-panel="__DOM_ID_PREFIX__JsonPanel" role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__JsonTab" hidden>
{# ns:start family._base.workspace.08_json-restore #}
                          <div class="__PREFIX__-json-restore-shell" id="__DOM_ID_PREFIX__JsonRestoreShell">
              <section class="__PREFIX__-json-card tool-json-panel" aria-label="Assessment JSON output and restore state">
                <div class="__PREFIX__-json-head tool-json-head">
                  <div class="__PREFIX__-json-title-wrap">
                    <span class="__PREFIX__-json-title tool-json-title">JSON Output</span>
                    <span class="__PREFIX__-json-helper">Exported assessment state should include filters, selected control, visible rows, and generated output.</span>
                  </div>
                  <span class="__PREFIX__-json-status is-hidden" id="__DOM_ID_PREFIX__JsonRestoreStatus" role="status" aria-live="polite"></span>
                </div>
                <div class="__PREFIX__-json-empty is-hidden" id="__DOM_ID_PREFIX__JsonRestoreEmpty">Explore controls before exporting JSON.</div>
                <pre class="__PREFIX__-json-output tool-json-output"><code id="__DOM_ID_PREFIX__JsonOutput"></code></pre>
              </section>
            </div>
{# ns:end family._base.workspace.08_json-restore #}
          </div>
        </div>
      </div>
{# ns:end family._base.workspace.07_table-output #}
    </div>
  </div>

  <div class="__PREFIX__-bundle-modal" id="__DOM_ID_PREFIX__BundleModal" hidden>
    <div class="__PREFIX__-bundle-backdrop" data-bundle-dismiss></div>
    <section class="__PREFIX__-bundle-dialog" id="__DOM_ID_PREFIX__BundleDialog" role="dialog" aria-modal="true" aria-labelledby="__DOM_ID_PREFIX__BundleTitle" aria-describedby="__DOM_ID_PREFIX__BundleIntro">
      <div class="__PREFIX__-bundle-header">
        <div>
          <p class="__PREFIX__-bundle-intro" id="__DOM_ID_PREFIX__BundleIntro">Preview the full script request scope before sending it out.</p>
        </div>
        <button type="button" class="__PREFIX__-bundle-close" id="__DOM_ID_PREFIX__BundleClose" aria-label="Close full script request">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>

      <div class="__PREFIX__-bundle-preview-shell">
        <div class="__PREFIX__-bundle-preview-frame">
          <div class="__PREFIX__-bundle-preview-card">
            <div class="__PREFIX__-bundle-preview-head">
              <p class="__PREFIX__-bundle-kicker">Request bundle</p>
              <h3 class="__PREFIX__-bundle-title" id="__DOM_ID_PREFIX__BundleTitle">Full benchmark script bundle</h3>
              <p>The full script bundle is available by request for the current benchmark scope.</p>
            </div>

            <div class="__PREFIX__-bundle-disclaimer" role="note" aria-labelledby="__DOM_ID_PREFIX__BundleDisclaimerTitle">
              <div class="__PREFIX__-bundle-disclaimer-head">
                <span class="__PREFIX__-bundle-disclaimer-icon" aria-hidden="true">
                  <i class="bi bi-exclamation-triangle"></i>
                </span>
                <div>
                  <strong id="__DOM_ID_PREFIX__BundleDisclaimerTitle">Important disclaimer</strong>
                  <span class="__PREFIX__-bundle-disclaimer-subtitle">Review and approve before any operational use.</span>
                </div>
              </div>
              <p>These scripts are for review, planning, and controlled internal use only. They are not a scanner, certification result, production-ready remediation bundle, or approval to make changes. Validate scope, environment, change approval, backups, and rollback before running anything.</p>
            </div>

            <dl class="__PREFIX__-bundle-details" id="__DOM_ID_PREFIX__BundleDetails"></dl>

            <div class="__PREFIX__-bundle-request">
              <span class="__PREFIX__-bundle-request-label">Request details</span>
              <pre class="__PREFIX__-bundle-request-text"><code id="__DOM_ID_PREFIX__BundleRequestText"></code></pre>
            </div>
          </div>
        </div>
      </div>

      <div class="__PREFIX__-bundle-actions">
        <div class="__PREFIX__-bundle-status" role="status" data-bundle-status="ready">
          Ready. Request details will use this benchmark scope.
        </div>
        <a class="__PREFIX__-action-btn __PREFIX__-action-btn-primary" id="__DOM_ID_PREFIX__BundleEmail" href="mailto:hello@infrastack.my">
          <i class="bi bi-envelope" aria-hidden="true"></i>
          <span>Email request</span>
        </a>
        <button type="button" class="__PREFIX__-action-btn __PREFIX__-action-btn-secondary" id="__DOM_ID_PREFIX__BundleCopy">
          <i class="bi bi-clipboard" aria-hidden="true"></i>
          <span data-button-label>Copy request</span>
        </button>
        <button type="button" class="__PREFIX__-action-btn __PREFIX__-action-btn-secondary" id="__DOM_ID_PREFIX__BundleCancel">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
          <span>Close</span>
        </button>
      </div>
    </section>
  </div>
</div>
</div>
{# ns:end family._base.workspace.00_shell #}
