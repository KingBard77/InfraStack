{% set visualVariant = variant|default('card') %}
{% set showPostDetail = visualVariant in ['hero', 'hero-small'] %}
{% if visualVariant == 'style' %}
<style>
.__PREFIX__-post-visual {
    --post-start: #F97316;
    --post-end: #7C3AED;
    --post-accent: #fed7aa;
}

.__PREFIX__-post-visual .tool-post-node:nth-child(1),
.__PREFIX__-post-visual .tool-post-node:nth-child(3),
.__PREFIX__-post-visual .tool-post-node:nth-child(5) {
    background: rgba(254, 215, 170, 0.24);
}

.__PREFIX__-post-visual .tool-post-icon {
    background: rgba(234, 88, 12, 0.28);
}

.__PREFIX__-post-visual .tool-post-icon svg {
    width: 1.75rem;
    height: 1.75rem;
    display: block;
}
</style>
{% else %}
<div
  class="tool-post-visual __PREFIX__-post-visual tool-post-visual-{{ visualVariant }}"
  style="--post-start: {{ post.card_gradient_start|default('#F97316') }}; --post-end: {{ post.card_gradient_end|default('#7C3AED') }};"
>
  <div class="tool-post-bg-icons" aria-hidden="true">
    <i class="bi bi-cash-stack"></i>
    <i class="bi bi-cloud"></i>
    <i class="bi bi-cpu"></i>
    <i class="bi bi-hdd-stack"></i>
    <i class="bi bi-graph-up-arrow"></i>
  </div>
  <div class="tool-post-header">
    <span class="tool-post-kicker">{{ post.card_kicker|default(post.category|default('AWS')) }}</span>
    <span class="tool-post-icon">{{ include('content/tools/__CATEGORY__/__TOOL_SLUG__/assets/icon/aws-tool-__TOOL_SLUG__.svg')|raw }}</span>
  </div>
  <div class="tool-post-title">{{ post.card_image_title|default(post.title|default('__TOOL_TITLE__')) }}</div>
  <div class="tool-post-map" aria-hidden="true">
    <span class="tool-post-node"><i class="bi bi-cloud"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-calculator"></i></span>
    <span class="tool-post-node"></span>
    <span class="tool-post-node"><i class="bi bi-filetype-json"></i></span>
  </div>
  <div class="tool-post-footer">
    <span>{{ post.reading_time|default('5 min read') }}</span>
    <span>{{ post.category|default('AWS') }}</span>
  </div>
  {% if showPostDetail %}
    <div class="tool-post-detail">
      <div class="tool-post-meta">
        <span><i class="bi bi-chevron-down"></i> {{ post.date_display|default('Apr. 6th, 2026') }}</span>
        <span><i class="bi bi-three-dots-vertical"></i> {{ post.category|default('AWS') }}</span>
        <span><i class="bi bi-clock"></i> {{ post.reading_time|default('5 min read') }}</span>
      </div>
      <div class="tool-post-detail-title">{{ post.title|default('__TOOL_TITLE__') }}</div>
      <span class="tool-post-read-more">
        Read More
        <i class="bi bi-arrow-right"></i>
      </span>
    </div>
  {% endif %}
</div>
{% endif %}
