{# tool.html.twig #}
{# ns:start family._base.workspace.00_shell #}

<div class="__TOOL_CLASS__" data-tool-slug="__TOOL_SLUG__">
  <div class="tool-box">
    {# ns:start family._base.workspace.01_input-brief #}
    <div class="tool-shell tool-prompt-shell __PREFIX__-input-card">
      <div class="__PREFIX__-input-brief" data-input-layout="stacked">
        <div class="__PREFIX__-input-row">
          <div class="__PREFIX__-input-label-wrap">
            <label for="__DOM_ID_PREFIX__Prompt" class="tool-main-label __PREFIX__-input-label">Architecture prompt</label>
            <span class="__PREFIX__-helper-chip" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
          </div>
          <div class="tool-main-input-grid __PREFIX__-main-input-grid __PREFIX__-input-stack">
            <textarea
              id="__DOM_ID_PREFIX__Prompt"
              class="form-control __PREFIX__-prompt __PREFIX__-input-control"
              rows="7"
              placeholder="Describe the AWS VPC layout, region, availability zones, ingress path, compute tier, database tier, and shared services."
            >Create an AWS VPC architecture in us-east-1 with 2 availability zones. Use public subnets for an internet-facing Application Load Balancer, private app subnets for EC2 application servers, and private data subnets for a Multi-AZ RDS PostgreSQL database. Add a single NAT gateway, VPC endpoints for S3 and Systems Manager, CloudWatch, and VPC flow logs.</textarea>
            <div class="__PREFIX__-input-error d-none" id="__DOM_ID_PREFIX__InputError" role="alert"></div>
          </div>
        </div>

        <div class="__PREFIX__-main-actions __PREFIX__-input-actions">
          <button
            type="button"
            class="tool-action-btn tool-action-btn-primary __PREFIX__-action-btn __PREFIX__-action-btn-primary"
            id="__DOM_ID_PREFIX__Generate"
          >
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span>Generate Diagram</span>
          </button>
          <button
            type="button"
            class="tool-action-btn tool-action-btn-secondary __PREFIX__-action-btn __PREFIX__-action-btn-secondary"
            id="__DOM_ID_PREFIX__Reset"
          >
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>

        <div class="__PREFIX__-input-helper-card">
          <span class="__PREFIX__-input-hint">Use one brief prompt with region, AZ count, ingress, private tiers, and supporting AWS services. Presets below can prefill and instantly generate a working layout.</span>
          <span class="__PREFIX__-helper-chip __PREFIX__-helper-chip-inline" title="Describe the architecture prompt boundary." aria-label="Describe the architecture prompt boundary.">i</span>
        </div>
      </div>
    </div>
    {# ns:end family._base.workspace.01_input-brief #}

    <div class="tool-error-state d-none" id="__DOM_ID_PREFIX__ErrorState"></div>

    <div class="__PREFIX__-advanced-grid">
      <aside class="tool-shell tool-inspector-shell">

        <div class="tool-shell-body">
          {# ns:start family._base.workspace.02_basic-settings #}
          <div class="tool-inspector-section __PREFIX__-basic-preset-section __PREFIX__-basic-card">

            <div class="__PREFIX__-example-card">
              <span class="__PREFIX__-example-label">Example architecture settings</span>
              <strong class="__PREFIX__-example-value">3-tier web, us-east-1, 2 zones</strong>
              <span class="__PREFIX__-example-helper">Region, zone count, and preset should change the generated model and exported JSON.</span>
            </div>

            <div class="__PREFIX__-basic-grid">
              <div class="__PREFIX__-control-stack __PREFIX__-setting-card">
                <label class="tool-control-label __PREFIX__-setting-label" for="__DOM_ID_PREFIX__Preset">Preset <span class="__PREFIX__-helper-chip" title="Choose a starting preset that updates the visible controls and generated output." aria-label="Choose a starting preset that updates the visible controls and generated output.">i</span></label>
                <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__PresetSelect">
                  <select id="__DOM_ID_PREFIX__Preset" class="form-select __PREFIX__-native-select">
                    <option value="three-tier-web" selected>3-Tier Web</option>
                    <option value="ecs-fargate">ECS Fargate</option>
                    <option value="eks-platform">Private EKS</option>
                    <option value="hybrid-shared">Hybrid Shared Services</option>
                  </select>
                </div>
              </div>

              <div class="__PREFIX__-control-stack __PREFIX__-setting-card">
                <label class="tool-control-label __PREFIX__-setting-label" for="__DOM_ID_PREFIX__Region">Region <span class="__PREFIX__-helper-chip" title="Choose the provider region used by the generated model and exported JSON." aria-label="Choose the provider region used by the generated model and exported JSON.">i</span></label>
                <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__RegionSelect">
                  <select id="__DOM_ID_PREFIX__Region" class="form-select __PREFIX__-native-select">
                    <option value="us-east-1">us-east-1</option>
                    <option value="us-east-2">us-east-2</option>
                    <option value="us-west-2">us-west-2</option>
                    <option value="eu-west-1">eu-west-1</option>
                    <option value="ap-southeast-1">ap-southeast-1</option>
                    <option value="ap-southeast-2">ap-southeast-2</option>
                    <option value="ap-northeast-1">ap-northeast-1</option>
                  </select>
                </div>
              </div>

              <div class="__PREFIX__-control-stack __PREFIX__-setting-card">
                <label class="tool-control-label __PREFIX__-setting-label" for="__DOM_ID_PREFIX__AzCount">Availability zones <span class="__PREFIX__-helper-chip" title="Choose the zone count used by placement and resilience assumptions." aria-label="Choose the zone count used by placement and resilience assumptions.">i</span></label>
                <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__AzCountSelect">
                  <select id="__DOM_ID_PREFIX__AzCount" class="form-select __PREFIX__-native-select">
                    <option value="1">1 AZ</option>
                    <option value="2" selected>2 AZ</option>
                    <option value="3">3 AZ</option>
                  </select>
                </div>
              </div>
              <p class="tool-control-hint __PREFIX__-setting-hint" id="__DOM_ID_PREFIX__PresetDescription">Public ALB, private EC2 app tier, Multi-AZ RDS, single NAT.</p>
            </div>
          </div>
          {# ns:end family._base.workspace.02_basic-settings #}

          {# ns:start family._base.workspace.03_custom-settings #}
          <details class="__PREFIX__-custom-panel" data-custom-layout="tabbed_two_column">
            <summary class="__PREFIX__-custom-panel-summary">
              <span>Custom</span>
                <span class="__PREFIX__-custom-arrow-slot" aria-hidden="true"></span>
            </summary>

            <div class="__PREFIX__-custom-panel-body">
              <div class="__PREFIX__-config-tabs" role="tablist" aria-label="AWS VPC custom configuration">
                <button type="button" class="__PREFIX__-config-tab active" id="__DOM_ID_PREFIX__NetworkConfigTab" data-config-tab-target="__DOM_ID_PREFIX__NetworkConfigPanel" role="tab" aria-controls="__DOM_ID_PREFIX__NetworkConfigPanel" aria-selected="true" tabindex="0">Network layout</button>
                <button type="button" class="__PREFIX__-config-tab" id="__DOM_ID_PREFIX__WorkloadConfigTab" data-config-tab-target="__DOM_ID_PREFIX__WorkloadConfigPanel" role="tab" aria-controls="__DOM_ID_PREFIX__WorkloadConfigPanel" aria-selected="false" tabindex="-1">Workload</button>
                <button type="button" class="__PREFIX__-config-tab" id="__DOM_ID_PREFIX__ServicesConfigTab" data-config-tab-target="__DOM_ID_PREFIX__ServicesConfigPanel" role="tab" aria-controls="__DOM_ID_PREFIX__ServicesConfigPanel" aria-selected="false" tabindex="-1">Services and controls</button>
              </div>

              <div class="tool-inspector-section __PREFIX__-config-panel active" id="__DOM_ID_PREFIX__NetworkConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__NetworkConfigTab">
                <div class="__PREFIX__-config-grid">
                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_ID_PREFIX__Cidr">VPC CIDR <span class="__PREFIX__-helper-chip __PREFIX__-custom-helper-chip" title="Tune vpc cidr before regenerating the diagram." aria-label="Tune vpc cidr before regenerating the diagram.">i</span></label>
                    <input type="text" id="__DOM_ID_PREFIX__Cidr" class="form-control" value="10.0.0.0/16" placeholder="10.0.0.0/16">
                  </div>

                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_ID_PREFIX__NatMode">NAT mode <span class="__PREFIX__-helper-chip __PREFIX__-custom-helper-chip" title="Tune nat mode before regenerating the diagram." aria-label="Tune nat mode before regenerating the diagram.">i</span></label>                    <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__NatModeSelect">
                      <select id="__DOM_ID_PREFIX__NatMode" class="form-select __PREFIX__-native-select">
                        <option value="none">No NAT</option>
                        <option value="single" selected>Single NAT</option>
                        <option value="per-az">One per AZ</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section __PREFIX__-config-panel" id="__DOM_ID_PREFIX__WorkloadConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__WorkloadConfigTab" hidden>
                <div class="__PREFIX__-config-grid">
                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_ID_PREFIX__AppTier">App tier <span class="__PREFIX__-helper-chip __PREFIX__-custom-helper-chip" title="Tune app tier before regenerating the diagram." aria-label="Tune app tier before regenerating the diagram.">i</span></label>                    <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__AppTierSelect">
                      <select id="__DOM_ID_PREFIX__AppTier" class="form-select __PREFIX__-native-select">
                        <option value="ec2" selected>EC2 Auto Scaling</option>
                        <option value="ecs">ECS / Fargate</option>
                        <option value="eks">EKS</option>
                        <option value="lambda">Lambda in VPC</option>
                      </select>
                    </div>
                  </div>

                  <div class="__PREFIX__-control-stack">
                    <label class="tool-control-label" for="__DOM_ID_PREFIX__Database">Database tier <span class="__PREFIX__-helper-chip __PREFIX__-custom-helper-chip" title="Tune database tier before regenerating the diagram." aria-label="Tune database tier before regenerating the diagram.">i</span></label>                    <div class="__PREFIX__-native-select-wrap" id="__DOM_ID_PREFIX__DatabaseSelect">
                      <select id="__DOM_ID_PREFIX__Database" class="form-select __PREFIX__-native-select">
                        <option value="none">No database tier</option>
                        <option value="rds" selected>RDS</option>
                        <option value="aurora">Aurora</option>
                        <option value="dynamodb">DynamoDB</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <div class="tool-inspector-section __PREFIX__-config-panel" id="__DOM_ID_PREFIX__ServicesConfigPanel" data-config-panel role="tabpanel" aria-labelledby="__DOM_ID_PREFIX__ServicesConfigTab" hidden>
                <div class="__PREFIX__-toggle-grid">
                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Route 53</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Route53" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">CloudFront</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__CloudFront">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">AWS WAF</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Waf">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Application Load Balancer</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Alb" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Bastion host</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Bastion">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">VPC endpoints</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Endpoints" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">VPC flow logs</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__FlowLogs" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">CloudWatch</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__CloudWatch" checked>
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Site-to-site VPN</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__SiteToSiteVpn">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">Transit gateway</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__TransitGateway">
                  </label>

                  <label class="__PREFIX__-toggle-item">
                    <span class="__PREFIX__-toggle-copy">ElastiCache</span>
                    <input type="checkbox" id="__DOM_ID_PREFIX__Cache">
                  </label>
                </div>
              </div>

            </div>
          </details>
          {# ns:end family._base.workspace.03_custom-settings #}

          {# ns:start family.architecture.workspace.04_selected-item #}
          <div class="tool-inspector-section __PREFIX__-selected-section" id="__DOM_ID_PREFIX__SelectedShell">
            <h3 class="__PREFIX__-section-title">Selected item</h3>

            <p class="__PREFIX__-selected-empty __PREFIX__-selected-empty-chips" id="__DOM_ID_PREFIX__SelectedEmpty" aria-label="Select a draggable box in the stage to move, resize, or highlight it. Select a line to adjust its arrow handles. Arrow keys move the selected box; Shift moves faster; Alt + arrow keys resize; Cmd/Ctrl + Z undoes the last stage edit.">
              <span class="__PREFIX__-selected-empty-copy">
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-select"><i class="bi bi-cursor" aria-hidden="true"></i>Select a draggable box</span>
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-action"><i class="bi bi-bezier2" aria-hidden="true"></i>Select a line to adjust arrows</span>
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-action"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move, resize, or highlight</span>
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-keyboard"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>Arrow keys move selected box</span>
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-keyboard"><i class="bi bi-shift" aria-hidden="true"></i>Shift moves faster</span>
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-resize"><i class="bi bi-aspect-ratio" aria-hidden="true"></i>Alt + arrow keys resize</span>
                <span class="__PREFIX__-selected-hint-chip __PREFIX__-selected-hint-chip-undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Cmd/Ctrl + Z undoes last edit</span>
              </span>
            </p>

            <div class="__PREFIX__-selected-editor d-none" id="__DOM_ID_PREFIX__SelectedEditor">
              <div class="__PREFIX__-selected-name" id="__DOM_ID_PREFIX__SelectedName"></div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="__DOM_ID_PREFIX__SelectedX">X position</label>
                <div class="tool-control-field">
                  <input type="number" id="__DOM_ID_PREFIX__SelectedX" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="__DOM_ID_PREFIX__SelectedY">Y position</label>
                <div class="tool-control-field">
                  <input type="number" id="__DOM_ID_PREFIX__SelectedY" class="form-control" min="0" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="__DOM_ID_PREFIX__SelectedWidth">Width</label>
                <div class="tool-control-field">
                  <input type="number" id="__DOM_ID_PREFIX__SelectedWidth" class="form-control" min="96" step="4">
                </div>
              </div>

              <div class="tool-control-row">
                <label class="tool-control-label" for="__DOM_ID_PREFIX__SelectedHeight">Height</label>
                <div class="tool-control-field">
                  <input type="number" id="__DOM_ID_PREFIX__SelectedHeight" class="form-control" min="44" step="4">
                </div>
              </div>

              <div class="__PREFIX__-selected-actions">
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__HighlightCard">Highlight box</button>
                <button type="button" class="tool-action-btn tool-action-btn-secondary" id="__DOM_ID_PREFIX__ApplyCardSize">Apply item</button>
                <button type="button" class="tool-action-btn tool-action-btn-ghost" id="__DOM_ID_PREFIX__ResetCardSize">Reset item</button>
              </div>
            </div>
          </div>
          {# ns:end family.architecture.workspace.04_selected-item #}
        </div>
      </aside>
    </div>

    <section class="tool-shell tool-stage-shell" id="__DOM_ID_PREFIX__StageShell" data-section="diagram-buttons" data-root-selector=".__TOOL_CLASS__">
      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-shell-header __PREFIX__-stage-header" data-section="title" data-root-selector=".__TOOL_CLASS__">
        <div class="__PREFIX__-stage-heading">
          <h2 class="tool-shell-title" id="__DOM_ID_PREFIX__StageTitle">__TOOL_TITLE__</h2>
          <p class="tool-shell-subtitle" id="__DOM_ID_PREFIX__StageSubtitle">
            <span class="__PREFIX__-stage-preset-chip">3-Tier Web preset</span>
          </p>
        </div>
        <div class="__PREFIX__-stage-meta" id="__DOM_ID_PREFIX__StageMeta"></div>
      </div>
      {# ns:end family.architecture.workspace.04_visual-contract #}

      {# ns:start family.architecture.workspace.04_visual-contract #}
      <div class="tool-stage-toolbar">
        <div class="__PREFIX__-stage-toolbar-actions">
          <div class="__PREFIX__-zoom-control" id="__DOM_ID_PREFIX__ZoomControl">
            <button type="button" class="__PREFIX__-zoom-step" id="__DOM_ID_PREFIX__ZoomOut" aria-label="Zoom out" title="Zoom out">
              <i class="bi bi-dash" aria-hidden="true"></i>
            </button>
            <input type="number" id="__DOM_ID_PREFIX__ZoomInput" class="__PREFIX__-zoom-input" value="50" min="15" max="240" step="1" aria-label="Zoom percentage">
            <span class="__PREFIX__-zoom-label" id="__DOM_ID_PREFIX__ZoomLabel">%</span>
            <button type="button" class="__PREFIX__-zoom-step" id="__DOM_ID_PREFIX__ZoomIn" aria-label="Zoom in" title="Zoom in">
              <i class="bi bi-plus" aria-hidden="true"></i>
            </button>
          </div>

          <button type="button" class="__PREFIX__-icon-btn" id="__DOM_ID_PREFIX__ZoomFit" aria-label="Zoom to fit" title="Zoom to fit">
            <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i>
          </button>
          <button type="button" class="__PREFIX__-icon-btn" id="__DOM_ID_PREFIX__ZoomActual" aria-label="Zoom to 100%" title="Zoom to 100%">
            <span>100</span>
          </button>
          <button type="button" class="__PREFIX__-icon-btn" id="__DOM_ID_PREFIX__UndoStageEdit" aria-label="Undo stage edit" title="Undo stage edit" disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
          <button type="button" class="__PREFIX__-icon-btn" id="__DOM_ID_PREFIX__HighlightAll" aria-label="Highlight entire diagram" title="Highlight entire diagram" aria-pressed="false">
            <i class="bi bi-bounding-box" aria-hidden="true"></i>
          </button>
          <button type="button" class="__PREFIX__-icon-btn" id="__DOM_ID_PREFIX__ZoomHideUi" aria-label="Hide UI" title="Hide UI">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
          </button>
          <button type="button" class="__PREFIX__-icon-btn" id="__DOM_ID_PREFIX__Fullscreen" aria-label="Open fullscreen" title="Open fullscreen">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
          </button>
          <button type="button" class="tool-action-btn tool-action-btn-ghost __PREFIX__-stage-toolbar-btn" id="__DOM_ID_PREFIX__ResetLayout" aria-label="Auto layout" title="Auto layout">Auto layout</button>
        </div>
      </div>

      <div class="tool-stage-body">
        <div class="tool-stage-empty" id="__DOM_ID_PREFIX__StageEmpty">Choose a preset to generate diagram.</div>
        <div class="tool-stage-canvas __PREFIX__-stage-canvas d-none" id="__DOM_ID_PREFIX__StageCanvas"></div>
      </div>

      <div class="__PREFIX__-stage-footer">
        <div class="__PREFIX__-stage-toolbar-chips">
          <span class="tool-helper-chip tool-helper-chip-prompt" title="Prompt and preset aware" aria-label="Prompt and preset aware" tabindex="0">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span class="__PREFIX__-visually-hidden">Prompt and preset aware</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-inspector" title="Editable inspector controls" aria-label="Editable inspector controls" tabindex="0">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            <span class="__PREFIX__-visually-hidden">Editable inspector controls</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-drag" title="Drag boxes to customize layout" aria-label="Drag boxes to customize layout" tabindex="0">
            <i class="bi bi-arrows-move" aria-hidden="true"></i>
            <span class="__PREFIX__-visually-hidden">Drag boxes to customize layout</span>
          </span>
          <span class="tool-helper-chip tool-helper-chip-svg" title="SVG workspace" aria-label="SVG workspace" tabindex="0">
            <i class="bi bi-bezier2" aria-hidden="true"></i>
            <span class="__PREFIX__-visually-hidden">SVG workspace</span>
          </span>
          <button type="button" class="tool-helper-chip tool-helper-chip-keyboard" id="__DOM_ID_PREFIX__UsageHelpButton" title="Keyboard shortcuts and usage" aria-label="Open keyboard help" aria-controls="__DOM_ID_PREFIX__UsageHelpPopup" aria-expanded="false">
            <i class="bi bi-keyboard" aria-hidden="true"></i>
            <span class="__PREFIX__-visually-hidden">Keyboard Help</span>
          </button>
        </div>
      </div>

      <div class="__PREFIX__-usage-overlay d-none" id="__DOM_ID_PREFIX__UsageHelpPopup" role="dialog" aria-modal="false" aria-labelledby="__DOM_ID_PREFIX__UsageHelpTitle">
        <div class="__PREFIX__-usage-card">
          <button type="button" class="__PREFIX__-usage-close" id="__DOM_ID_PREFIX__UsageHelpClose" aria-label="Close keyboard help">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>

          <h3 class="__PREFIX__-usage-title" id="__DOM_ID_PREFIX__UsageHelpTitle">Diagram Controls</h3>
          <p class="__PREFIX__-usage-copy">Select a box in the diagram, then adjust it without leaving the stage.</p>

          <div class="__PREFIX__-usage-panel">Hold the selected box in place visually while you tune layout, size, and zoom.</div>

          <div class="__PREFIX__-usage-divider"></div>

          <div class="__PREFIX__-usage-list" aria-label="Keyboard and pointer controls">
            <div class="__PREFIX__-usage-row">
              <span class="__PREFIX__-usage-keys">
                <kbd>←</kbd>
                <kbd>↑</kbd>
                <kbd>↓</kbd>
                <kbd>→</kbd>
              </span>
              <span>move selected box</span>
            </div>
            <div class="__PREFIX__-usage-row">
              <span class="__PREFIX__-usage-keys">
                <kbd>Shift</kbd>
                <kbd>+</kbd>
                <kbd>Arrows</kbd>
              </span>
              <span>move faster</span>
            </div>
            <div class="__PREFIX__-usage-row">
              <span class="__PREFIX__-usage-keys">
                <kbd>Alt</kbd>
                <kbd>+</kbd>
                <kbd>Arrows</kbd>
              </span>
              <span>resize selected box</span>
            </div>
            <div class="__PREFIX__-usage-row">
              <span class="__PREFIX__-usage-keys">
                <kbd>Mouse</kbd>
                <kbd>Drag</kbd>
              </span>
              <span>reposition box</span>
            </div>
            <div class="__PREFIX__-usage-row">
              <span class="__PREFIX__-usage-keys">
                <kbd>Cmd / Ctrl</kbd>
                <kbd>+</kbd>
                <kbd>Z</kbd>
              </span>
              <span>undo stage edit</span>
            </div>
            <div class="__PREFIX__-usage-row">
              <span class="__PREFIX__-usage-keys">
                <kbd>Ctrl / Cmd</kbd>
                <kbd>Wheel</kbd>
              </span>
